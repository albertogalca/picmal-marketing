---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import VideoPlayer from "../components/VideoPlayer.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import FAQSchema from "../components/schema/FAQSchema.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import FeatureCard from "../components/FeatureCard.astro";
import { Image } from "astro:assets";
import Button from "../components/Button.astro";
import Testimonials from "../components/Testimonials.astro";
import Paragraph from "../components/Paragraph.astro";
import H3 from "../components/H3.astro";
import TrustBar from "../components/TrustBar.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import FileSizeComparison from "../components/FileSizeComparison.astro";

const SITE_TITLE = "Picmal - Image converter & compressor for Mac";
const SITE_DESCRIPTION =
  "Picmal makes converting and compressing images a breeze. Convert or compress batches of images, entirely offline on your Mac—fast and private.";

const faqs = [
  {
    question: "Is Picmal available for Windows or Linux?",
    answer:
      "Picmal is a native Mac app, so it's only available for Mac. For now and forever.",
  },
  {
    question: "What image formats does Picmal support?",
    answer:
      "Picmal supports 20+ formats including JPEG, PNG, WEBP, AVIF, HEIC, RAW (CR2, NEF, ARW), TIFF, PSD, GIF, BMP, SVG, EPS, AI, ICO, and more.",
  },
  {
    question: "What compression formats are supported?",
    answer:
      "Picmal supports compression for the following formats: JPEG, WebP, PNG, GIF, TIFF, AVIF and PDF. You can either compress images directly without converting them or compress them after converting them to one of these formats.",
  },
  {
    question: "Where are my images processed?",
    answer:
      "All image processing happens locally on your Mac. Picmal does not upload your images to any servers.",
  },
  {
    question: "Can I convert multiple images at once?",
    answer:
      "Yes! Picmal excels at batch processing. Simply drag and drop multiple images, or even entire folders, and convert them all at once.",
  },
  {
    question: "What macOS versions are supported?",
    answer:
      "Picmal requires macOS Sonoma (14.0) or later. It's optimized for Apple Silicon Macs but also works great on Intel Macs.",
  },
  {
    question: "Do you offer a free trial?",
    answer:
      "No, but if you try and don't like it, contact me and I will refund you the money.",
  },
  {
    question: "Do I need an internet connection to use Picmal?",
    answer:
      "No internet connection is required after installation. Picmal works completely offline, ensuring your images never leave your device.",
  },
];

const licenseFaqs = [
  {
    question: "How does the license work?",
    answer:
      "When you purchase a Picmal license, you can use it indefinitely without any additional fees. This means you won't need to renew your license or make any regular payments to continue using it. You can move your license between devices, but you must first deactivate the license on the current device before activating it on a new one.",
  },
  {
    question: "How many devices can I use Picmal on?",
    answer:
      "Each license lets you use Picmal on that number of different Macs — for example, the 2-device license works on two Macs, the 5-device license on five, and so on.",
  },
  {
    question: "Can I use Picmal on multiple Macs?",
    answer:
      "While your license is tied to one active device at a time, you can transfer it between your Macs. Simply deactivate the license from your current Mac and activate it on another Mac when needed.",
  },
  {
    question: "What happens if I get a new Mac?",
    answer:
      "You can easily transfer your Picmal license to your new Mac. Just deactivate the license on your old Mac (via Picmal → Register license), then install Picmal on your new Mac and activate it with your existing license key.",
  },
  {
    question: "Can I get a refund?",
    answer:
      "Yes, there is a 14-day money-back guarantee. No questions asked. If you're not satisfied with Picmal, send your refund request to support@picmal.app and I'd love to hear your feedback too!",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <FAQSchema />
  </head>
  <body>
    <Header />

    <!-- Hero Section -->
    <main id="main-content" class="relative z-10 px-6 pt-32 pb-16">
      <div class="max-w-3xl mx-auto text-center">
        <H1 class="mb-6"> Image converter & compressor for Mac </H1>
        <Paragraph class="mb-6 max-w-xl mx-auto">
          Picmal makes converting and compressing images a breeze. Convert or
          compress batches of images, entirely offline on your Mac—fast and
          private.
        </Paragraph>

        <div class="flex flex-col items-center gap-4 mb-12">
          <div
            class="flex flex-col sm:flex-row gap-3 items-center justify-center"
          >
            <Button text="Buy for Mac" />
            <Button
              href="/apps/picmal/updates/Picmal.dmg"
              text="Download"
              variant="secondary"
              icon="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8 4.35 4.35 0 0 1-2.59-4.03z"
              iconType="fill"
              target="_self"
              rel=""
            />
          </div>
          <Paragraph size="small">
            One-time purchase • 14-day money back guarantee
          </Paragraph>
        </div>

        <!-- Demo Video -->
        <div class="max-w-4xl mx-auto">
          <VideoPlayer src="/picmal-demo.mp4" />
        </div>

        <!-- Trust Bar -->
        <div class="mt-12">
          <TrustBar />
        </div>
      </div>
    </main>

    <!-- Features Section -->
    <section
      id="features"
      class="relative z-10 px-6 py-20 bg-accent-background"
    >
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-24 text-center">Why choose Picmal?</H2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 text-left">
          <FeatureCard
            icon="M13 10V3L4 14h7v7l9-11h-7z"
            title="It's fast & local"
            description="Picmal works offline. You don't need an internet connection for anything. Everything happens on your laptop."
          />

          <FeatureCard
            icon="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
            title="It's all kept private"
            description="Everything's handled from the analytics tool I use to how your pictures are stored — I don't upload any of your private data anywhere."
          />

          <FeatureCard
            icon="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 16c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6zm0-10c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4z"
            title="It's meant to be straightforward"
            description="If I add anything else, it'll be for a good reason. There's no need for unnecessary AI or random features. It's just a basic UI that works well and looks like an app designed by Apple."
          />

          <FeatureCard
            icon="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h2v-6h-2v6zm0-8h2V7h-2v2z"
            title="It's designed to save you time"
            description="Batch process thousands of images at once. Drop entire folders and let Picmal handle the rest while you focus on what matters."
          />
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="relative z-10 px-6 py-20 bg-white">
      <div class="max-w-xl mx-auto">
        <H2 class="mb-10 text-center">Pricing</H2>

        <!-- Pricing Card -->
        <div class="bg-white rounded-xl p-4 md:p-8 border border-gray-200 shadow-sm">
          <div class="mb-6">
            <H3 class="text-xl md:text-3xl">Single license</H3>
          </div>

          <!-- Price -->
          <div class="mb-8 flex items-start">
            <span class="text-4xl md:text-5xl font-bold text-black">$9.99</span>
            <span class="text-gray-500 text-xl md:text-2xl ml-2">/once</span>
          </div>

          <!-- Pricing Tiers Info -->
          <div
            class="mb-8 bg-gray-50 rounded-lg px-4 py-6 md:px-6 border border-gray-100"
          >
            <h4 class="text-base font-bold text-black mb-4">
              Price increases with each tier
            </h4>

            <div class="space-y-2 text-base">
              <div class="flex items-center gap-3">
                <svg
                  class="w-4 h-4 text-gray-400 flex-shrink-0 hidden md:block"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <circle
                    cx="10"
                    cy="10"
                    r="8"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"></circle>
                  <circle cx="10" cy="10" r="3" fill="currentColor"></circle>
                </svg>
                <span class="text-gray-500 line-through"
                  >$5.99 for customers 1–10 (sold)</span
                >
              </div>

              <div class="flex items-center gap-3">
                <svg
                  class="w-4 h-4 text-gray-400 flex-shrink-0 hidden md:block"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <circle
                    cx="10"
                    cy="10"
                    r="8"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"></circle>
                  <circle cx="10" cy="10" r="3" fill="currentColor"></circle>
                </svg>
                <span class="text-gray-500 line-through"
                  >$7.99 for customers 11–20 (sold)</span
                >
              </div>

              <div class="flex items-center gap-3">
                <svg
                  class="w-4 h-4 text-accent flex-shrink-0 hidden md:block"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="font-medium text-black"
                  >$9.99 for customers 21–30</span
                >
              </div>

              <div class="flex items-center gap-3">
                <svg
                  class="w-4 h-4 text-gray-300 flex-shrink-0 hidden md:block"
                  fill="none"
                  viewBox="0 0 20 20"
                >
                  <circle
                    cx="10"
                    cy="10"
                    r="8"
                    stroke="currentColor"
                    stroke-width="2"></circle>
                </svg>
                <span class="text-gray-600">$11.99 for customers 31–40</span>
              </div>

              <div class="flex items-center gap-3">
                <svg
                  class="w-4 h-4 text-gray-300 flex-shrink-0 hidden md:block"
                  fill="none"
                  viewBox="0 0 20 20"
                >
                  <circle
                    cx="10"
                    cy="10"
                    r="8"
                    stroke="currentColor"
                    stroke-width="2"></circle>
                </svg>
                <span class="text-gray-600">$13.99 for customers 41–50</span>
              </div>

              <div class="flex items-center gap-3">
                <svg
                  class="w-4 h-4 text-gray-300 flex-shrink-0 hidden md:block"
                  fill="none"
                  viewBox="0 0 20 20"
                >
                  <circle
                    cx="10"
                    cy="10"
                    r="8"
                    stroke="currentColor"
                    stroke-width="2"></circle>
                </svg>
                <span class="text-gray-600">$15.99 for customers 51+</span>
              </div>
            </div>
          </div>

          <!-- Features Label -->
          <div class="mb-4">
            <p class="text-base font-semibold text-gray-600">Features</p>
          </div>

          <!-- Features List -->
          <div class="space-y-3 mb-8">
            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-accent flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700">All future updates included</span>
            </div>

            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-accent flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700">Convert 20+ image formats</span>
            </div>

            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-accent flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700"
                >Compress images without quality loss</span
              >
            </div>

            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-accent flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700"
                >Batch processing for multiple images</span
              >
            </div>

            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-accent flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700"
                >100% offline - your images never leave your Mac</span
              >
            </div>
          </div>

          <!-- CTA Button -->
          <Button text="Buy for Mac" class="w-full" />
        </div>

        <p class="text-center text-sm text-gray-600 mt-8">
          Prices in USD. VAT may apply. Secure payment via Lemon Squeezy.
        </p>
      </div>

      <div class="max-w-3xl mx-auto mt-16">
        <!-- License FAQ -->
        <div class="mt-12">
          <FAQ faqs={licenseFaqs} />
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section id="testimonials" class="relative z-10 px-6 py-20 bg-accent-background">
      <div class="max-w-5xl mx-auto">
        <H2 class="mb-10 text-center">What users are saying</H2>

        <Testimonials />

        <div class="mt-12 text-center space-y-4">
          <Paragraph class="font-bold text-black">
            Are you happy with Picmal?
          </Paragraph>
          <Button
            href="mailto:support@picmal.app"
            text="Leave a review"
            variant="secondary"
            size="small"
            class="block max-w-[200px] mx-auto"
          />
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="relative z-10 px-6 py-20 bg-white">
      <div class="max-w-xl mx-auto">
        <div class="relative">
          <!-- Background layer -->
          <div
            class="absolute inset-0 transform rotate-1 trangray-x-2 trangray-y-2 rounded-2xl bg-gray-100 border-gray-300/30 border"
          >
          </div>

          <!-- Main letter -->
          <div
            class="relative transform -rotate-1 bg-white border-gray-200 border rounded-2xl p-8 shadow-lg"
          >
            <div class="text-lg leading-relaxed text-black">
              <Paragraph class="mb-6 text-lg">Hey there!</Paragraph>

              <Paragraph class="mb-6 text-lg">
                I'm{" "}
                <a
                  href="https://albertogalca.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline underline-offset-4 hover:text-black transition-colors duration-200"
                >
                  Alberto</a
                >
                , the developer behind Picmal.
              </Paragraph>

              <Paragraph class="mb-6 text-lg">
                I built this app because I was frustrated with the options that
                were already out there. Online converters were a pain because
                you had to upload private images, and the local tools I tried
                were either too complicated or required using the terminal.
              </Paragraph>

              <Paragraph class="mb-6 text-lg">
                Picmal is my go-to: a native Mac app that's fast, fully private,
                and can handle multiple images at once. Simple, reliable, and
                designed with care.
              </Paragraph>

              <Paragraph class="mb-8 text-lg">
                If you have any questions or suggestions for improvement, I'd be
                happy to hear them.
              </Paragraph>

              <div class="flex items-center gap-2">
                <Image
                  src="/alberto.webp"
                  alt="Alberto, creator of Picmal"
                  width={64}
                  height={64}
                  class="w-14 h-14 object-cover rounded-full"
                />
                <div>
                  <Paragraph class="font-semibold text-black">Alberto</Paragraph
                  >
                  <Paragraph> Creator of Picmal </Paragraph>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-20 bg-accent-background">
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-10"> Frequently asked questions </H2>
        <FAQ faqs={faqs} />
      </div>
    </section>

    <!-- Final CTA Section -->
    <section class="relative z-10 px-6 py-20 bg-white">
      <div class="max-w-2xl mx-auto text-center">
        <H2 class="mb-6">Ready to start converting?</H2>
        <Paragraph class="mb-8 text-lg">
          Join Mac users who trust Picmal for fast, private image conversion.
        </Paragraph>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <Button text="Buy for Mac" />
          <Button
            href="/apps/picmal/updates/Picmal.dmg"
            text="Download"
            variant="secondary"
            icon="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8 4.35 4.35 0 0 1-2.59-4.03z"
            iconType="fill"
            target="_self"
            rel=""
          />
        </div>
        <Paragraph size="small" class="mt-4">
          14-day money back guarantee
        </Paragraph>
      </div>
    </section>

    <Footer />
  </body>
</html>
