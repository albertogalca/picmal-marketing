---
import { Image } from "astro:assets";
import H3 from "./H3.astro";
import Button from "./Button.astro";
import Paragraph from "./Paragraph.astro";

export interface Props {
  showImage?: boolean;
  variant?: "dark" | "light";
  title?: string;
  description?: string;
  buttonText?: string;
  className?: string;
}

const {
  showImage = true,
  title = "Use Picmal to easily convert your media on your Mac",
  description = "If you're not happy with your purchase, you can request a refund within 14 days.",
  buttonText = "Buy for Mac",
  className = "",
} = Astro.props;
---

<div
  class={`relative bg-background-subtle border border-border rounded-lg overflow-hidden group grid grid-cols-1 md:grid-cols-8 items-center ${className}`}
>
  <!-- Subtle gradient overlay -->
  <div
    class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
    style="background: radial-gradient(circle at bottom right, rgba(27, 91, 255, 0.03), transparent 60%);"
  >
  </div>

  <!-- Content with space for image on the right -->
  <div class="relative px-4 py-8 md:p-12 col-span-4">
    <div class="relative z-10 text-left max-w-full">
      <H3 class="mb-4">
        {title}
      </H3>
      <Paragraph size="small" class="mb-8 text-text-secondary">
        {description}
      </Paragraph>
      <Button text={buttonText} />
    </div>
  </div>

  <!-- Picmal app interface - positioned absolute bottom-right -->
  {
    showImage && (
      <div class="pointer-events-none px-4 col-span-4 hidden md:block">
        <Image
          src="/convert_demo.png"
          alt="Picmal App Interface"
          width={480}
          height={360}
          class="w-full ml-auto h-auto"
        />
      </div>
    )
  }
</div>
