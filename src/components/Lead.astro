---
import { cn } from "../utils/cn";

export interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
// Hero subheading / large lead paragraph. Callers keep their layout
// classes (max-width, margins, alignment) via `class`.
const defaultClasses = "text-body-big text-text-secondary text-pretty";
const mergedClasses = cn(defaultClasses, className);
---

<p class={mergedClasses}>
  <slot />
</p>
