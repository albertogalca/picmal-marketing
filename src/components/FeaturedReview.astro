---
import { Image } from "astro:assets";
import macStoriesLogo from "../../public/macstories_proof.webp";
---

<section class="relative z-10 px-6 pt-8 sm:pt-10 pb-4">
  <div class="max-w-2xl mx-auto text-center">
    <!-- Stars -->
    <div
      class="flex justify-center gap-1 mb-4"
      role="img"
      aria-label="Rated 5 out of 5 stars"
    >
      {
        [...Array(5)].map(() => (
          <svg
            class="w-4 h-4 text-amber-400"
            fill="currentColor"
            viewBox="0 0 20 20"
            aria-hidden="true"
          >
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))
      }
    </div>

    <!-- Quote -->
    <p class="text-body-big text-text-secondary text-pretty">
      "Picmal is an excellent way to manage file conversion and compression jobs
      of any size. <span
        class="bg-accent/15 text-text rounded px-1 py-0.5 font-medium box-decoration-clone"
        >The simplicity and speed</span
      > with which you can manage batch conversion and compression sets it apart and
      makes it worth checking out."
    </p>

    <!-- Attribution -->
    <a
      href="https://www.macstories.net/reviews/picmal-streamlines-batch-conversion-and-compression-on-the-mac/"
      target="_blank"
      rel="nofollow noreferrer"
      aria-label="Read the MacStories review of Picmal"
      class="inline-flex items-center justify-center mt-4 py-2 transition-[scale,opacity] duration-200 hover:opacity-70 active:scale-[0.96] motion-reduce:transition-none"
    >
      <Image
        src={macStoriesLogo}
        alt="MacStories"
        width={240}
        height={73}
        class="h-8 sm:h-9 w-auto object-contain"
        loading="lazy"
      />
    </a>
  </div>
</section>
