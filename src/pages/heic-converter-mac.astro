---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import PricingSection from "../components/PricingSection.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import ComparisonHero from "../components/ComparisonHero.astro";
import CardGrid from "../components/CardGrid.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ConversionGrid from "../components/ConversionGrid.astro";

const title =
  "Picmal: Convert HEIC to JPG on Mac, batch HEIC converter";
const description =
  "How to convert HEIC to JPG on Mac: drop your iPhone photos into Picmal and convert them to JPG, PNG, WebP or any format. Batch, offline, no quality loss. $19 one-time.";

const faqs = [
  {
    question: "How do I convert HEIC to JPG on a Mac?",
    answer:
      "Open Picmal, drag your HEIC photos in from Finder or Photos, choose JPG as the output format, and click Convert. You can do one photo or a whole folder at once, and it all happens on your Mac.",
  },
  {
    question: "What is HEIC and why do I need to convert it?",
    answer:
      "HEIC is Apple's image format used by iPhones since iOS 11. While it offers better compression than JPG, many websites, Windows PCs, and older apps can't open HEIC files. Converting to JPG or PNG makes them universally compatible.",
  },
  {
    question: "What formats can I convert HEIC to?",
    answer:
      "Picmal converts HEIC to JPG, PNG, WebP, AVIF, TIFF, GIF, DNG, and any other image format you need.",
  },
  {
    question: "Can I batch convert all my iPhone photos at once?",
    answer:
      "Yes. Drag and drop hundreds or thousands of HEIC files from your Photos library or any folder. Picmal converts them all at once.",
  },
  {
    question: "Does converting HEIC to JPG lose quality?",
    answer:
      "JPG uses lossy compression, so there's a slight quality reduction. Picmal lets you adjust the quality slider. At 90%+ quality, the difference is imperceptible.",
  },
  {
    question: "Is this different from Preview's export feature?",
    answer:
      "Preview can convert one file at a time. Picmal handles batch conversion of hundreds of files, offers more output formats, and lets you fine-tune quality settings.",
  },
  {
    question: "Do my photos leave my Mac?",
    answer:
      "No. All conversion happens locally on your Mac. Picmal works completely offline. Your photos never touch any server.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <ComparisonHero
      title="Convert HEIC photos on your Mac in seconds"
      subhead="Your iPhone shoots HEIC, but the world runs on JPG. Picmal batch converts your HEIC files to JPG, PNG, WebP, or any format. Fast, offline, and private."
      buyEvent="buy_clicked_heic_converter_mac"
      defaultTab="convert"
    />

    <!-- How It Works -->
    <CardGrid
      heading="How to convert HEIC to JPG on your Mac"
      numbered
      items={[
        {
          title: "Drop your HEIC files",
          description:
            "Drag and drop HEIC files from Finder, Photos, or any folder.",
        },
        {
          title: "Choose output format",
          description: "Select JPG, PNG, WebP, or any other format.",
        },
        {
          title: "Convert",
          description: "Click Convert and your files are ready in seconds.",
        },
      ]}
    />

    <!-- HEIC Conversion Options -->
    <Section>
      <SectionHeading>
        Convert HEIC to any format
        <Fragment slot="sublead">
          New to this? Follow the step-by-step guide on <a
            class="link"
            href="/blog/how-to-convert-heic-to-jpg-mac"
            >how to convert HEIC to JPG on Mac</a
          >.
        </Fragment>
      </SectionHeading>
      <ConversionGrid
        columns={4}
        links={[
          "heic-to-jpg",
          "heic-to-png",
          "heic-to-webp",
          "heic-to-avif",
          "heic-to-tiff",
          "heic-to-gif",
        ].map((slug) => ({
          href: `/convert/${slug}`,
          label: slug.replace("heic-to-", "HEIC to ").toUpperCase(),
        }))}
      />
    </Section>

    <MasonryTestimonials />

    <PricingSection />

    <Section id="faq" width="narrow">
      <SectionHeading
        sublead="Something not covered here? Write to support@picmal.app"
      >
        Frequently Asked Questions
      </SectionHeading>
      <Card>
        <FAQ faqs={faqs} />
      </Card>
    </Section>

    <Footer />
    <SupportedFormatsModal />
  </body>
</html>
