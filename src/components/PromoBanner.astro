---
// Set the end date for the promo (end of November 2025)
const endDate = new Date("2025-12-01T00:00:00").getTime();
---

<div class="flex justify-center mb-8">
  <a
    href="#pricing"
    class="inline-flex items-center gap-3 rounded-full px-2 py-2 pr-4 border border-accent/30 bg-accent/5 hover:bg-accent/10 hover:border-accent/50 transition-all"
  >
    <span
      class="px-3 py-1 rounded-full bg-accent text-white text-eyebrow font-semibold uppercase tracking-wide whitespace-nowrap"
    >
      Launch price
    </span>
    <span class="text-body-sm text-text whitespace-nowrap block md:hidden">
      <strong class="font-semibold">$9.99</strong> before Dec
    </span>
    <span class="text-body-sm text-text whitespace-nowrap hidden md:block">
      Get Picmal for <strong class="font-semibold">$9.99</strong> before December
    </span>
    <div
      id="countdown"
      class="hidden md:flex items-center gap-1 text-body-sm font-mono text-text-secondary"
    >
      <span class="countdown-item" data-type="days">00</span><span
        class="text-text-secondary/50">D</span
      >
      <span class="countdown-item" data-type="hours">00</span><span
        class="text-text-secondary/50">H</span
      >
      <span class="countdown-item" data-type="minutes">00</span><span
        class="text-text-secondary/50">M</span
      >
      <span class="countdown-item" data-type="seconds">00</span><span
        class="text-text-secondary/50">S</span
      >
    </div>
  </a>
</div>

<script define:vars={{ endDate }}>
  function updateCountdown() {
    const now = new Date().getTime();
    const distance = endDate - now;

    if (distance < 0) {
      document.getElementById("countdown")?.remove();
      return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor(
      (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)
    );
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    const countdownEl = document.getElementById("countdown");
    if (countdownEl) {
      countdownEl.querySelector('[data-type="days"]').textContent = String(
        days
      ).padStart(2, "0");
      countdownEl.querySelector('[data-type="hours"]').textContent = String(
        hours
      ).padStart(2, "0");
      countdownEl.querySelector('[data-type="minutes"]').textContent = String(
        minutes
      ).padStart(2, "0");
      countdownEl.querySelector('[data-type="seconds"]').textContent = String(
        seconds
      ).padStart(2, "0");
    }
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>

<style>
  .countdown-item {
    min-width: 1.5rem;
    text-align: center;
  }
</style>
