---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import H1 from "../components/H1.astro";
import Paragraph from "../components/Paragraph.astro";
import Button from "../components/Button.astro";
import TrustBar from "../components/TrustBar.astro";
import CardGrid from "../components/CardGrid.astro";

const DMG_URL =
  "https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg";

const steps = [
  {
    title: "Open the disk image",
    description:
      "Double-click the downloaded Picmal.dmg and drag Picmal into your Applications folder.",
  },
  {
    title: "Launch Picmal",
    description:
      "Open Picmal from Applications. You can look around the whole app for free.",
  },
  {
    title: "Add your license to start converting",
    description:
      "The app needs a license to process files. Buy one, paste the key, and you're running in about ten seconds.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead
      title="Picmal: Download for Mac"
      description="Download Picmal for Mac. Free to install, one payment of $15.99 to unlock. Batch convert and compress images, video, audio, and PDFs, all offline."
      noindex={true}
    />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <main id="main-content" class="relative z-10 pt-32 pb-16 sm:pb-20">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <H1 class="mb-6">Download Picmal for Mac</H1>
        <Paragraph size="lead" class="mb-8 max-w-xl mx-auto">
          Picmal is free to install and look around. To start converting you
          need a license, which is a single $15.99 payment. Don't like it? Full
          refund within 14 days.
        </Paragraph>

        <div class="flex flex-col items-center gap-3">
          <Button
            href={DMG_URL}
            text="Download Picmal (.dmg)"
            class="w-full sm:w-auto"
            onclick={import.meta.env.PROD
              ? "window.seline?.track('download_dmg')"
              : undefined}
          />
          <a
            href="/#pricing"
            class="inline-flex items-center gap-1.5 text-small text-text-secondary hover:text-text transition-colors rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            or get a license for $15.99
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="mt-6">
          <TrustBar />
        </div>

        <p class="mt-6 text-small text-text-secondary">
          Requires macOS 15.0 (Sequoia) or later · Apple Silicon &amp; Intel
        </p>
      </div>

      <!-- Install steps -->
      <CardGrid heading="Installing Picmal" numbered items={steps} />
    </main>

    <Footer />

  </body>
</html>
