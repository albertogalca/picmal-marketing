---
interface Props {
  currentCategory?: "All" | "Changelog" | "Guide" | "Tutorial";
}

const { currentCategory = "All" } = Astro.props;

const categories = [
  { name: "All", href: "/blog" },
  { name: "Changelog", href: "/blog/changelog" },
  { name: "Guide", href: "/blog/guide" },
  { name: "Tutorial", href: "/blog/tutorial" },
];
---

<div class="flex flex-wrap gap-3 mb-16">
  {
    categories.map((category) => (
      <a
        href={category.href}
        class={`px-4 py-2 rounded-lg font-medium text-sm transition-colors ${
          currentCategory === category.name
            ? "bg-accent text-white"
            : "bg-accent-background text-black/65 hover:bg-accent hover:text-white"
        }`}
      >
        {category.name}
      </a>
    ))
  }
</div>
