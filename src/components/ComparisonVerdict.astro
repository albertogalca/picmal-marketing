---
import Card from "./Card.astro";

interface Props {
  competitor: string;
  summary: string;
  picmalFor: string;
  competitorFor: string;
}

const { competitor, summary, picmalFor, competitorFor } = Astro.props;
---

<section class="relative z-10 px-6 py-12" aria-label={`Picmal vs ${competitor} quick answer`}>
  <div class="max-w-5xl mx-auto"><div class="max-w-3xl">
    <Card>
      <div class="flex items-baseline gap-2 mb-4">
        <span class="text-small font-semibold text-accent">TL;DR</span>
        <span class="text-small text-text-secondary">Picmal vs {competitor}</span>
      </div>
      <p class="text-body md:text-body-big leading-relaxed text-text text-pretty mb-4">{summary}</p>
      <dl class="grid sm:grid-cols-2 gap-4 pt-4 border-t border-border">
        <div>
          <dt class="text-small font-medium text-text-secondary mb-1">Pick Picmal if</dt>
          <dd class="text-small text-text">{picmalFor}</dd>
        </div>
        <div>
          <dt class="text-small font-medium text-text-secondary mb-1">Pick {competitor} if</dt>
          <dd class="text-small text-text">{competitorFor}</dd>
        </div>
      </dl>
    </Card>
  </div></div>
</section>
