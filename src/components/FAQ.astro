---
import H3 from "./H3.astro";
import Paragraph from "./Paragraph.astro";

interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQ[];
  size?: "base" | "lead";
}

const { faqs, size = "base" } = Astro.props;
---

<div class="space-y-1">
  {
    faqs.map((faq) => (
      <div class="border-b transition-colors border-background-subtle last:border-0">
        <details class="group">
          <summary class="w-full py-4 flex items-center justify-between text-left cursor-pointer list-none">
            <H3 class="pr-4">{faq.question}</H3>
            <div
              class="flex-shrink-0 transition-transform duration-200 group-open:rotate-180"
              aria-hidden="true"
            >
              <svg
                class="w-5 h-5 text-text"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width={2}
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </div>
          </summary>
          <div class="pb-4">
            <Paragraph size={size}>{faq.answer}</Paragraph>
          </div>
        </details>
      </div>
    ))
  }
</div>

<style>
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  details > summary::marker {
    content: "";
  }
</style>
