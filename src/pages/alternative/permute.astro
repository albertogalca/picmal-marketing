---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import PricingSection from "../../components/PricingSection.astro";
import Section from "../../components/Section.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";
import FAQSection from "../../components/FAQSection.astro";

const SITE_DESCRIPTION =
  "Want a Permute alternative? Picmal converts, compresses, and edits images, video, audio, and PDFs in one Mac app. Runs fully offline, native macOS UI, $29 once. 14-day refund.";

const faqs = [
  {
    question: "Is Picmal a good Permute alternative?",
    answer:
      "If you don't need to trim, crop, or merge video, then yes. Picmal converts, compresses, and handles images, video, audio, and PDFs in one window. Permute adds a video editing layer. Picmal skips it.",
  },
  {
    question: "Does Picmal work offline like Permute?",
    answer:
      "Yes. Everything runs locally on your Mac. Nothing gets uploaded anywhere.",
  },
  {
    question: "Can Picmal convert and compress video and audio?",
    answer:
      "Yes. Picmal converts video (MP4, MOV, MKV, and more) and audio (MP3, WAV, FLAC, and more). It compresses all of them, images, video, audio, and PDFs, and the output is never larger than the input. No timeline editing though. No trimming, cropping, or merging.",
  },
  {
    question: "Is Picmal actually cheaper than Permute?",
    answer:
      "No, Permute is cheaper. It's $14.99 for up to three activations, and it's on Setapp if you pay for that. Picmal is $29 for one Mac and $39 for two. What you get for the difference is PDF compression and combining, a watched folder that converts whatever lands in it, and a Finder right-click. Picmal also runs on macOS 15, where Permute 4 needs macOS 26 and an Apple Silicon Mac.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Just email support@picmal.app.",
  },
];
---

<MarketingLayout
  title="Picmal: The all-in-one Permute alternative for Mac"
  description={SITE_DESCRIPTION}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
        <FAQSchema faqs={faqs} />
  </Fragment>

  <ComparisonHero
    title="The all-in-one Permute alternative for Mac"
    subhead="Both are offline Mac converters. Permute is the cheaper one and adds timeline video editing. Picmal adds compression for images, video, audio, and PDFs, plus PDF tools and folder monitoring. It comes down to what you need."
    releaseBadge={false}
    buyEvent="buy_clicked_permute_comparison"
  />

  <ComparisonVerdict
    competitor="Permute"
    summary="Picmal ($29) and Permute (~$14.99, also on Setapp) are both offline Mac converters, with Permute the cheaper of the two. Picmal compresses images, video, audio, and PDFs, with PDF tools, folder monitoring, and Finder right-click. Permute adds timeline editing (trim, crop, merge) and audio normalization."
    picmalFor="You convert and compress media on your Mac and want folder monitoring, PDF tools, and a Finder right-click, and you don't need to trim or merge videos."
    competitorFor="You need to trim, crop, or merge videos, normalize audio, batch edit metadata, schedule conversions, or pull text out of images with OCR. Or you already pay for Setapp."
  />

  <!-- Comparison Table -->
  <Section width="narrow">
    <SectionHeading>
      Picmal vs Permute at a glance
      <Fragment slot="sublead">
        Permute is good at video editing. But sometimes you just want one app
        to convert and compress a file without thinking about it.
      </Fragment>
    </SectionHeading>
    <ComparisonTable
      competitor="Permute"
      rows={[
      {
        feature: "Price",
        picmal: "$29 one-time",
        competitor: "$14.99 one-time",
      },
      {
        feature: "Setapp",
        picmal: "No",
        competitor: "Yes, included in the subscription",
      },
      {
        feature: "Privacy",
        picmal: "100% offline",
        competitor: "100% offline",
      },
      {
        feature: "Interface",
        picmal: "One window, no hunting through menus",
        competitor: "Groups + presets",
      },
      {
        feature: "Image formats",
        picmal: "20+",
        competitor: "15+",
      },
      {
        feature: "Compression",
        picmal: "Images, video, audio & PDF, never bigger than the original",
        competitor: "Target file size when converting",
      },
      {
        feature: "PDF tools",
        picmal: "Compress, combine, images to PDF",
        competitor: "PDF pages to images",
      },
      {
        feature: "Video editing",
        picmal: "No",
        competitor: "Trim, crop, stitch",
      },
      {
        feature: "Metadata",
        picmal: "Strip location data before sharing",
        competitor: "Batch metadata editor",
      },
      {
        feature: "Shortcuts",
        picmal: "Yes",
        competitor: "Yes",
      },
      {
        feature: "Automatic conversion",
        picmal: "Watches a folder, converts what lands in it",
        competitor: "Drop zones, drop files onto a preset",
      },
      {
        feature: "Finder right-click",
        picmal: "Yes, convert without opening the app",
        competitor: "No",
      },
      {
        feature: "macOS",
        picmal: "15+",
        competitor: "26+, Apple Silicon only (Permute 4)",
      },
    ]}
    />
  </Section>

  <!-- Testimonials Section -->
  <MasonryTestimonials />

  <!-- Pricing -->
  <PricingSection />

  <!-- FAQ Section -->
  <FAQSection
    faqs={faqs}
    heading="Frequently asked questions"
    sublead="Can't find what you're looking for? Email support@picmal.app"
  />

  <Fragment slot="after">
    <SupportedFormatsModal />
  </Fragment>
</MarketingLayout>
