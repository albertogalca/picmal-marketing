---
import Card from "./Card.astro";
import { UPGRADE, licenseFaqs } from "../config/pricing";
import FAQ from "./FAQ.astro";
import Paragraph from "./Paragraph.astro";
import PricingPlans from "./PricingPlans.astro";
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";


---

<Section id="pricing" width="medium" bg="subtle">
  {/* Redesign: the upgrade note is the heading's quiet second half. Only the
      action is accented, so it never competes with the buy button below. */}
  <SectionHeading>
    Pay once and you're all set
    <Fragment slot="sublead">
      Already own Picmal? <a class="link font-medium" href={UPGRADE.url}
        >Add more Macs <span aria-hidden="true">&rarr;</span></a
      >
    </Fragment>
  </SectionHeading>

  <PricingPlans />

  <div class="max-w-3xl mt-16">
    <FAQ faqs={licenseFaqs} />
  </div>
</Section>
