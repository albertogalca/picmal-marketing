---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";
import CTASection from "../../components/CTASection.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import Section from "../../components/Section.astro";
import RelatedGrid from "../../components/RelatedGrid.astro";
import LinkCard from "../../components/LinkCard.astro";
import { compressions } from "../../data/compressions";
import FormatPill from "../../components/FormatPill.astro";

const title = "Picmal: Compress images on Mac, reduce file size";
const description =
  "Compress JPG, PNG, GIF, WebP, AVIF, TIFF, and PDF files on your Mac. Batch compression, offline processing, adjustable quality.";
---

<MarketingLayout
  title={title}
  description={description}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
  </Fragment>

  <ComparisonHero
    pricingHref="/#pricing"
    title="Compress by format: pick the one you have"
    subhead="A page per format, with what each one throws away and how small it usually gets. JPG, PNG, GIF, WebP, AVIF, TIFF and PDF, all compressed on your Mac with nothing uploaded."
    buyEvent="buy_clicked_compress_hub"
    defaultTab="compress"
  />

  <!-- Format Cards -->
  <Section>
    <div class="grid md:grid-cols-2 gap-4">
      {
        compressions.map((c) => (
          <LinkCard href={`/compress/${c.slug}`}>
            <div class="flex items-center gap-3 mb-3">
              <FormatPill ext={c.format} />
              <h2 class="text-h3 text-text">Compress {c.name}</h2>
            </div>
            <p class="text-small text-text-secondary">{c.description}</p>
          </LinkCard>
        ))
      }
    </div>
  </Section>

  <RelatedGrid
    heading="Guides"
    links={[
      {
        href: "/compress-images-mac",
        label: "Compress images on Mac",
        description:
          "The overview: how to make a photo smaller, what the quality slider costs you, and what to expect in MB.",
      },
      {
        href: "/blog/reduce-image-file-size-mac",
        label: "How to reduce image file size on Mac",
        description:
          "Resize, compress, convert, or strip metadata, with before and after numbers.",
      },
      {
        href: "/blog/reduce-photo-library-size-mac",
        label: "How to reduce your photo library size on Mac",
        description: "Reclaim disk space without deleting photos.",
      },
    ]}
  />

  <CTASection
    heading="Compress any file format with Picmal"
    analyticsEvent="buy_clicked_compress_hub_bottom"
  />
</MarketingLayout>
