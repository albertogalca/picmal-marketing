---
import H3 from "./H3.astro";
import Paragraph from "./Paragraph.astro";

export interface Props {
  title: string;
  description: string;
  dataAttribute: string;
  dataValue: string;
  class?: string;
}

const {
  title,
  description,
  dataAttribute,
  dataValue,
  class: className = "",
} = Astro.props;

const dataAttrs = { [dataAttribute]: dataValue };
---

<div
  class={`bg-background-subtle border border-text-secondary/20 rounded-lg p-8 cursor-pointer transition-all hover:border-accent text-left  ${className}`}
  {...dataAttrs}
>
  <H3 class="mb-2">{title}</H3>
  <Paragraph>
    {description}
  </Paragraph>
</div>
