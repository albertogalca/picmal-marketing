---
import { Image } from "astro:assets";
import testimonials from "../data/testimonials.json";
import crypto from "crypto";
import H3 from "./H3.astro";
import Paragraph from "./Paragraph.astro";

function getGravatarUrl(email: string, size: number = 80): string {
  const hash = crypto
    .createHash("md5")
    .update(email.toLowerCase().trim())
    .digest("hex");
  return `https://gravatar.com/avatar/${hash}?s=${size}&d=mp&r=g`;
}

function renderStars(rating: number): string {
  return Array.from({ length: 5 }, (_, i) => (i < rating ? "★" : "☆")).join("");
}
---

<div class="max-w-4xl mx-auto">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      testimonials.map((testimonial) => (
        <div class="bg-accent-background/65 border border-gray-200 rounded-lg p-6">
          <div class="flex items-start gap-4">
            <Image
              src={getGravatarUrl(testimonial.email, 48)}
              alt={testimonial.name}
              width={48}
              height={48}
              class="w-12 h-12 rounded-full"
              loading="lazy"
            />
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-2">
                <H3 class="font-semibold text-base md:text-base">
                  {testimonial.name}
                </H3>
                <div class="text-yellow-500 text-sm">
                  {renderStars(testimonial.rating)}
                </div>
              </div>
              <Paragraph class="mb-3">{testimonial.content}</Paragraph>
              <Paragraph>
                <time class="text-base">{testimonial.date}</time>
              </Paragraph>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>
