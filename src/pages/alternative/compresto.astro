---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import OrganizationSchema from "../../components/schema/OrganizationSchema.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import Paragraph from "../../components/Paragraph.astro";
import SectionDivider from "../../components/SectionDivider.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeaturedOn from "../../components/FeaturedOn.astro";
import BentoFeatures from "../../components/BentoFeatures.astro";
import PricingSection from "../../components/PricingSection.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";

const SITE_TITLE = "Picmal: The Affordable Compresto Alternative for Mac";
const SITE_DESCRIPTION =
  "Looking for a Compresto alternative? Picmal is an all-in-one Mac media toolkit—convert, compress, and edit images, video, audio, and PDFs for $15.99, not $49. Shortcuts integration, folder monitoring. 14-day refund.";

const faqs = [
  {
    question: "Is Picmal a good Compresto alternative?",
    answer:
      "Depends what you need. Picmal converts formats, compresses files, and handles images, video, audio, and PDFs — all for $15.99. Compresto is purpose-built to compress as aggressively as possible, and has a Raycast extension. Different tools for different jobs.",
  },
  {
    question: "Does Picmal compress files as much as Compresto?",
    answer:
      "Compresto advertises up to 90% reduction and is tuned specifically for that. Picmal compresses well across images, video, audio, and PDFs — not as aggressively, but enough for most cases. You also get format conversion and PDF tools alongside.",
  },
  {
    question: "Why is Picmal so much cheaper than Compresto?",
    answer:
      "Compresto costs $49 and focuses entirely on compression. Picmal is $15.99 and covers more: converting, compressing, light editing, and PDF tools. Single-purpose tools that do one thing very well often cost more.",
  },
  {
    question: "Does Picmal have Raycast integration like Compresto?",
    answer:
      "Not yet — Raycast is coming. Right now Picmal works with Apple Shortcuts and Finder right-click. If Raycast is core to your workflow, Compresto's extension is the better option for now.",
  },
  {
    question: "Can Picmal compress PDFs like Compresto?",
    answer:
      "Yes. Picmal compresses PDFs with a guarantee the output is never larger than the input. It also combines PDFs, turns images into a PDF, and exports PDF pages to PNG at a chosen DPI. Plus real compression for images, video, and audio.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Email support@picmal.app.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <ComparisonHero
      title="The affordable Compresto alternative for Mac"
      subhead="Compresto does compression well. If you also need to convert formats, work with video and audio, or handle PDFs — Picmal does all of that for $15.99, not $49."
      buyEvent="buy_clicked_compresto_comparison"
    />

    <ComparisonVerdict
      competitor="Compresto"
      summary="Compresto squeezes files as small as they'll go — up to 90% reduction — with a Raycast extension. Picmal ($15.99 one-time) does real compression too, but also converts formats, covers video and audio, handles PDFs, and costs a third as much."
      picmalFor="You need more than just compression — formats to convert, video and audio to process, PDFs to shrink or combine — and don't want to pay $49 for it."
      competitorFor="You compress files constantly and want the maximum reduction possible, and you live in Raycast."
    />

    <SectionDivider />

    <!-- Comparison Table -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-4 text-center">Picmal vs Compresto at a glance</H2>
        <Paragraph class="mb-8 text-center max-w-2xl mx-auto">
          Compresto is built for one thing: squeezing files as small as possible.
          Picmal handles more — convert, compress, and edit across images, video,
          audio, and PDFs. Both run offline, both support batch.
        </Paragraph>

        <div
          class="bg-background-subtle/50 border border-border rounded-2xl p-4 md:p-8"
        >
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left p-4 font-semibold text-text">Feature</th>
                  <th class="text-left p-4 font-semibold text-text">Picmal</th>
                  <th class="text-left p-4 font-semibold text-text"
                    >Compresto</th
                  >
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr>
                  <td class="p-4 text-text-secondary">Price</td>
                  <td class="p-4 text-text">$15.99 one-time</td>
                  <td class="p-4 text-text">$49 one-time (or $7/mo)</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Primary purpose</td>
                  <td class="p-4 text-text">Convert, compress &amp; edit</td>
                  <td class="p-4 text-text">File compression</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Privacy</td>
                  <td class="p-4 text-text">100% offline</td>
                  <td class="p-4 text-text">100% offline</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Image conversion</td>
                  <td class="p-4 text-text">Yes—HEIC, JPG, PNG, WebP, etc.</td>
                  <td class="p-4 text-text">Compression only</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video conversion</td>
                  <td class="p-4 text-text">Yes—MP4, MOV, MKV, etc.</td>
                  <td class="p-4 text-text">Compression only</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Audio conversion</td>
                  <td class="p-4 text-text">Yes—MP3, WAV, FLAC, etc.</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">PDF support</td>
                  <td class="p-4 text-text"
                    >Yes—compress, combine, images→PDF</td
                  >
                  <td class="p-4 text-text">Yes—compression</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Compression</td>
                  <td class="p-4 text-text"
                    >Yes—images, video, audio, PDF</td
                  >
                  <td class="p-4 text-text">Up to 90% reduction</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Metadata removal</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">Yes</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Folder monitoring</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">Yes</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Shortcuts integration</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Raycast extension</td>
                  <td class="p-4 text-text">Coming soon</td>
                  <td class="p-4 text-text">Yes</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Finder right-click</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">macOS</td>
                  <td class="p-4 text-text">14+</td>
                  <td class="p-4 text-text">13+</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Who Picmal Is For / Who Should Stick with Compresto -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-4">Which one is right for you?</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Here's where each one makes more sense.
          </Paragraph>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Picmal Column -->
          <div
            class="bg-background-subtle border border-border rounded-2xl p-6 md:p-8"
          >
            <div class="mb-6">
              <h3 class="text-h3 text-text mb-2">
                Choose Picmal
              </h3>
              <p class="text-text-secondary">
                You need more than just compression
              </p>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want one app to convert, compress, and edit your media
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You use Apple Shortcuts for automation
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need to convert or compress video, audio, and PDFs too
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You don't want to pay $49 for a single-purpose app
                </span>
              </li>
            </ul>
          </div>

          <!-- Compresto Column -->
          <div
            class="bg-background-subtle border border-border rounded-2xl p-6 md:p-8"
          >
            <div class="mb-6">
              <h3 class="text-h3 text-text mb-2">
                Choose Compresto
              </h3>
              <p class="text-text-secondary">
                Compression is your only job
              </p>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  Your focus is compression, not format conversion
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need Raycast extension integration
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need up to 90% file size reduction
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want a dedicated, single-purpose compression app
                </span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- BentoFeatures -->
    <BentoFeatures />

    <SectionDivider />

    <!-- Testimonials Section -->
    <MasonryTestimonials />

    <section
      id="featured"
      class="absolute w-px h-px overflow-hidden -m-px p-0 border-0"
      style="clip:rect(0 0 0 0); clip-path:inset(50%)"
      aria-hidden="true"
    >
      <FeaturedOn />
    </section>

    <SectionDivider />

    <!-- Pricing -->
    <section id="pricing" class="relative z-10 px-6 py-20">
      <PricingSection />
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-6">Frequently asked questions</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Can't find what you're looking for? Email support@picmal.app
          </Paragraph>
        </div>
        <div
          class="bg-background-subtle/50 border border-border rounded-2xl p-4 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />

    <SupportedFormatsModal />

  </body>
</html>
