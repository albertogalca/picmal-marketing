---
import PixelGlyph from "./PixelGlyph.astro";

interface Props { icon?: string; title: string; apps?: { name: string; src: string }[] }
const { icon, title, apps } = Astro.props;
---

<div class="pm-feature">
  <div class="pm-feature__icon">
    {apps ? (
      <div class="pm-feature__apps">{apps.map((a) => <img src={a.src} alt={a.name} width="39" height="39" />)}</div>
    ) : icon ? <PixelGlyph name={icon} /> : null}
  </div>
  <div class="pm-feature__title">{title}</div>
  <div class="pm-feature__text"><slot /></div>
</div>
