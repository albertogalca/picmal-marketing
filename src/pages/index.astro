---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import WebSiteSchema from "../components/schema/WebSiteSchema.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import FAQSchema, { faqs } from "../components/schema/FAQSchema.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Button from "../components/Button.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import Paragraph from "../components/Paragraph.astro";
import FeaturedOn from "../components/FeaturedOn.astro";
import SectionDivider from "../components/SectionDivider.astro";
import BentoFeatures from "../components/BentoFeatures.astro";
import SegmentedControl from "../components/SegmentedControl.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import CompressFormatsModal from "../components/CompressFormatsModal.astro";
import TrustBar from "../components/TrustBar.astro";
import PricingSection from "../components/PricingSection.astro";
import FeaturedReview from "../components/FeaturedReview.astro";
import Lead from "../components/Lead.astro";
import { getEntrySlug } from "../utils/changelog";

const SITE_TITLE =
  "Picmal is your Mac's media toolkit to convert, compress & edit";
const SITE_DESCRIPTION =
  "Convert, compress, and edit your images, video, and audio right on your Mac — instead of trusting sketchy websites. Everything works offline, no subscription.";

const changelogEntries = await getCollection("changelog");
const latestRelease = changelogEntries.sort((a, b) =>
  b.data.version.localeCompare(a.data.version, undefined, {
    numeric: true,
    sensitivity: "base",
  }),
)[0];
const latestReleaseHref = `/changelog#${getEntrySlug(latestRelease)}`;
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <WebSiteSchema url={Astro.site!.href} />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <!-- Hero Section -->
    <main id="main-content" class="relative z-10 pt-32 pb-20">
      <div class="max-w-7xl mx-auto px-6 xl:px-0">
        <div
          class="grid lg:grid-cols-5 gap-12 lg:gap-16 items-start mb-12 sm:mb-16"
        >
          <div class="text-center lg:text-left lg:col-span-2">
            <div
              class="max-w-4xl mx-auto lg:mx-0 flex justify-center lg:justify-start items-center lg:items-start flex-col"
            >
              <a
                href={latestReleaseHref}
                class="group/release mb-6 inline-flex items-center gap-2 max-w-full rounded-xl border border-border bg-background-subtle py-1 pl-1 pr-3 text-small text-text-secondary whitespace-nowrap hover:text-text hover:border-border/60 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
              >
                <span
                  class="shrink-0 rounded-xl bg-accent/10 px-2 py-0.5 text-small font-semibold leading-none text-accent"
                  >v{latestRelease.data.version}</span
                >
                <span class="hidden sm:inline truncate"
                  >{latestRelease.data.title}</span
                >
                <span class="sm:hidden">What's new</span>
                <span
                  class="shrink-0 transition-transform duration-200 ease-out motion-safe:group-hover/release:translate-x-0.5"
                  aria-hidden="true">&rarr;</span
                >
              </a>
              <H1 class="mb-6 max-w-2xl mx-auto lg:mx-0"
                >Your Mac's media toolkit</H1
              >
              <Lead class="mb-6 sm:mb-8 max-w-xl mx-auto lg:mx-0 px-4 sm:px-0">
                Convert, compress, and edit your images, videos, and audio right
                on your Mac — instead of trusting sketchy websites with them.
                Everything works offline and respects your privacy.
              </Lead>
            </div>

            <!-- CTA Buttons -->
            <div
              class="flex flex-col items-center lg:items-start gap-4 sm:gap-6"
            >
              <div
                class="flex flex-col sm:flex-row items-center lg:items-start gap-3 w-full sm:w-auto"
              >
                <Button
                  text="Get Picmal"
                  href="/#pricing"
                  target="_self"
                  id="buy-cta-button"
                  class="w-full sm:w-auto"
                />
                <Button
                  text="Download"
                  href="/download"
                  variant="secondary"
                  target="_self"
                  icon="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 14.25 3.51 5.71 9.05 5.43c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 3.97l.01-.01zM12.03 5.38c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"
                  iconType="fill"
                  id="download-cta-button"
                  class="w-full sm:w-auto"
                />
              </div>

              <!-- Social Proof & Guarantee -->
              <div class="flex flex-col items-center lg:items-start gap-3">
                <TrustBar />
                <p class="text-small text-text-secondary text-pretty">
                  One payment, yours for good · 14-day money-back
                </p>
              </div>
            </div>
          </div>

          <!-- Demo Video + filter -->
          <div class="w-full lg:col-span-3">
            <div class="mb-6">
              <SegmentedControl
                ariaLabel="Filter demo by action"
                mode="tabs"
                segmentClass="hero-demo-tab"
                activeId="convert"
                segments={[
                  { id: "convert", label: "Convert" },
                  { id: "compress", label: "Compress" },
                  { id: "pdf", label: "PDF" },
                ]}
              />
            </div>
            <div class="rounded-xl overflow-hidden border border-border">
              <div class="aspect-video bg-background-subtle">
                <video
                  id="hero-demo-video"
                  class="w-full h-full object-cover"
                  width="1920"
                  height="1080"
                  poster="/convert-poster.webp"
                  loop
                  muted
                  playsinline
                  preload="metadata"
                  aria-label="Picmal demo"
                >
                </video>
              </div>
            </div>
          </div>
        </div>
      </div>
      <FeaturedReview />
    </main>

    <SectionDivider />

    <section id="features" class="relative z-10">
      <BentoFeatures />
    </section>

    <SectionDivider />

    <!-- Pricing -->
    <section
      id="pricing"
      class="relative z-10 px-6 py-20 bg-background-subtle/50 border-y border-border"
    >
      <PricingSection />
    </section>

    <SectionDivider />

    <section id="testimonials" class="relative z-10">
      <MasonryTestimonials />
    </section>

    <section
      id="featured"
      class="absolute w-px h-px overflow-hidden -m-px p-0 border-0"
      style="clip:rect(0 0 0 0); clip-path:inset(50%)"
      aria-hidden="true"
    >
      <FeaturedOn />
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-4">Frequently Asked Questions</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Something not covered here? Write to support@picmal.app
          </Paragraph>
        </div>
        <div
          class="bg-background-subtle/50 border border-border rounded-2xl p-6 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />

    <!-- Modal rendered at page level to avoid z-index issues -->
    <SupportedFormatsModal />
    <CompressFormatsModal />

    <!-- Hero demo filter: swap video by action -->
    <script>
      const heroVideo = document.getElementById(
        "hero-demo-video",
      ) as HTMLVideoElement | null;
      if (heroVideo) {
        // Honor reduced-motion: leave the poster showing and never autoplay.
        const prefersReducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        const sources: Record<
          string,
          { label: string; src: string; poster: string }
        > = {
          convert: {
            label: "Convert",
            src: "/convert.mp4",
            poster: "/convert-poster.webp",
          },
          compress: {
            label: "Compress",
            src: "/compress.mp4",
            poster: "/compress-poster.webp",
          },
          pdf: { label: "PDF", src: "/pdf.mp4", poster: "/pdf-poster.webp" },
        };
        let currentId = "convert";

        function setVideo(id: string) {
          const pair = sources[id];
          if (!pair) return;
          heroVideo!.setAttribute("aria-label", `Picmal ${pair.label} demo`);
          if (heroVideo!.src === new URL(pair.src, window.location.origin).href)
            return;
          // Show the matching poster immediately so there's never a blank box
          // while the next clip buffers.
          heroVideo!.poster = pair.poster;
          heroVideo!.src = pair.src;
          heroVideo!.load();
          if (!prefersReducedMotion) heroVideo!.play().catch(() => {});
        }

        setVideo(currentId);

        document.querySelectorAll(".hero-demo-tab").forEach((btn) => {
          btn.addEventListener("click", () => {
            const id = (btn as HTMLElement).dataset.segment;
            if (!id || id === currentId) return;
            currentId = id;
            document.querySelectorAll(".hero-demo-tab").forEach((b) => {
              const active = b === btn;
              b.classList.toggle("active", active);
              b.setAttribute("aria-selected", active ? "true" : "false");
            });
            setVideo(id);
          });
        });
      }
    </script>

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "cantimplorastudio" };
    </script>
    <script
      src="https://lmsqueezy.com/affiliate.js"
      defer
      onerror="console.warn('Failed to load Lemon Squeezy affiliate script')"
    ></script>

    <!-- PostHog Analytics with keyboard accessibility -->
    <script>
      // Track buy button clicks (both mouse and keyboard)
      document
        .getElementById("buy-cta-button")
        ?.addEventListener("click", () => {
          if (typeof posthog !== "undefined") posthog.capture("buy_clicked");
        });

      // Track download button clicks
      document
        .getElementById("download-cta-button")
        ?.addEventListener("click", () => {
          if (typeof posthog !== "undefined")
            posthog.capture("download_clicked");
        });
    </script>
  </body>
</html>
