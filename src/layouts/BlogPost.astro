---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import ArticleSchema from "../components/schema/ArticleSchema.astro";
import BlogFAQSchema from "../components/schema/BlogFAQSchema.astro";
import CTASection from "../components/CTASection.astro";
import H1 from "../components/H1.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import RelatedConversions from "../components/RelatedConversions.astro";
import { DEFAULT_TIER } from "../config/pricing";

type Props = CollectionEntry<"blog">["data"] & {
  category?: string;
  slug?: string;
  tags?: string[];
  faqs?: { question: string; answer: string }[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category,
  slug,
  tags,
  faqs,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${title} | Picmal`}
      description={description}
      image={heroImage}
      ogType="article"
      publishedTime={pubDate.toISOString()}
      modifiedTime={updatedDate ? updatedDate.toISOString() : pubDate.toISOString()}
    />
    {
      slug && (
        <ArticleSchema
          post={{
            title,
            description,
            pubDate,
            updatedDate,
            heroImage,
            category,
          }}
          url={Astro.site!.href}
          slug={slug}
        />
      )
    }
    {faqs && faqs.length > 0 && <BlogFAQSchema faqs={faqs} />}
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <!-- Article -->
    <article class="relative z-10 px-6 pt-32 pb-20">
      <div class="max-w-3xl mx-auto">
        <!-- Breadcrumb -->
        <div class="article-breadcrumb">
          <Breadcrumb
            items={[
              { label: "Home", href: "/" },
              { label: "Blog", href: "/blog" },
              { label: title },
            ]}
          />
        </div>

        <!-- Header -->
        <header class="mb-10 article-header">
          <div class="flex items-center gap-3 mb-8 text-small">
            <a
              href="https://albertogalca.com/"
              rel="author"
              class="text-text-secondary transition-colors hover:text-text"
              >By Alberto Gallego</a
            >
            <span class="text-text-secondary">•</span>
            {
              category && (
                <>
                  <span class="px-2 py-1 bg-accent/10 text-accent rounded-xl font-medium">
                    {category}
                  </span>
                  <span class="text-text-secondary">•</span>
                </>
              )
            }
            <time datetime={pubDate.toISOString()} class="text-text-secondary">
              <FormattedDate date={pubDate} />
            </time>
            {
              updatedDate && (
                <>
                  <span class="text-text-secondary">•</span>
                  <span class="text-text-secondary italic">
                    Updated <FormattedDate date={updatedDate} />
                  </span>
                </>
              )
            }
          </div>

          <H1 id="article-title" class="mb-4">
            {title}
          </H1>

          <!-- The post answers the question for free, so the buy line stays one
               quiet sentence. Until Aug 2026 the only CTA sat at 84% scroll
               depth, well past where a 30-second visit ever gets.
               Wording has to hold for all 44 posts, how-tos and comparisons
               alike, so it names no steps the post might not have. -->
          <p class="mt-6 text-small text-text-secondary">
            {"Picmal does this on your Mac: drag, click, done. "}
            <a
              href={DEFAULT_TIER.checkoutUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="link"
              onclick={import.meta.env.PROD
                ? `window.seline?.track('buy_clicked_blog_top_${slug || "post"}', { macs: ${DEFAULT_TIER.macs}, source: 'blog_top' })`
                : undefined}
            >
              {`Get Picmal for $${DEFAULT_TIER.price}`}
            </a>
          </p>
        </header>

        <!-- Content -->
        <div
          class="prose max-w-none article-content
              prose-headings:text-text prose-headings:font-semibold
              prose-p:text-text-secondary prose-p:leading-relaxed
              prose-strong:text-text
              prose-th:text-text
              prose-td:text-text-secondary
              prose-ul:text-text-secondary
              prose-ol:text-text-secondary
              prose-li:text-text-secondary
              prose-img:rounded-xl"
          role="main"
          aria-labelledby="article-title"
        >
          <slot />
        </div>

        <!-- Related conversion tools (tag-matched, indexed pages only) -->
        <RelatedConversions tags={tags} />

        <!-- Download CTA -->
        <div class="mt-12 article-cta">
          <CTASection
            heading="Use Picmal to easily convert your media on your Mac"
            analyticsEvent={`buy_clicked_blog_${slug || "post"}`}
          />
        </div>

        <!-- Related Posts -->
        <div class="article-related">
          {
            slug && (
              <RelatedPosts
                currentSlug={slug}
                category={category}
                tags={tags}
                limit={2}
              />
            )
          }
        </div>
      </div>
    </article>

    <Footer />
  </body>
</html>
