---
import SectionHeader from "../components/SectionHeader.astro";
import PostCard from "../components/PostCard.astro";
import Chip from "../components/Chip.astro";
import { getPublishedPosts } from "../../utils/posts";

const posts = (await getPublishedPosts()).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
---

<div class="pm-wrap">
  <div style="padding-top: 96px"><SectionHeader level={1} title="Blog." subtitle="Guides for every format, and what's new in Picmal." /></div>
  <div class="pm-chips pm-mt-8"><Chip active>All</Chip><Chip>Guides</Chip><Chip>Newsletter</Chip></div>
  <div class="pm-grid3 pm-mt-16">{posts.map((p) => <PostCard post={p} excerpt />)}</div>
</div>
