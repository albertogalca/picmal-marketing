const audioFormats = {
  input: [
    "MP3",
    "WAV",
    "AAC",
    "M4A",
    "FLAC",
    "OGG",
    "Opus",
    "AIFF",
    "AC3",
    "DTS",
    "WV",
    "TTA",
    "AU",
    "CAF",
    "SPX",
    "IRCAM",
    "SND",
    "VOC",
    "W64",
    "SLN",
    "HCOM",
    "PAF",
    "MP2",
    "WVE",
    "NIST",
    "AIF",
    "AIFC",
    "AVR",
    "PVF",
    "WMA",
    "OGA",
    "M4R",
  ],
  output: ["MP3", "WAV", "AAC", "FLAC", "OGG", "Opus"],
};

const videoFormats = {
  input: [
    "MP4",
    "MOV",
    "AVI",
    "MKV",
    "WebM",
    "FLV",
    "WMV",
    "M4V",
    "MPEG",
    "MPG",
    "M2TS",
    "MTS",
    "VOB",
    "TS",
    "WTV",
    "3GP",
    "ASF",
    "OGV",
    "MJPEG",
    "M2V",
    "HEVC",
    "F4V",
    "MXF",
  ],
  output: [
    "MP4",
    "MOV",
    "AVI",
    "MKV",
    "WebM",
    "FLV",
    "WMV",
    "M4V",
    "3GP",
    "MPEG",
