---
import Button from "./Button.astro";
import { DEFAULT_TIER, type Tier } from "../config/pricing";

interface Props {
  /** Seline event fired on the buy click, e.g. "buy_clicked_video_converter_mac" */
  buyEvent: string;
  /** Where "Need 2, 5 or 10 Macs?" points. Same-page anchor by default; pages
      without their own PricingSection pass "/#pricing". */
  pricingHref?: string;
  /** Which CTA fired the event, so the funnel can tell hero from pricing card. */
  source?: string;
  /** Extra classes for the wrapper */
  class?: string;
  /** Which licence the hero sells. Defaults to the entry tier, which is right
      for every page written for one person with one Mac. A page written for an
      audience that arrives needing several (studios, education) passes its own
      tier so the hero, the header and the closing CTA all quote one number. */
  tier?: Tier;
  /** The trailing link in the terms line. The default sends a single-Mac reader
      up the ladder; a page that is already about the ladder sends them the
      other way. */
  linkText?: string;
}

const {
  buyEvent,
  pricingHref = "#pricing",
  source = "hero",
  class: className = "",
  tier = DEFAULT_TIER,
  linkText = "Need 2, 5 or 10 Macs?",
} = Astro.props;

// "$29 once" on the entry tier, "$89 once for 5 Macs" on a team tier: the seat
// count only earns its words when it is not 1.
const priceLine =
  tier.macs === 1
    ? `$${tier.price} once`
    : `$${tier.price} once for ${tier.macs} Macs`;

// The buy button carries no href, so Button falls back to
// DEFAULT_TIER.checkoutUrl and the click lands on Stripe. Until Aug 2026 this
// button pointed at /#pricing: every recorded buy_clicked was a scroll, and the
// checkout link three screens down got zero clicks in W35.
//
// The Download button that used to sit beside it is gone (Sep 2026). There is
// no trial: the app installs and opens, and converts nothing until a key goes
// in. Six months of Seline said the button was not serving the buyers it was
// built for. download_dmg fired 48 times: 39 on /download, before anyone had
// paid, against 9 on /thank-you. Four out of five downloads were strangers
// installing an app that could not do the job they came for, and the hero was
// offering them that as the peer of the buy button, 62 clicks against 101.
//
// So the hero asks for one thing. /download still exists, still ranks for
// "download picmal for mac", and is still linked from the bottom of every page
// through CTASection, where a reader has already seen the price. The door is
// after the pitch now, instead of in place of it.
---

<div class={className || undefined}>
  <div class="hero-reveal flex flex-col sm:flex-row gap-3" style="--d: 160ms">
    <Button
      text={`Get Picmal for $${tier.price}`}
      href={tier.checkoutUrl}
      class="w-full sm:w-auto"
      onclick={import.meta.env.PROD
        ? `window.seline?.track('${buyEvent}', { macs: ${tier.macs}, source: '${source}' })`
        : undefined}
    />
  </div>

  <!-- What it costs and where the files stay, in one line. Muted so it
       supports the button without competing. -->
  <p
    class="hero-reveal mt-5 text-small text-text-secondary"
    style="--d: 200ms"
  >
    <svg
      class="inline-block w-4 h-4 mr-1.5 align-[-3px]"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
    {/* "No uploads" used to live here. The H1 says "Nothing gets uploaded"
        and the sublead says "while a website would still be uploading", so
        this was the third time in one screen. The line's job is the terms, so
        it keeps the ones nothing else states. */}
    {`${priceLine}, updates included. No account, no subscription, works offline. `}
    <a href={pricingHref} class="link">{linkText}</a>
  </p>
</div>
