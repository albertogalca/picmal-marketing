---
import H2 from "./H2.astro";
import Paragraph from "./Paragraph.astro";
import Button from "./Button.astro";
import { DEFAULT_TIER, type Tier } from "../config/pricing";

interface Props {
  heading: string;
  analyticsEvent: string;
  /** The line under the heading. Defaults to the terms, which is the right
      answer on a page that has not already spent itself saying them. On
      /pricing it has, so that page passes something the reader has not read
      six times by the time they get here. */
  note?: string;
  /** Which licence the button buys. Defaults to the entry tier, which is what
      every general page should sell. A page written for one audience (studios,
      education) passes the tier that audience came for, so the closing button
      does not drop them back to 1 Mac. */
  tier?: Tier;
}

const {
  heading,
  analyticsEvent,
  note = "One-time purchase · No subscription · 14-day money-back guarantee",
  tier = DEFAULT_TIER,
} = Astro.props;
---

<section class="relative z-10 px-6 py-20">
  <div class="max-w-4xl mx-auto">
    <div
      class="bg-background-subtle border border-border rounded-2xl p-8 md:p-12 text-center"
    >
      <H2 class="mb-6">{heading}</H2>
      <Paragraph class="mb-10 max-w-2xl mx-auto">{note}</Paragraph>
      <div class="flex flex-col items-center gap-3">
        <Button
          text={`Get Picmal for $${tier.price}`}
          href={tier.checkoutUrl}
          onclick={import.meta.env.PROD
            ? `window.seline?.track('${analyticsEvent}')`
            : undefined}
        />
        <a
          href="/download"
          class="inline-flex items-center gap-1.5 text-small text-text-secondary hover:text-text transition-colors rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          or download to take a look
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>
