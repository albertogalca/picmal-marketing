---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import PricingSection from "../../components/PricingSection.astro";
import FounderLetter from "../../components/FounderLetter.astro";
import Section from "../../components/Section.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import AlternativeVerdict from "../../components/AlternativeVerdict.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";
import FAQSection from "../../components/FAQSection.astro";

const SITE_DESCRIPTION =
  "Want a How To Convert alternative on your Mac? Picmal converts, compresses, and edits images, video, and audio, plus PDF tools, all on your Mac. Nothing gets uploaded. $29 once, no subscription. 14-day refund.";

const faqs = [
  {
    question: "Is Picmal a good How To Convert alternative?",
    answer:
      "For media files on a Mac, yes. Picmal converts and compresses images, video, audio, and PDFs, and it ties into macOS with Shortcuts and folder monitoring. If you need to convert Word documents or emails, How To Convert does that and Picmal doesn't.",
  },
  {
    question: "Does Picmal work offline like How To Convert?",
    answer:
      "Yes. Both apps do the work on your Mac. Your files never go to a server.",
  },
  {
    question: "Why does Picmal cost more than How To Convert?",
    answer:
      "Picmal is $29, How To Convert is $29. The $10 buys a Mac app instead of a cross-platform one: a native interface, Shortcuts, Finder right-click, folder monitoring, and a command line tool. How To Convert spends its scope on Windows and Linux and on documents and email.",
  },
  {
    question: "Can Picmal convert documents like PDFs or Word files?",
    answer:
      "Picmal can compress PDFs, combine them, turn images into a PDF, and export pages to PNG. It doesn't convert document formats, so no Word, DOCX, or Markdown. For that, reach for How To Convert or Pandoc.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Email support@picmal.app within 14 days and I'll refund you, no questions asked.",
  },
];
---

<MarketingLayout
  title="Picmal: A native Mac alternative to How To Convert"
  description={SITE_DESCRIPTION}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
        <FAQSchema />
  </Fragment>

  <ComparisonHero
    title="A native Mac alternative to How To Convert"
    subhead="How To Convert does documents, emails, and three platforms. Picmal does media, so images, video, audio, and PDFs, on the Mac only, with a native interface, Shortcuts, and folder monitoring."
    buyEvent="buy_clicked_howtoconvert_comparison"
  />

  <ComparisonVerdict
    competitor="How To Convert"
    summary="How To Convert handles documents, emails, and media across Windows, Mac, and Linux. Picmal ($29, paid once) is Mac only and sticks to media, so images, video, audio, and PDFs, with a native interface, Shortcuts, and folder monitoring."
    picmalFor="You're on a Mac and mostly work with media files. You want something that feels native, with Shortcuts, folder monitoring, and a command line tool, and you don't need Windows or Linux."
    competitorFor="You convert documents or emails, or you need the same app on Windows or Linux too."
  />

  <!-- Comparison Table -->
  <Section width="default">
    <SectionHeading>
      Picmal vs How To Convert at a glance
      <Fragment slot="sublead">
        How To Convert is broad. It supports thousands of format combinations
        across five categories. But if you're on a Mac and you live in media,
        converting, compressing, and editing images, video, and audio, Picmal
        is the more focused, native pick.
      </Fragment>
    </SectionHeading>
    <ComparisonTable
      competitor="How To Convert"
      rows={[
      {
        feature: "Price",
        picmal: "$29 one-time",
        competitor: "$29 one-time",
      },
      {
        feature: "Platforms",
        picmal: "macOS only",
        competitor: "Mac, Windows, Linux",
      },
      {
        feature: "Privacy",
        picmal: "100% offline",
        competitor: "100% offline",
      },
      {
        feature: "Interface",
        picmal: "Native macOS, single window",
        competitor: "Cross-platform wrapper",
      },
      {
        feature: "Image formats",
        picmal: "20+",
        competitor: "40+",
      },
      {
        feature: "Video formats",
        picmal: "20+",
        competitor: "50+",
      },
      {
        feature: "Document conversions",
        picmal: "No",
        competitor: "Yes (DOCX, PDF, MD, etc.)",
      },
      {
        feature: "Email conversions",
        picmal: "No",
        competitor: "Yes (EML, MSG)",
      },
      {
        feature: "Metadata removal",
        picmal: "Yes, strip location data before sharing",
        competitor: "No",
      },
      {
        feature: "Finder right-click",
        picmal: "Yes, convert without opening the app",
        competitor: "No",
      },
      {
        feature: "Shortcuts integration",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "Folder monitoring",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "Device license",
        picmal: "2 Macs, 5 with Pro",
        competitor: "5 devices",
      },
    ]}
    />
  </Section>

  <!-- Who Picmal Is For / Who Should Stick with How To Convert -->
  <AlternativeVerdict
    sublead="Here's where each one makes more sense."
    picmal={{
      heading: "Choose Picmal",
      lead: "Best for Mac users who care about design and automation",
      items: [
        "You want an app that feels native to macOS, not a cross-platform wrapper",
        "You need system integrations like Shortcuts or folder monitoring",
        "You convert, compress, and edit images, video, and audio, plus PDF tools, and you don't need documents",
        "You'd rather have a focused tool from one developer who builds for one platform",
        "You want a Mac app, not a cross-platform one",
      ],
    }}
    rival={{
      heading: "Choose How To Convert",
      lead: "Best for cross-platform users with a wide range of formats",
      items: [
        "You work on Windows or Linux (or all three)",
        "You need document conversions (Word, PDF, Markdown, ebooks)",
        "You need email format conversions (EML, MSG)",
        "You want the cheaper one and can live without the Mac integrations",
        "Format variety matters more than native feel",
      ],
    }}
  />

  <!-- Features -->
  <FeatureGrid
    heading="Everything else Picmal does"
    subleadIntro="One app for images, video, audio, and PDFs. Convert, compress, and edit, all on your Mac."
  />

  <!-- Testimonials Section -->
  <MasonryTestimonials />

  <!-- Pricing -->
  <PricingSection />

  <!-- Founder letter -->
  <FounderLetter />

  <!-- FAQ Section -->
  <FAQSection
    faqs={faqs}
    heading="Frequently asked questions"
    sublead="Can't find what you're looking for? Email support@picmal.app"
  />

  <Fragment slot="after">
    <SupportedFormatsModal />
  </Fragment>
</MarketingLayout>
