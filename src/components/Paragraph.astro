---
import { cn } from "../utils/cn";

interface Props {
  class?: string;
  size?: "base" | "small" | "lead";
  color?: "secondary" | "primary";
}

const { class: className, size = "base", color = "secondary" } = Astro.props;

const sizeClasses = {
  base: "text-body",
  small: "text-small",
  lead: "text-body-big",
};

const colorClasses = {
  secondary: "text-text-secondary",
  primary: "text-text",
};

const defaultClasses = `${sizeClasses[size]} ${colorClasses[color]} text-pretty`;
const mergedClasses = cn(defaultClasses, className);
---

<p class={mergedClasses}>
  <slot />
</p>
