---
import Paragraph from "./Paragraph.astro";
---

<div
  class="w-full border-b border-text/5 bg-background-subtle/90 dark:bg-background/70"
>
  <div class="max-w-6xl mx-auto py-3 flex flex-row justify-center">
    <div
      class="flex flex-col sm:flex-row items-center gap-2 text-text-secondary text-center"
    >
      <Paragraph size="small"
        >Lifetime access stays at $9.99 until the end of November.</Paragraph
      >
      <a
        href="#pricing"
        class="inline-flex items-center gap-2 rounded-lg px-3 py-1 border border-text/10 bg-background text-text text-xs font-semibold hover:border-text/40 transition-colors"
      >
        Get it now
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 12h14m-6-6 6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </div>
</div>
