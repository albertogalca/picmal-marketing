---
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import FallbackImage from "../../public/og.png";
import { SITE_TITLE } from "../consts";
import Seline from "./Seline.astro";
import OrganizationSchema from "./schema/OrganizationSchema.astro";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  ogType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

// Remove .html extension, trailing slashes, and query parameters for consistent canonical URLs
const cleanPath =
  Astro.url.pathname
    .replace(/\/index\.html$/, "/")
    .replace(/\.html$/, "")
    .replace(/\/$/, "") || "/";
const canonicalURL = new URL(cleanPath, Astro.site);

const { title, description, image = FallbackImage, ogType = "website", publishedTime, modifiedTime, noindex = false } = Astro.props;
---

{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Site-wide entity graph. It lives here, not on individual pages, because
     ProductSchema and ArticleSchema now reference the Organization and Person
     by @id: 23 feature pages and every blog post emit those refs, and a ref
     whose node is not on the same page resolves to nothing. -->
<OrganizationSchema url={Astro.site!.href} />

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<meta
  name="theme-color"
  content="#ffffff"
  media="(prefers-color-scheme: light)"
/>
<meta
  name="theme-color"
  content="#0a0a0a"
  media="(prefers-color-scheme: dark)"
/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<!-- Machine-readable entry points, so an agent that lands on any page can find
     the spec and the agent guide without guessing at URLs. -->
<link
  rel="service-desc"
  type="application/vnd.oai.openapi+json;version=3.1"
  href="/openapi.json"
/>
<link
  rel="describedby"
  type="text/markdown"
  title="AGENTS.md"
  href="/AGENTS.md"
/>
<link rel="describedby" type="text/plain" title="llms.txt" href="/llms.txt" />
<script is:inline>
  (function () {
    // No stored choice means the visitor has not chosen, so follow the OS. The
    // whole token layer is light-dark(), so dark costs nothing extra, and this
    // is a Mac-first audience on a site arguing that it feels native. An
    // explicit choice still wins: localStorage is read first.
    const stored = localStorage.getItem("theme");
    const theme =
      stored ||
      (window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light");
    const root = document.documentElement;

    root.classList.remove("light", "dark");
    root.classList.add(theme);

    root.style.colorScheme = theme;
  })();
</script>
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
{!noindex && <link rel="canonical" href={canonicalURL} />}
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="preconnect" href="https://cdn.seline.com" />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Picmal" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />
<meta property="og:image:width" content={String(image.width)} />
<meta property="og:image:height" content={String(image.height)} />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@picmalapp" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image.src, Astro.url)} />
<Seline />
