---
import { Icon } from "astro-icon/components";
import H3 from "./H3.astro";
import Paragraph from "./Paragraph.astro";
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";

// App icons (public/*.png) shown for the "Fits your workflow" feature. Each
// links to the integrations docs.
const workflowApps = [
  { name: "Finder", src: "/finder.png" },
  { name: "Shortcuts", src: "/shortcuts.png" },
  { name: "Raycast", src: "/raycast.png" },
];
const INTEGRATIONS_HREF = "/docs/integrations";

// Heading + sublead copy. Defaults answer the landing page's testimonials
// question ("Tired of going online...") that sits directly above this section;
// comparison pages, where that setup isn't present, pass standalone copy. The
// sublead tail ("...plenty more in the docs") with its link is always kept.
const {
  heading = "Nice, but what can you do with Picmal?",
  subleadIntro = "Quite a lot, actually.",
} = Astro.props as { heading?: string; subleadIntro?: string };

// `icon` is a Phosphor (duotone) name for astro-icon; the workflow feature
// renders `apps` (app icons) instead of a single icon.
const features: {
  icon?: string;
  apps?: typeof workflowApps;
  title: string;
  desc: string;
  modalId?: string;
}[] = [
  {
    icon: "ph:selection-plus-duotone",
    title: "Convert between formats",
    desc: "Over 100 formats across images, video, audio, RAW, and PDF. HEIC to JPG, MOV to MP4, FLAC to ALAC. Drop it in, pick the output, done.",
    modalId: "open-formats-modal-bento",
  },
  {
    icon: "ph:trend-down-duotone",
    title: "Compress and save space",
    desc: "Get under an email limit or a slow upload, without the quality drop you'd actually notice. No browser, no waiting.",
    modalId: "open-compress-formats-modal-bento",
  },
  {
    icon: "ph:file-dashed-duotone",
    title: "Split and organize PDFs",
    desc: "Break a PDF apart, or drag pages around to reorder, rotate, and delete. Your documents never leave your Mac.",
  },
  {
    icon: "ph:film-strip-duotone",
    title: "Combine videos",
    desc: "Stitch a pile of clips into one video. Drag to reorder, pick the format, export in a single pass.",
  },
  {
    icon: "ph:waveform-duotone",
    title: "Merge and split audio",
    desc: "Join tracks into one file, or split a long recording by its chapters. Podcasts and audiobooks, sorted.",
  },
  {
    icon: "ph:images-duotone",
    title: "Images to PDF",
    desc: "Turn a folder of photos into a multi-page PDF. A4, Letter, or custom, with a password if you want one.",
  },
  {
    icon: "ph:file-pdf-duotone",
    title: "Combine PDFs",
    desc: "Merge a stack of PDFs into one file. Put the pages in the right order, set the size, and save it out.",
  },
  {
    apps: workflowApps,
    title: "Fits your workflow",
    desc: "Finder, Shortcuts, and Raycast. A conversion is never more than a right-click away.",
  },
  {
    icon: "ph:terminal-window-duotone",
    title: "Picmal CLI",
    desc: "Script it, drop it in a cron job, or hand it to a coding agent. The same engine as the app, right from your terminal.",
  },
];
---

<Section id="features" width="wide">
  <SectionHeading align="left" subleadClass="max-w-xl">
    {heading}
    <Fragment slot="sublead">
      {subleadIntro} These are the essentials, and there's plenty more in the <a
        href="/docs"
        class="link">docs</a
      >.
    </Fragment>
  </SectionHeading>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10">
    {
      features.map((f) => (
        <div>
          {f.apps ? (
            <div class="flex items-center gap-3 mb-4">
              {f.apps.map((app) => (
                <a
                  href={INTEGRATIONS_HREF}
                  title={app.name}
                  aria-label={app.name}
                  class="rounded-[22%] transition-[opacity,scale] duration-200 ease-out hover:opacity-80 active:scale-[0.96] motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
                >
                  <img
                    src={app.src}
                    alt={app.name}
                    width="56"
                    height="56"
                    class="w-10 h-10 rounded-[22%] ring-1 ring-black/10 dark:ring-white/10"
                    loading="lazy"
                  />
                </a>
              ))}
            </div>
          ) : (
            <Icon name={f.icon!} class="w-10 h-10 mb-4 text-text" />
          )}
          <div class="flex items-center gap-1.5 mb-1">
            <H3 class="text-h4">{f.title}</H3>
            {f.modalId && (
              <button
                id={f.modalId}
                type="button"
                aria-label="See all supported formats"
                title="See all supported formats"
                class="relative shrink-0 cursor-pointer text-text-secondary transition-[color,scale] duration-200 hover:text-text active:scale-[0.92] motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50 rounded-full before:absolute before:-inset-3 before:content-['']"
              >
                <Icon name="ph:info" class="w-4 h-4" />
              </button>
            )}
          </div>
          <Paragraph>{f.desc}</Paragraph>
        </div>
      ))
    }
  </div>
</Section>
