---
import { Image } from "astro:assets";
import H2 from "./H2.astro";
import H3 from "./H3.astro";
import Button from "./Button.astro";
import Paragraph from "./Paragraph.astro";

const today = new Date();
const itShouldBeWhite = Astro.url.pathname === "/affiliate";
---

<div>
  <!-- Main Footer -->
  <footer class="relative z-10 px-6 py-16">
    <div class="max-w-6xl mx-auto">
      <!-- Footer Links Grid -->
      <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
        <!-- Logo and Copyright - Desktop only -->
        <div class="hidden md:block md:col-span-1">
          <div class="flex items-center space-x-2 mb-4">
            <Image
              src="/logo.webp"
              alt="Picmal Logo"
              width="32"
              height="32"
              class="rounded-lg w-8 h-8 object-cover"
            />
          </div>
          <Paragraph size="small" class="mb-2">
            Batch convert and compress images offline on your Mac. Beautiful,
            private, and straightforward.
          </Paragraph>
          <Paragraph size="small">
            Copyright © {today.getFullYear()} - All rights reserved.
          </Paragraph>

          <!-- Theme Switcher -->
          <button
            id="theme-toggle-desktop"
            class="mt-4 inline-flex items-center gap-2 text-sm text-text-secondary hover:text-text transition-colors"
            aria-label="Toggle theme"
          >
            <svg
              id="theme-icon-light-desktop"
              class="w-4 h-4 hidden"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                fill-rule="evenodd"
                clip-rule="evenodd"></path>
            </svg>
            <svg
              id="theme-icon-dark-desktop"
              class="w-4 h-4 hidden"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
              ></path>
            </svg>
            <span id="theme-label-desktop">Dark</span>
          </button>

          <!-- TinyLaunch Badge -->
          <!-- <div class="mt-6">
            <a href="https://tinylaunch.com" target="_blank" rel="noopener">
              <img
                src="https://tinylaunch.com/tinylaunch_badge_3.svg"
                alt="TinyLaunch Badge"
                style="width:202px; height:auto;"
              />
            </a>
          </div> -->
        </div>

        <!-- Product -->
        <div>
          <H3 class="mb-4">Product</H3>
          <ul class="space-y-2">
            <li>
              <a
                href="/apps/picmal/updates/Picmal.dmg"
                class="text-sm transition-colors text-text-secondary hover:text-text cursor-pointer"
              >
                Download
              </a>
            </li>
            <li>
              <a
                href="/#features"
                class="text-sm transition-colors text-text-secondary hover:text-text cursor-pointer"
              >
                Features
              </a>
            </li>
            <li>
              <a
                href="/#pricing"
                class="text-sm transition-colors text-text-secondary hover:text-text cursor-pointer"
              >
                Pricing
              </a>
            </li>
            <li>
              <a
                href="/affiliate"
                class="text-sm transition-colors text-text-secondary hover:text-text cursor-pointer"
              >
                Earn 25% as affiliate
              </a>
            </li>
          </ul>
        </div>

        <!-- Resources -->
        <div>
          <H3 class="mb-4">Resources</H3>
          <ul class="space-y-2">
            <li>
              <a
                href="/blog"
                class="text-sm transition-colors text-text-secondary hover:text-text cursor-pointer"
              >
                Blog
              </a>
            </li>
            <li>
              <a
                href="/changelog"
                class="text-sm transition-colors text-text-secondary hover:text-text cursor-pointer"
              >
                Changelog
              </a>
            </li>
            <li>
              <a
                href="/tools"
                class="text-sm transition-colors text-text-secondary hover:text-text cursor-pointer"
              >
                Tools
              </a>
            </li>
          </ul>
        </div>

        <!-- Company -->
        <div>
          <H3 class="mb-4">Company</H3>
          <ul class="space-y-2">
            <li>
              <a
                href="mailto:support@picmal.app"
                class="text-sm transition-colors text-text-secondary hover:text-text cursor-pointer"
              >
                Get in touch
              </a>
            </li>
            <li>
              <a
                href="https://x.com/picmalapp"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm transition-colors text-text-secondary hover:text-text cursor-pointer"
              >
                Follow on X
              </a>
            </li>
            <li>
              <a
                href="https://albertogalca.com"
                target="_blank"
                class="text-sm transition-colors text-text-secondary hover:text-text cursor-pointer"
