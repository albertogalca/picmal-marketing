---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import OrganizationSchema from "../../components/schema/OrganizationSchema.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import PricingSection from "../../components/PricingSection.astro";
import FounderLetter from "../../components/FounderLetter.astro";
import Section from "../../components/Section.astro";
import Card from "../../components/Card.astro";
import H3 from "../../components/H3.astro";
import Paragraph from "../../components/Paragraph.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";

const SITE_DESCRIPTION =
  "Looking for a CloudConvert alternative? Picmal converts and compresses images, video, audio, and PDFs on your Mac. No uploads, no daily limits, no credits. $15.99 once. 14-day refund.";

const faqs = [
  {
    question: "Is Picmal a good CloudConvert alternative?",
    answer:
      "For images, video, audio, and PDFs, yes. Picmal does the same conversions on your own Mac, with no upload, no daily cap, and no credits to buy. CloudConvert covers far more file types than Picmal does, including documents, spreadsheets, ebooks, and CAD, so if you need those it stays useful.",
  },
  {
    question: "What's CloudConvert's free limit?",
    answer:
      "10 conversions a day, up to 1GB per file and 5 minutes of processing. Past that you buy credits, either as a one-off package or a monthly subscription, and longer conversions consume more of them. Picmal is $15.99 once and doesn't count conversions.",
  },
  {
    question: "Does CloudConvert upload my files?",
    answer:
      "Yes. It's a web service, so every file goes to their servers to be processed and comes back as a download. They delete files after a period, but the upload happens. Picmal never sends a file anywhere. It converts on your Mac, offline, and works on a plane.",
  },
  {
    question: "Is Picmal cheaper than CloudConvert?",
    answer:
      "It depends on volume. CloudConvert's free tier costs nothing if you convert fewer than 10 files a day. Once you're past that regularly, credits add up every month, while Picmal is $15.99 paid once with updates included.",
  },
  {
    question: "Can Picmal handle large video files?",
    answer:
      "Yes, and there's no file size ceiling because nothing is being uploaded. The limit is your Mac's disk and patience. CloudConvert caps free conversions at 1GB and 5 minutes of processing.",
  },
  {
    question: "Does CloudConvert have an API? Does Picmal?",
    answer:
      "CloudConvert has a proper REST API, which is its real strength for developers automating conversions on a server. Picmal isn't a server tool, but it does have a command line interface, Apple Shortcuts actions, and a Raycast extension for automating things on your own machine.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Email support@picmal.app.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead
      title="Picmal: The CloudConvert alternative that never uploads your files"
      description={SITE_DESCRIPTION}
    />
    <OrganizationSchema url={Astro.site!.href} />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <ComparisonHero
      title="The CloudConvert alternative that never uploads your files"
      subhead="CloudConvert is a good web service. It also means every file you convert goes to someone else's server, 10 a day for free and credits after that. Picmal does images, video, audio, and PDFs on your Mac for $15.99 once."
      buyEvent="buy_clicked_cloudconvert_comparison"
    />

    <ComparisonVerdict
      competitor="CloudConvert"
      summary="CloudConvert converts almost anything, including documents and formats no Mac app touches, and has a genuinely good API. The trade is that your files leave your machine, you get 10 free conversions a day, and past that you're buying credits. Picmal ($15.99, pay once) covers images, video, audio, and PDFs entirely offline, with no limits to count."
      picmalFor="Your files are images, video, audio, or PDFs, you convert them often, and you'd rather not upload client work or personal photos to a server to do it."
      competitorFor="You need document, ebook, or CAD conversions, you're automating from a server via API, or you convert so rarely that 10 a day free is plenty."
    />

    <!-- Comparison Table -->
    <Section width="default">
      <SectionHeading>
        Picmal vs CloudConvert at a glance
        <Fragment slot="sublead">
          CloudConvert is a website that converts nearly any file type. Picmal is
          a Mac app that converts and compresses media without an internet
          connection. The right one depends on what you're converting and how
          often.
        </Fragment>
      </SectionHeading>
      <Card padding="p-4 md:p-8">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left p-4 font-semibold text-text">Feature</th>
                <th class="text-left p-4 font-semibold text-text">Picmal</th>
                <th class="text-left p-4 font-semibold text-text"
                  >CloudConvert</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <tr>
                <td class="p-4 text-text-secondary">Price</td>
                <td class="p-4 text-text tabular-nums">$15.99 one-time</td>
                <td class="p-4 text-text">Free tier, then credits</td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">Where files are processed</td>
                <td class="p-4 text-text">On your Mac</td>
                <td class="p-4 text-text">Uploaded to their servers</td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">Works offline</td>
                <td class="p-4 text-text">Yes</td>
                <td class="p-4 text-text">No</td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">Free usage limit</td>
                <td class="p-4 text-text">No limits, it's a paid app</td>
                <td class="p-4 text-text tabular-nums">10 conversions a day</td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">File size limit</td>
                <td class="p-4 text-text">Your disk</td>
                <td class="p-4 text-text tabular-nums">1GB free, 5 min max</td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">Images</td>
                <td class="p-4 text-text">Convert &amp; compress</td>
                <td class="p-4 text-text">Convert</td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">Video &amp; audio</td>
                <td class="p-4 text-text">Convert &amp; compress</td>
                <td class="p-4 text-text">Convert</td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">PDF</td>
                <td class="p-4 text-text"
                  >Compress, merge, split, images to PDF</td
                >
                <td class="p-4 text-text">Convert</td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">Documents &amp; ebooks</td>
                <td class="p-4 text-text">No</td>
                <td class="p-4 text-text">Yes</td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">Batch processing</td>
                <td class="p-4 text-text">Hundreds at once</td>
                <td class="p-4 text-text">Yes, uses credits per file</td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">API</td>
                <td class="p-4 text-text">No, but has a CLI</td>
                <td class="p-4 text-text">Yes</td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">Shortcuts integration</td>
                <td class="p-4 text-text">Yes</td>
                <td class="p-4 text-text">No</td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">Finder right-click</td>
                <td class="p-4 text-text">Yes</td>
                <td class="p-4 text-text">No</td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">Account required</td>
                <td class="p-4 text-text">No</td>
                <td class="p-4 text-text">Yes, beyond the free tier</td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">Platform</td>
                <td class="p-4 text-text tabular-nums">macOS 15+</td>
                <td class="p-4 text-text">Any browser</td>
              </tr>
            </tbody>
          </table>
        </div>
      </Card>
    </Section>

    <!-- Who each is for -->
    <Section width="default">
      <SectionHeading>
        Which one is right for you?
        <Fragment slot="sublead">
          Here's where each one makes more sense.
        </Fragment>
      </SectionHeading>

      <div class="grid md:grid-cols-2 gap-6">
        <Card>
          <div class="mb-6">
            <H3 class="mb-2">Choose Picmal</H3>
            <Paragraph color="secondary">
              You convert media often, on your own machine
            </Paragraph>
          </div>

          <ul class="space-y-4">
            <li class="flex gap-3 items-start">
              <svg
                class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-text">
                You handle client work or personal files you'd rather not upload
              </span>
            </li>

            <li class="flex gap-3 items-start">
              <svg
                class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-text">
                You keep hitting the 10 a day limit or buying credits
              </span>
            </li>

            <li class="flex gap-3 items-start">
              <svg
                class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-text">
                Your files are big, and uploading a 4GB video is the slow part
              </span>
            </li>

            <li class="flex gap-3 items-start">
              <svg
                class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-text">
                You want it in Finder, Shortcuts, and Raycast rather than a tab
              </span>
            </li>
          </ul>
        </Card>

        <Card>
          <div class="mb-6">
            <H3 class="mb-2">Stay with CloudConvert</H3>
            <Paragraph color="secondary">
              You need breadth, or you barely convert anything
            </Paragraph>
          </div>

          <ul class="space-y-4">
            <li class="flex gap-3 items-start">
              <svg
                class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-text">
                You convert documents, spreadsheets, ebooks, or CAD files
              </span>
            </li>

            <li class="flex gap-3 items-start">
              <svg
                class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-text">
                You're automating conversions from a server through the API
              </span>
            </li>

            <li class="flex gap-3 items-start">
              <svg
                class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-text">
                You convert a handful of files a year, so free is genuinely free
              </span>
            </li>

            <li class="flex gap-3 items-start">
              <svg
                class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-text">
                You're not on a Mac, or you move between machines
              </span>
            </li>
          </ul>
        </Card>
      </div>
    </Section>

    <FeatureGrid
      heading="Everything else Picmal does"
      subleadIntro="One app for images, video, audio, and PDFs. Convert, compress, and edit, all on your Mac."
    />

    <MasonryTestimonials />

    <PricingSection />

    <FounderLetter />

    <Section id="faq" width="narrow">
      <SectionHeading
        sublead="Can't find what you're looking for? Email support@picmal.app"
      >
        Frequently asked questions
      </SectionHeading>
      <Card>
        <FAQ faqs={faqs} />
      </Card>
    </Section>

    <Footer />

    <SupportedFormatsModal />
  </body>
</html>
