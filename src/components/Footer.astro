---
import { Image } from "astro:assets";
import H2 from "./H2.astro";
import H3 from "./H3.astro";
import Button from "./Button.astro";
import Paragraph from "./Paragraph.astro";

const today = new Date();
const isHomePage = Astro.url.pathname === "/";
---

<div>
  <!-- Newsletter Section -->
  <section
    class={`relative z-10 px-6 py-16 ${isHomePage ? "bg-white" : "bg-accent-background"}`}
  >
    <div class="max-w-2xl mx-auto text-center">
      <H2 class="mb-4"> Join to know about new updates </H2>
      <Paragraph class="mb-6">
        Everytime I release a new feature or have a deal I will email you. No
        spam, I promise!
      </Paragraph>

      <form
        action="https://buttondown.com/api/emails/embed-subscribe/picmal"
        method="post"
        target="popupwindow"
        class="flex flex-col sm:flex-row gap-3 justify-center items-center max-w-md mx-auto"
      >
        <label for="bd-email" class="sr-only">Enter your email</label>
        <input
          type="email"
          name="email"
          id="bd-email"
          placeholder="Enter your email"
          required
          class="w-full sm:flex-1 px-4 py-3 rounded-lg border focus:ring-2 focus:ring-accent focus:border-transparent outline-none bg-white border-gray-300 text-base placeholder-gray-500"
        />
        <Button
          type="submit"
          text="Subscribe"
          class="w-full sm:w-auto whitespace-nowrap"
        />
      </form>
    </div>
  </section>

  <!-- Main Footer -->
  <footer class="relative z-10 px-6 py-16 border-t border-gray-100 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
        <!-- Logo and Copyright -->
        <div class="md:col-span-1">
          <div class="flex items-center space-x-2 mb-4">
            <Image
              src="/logo.webp"
              alt="Picmal Logo"
              width="32"
              height="32"
              class="rounded-lg w-8 h-8 object-cover"
            />
          </div>
          <Paragraph size="small">
            © {today.getFullYear()}
            <a
              href="https://cantimplora.studio/"
              target="_blank"
              rel="noopener nofollow noreferrer"
              class="underline underline-offset-4 hover:text-black transition-colors"
            >
              Cantimplora Studio</a
            >, LLC. All rights reserved.
          </Paragraph>
        </div>

        <!-- Company -->
        <div>
          <H3 class="mb-4">Company</H3>
          <ul class="space-y-1">
            <li>
              <a
                href="mailto:support@picmal.app"
                class="text-sm transition-colors text-black hover:text-black cursor-pointer"
              >
                Get in touch
              </a>
            </li>
            <li>
              <a
                href="https://x.com/picmalapp"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm transition-colors text-black hover:text-black cursor-pointer"
              >
                Follow on X
              </a>
            </li>
            <li>
              <a
                href="/terms"
                class="text-sm transition-colors text-black hover:text-black cursor-pointer"
              >
                Terms of Use
              </a>
            </li>
            <li>
              <a
                href="/privacy"
                class="text-sm transition-colors text-black hover:text-black cursor-pointer"
              >
                Privacy Policy
              </a>
            </li>
          </ul>
        </div>

        <!-- Product -->
        <div>
          <H3 class="mb-4">Product</H3>
          <ul class="space-y-1">
            <li>
              <a
                href="/#features"
                class="text-sm transition-colors text-black hover:text-black cursor-pointer"
              >
                Features
              </a>
            </li>

            <li>
              <a
                href="/#testimonials"
                class="text-sm transition-colors text-black hover:text-black cursor-pointer"
              >
                Testimonials
              </a>
            </li>
            <li>
              <a
                href="/#about"
                class="text-sm transition-colors text-black hover:text-black cursor-pointer"
              >
                About
              </a>
            </li>
            <li>
              <a
                href="/#faq"
                class="text-sm transition-colors text-black hover:text-black cursor-pointer"
              >
                FAQ
              </a>
            </li>
            <li>
              <a
                href="/#pricing"
                class="text-sm transition-colors text-black hover:text-black cursor-pointer"
              >
                Pricing
              </a>
            </li>
          </ul>
        </div>

        <!-- Resources -->
        <div>
          <H3 class="mb-4">Resources</H3>
          <ul class="space-y-1">
            <li>
              <a
                href="/blog"
                class="text-sm transition-colors text-black hover:text-black cursor-pointer"
              >
                Blog
              </a>
            </li>
            <li>
              <a
                href="/blog?category=Changelog"
                class="text-sm transition-colors text-black hover:text-black cursor-pointer"
              >
                Changelog
              </a>
            </li>
            <li>
              <a
                href="https://picmal.userjot.com"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm transition-colors text-black hover:text-black cursor-pointer"
              >
                Feedback & roadmap
              </a>
            </li>
            <li>
              <a
                href="/tools/image-format-selector"
                class="text-sm transition-colors text-black hover:text-black cursor-pointer"
              >
                Format selector
              </a>
            </li>
            <li>
              <a
                href="/tools"
                class="text-sm transition-colors text-black hover:text-black cursor-pointer"
              >
                All tools
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </footer>
</div>

<script>
  // Handle newsletter form submission
  const form = document.querySelector('form[action*="buttondown.com"]');
  if (form) {
    form.addEventListener("submit", function () {
      window.open("https://buttondown.com/picmal", "popupwindow");
    });
  }
</script>
