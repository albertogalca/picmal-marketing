---
import { Icon } from "astro-icon/components";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Card from "../components/Card.astro";
import H3 from "../components/H3.astro";
import Button from "../components/Button.astro";
import Paragraph from "../components/Paragraph.astro";
import FAQ from "../components/FAQ.astro";

const SITE_DESCRIPTION =
  "Earn 25% commission on every Picmal sale you refer. 60-day cookie, $10 payout threshold, no quotas.";

const SIGNUP_URL = "https://licenses.albertogalca.com/affiliate/signup/new";
const SIGNIN_URL = "https://licenses.albertogalca.com/affiliate/recoveries/new";

// The three terms of the deal, shown as one quiet summary panel (not competing
// trophy cards) so they inform without out-shouting the CTA. Labels explain the jargon.
const terms = [
  { value: "25%", label: "Commission on every sale" },
  { value: "60 days", label: "Cookie window to come back and buy" },
  { value: "$10", label: "Minimum payout, paid monthly" },
];

const steps = [
  {
    title: "Sign up",
    body: "Register in a couple of minutes and get your unique affiliate link.",
    icon: "ph:user-plus-duotone",
  },
  {
    title: "Share your link",
    body: "Share Picmal on your website, blog, or social media.",
    icon: "ph:share-network-duotone",
  },
  {
    title: "Earn commission",
    body: "Get 25% on every sale. Tracked live, paid out monthly.",
    icon: "ph:coins-duotone",
  },
];

const affiliateFaqs = [
  {
    question: "Why promote Picmal?",
    answer:
      "Honestly? Because HEIC files, huge photos, and slow online converters are problems Mac users actually have, and Picmal fixes them. There's not much affiliate competition in this niche, and because it's a one-time purchase rather than a subscription, people are quicker to say yes.",
  },
  {
    question: "Who does best with this program?",
    answer:
      "Mac bloggers, photo and video YouTubers, newsletter writers, and people who run 'best Mac apps' style sites. If your audience ever complains about HEIC files or the size of their photo library, Picmal is an easy recommendation.",
  },
  {
    question: "Do you provide creative assets?",
    answer:
      "Yes. There's a press kit at picmal.app/press with screenshots, demo videos, and copy you can use. If you need a different format or something specific, email support@picmal.app and I'll send it over.",
  },
  {
    question: "How do I make money as an affiliate?",
    answer:
      "Put your link in a blog post, video description, newsletter, tweet, wherever it fits. We track the clicks and sales. The 60-day cookie means people don't have to buy on the first visit for you to get credit.",
  },
  {
    question: "How much can I earn?",
    answer:
      "You get 25% of every sale, which is about $5 to $15 per customer depending on the plan they pick. Since Picmal is a one-time purchase, you get the full commission upfront. No waiting on renewals.",
  },
  {
    question: "When do I get paid?",
    answer:
      "We pay out monthly once you've hit $10. You can track clicks, sales, and earnings from your dashboard.",
  },
  {
    question: "How do I sign up?",
    answer:
      'Click "Become an affiliate" above. Sign-up takes a couple of minutes. Once you\'re approved you get your link.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Picmal: Affiliate program"
      description={SITE_DESCRIPTION}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: "Picmal Affiliate Program",
        description: SITE_DESCRIPTION,
        speakable: {
          "@type": "SpeakableSpecification",
          cssSelector: ["#main-content h1", "#main-content p"],
        },
      })}
    />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <!-- Hero — left-aligned to match the site's reference hero (index.astro);
         two-column so the deal-terms panel fills the space a hero image would. -->
    <main id="main-content" class="relative z-10 px-6 pt-32 pb-16 sm:pb-20">
      <div class="max-w-5xl mx-auto">
        <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
          <div>
            <div class="hero-reveal" style="--d: 0ms">
              <SectionHeading
                level={1}
                align="left"
                class="mb-8"
                headingClass="mb-6"
              >
                Become an affiliate and earn 25% on each sale
                <Fragment slot="sublead">
                  You get about $5 to $15 per sale, depending on which plan they
                  buy.
                  The cookie lasts 60 days, so people who click your link have
                  two months to come back and purchase.
                </Fragment>
              </SectionHeading>
            </div>

            <div
              class="hero-reveal flex flex-col items-start gap-3"
              style="--d: 80ms"
            >
              <Button
                href={SIGNUP_URL}
                text="Become an affiliate"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto"
              />
              <a
                href={SIGNIN_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="link inline-block py-1 text-small text-text-secondary"
              >
                Already an affiliate? Sign in
              </a>
            </div>

            <p
              class="hero-reveal mt-5 flex items-center gap-2 text-small text-text-secondary"
              style="--d: 160ms"
            >
              <svg
                class="w-4 h-4 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 6 9 17l-5-5"></path>
              </svg>
              Free to join, no quotas. Approved manually by me.
            </p>
          </div>

          <!-- The deal at a glance: fills the right column and groups the terms
               as one quiet summary panel, not competing metric cards. -->
          <div class="hero-reveal" style="--d: 240ms">
            <Card>
              <p class="text-small font-[590] text-text-secondary mb-2">
                The deal at a glance
              </p>
              <dl class="divide-y divide-border">
                {
                  terms.map((t) => (
                    <div class="flex items-baseline justify-between gap-4 py-4 last:pb-0">
                      <dt class="text-h3 text-text tabular-nums">{t.value}</dt>
                      <dd class="text-small text-text-secondary text-right max-w-[20ch]">
                        {t.label}
                      </dd>
                    </div>
                  ))
                }
              </dl>
            </Card>
          </div>
        </div>
      </div>
    </main>

    <!-- How It Works -->
    <Section>
      <SectionHeading align="left" subleadClass="max-w-xl">
        How it works
        <Fragment slot="sublead">
          Three steps, and you're set up in a couple of minutes. No quotas, no
          approval hoops.
        </Fragment>
      </SectionHeading>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10">
        {
          steps.map((step, i) => (
            <div>
              <div class="flex items-center gap-3 mb-4">
                <Icon name={step.icon} class="w-9 h-9 text-text" />
                <span class="text-small font-[590] tabular-nums text-text-secondary">
                  Step {i + 1}
                </span>
              </div>
              <H3 class="text-h4 mb-1">{step.title}</H3>
              <Paragraph>{step.body}</Paragraph>
            </div>
          ))
        }
      </div>
    </Section>

    <!-- FAQ -->
    <Section id="faq" width="narrow">
      <SectionHeading>Frequently asked questions</SectionHeading>
      <Card>
        <FAQ faqs={affiliateFaqs} />
      </Card>
    </Section>

    <!-- Closing CTA — repairs the peak-end: the reader is convinced by the FAQ,
         then gets a place to act plus a plain, first-person reassurance. -->
    <Section bg="subtle">
      <SectionHeading>
        Ready to earn 25%?
        <Fragment slot="sublead">
          It's just me, Alberto, behind Picmal and this program. Payouts go out
          every month once you pass $10, and you can watch every click and sale
          land in your dashboard in real time.
        </Fragment>
      </SectionHeading>
      <div class="flex flex-col items-center gap-3">
        <Button
          href={SIGNUP_URL}
          text="Become an affiliate"
          target="_blank"
          rel="noopener noreferrer"
        />
        <a
          href={SIGNIN_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="link inline-block py-1 text-small text-text-secondary"
        >
          Already an affiliate? Sign in
        </a>
      </div>
      <Paragraph size="small" class="text-center mt-8">
        Questions? Email me at <a class="link" href="mailto:support@picmal.app"
          >support@picmal.app</a
        >, or grab the <a class="link" href="/press">press kit</a>.
      </Paragraph>
    </Section>

    <Footer />

    <!-- One-time hero entrance, staggered; opacity + transform only, gated on
         prefers-reduced-motion. Matches the reference hero. -->
    <style>
      @media (prefers-reduced-motion: no-preference) {
        .hero-reveal {
          opacity: 0;
          animation: hero-reveal 0.6s cubic-bezier(0.2, 0, 0, 1) both;
          animation-delay: var(--d, 0ms);
        }
        @keyframes hero-reveal {
          from {
            opacity: 0;
            transform: translateY(12px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
      }
    </style>
  </body>
</html>
