---
export interface Props {
  width?: string;
  height?: string;
  text?: string;
  aspectRatio?: string;
  rounded?: boolean;
  icon?: boolean;
}

const {
  width = "100%",
  height = "auto",
  text = "Image",
  aspectRatio,
  rounded = false,
  icon = true,
} = Astro.props;

const roundedClass = rounded ? "rounded-2xl" : "rounded-lg";
---

<div
  class={`bg-gradient-to-br from-background-subtle to-background border border-text/10 flex items-center justify-center ${roundedClass} overflow-hidden`}
  style={aspectRatio ? `aspect-ratio: ${aspectRatio}; width: ${width};` : `width: ${width}; height: ${height};`}
>
  <div class="text-center">
    {
      icon && (
        <svg
          class="w-16 h-16 mx-auto mb-3 text-text-secondary/30"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
          />
        </svg>
      )
    }
    <p class="text-sm text-text-secondary/50 font-medium">{text}</p>
  </div>
</div>
