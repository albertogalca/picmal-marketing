---
import { cn } from "../utils/cn";
import H1 from "./H1.astro";
import H2 from "./H2.astro";
import Paragraph from "./Paragraph.astro";

/**
 * SectionHeading, the single heading-block primitive for every section header
 * on the site. Adapts to its position:
 *   - `level`  1 for the page hero (renders H1), 2 for sections (default, H2)
 *   - `align`  "center" (default) or "left"
 *   - sublead  a supporting lead line, pass the `sublead` string, or use the
 *              named `sublead` slot when it needs links/markup
 * Margins are baked in (block `mb-12`, heading `mb-4`); override per position
 * with `class` (wrapper), `headingClass`, and `subleadClass`.
 */
interface Props {
  level?: 1 | 2;
  align?: "center" | "left";
  sublead?: string;
  class?: string;
  headingClass?: string;
  subleadClass?: string;
}

const {
  level = 2,
  // Redesign: left-aligned by default, on the page column's edge.
  align = "left",
  sublead,
  class: className,
  headingClass,
  subleadClass,
} = Astro.props;

const Heading = level === 1 ? H1 : H2;
// A caller margin (mb-8 above a reading column) replaces the default rhythm
// entirely; otherwise tailwind-merge kept sm:mb-16 and prose sat 64px down.
const customMargin = /(^|\s)(sm:|md:)?mb-/.test(className ?? "");
const centered = align === "center";
const hasSublead = sublead !== undefined || Astro.slots.has("sublead");
const subleadText = sublead ?? (Astro.slots.has("sublead") ? await Astro.slots.render("sublead") : "");
const twoTone = level === 2 && hasSublead && subleadText.replace(/<[^>]+>/g, "").trim().length <= 120;
---

{/* Redesign: the two-tone heading. A short sublead continues the heading at
    the same size in text-quiet, so the two read as one sentence in two voices.
    A long one (over ~120 characters) drops to a lead paragraph instead. */}
<div class={cn(centered && "text-center", !customMargin && (hasSublead ? "mb-10 sm:mb-16" : "mb-8 sm:mb-10"), className)}>
  <Heading class={cn(twoTone ? "mb-0" : "mb-4", headingClass)}><slot /></Heading>
  {
    hasSublead && (
      <Paragraph
        size="lead"
        class={cn(
          twoTone && "text-text-quiet font-medium mt-1",
          twoTone && "text-h2 font-medium max-w-3xl",
          // A long sublead is a lead paragraph: it sits on the 640px measure.
          !twoTone && !centered && "max-w-[640px]",
          centered && "max-w-2xl mx-auto",
          subleadClass,
        )}
      >
        <slot name="sublead">{sublead}</slot>
      </Paragraph>
    )
  }
</div>
