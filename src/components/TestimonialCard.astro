---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { seeded } from "../utils/pixels";

interface Testimonial {
  name?: string;
  description?: string;
  image?: string;
  content: string;
  highlight?: string;
  link?: string;
  type?: string;
  publication?: string;
  logo?: string | ImageMetadata;
  /** Dark-text logo on transparent bg: flip it to stay legible in dark mode. */
  logoInvertDark?: boolean;
  /** Intrinsic logo size. Wrong values letterbox the mark inside object-contain. */
  logoWidth?: number;
  logoHeight?: number;
}

interface Props {
  testimonial: Testimonial;
  /** "center" = hero (big, centered), "left" = testimonials grid */
  align?: "left" | "center";
  class?: string;
}

const { testimonial: t, align = "left", class: className = "" } = Astro.props;

const isPress = t.type === "press";
const isCenter = align === "center";

// Redesign: a reviewer without a photo gets a 5x5 mirrored pixel face drawn
// from their name, on one of the three pixel-art grounds. Same name, same face.
function getInitialsAvatar(name: string): string {
  const r = seeded(name);
  const grounds = [["#1450e0", "#f1f6ff"], ["#0b0b12", "#3b82f6"], ["#f1f6ff", "#1450e0"]];
  let h = 0;
  for (const c of name) h = (h * 31 + c.charCodeAt(0)) >>> 0;
  const [bg, ink] = grounds[h % 3];
  let rects = "";
  for (let y = 0; y < 5; y++)
    for (let x = 0; x < 3; x++)
      if (r() < 0.5) {
        rects += `<rect x="${x * 16}" y="${y * 16}" width="16" height="16"/>`;
        if (x < 2) rects += `<rect x="${(4 - x) * 16}" y="${y * 16}" width="16" height="16"/>`;
      }
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 80 80" shape-rendering="crispEdges"><rect width="80" height="80" fill="${bg}"/><g fill="${ink}">${rects}</g></svg>`;
  return `data:image/svg+xml;base64,${Buffer.from(svg).toString("base64")}`;
}

const content = t.content.trim();

// brightness-0 first flattens the logo to black, so invert gives a clean white
// silhouette instead of the hue-shifted mess plain `invert` makes of a colour mark.
const logoClass = `h-8 sm:h-9 w-auto object-contain${t.logoInvertDark ? " dark:brightness-0 dark:invert" : ""}`;
const at = t.highlight ? content.indexOf(t.highlight) : -1;
const quote =
  at === -1
    ? { before: content, mark: "", after: "" }
    : {
        before: content.slice(0, at),
        mark: t.highlight!,
        after: content.slice(at + t.highlight!.length),
      };
---

<div class:list={[className]}>
  <!-- Quote -->
  <!-- No newlines inside the quote: they collapse into stray spaces around the
       highlight ("word . Next" instead of "word. Next"). -->
  <p class:list={["text-text text-pretty", isCenter ? "text-h3 font-medium mb-5" : "text-body mb-5"]}>"{quote.before}{quote.mark && <span class="font-semibold">{quote.mark}</span>}{quote.after}"</p>

  <!-- Attribution -->
  {
    isPress ? (
      <div class:list={["flex items-center"]}>
        {t.link ? (
          <a
            href={t.link}
            target="_blank"
            rel="nofollow noreferrer"
            aria-label={`Read the ${t.publication} review of Picmal`}
            class="inline-flex items-center justify-center py-1 rounded-xl transition-[scale,opacity] duration-200 hover:opacity-70 active:scale-[0.96] motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            <Image
              src={t.logo!}
              alt={t.publication ?? ""}
              width={t.logoWidth ?? 240}
              height={t.logoHeight ?? 73}
              class={logoClass}
              loading="lazy"
            />
          </a>
        ) : (
          <Image
            src={t.logo!}
            alt={t.publication ?? ""}
            width={t.logoWidth ?? 240}
            height={t.logoHeight ?? 73}
            class={logoClass}
            loading="lazy"
          />
        )}
      </div>
    ) : (
      <div
        class:list={[
          "flex items-center gap-3",
        ]}
      >
        <img
          src={t.image || getInitialsAvatar(t.name ?? "")}
          alt={`${t.name}, Picmal user`}
          width={40}
          height={40}
          class:list={["w-8 h-8 flex-shrink-0 object-cover", t.image ? "rounded-full ring-1 ring-black/10 dark:ring-white/10" : "rounded-md"]}
          loading="lazy"
        />
        <div class="flex flex-col leading-tight">
          <span class="text-small font-medium text-text">{t.name}</span>
          {t.description && (
            <span class="text-small text-text-secondary">{t.description}</span>
          )}
        </div>
      </div>
    )
  }
</div>
