---
import MarketingLayout from "../../../layouts/MarketingLayout.astro";
import BlockGrid from "../../../components/BlockGrid.astro";
import ComparisonHero from "../../../components/ComparisonHero.astro";
import ProductSchema from "../../../components/schema/ProductSchema.astro";
import Section from "../../../components/Section.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import BenefitsCard from "../../../components/BenefitsCard.astro";
import ConversionGrid from "../../../components/ConversionGrid.astro";
import FAQSection from "../../../components/FAQSection.astro";
import FAQSchema from "../../../components/schema/FAQSchema.astro";
import GuideCrossLink from "../../../components/GuideCrossLink.astro";

import {
  videoConversions,
  videoFormats,
  getRelatedVideoConversions,
  isVideoConversionIndexed,
  labelFor,
} from "../../../data/videoConversions";

export function getStaticPaths() {
  return videoConversions.map((c) => ({
    params: { slug: c.slug },
    props: { conversion: c },
  }));
}

const { conversion } = Astro.props;
const from = videoFormats[conversion.from];
const to = videoFormats[conversion.to];
const related = getRelatedVideoConversions(conversion.slug, 6);

const title = conversion.metaTitle;
const description = conversion.metaDescription;

// Cross-links to the in-depth blog guide for high-demand video conversions.
const blogGuides: Record<string, { title: string; slug: string }> = {
  "hevc-to-mp4": {
    title: "How to Convert HEVC to MP4 on Mac (2026 Guide)",
    slug: "convert-hevc-to-mp4-mac",
  },
  "avi-to-mp4": {
    title: "How to Convert AVI to MP4 on Mac (Free and Paid)",
    slug: "convert-avi-to-mp4-mac",
  },
  "mov-to-mp4": {
    title: "How to Convert MOV to MP4 on Mac: 3 Free Ways (2026)",
    slug: "convert-mov-to-mp4-mac",
  },
  "mkv-to-mp4": {
    title: "How to Convert MKV to MP4 on Mac (Keep Subtitles and Audio Tracks)",
    slug: "convert-mkv-to-mp4-mac",
  },
  "mov-to-gif": {
    title: "QuickTime to GIF on Mac: 3 Free Methods (2026)",
    slug: "quicktime-to-gif-mac",
  },
  "mp4-to-gif": {
    title: "QuickTime to GIF on Mac: 3 Free Methods (2026)",
    slug: "quicktime-to-gif-mac",
  },
};
const blogGuide = blogGuides[conversion.slug];

// Low-demand templated pairs are de-indexed to concentrate site quality on winners.
const noindex = !isVideoConversionIndexed(conversion.slug);
---

<MarketingLayout
  title={title}
  description={description}
  noindex={noindex}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema faqs={conversion.faqs} />
  </Fragment>

  <ComparisonHero
    pricingHref="/#pricing"
    title={`Convert ${labelFor(from)} to ${labelFor(to)} on Mac`}
    subhead={conversion.whyConvert}
    buyEvent={`buy_clicked_video_${conversion.slug}`}
    defaultTab="convert"
  />

  <!-- Benefits -->
  <Section width="narrow">
    <BenefitsCard
      heading={`Why convert ${from.name} to ${to.name} with Picmal`}
      benefits={conversion.benefits}
    />
  </Section>

  <!-- How it works -->
  <BlockGrid ordered
    heading="Convert in 3 steps"
    items={[
      {
        title: `Drop your ${from.name} files`,
        description: "Drag and drop one file or a whole folder.",
      },
      {
        title: `Choose ${to.name}`,
        description: "Pick the output format and quality.",
      },
      {
        title: "Convert",
        description: "Click Convert. Everything runs on your Mac.",
      },
    ]}
  />

  <!-- FAQ -->
  <FAQSection faqs={conversion.faqs} />

  <!-- Blog Guide Cross-Link -->
  {
    blogGuide && (
      <GuideCrossLink
        href={`/blog/${blogGuide.slug}`}
        title={blogGuide.title}
        sublead="Want step-by-step instructions with free methods (HandBrake, VLC, FFmpeg) alongside Picmal?"
      />
    )
  }

  <!-- Related video conversions -->
  <Section>
    <SectionHeading class="mb-8">More video conversions</SectionHeading>
    <ConversionGrid
      links={related.map((c) => ({
        href: `/convert/video/${c.slug}`,
        label: `${videoFormats[c.from].name} to ${videoFormats[c.to].name}`,
      }))}
      linkText="All video conversions"
      linkHref="/video-converter-mac"
    />
  </Section>
</MarketingLayout>
