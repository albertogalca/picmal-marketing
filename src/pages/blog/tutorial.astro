---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import BlogNavigation from "../../components/BlogNavigation.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import "../../styles/global.css";

const posts = (await getCollection("blog"))
  .filter(post => post.data.category === "Tutorial")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Tutorials - ${SITE_TITLE} | Step-by-Step Image Conversion Guides`} description="Learn image conversion with our step-by-step tutorials. Master batch conversion, file formats, and optimization techniques." />
  </head>
  <body class="bg-white">
    <Header />
    <main class="relative z-10 px-6 pt-32 pb-16">
      <div class="max-w-3xl mx-auto">
        <!-- Blog Header -->
        <div class="mb-12">
          <h1
            class="text-4xl md:text-5xl font-bold text-slate-900 mb-4 leading-tight"
          >
            Tutorials
          </h1>
          <p class="text-lg text-slate-600">
            Step-by-step tutorials to help you master image conversion and optimization.
          </p>
        </div>

        <!-- Category Navigation -->
        <BlogNavigation currentCategory="Tutorial" />

        <!-- Blog Posts Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {
            posts.map((post) => (
              <article class="group cursor-pointer bg-white rounded-none border-none p-0 m-0">
                <a
                  href={`/blog/${post.id}`}
                  class="block bg-white rounded-none border-none p-0 m-0"
                >
                  {post.data.heroImage ? (
                    <div class="relative aspect-video overflow-hidden mb-4 rounded-md bg-slate-200">
                      <Image
                        src={post.data.heroImage}
                        alt={post.data.title}
                        width={400}
                        height={225}
                        class="w-full h-full object-cover"
                      />
                    </div>
                  ) : (
                    <div class="relative aspect-video overflow-hidden mb-4 rounded-md bg-slate-200" />
                  )}
                  <div class="flex items-center gap-3 mb-2 text-sm">
                    <span class="text-purple-600">Tutorial</span>
                    <span class="text-slate-300">•</span>
                    <time
                      class="text-slate-500"
                      datetime={post.data.pubDate.toISOString()}
                    >
                      <FormattedDate date={post.data.pubDate} />
                    </time>
                  </div>
                  <h3 class="text-xl font-bold text-slate-900 group-hover:text-[#1B5BFF] transition-colors mb-2 leading-snug">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <p class="text-slate-600 text-sm leading-relaxed">
                      {post.data.description}
                    </p>
                  )}
                </a>
              </article>
            ))
          }
        </div>

        {
          posts.length === 0 && (
            <div class="text-center py-16">
              <p class="text-slate-600 text-lg">No tutorial posts found.</p>
            </div>
          )
        }
      </div>
    </main>
    <Footer />
  </body>
</html>