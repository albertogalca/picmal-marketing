---
import ArtCard from "../components/pm/ArtCard.astro";
import { postArt } from "../data/cardArt";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import ArticleSchema from "../components/schema/ArticleSchema.astro";
import BlogFAQSchema from "../components/schema/BlogFAQSchema.astro";
import BlogItemListSchema from "../components/schema/BlogItemListSchema.astro";
import CTASection from "../components/CTASection.astro";
import H1 from "../components/H1.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import RelatedConversions from "../components/RelatedConversions.astro";
import { DEFAULT_TIER } from "../config/pricing";
import { displayCategory } from "../utils/posts";
import TableOfContents from "../components/TableOfContents.astro";
import { existsSync } from "node:fs";
import { join } from "node:path";

type Props = CollectionEntry<"blog">["data"] & {
  category?: string;
  slug?: string;
  tags?: string[];
  faqs?: { question: string; answer: string }[];
  itemList?: {
    name: string;
    description?: string;
    url?: string;
    price?: string;
    operatingSystem?: string;
  }[];
  headings?: MarkdownHeading[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category,
  slug,
  tags,
  faqs,
  itemList,
  headings = [],
} = Astro.props;

const categoryLabel = displayCategory(category);
// Redesign: the post's pixel card sits under the header, like a cover. The
// short-label card.png (scripts/generate-blog-covers.js --cards) when there is
// one, with its dark twin.
const cardPath = (name: string) =>
  slug && existsSync(join(process.cwd(), "public", `images/blog/${slug}/${name}`))
    ? `/images/blog/${slug}/${name}`
    : undefined;
const coverCard = cardPath("card.png");
const coverCardDark = cardPath("card-dark.png");
// Redesign: the cover is the design system's ArtCard, drawn live.
const heroArt = slug ? postArt(slug, category) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${title} | Picmal`}
      description={description}
      image={heroImage}
      ogType="article"
      publishedTime={pubDate.toISOString()}
      modifiedTime={updatedDate ? updatedDate.toISOString() : pubDate.toISOString()}
    />
    {
      slug && (
        <ArticleSchema
          post={{
            title,
            description,
            pubDate,
            updatedDate,
            heroImage,
            category,
          }}
          url={Astro.site!.href}
          slug={slug}
        />
      )
    }
    {faqs && faqs.length > 0 && <BlogFAQSchema faqs={faqs} />}
    {
      itemList && itemList.length > 0 && (
        <BlogItemListSchema name={title} items={itemList} />
      )
    }
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <!-- Article -->
    <article class="relative z-10 px-6 pt-32 pb-20">
      {/* Redesign: the article sits on the page column's left edge, with the
          section map in the space to its right. */}
      <div class="max-w-5xl mx-auto"><div class="max-w-[680px]">
        <!-- Breadcrumb -->
        <div class="article-breadcrumb">
          <Breadcrumb
            items={[
              { label: "Home", href: "/" },
              { label: "Blog", href: "/blog" },
              { label: title },
            ]}
          />
        </div>

        <!-- Header -->
        <header class="mb-10 article-header">
          <!-- The pill separates itself by shape, so only the text items
               need a dot between them. -->
          <div
            class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-8 text-small text-text-secondary"
          >
            {
              categoryLabel && (
                <span class="mr-1 text-accent font-medium">
                  {categoryLabel}
                </span>
              )
            }
            <a
              href="https://albertogalca.com/"
              rel="author"
              class="transition-colors hover:text-text"
              >By Alberto Gallego</a
            >
            <span aria-hidden="true">·</span>
            <time datetime={pubDate.toISOString()}>
              <FormattedDate date={pubDate} />
            </time>
            {
              updatedDate && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>
                    Updated <FormattedDate date={updatedDate} />
                  </span>
                </>
              )
            }
          </div>

          <H1 id="article-title" class="mb-4">
            {title}
          </H1>

          <!-- The post answers the question for free, so the buy line stays one
               quiet sentence. Until Aug 2026 the only CTA sat at 84% scroll
               depth, well past where a 30-second visit ever gets.
               Wording has to hold for all 44 posts, how-tos and comparisons
               alike, so it names no steps the post might not have. -->
          <p class="mt-6 text-small text-text-secondary">
            {"Picmal does this on your Mac: drag, click, done. "}
            <a
              href={DEFAULT_TIER.checkoutUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="link"
              onclick={import.meta.env.PROD
                ? `window.seline?.track('buy_clicked_blog_top_${slug || "post"}', { macs: ${DEFAULT_TIER.macs}, source: 'blog_top' })`
                : undefined}
            >
              {`Get Picmal for $${DEFAULT_TIER.price}`}
            </a>
          </p>
        </header>

        {heroArt ? (
          <div class="mb-12" aria-hidden="true">
            <ArtCard title={heroArt.title} texture={heroArt.texture} ground={heroArt.ground} seed={heroArt.seed} />
          </div>
        ) : coverCard && (
          <div class="mb-12 aspect-video overflow-hidden rounded-xl ring-1 ring-border" aria-hidden="true">
            <img src={coverCard} alt="" width="1600" height="900" class:list={["h-full w-full object-cover", coverCardDark && "dark:hidden"]} />
            {coverCardDark && <img src={coverCardDark} alt="" width="1600" height="900" class="hidden h-full w-full object-cover dark:block" />}
          </div>
        )}
        <!-- Content, with the section map beside it on wide screens -->
        <div class="relative">
        <TableOfContents headings={headings} />
        <div
          class="prose max-w-none article-content
              prose-headings:text-text prose-headings:font-semibold
              prose-p:text-text prose-p:leading-relaxed prose-p:text-[17px] prose-li:text-[17px]
              prose-strong:text-text
              prose-th:text-text
              prose-td:text-text
              prose-ul:text-text
              prose-ol:text-text
              prose-li:text-text
              prose-img:rounded-xl"
          role="main"
          aria-labelledby="article-title"
        >
          <slot />
        </div>
        </div>

        <!-- Closing CTA. The tag-matched converter links sit inside it, so
             the end of a post pitches once instead of three times. -->
        <div class="mt-16 article-cta">
          <CTASection
            heading="Drag the files in. Get them back converted."
            analyticsEvent={`buy_clicked_blog_${slug || "post"}`}
            class="p-0"
          >
            <RelatedConversions tags={tags} />
          </CTASection>
        </div>

        <!-- Related Posts -->
        <div class="article-related">
          {
            slug && (
              <RelatedPosts
                currentSlug={slug}
                category={category}
                tags={tags}
                limit={2}
              />
            )
          }
        </div>
      </div></div>
    </article>

    <Footer />
  </body>
</html>
