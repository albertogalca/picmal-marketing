<!-- ponytail: sr-only backlink holder, not social proof. It used to be a
     visible logo marquee; the leftover w-full + w-max track beat sr-only's
     width:1px and pushed the document ~300px wider than the viewport. Anchor
     text carries the link now, no images and no animation. -->
<ul class="sr-only">
  {
    logos.map((logo) => (
      <li>
        <a href={logo.href} target="_blank" rel="noopener">
          {logo.alt || logo.name}
        </a>
      </li>
    ))
  }
</ul>
