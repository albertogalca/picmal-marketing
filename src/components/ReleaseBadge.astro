---
import { getCollection } from "astro:content";
import { getEntrySlug } from "../utils/changelog";
import { cn } from "../utils/cn";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const changelogEntries = await getCollection("changelog");
const latestRelease = changelogEntries.sort((a, b) =>
  b.data.version.localeCompare(a.data.version, undefined, {
    numeric: true,
    sensitivity: "base",
  }),
)[0];
const latestReleaseHref = `/changelog#${getEntrySlug(latestRelease)}`;
---

<a
  href={latestReleaseHref}
  class={cn(
    "group relative inline-flex items-center gap-2 whitespace-nowrap rounded-xl border border-border bg-background-subtle py-1.5 pl-3 pr-3.5 text-small text-text-secondary",
    "transition-[color,border-color,scale] duration-200 ease-out hover:text-text hover:border-border/60 active:scale-[0.97] motion-reduce:transition-none",
    "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
    // Extend the tap target to 44px without changing the compact pill height.
    "before:absolute before:inset-x-0 before:top-1/2 before:h-11 before:-translate-y-1/2 before:content-['']",
    className,
  )}
>
  <span class="w-1.5 h-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"
  ></span>
  <span
    >What's new in <span class="font-medium text-text"
      >v{latestRelease.data.version}</span
    ></span
  >
  <span
    class="shrink-0 transition-transform duration-200 ease-out motion-safe:group-hover:translate-x-0.5"
    aria-hidden="true">&rarr;</span
  >
</a>
