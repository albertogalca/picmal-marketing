---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import OrganizationSchema from "../../components/schema/OrganizationSchema.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import Paragraph from "../../components/Paragraph.astro";
import SectionDivider from "../../components/SectionDivider.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeaturedOn from "../../components/FeaturedOn.astro";
import BentoFeatures from "../../components/BentoFeatures.astro";
import PricingSection from "../../components/PricingSection.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";

const SITE_TITLE = "Picmal: The Native Mac HandBrake Alternative";
const SITE_DESCRIPTION =
  "Looking for a HandBrake alternative on Mac? Picmal is an all-in-one media toolkit—convert, compress, and edit images, video, audio, and PDFs—with a native macOS interface. Shortcuts integration, folder monitoring. $15.99 one-time.";

const faqs = [
  {
    question: "Is Picmal a good HandBrake alternative?",
    answer:
      "For Mac users who also work with images, audio, and PDFs — yes. Picmal has a polished native interface, Shortcuts integration, and covers more file types. HandBrake is a better fit if you need advanced video encoding controls and don't want to pay for an app.",
  },
  {
    question: "Why pay for Picmal when HandBrake is free?",
    answer:
      "HandBrake is great for video encoding and costs nothing. Picmal adds image conversion, audio, PDF tools, folder monitoring, and Finder right-click — and feels like a native Mac app. If video encoding is all you need, HandBrake is genuinely a fine choice.",
  },
  {
    question: "Can Picmal convert images? Can HandBrake?",
    answer:
      "Picmal converts 20+ image formats (HEIC, JPG, PNG, WebP, etc.) and decodes RAW files. HandBrake is video-only — images aren't on its radar.",
  },
  {
    question: "Does HandBrake have more video options than Picmal?",
    answer:
      "Yes — device presets, CRF tuning, DVD/BluRay ripping, subtitle tracks, HDR. HandBrake goes deep on video. Picmal picks good defaults so you don't have to think about codecs, and covers images, audio, and PDFs alongside video.",
  },
  {
    question: "Does Picmal work on Windows or Linux like HandBrake?",
    answer:
      "No. Picmal is Mac-only. HandBrake runs on Windows and Linux too.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Email support@picmal.app.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <ComparisonHero
      title="The native Mac HandBrake alternative"
      subhead="HandBrake is powerful and free. If you also work with images, audio, and PDFs — and want something that feels like a proper Mac app — Picmal covers all of it for $15.99."
      buyEvent="buy_clicked_handbrake_comparison"
    />

    <ComparisonVerdict
      competitor="HandBrake"
      summary="HandBrake is free, open-source, and runs on Windows/Linux/Mac with serious encoding controls. Picmal ($15.99 one-time) is Mac-only, covers images, audio, and PDFs alongside video, and feels like it belongs on your Mac. Neither uploads your files."
      picmalFor="You're on Mac and need images, audio, or PDFs alongside video — or just want an app with a native feel and Shortcuts integration."
      competitorFor="You need CRF tuning, device presets, DVD/Blu-ray ripping, or cross-platform (Windows/Linux) support — and free is important."
    />

    <SectionDivider />

    <!-- Comparison Table -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-4 text-center">Picmal vs HandBrake at a glance</H2>
        <Paragraph class="mb-8 text-center max-w-2xl mx-auto">
          HandBrake is a free video encoder with serious encoding controls.
          Picmal is a paid Mac app that covers images, audio, and PDFs alongside
          video, with a simpler interface. Different tradeoffs.
        </Paragraph>

        <div
          class="bg-background-subtle/50 border border-border rounded-2xl p-4 md:p-8"
        >
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left p-4 font-semibold text-text">Feature</th>
                  <th class="text-left p-4 font-semibold text-text">Picmal</th>
                  <th class="text-left p-4 font-semibold text-text"
                    >HandBrake</th
                  >
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr>
                  <td class="p-4 text-text-secondary">Price</td>
                  <td class="p-4 text-text">$15.99 one-time</td>
                  <td class="p-4 text-text">Free (open source)</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Platforms</td>
                  <td class="p-4 text-text">macOS only</td>
                  <td class="p-4 text-text">Windows, Mac, Linux</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Privacy</td>
                  <td class="p-4 text-text">100% offline</td>
                  <td class="p-4 text-text">100% offline</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Interface</td>
                  <td class="p-4 text-text">Native macOS, polished UI</td>
                  <td class="p-4 text-text">Cross-platform, functional</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Image conversion</td>
                  <td class="p-4 text-text">Yes—20+ formats</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video conversion</td>
                  <td class="p-4 text-text">Yes—common formats</td>
                  <td class="p-4 text-text">Yes—advanced encoding options</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Audio conversion</td>
                  <td class="p-4 text-text">Yes—MP3, WAV, FLAC, etc.</td>
                  <td class="p-4 text-text">Audio within video only</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Compression</td>
                  <td class="p-4 text-text">Images, video, audio &amp; PDF</td>
                  <td class="p-4 text-text">Video encoding only</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">PDF tools</td>
                  <td class="p-4 text-text"
                    >Yes—compress, combine, images&rarr;PDF</td
                  >
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">DVD/BluRay ripping</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text">Yes (unprotected)</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Device presets</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text">Yes—Apple, Android, web, etc.</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video filters</td>
                  <td class="p-4 text-text">Basic</td>
                  <td class="p-4 text-text"
                    >Advanced (deinterlace, denoise, HDR)</td
                  >
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Subtitle support</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text">Yes—SRT, SSA, VobSub, CEA-608</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Metadata removal</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">Limited</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Shortcuts integration</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Folder monitoring</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Finder right-click</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Who Picmal Is For / Who Should Stick with HandBrake -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-4">Which one is right for you?</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Here's where each one makes more sense.
          </Paragraph>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Picmal Column -->
          <div
            class="bg-background-subtle border border-border rounded-2xl p-6 md:p-8"
          >
            <div class="mb-6">
              <h3 class="text-h3 text-text mb-2">
                Choose Picmal
              </h3>
              <p class="text-text-secondary">
                Mac-native, images + audio + PDFs + video in one place
              </p>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want to convert, compress, and edit images, video, audio,
                  and PDFs in one app
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You use Apple Shortcuts for automation
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You care about a well-designed UI that feels like Mac
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want folder monitoring and Finder integration
                </span>
              </li>
            </ul>
          </div>

          <!-- HandBrake Column -->
          <div
            class="bg-background-subtle border border-border rounded-2xl p-6 md:p-8"
          >
            <div class="mb-6">
              <h3 class="text-h3 text-text mb-2">
                Choose HandBrake
              </h3>
              <p class="text-text-secondary">
                Free, powerful video encoding, cross-platform
              </p>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You only need video transcoding and encoding
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text"> You use Windows or Linux </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You don't want to pay for an app
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need DVD/BluRay ripping or subtitle support
                </span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- BentoFeatures -->
    <BentoFeatures />

    <SectionDivider />

    <!-- Testimonials Section -->
    <MasonryTestimonials />

    <section
      id="featured"
      class="absolute w-px h-px overflow-hidden -m-px p-0 border-0"
      style="clip:rect(0 0 0 0); clip-path:inset(50%)"
      aria-hidden="true"
    >
      <FeaturedOn />
    </section>

    <SectionDivider />

    <!-- Pricing -->
    <section id="pricing" class="relative z-10 px-6 py-20">
      <PricingSection />
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-6">Frequently asked questions</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Can't find what you're looking for? Email support@picmal.app
          </Paragraph>
        </div>
        <div
          class="bg-background-subtle/50 border border-border rounded-2xl p-4 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />

    <SupportedFormatsModal />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "cantimplorastudio" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
