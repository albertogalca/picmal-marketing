---
import { Icon } from "astro-icon/components";
import MarketingLayout from "../../../layouts/MarketingLayout.astro";
import BlockGrid from "../../../components/BlockGrid.astro";
import ComparisonHero from "../../../components/ComparisonHero.astro";
import ProductSchema from "../../../components/schema/ProductSchema.astro";
import Section from "../../../components/Section.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import Paragraph from "../../../components/Paragraph.astro";
import ConversionGrid from "../../../components/ConversionGrid.astro";
import FAQSection from "../../../components/FAQSection.astro";
import FAQSchema from "../../../components/schema/FAQSchema.astro";

import {
  audioConversions,
  audioFormats,
  getRelatedAudioConversions,
  isAudioConversionIndexed,
} from "../../../data/audioConversions";

export function getStaticPaths() {
  return audioConversions.map((c) => ({
    params: { slug: c.slug },
    props: { conversion: c },
  }));
}

const { conversion } = Astro.props;

// Blog post cross-links for audio conversion pages
const blogGuides: Record<string, { title: string; slug: string }> = {
  "flac-to-alac": {
    title: "How to Convert FLAC to ALAC on Mac (4 Free Methods)",
    slug: "convert-flac-to-alac-mac",
  },
  "wav-to-mp3": {
    title: "How to Convert WAV to MP3 on Mac (3 Free Methods)",
    slug: "convert-wav-to-mp3-mac",
  },
};
const blogGuide = blogGuides[conversion.slug];
const from = audioFormats[conversion.from];
const to = audioFormats[conversion.to];
const related = getRelatedAudioConversions(conversion.slug, 6);

// The hero says what the page does and that it happens on the Mac. The longer
// "why" paragraph used to be the hero subhead; it now opens the first section.
const heroLine =
  conversion.heroLine ??
  `Convert ${from.name} to ${to.name} on your Mac, one file or a whole folder. Nothing gets uploaded.`;

const title = conversion.metaTitle;
const description = conversion.metaDescription;

// Low-demand templated pairs are de-indexed to concentrate site quality on winners.
const noindex = !isAudioConversionIndexed(conversion.slug);
---

<MarketingLayout
  title={title}
  description={description}
  noindex={noindex}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema faqs={conversion.faqs} />
  </Fragment>

  <ComparisonHero
    pricingHref="/#pricing"
    title={`Convert ${from.name} to ${to.name} on Mac`}
    subhead={heroLine}
    buyEvent={`buy_clicked_audio_${conversion.slug}`}
    defaultTab="convert"
    art={{ title: `${from.name} → ${to.name}`, texture: "wave", ground: "night" }}
    demo={false}
  />

  {/* Same structure as the image convert pages: every section on the hero's
      left edge, headings on that edge too. */}

  <!-- Why -->
  <Section width="wide">
    <SectionHeading align="left" class="mb-8">
      Why convert {from.name} to {to.name}?
    </SectionHeading>
    <Paragraph size="lead" class="max-w-[65ch] mb-10">
      {conversion.whyConvert}
    </Paragraph>
    <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3 max-w-4xl">
      {
        conversion.benefits.map((benefit) => (
          <li class="flex items-start gap-3">
            <Icon
              name="ph:check"
              class="w-5 h-5 text-text-secondary shrink-0 mt-0.5"
              aria-hidden="true"
            />
            <span class="text-text-secondary text-pretty">{benefit}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- How it works -->
  <Section width="wide">
    <SectionHeading align="left" class="mb-8">Convert in 3 steps</SectionHeading>
    <BlockGrid
      ordered
      items={[
        {
          title: `Drop your ${from.name} files`,
          description: "Drag and drop one file or a whole folder.",
        },
        {
          title: `Choose ${to.name}`,
          description: "Pick the output format and quality.",
        },
        {
          title: "Convert",
          description: "Click Convert. Everything runs on your Mac.",
        },
      ]}
    />
  </Section>

  <!-- FAQ -->
  <FAQSection faqs={conversion.faqs} align="left" />

  <!-- Related, with the long guide folded in as one line instead of its own
       boxed section. -->
  <Section width="wide">
    <SectionHeading align="left" class="mb-8">More audio conversions</SectionHeading>
    {
      blogGuide && (
        <Paragraph class="mb-6 max-w-[65ch]">
          Want the free methods too? Read{" "}
          <a href={`/blog/${blogGuide.slug}`} class="link">
            {blogGuide.title}
          </a>.
        </Paragraph>
      )
    }
    <ConversionGrid
      links={related.map((c) => ({
        href: `/convert/audio/${c.slug}`,
        label: `${audioFormats[c.from].name} to ${audioFormats[c.to].name}`,
      }))}
      linkText="All audio conversions"
      linkHref="/audio-converter-mac"
      linkAlign="left"
    />
  </Section>

</MarketingLayout>
