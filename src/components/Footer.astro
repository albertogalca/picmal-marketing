                About the author
              </a>
            </li>
          </ul>
        </div>

        <!-- Legal -->
        <div>
          <H3 class="mb-4">Legal</H3>
          <ul class="space-y-2">
            <li>
              <a
                href="/terms"
                class="text-sm transition-colors text-text-secondary hover:text-text cursor-pointer"
              >
                Terms of Use
              </a>
            </li>
            <li>
              <a
