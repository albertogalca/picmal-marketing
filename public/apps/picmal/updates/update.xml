        <item>
            <title>1.1.3</title>
            <pubDate>Sat, 11 Oct 2025 07:58:34 +0200</pubDate>
            <link>https://picmal.app/</link>
            <description><![CDATA[
                <h3>🔐 License Activation Required</h3>
                <p><strong>To use Picmal from this version onward, you'll need to activate your license within the app.</strong></p>

                <h4>How to get your license key:</h4>
                <ol>
                    <li>Go to <a href="https://app.lemonsqueezy.com/my-orders">app.lemonsqueezy.com/my-orders</a></li>
                    <li>Enter your email address</li>
                    <li>Check your email for a link to access your order</li>
                    <li>Copy your license key from the order page</li>
                </ol>

                <h4>How to activate:</h4>
                <ol>
                    <li>Open Picmal</li>
                    <li>Go to <strong>Picmal → Register License…</strong></li>
                    <li>Enter your license key</li>
                </ol>

                <p><em>Thank you for supporting Picmal!</em></p>
            ]]></description>
            <sparkle:version>22</sparkle:version>
            <sparkle:shortVersionString>1.1.3</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
