---
interface Props {
  url: string;
}

const { url } = Astro.props;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Picmal",
  url: url,
  logo: new URL("/logo.webp", url).href,
  sameAs: ["https://albertogalca.com/", "https://github.com/albertogalca"],
  description:
    "All-in-one media tool for Mac. Batch convert, compress, and create images, videos, audio, and PDF files offline on your Mac.",
  founder: {
    "@type": "Person",
    name: "Alberto Gallego",
    url: "https://albertogalca.com/",
  },
  // Legal entity, registered address and support inbox. Same details already
  // published on /terms, /privacy and /contact: this is the machine-readable
  // copy so an agent can verify the business without parsing a legal page.
  legalName: "Cantimplora Studio, LLC",
  email: "support@picmal.app",
  address: {
    "@type": "PostalAddress",
    streetAddress: "30 N Gould St Ste R",
    addressLocality: "Sheridan",
    addressRegion: "WY",
    postalCode: "82801",
    addressCountry: "US",
  },
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "customer support",
      email: "support@picmal.app",
      url: new URL("/contact", url).href,
      availableLanguage: ["English", "Spanish"],
    },
    {
      "@type": "ContactPoint",
      contactType: "sales",
      email: "support@picmal.app",
      url: new URL("/contact", url).href,
      availableLanguage: ["English", "Spanish"],
    },
  ],
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(organizationSchema)}
/>
