---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Paragraph from "../components/Paragraph.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import SectionDivider from "../components/SectionDivider.astro";
import PricingSection from "../components/PricingSection.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import ComparisonHero from "../components/ComparisonHero.astro";
import CardGrid from "../components/CardGrid.astro";

const title =
  "Batch Image Converter for Mac — Convert Hundreds at Once | Picmal";
const description =
  "Batch convert images on your Mac. Drop hundreds of files or entire folders — HEIC, JPG, PNG, WebP, AVIF, TIFF, and more. Offline. $15.99 one-time.";

const faqs = [
  {
    question: "How many images can I batch convert at once?",
    answer:
      "There's no limit. Picmal handles hundreds or thousands of files at once. Drag and drop entire folders and Picmal converts everything inside.",
  },
  {
    question: "Can I convert mixed formats in one batch?",
    answer:
      "Yes. Drop a mix of HEIC, JPG, PNG, and other formats — Picmal detects each file's format and converts them all to your chosen output format.",
  },
  {
    question: "How fast is batch conversion?",
    answer:
      "Picmal uses your Mac's hardware acceleration for fast processing. A typical batch of 100 photos converts in seconds on Apple Silicon Macs.",
  },
  {
    question: "Can I drop entire folders?",
    answer:
      "Yes. Drag and drop folders directly into Picmal. It processes all supported files inside, including nested subfolders.",
  },
  {
    question: "Does batch conversion affect quality?",
    answer:
      "No. Each file is converted with the same quality settings you choose. You can adjust the quality slider before starting the batch.",
  },
  {
    question: "Can I also batch compress without converting?",
    answer:
      "Yes. Select compression mode to reduce file sizes while keeping the original format. Works with JPG, PNG, WebP, and more.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

        <ComparisonHero
      title="Batch convert hundreds of images on your Mac"
      subhead="Drop entire folders into Picmal and convert everything at once. HEIC, JPG, PNG, WebP, AVIF, TIFF — all formats supported. Offline, no subscription."
      buyEvent="buy_clicked_batch_converter_mac"
      defaultTab="convert"
    >
      <Breadcrumb
        slot="breadcrumb"
        items={[{ label: "Home", href: "/" }, { label: "Batch Image Converter for Mac" }]}
      />
    </ComparisonHero>

    <SectionDivider />

    <!-- How Batch Works -->
    <CardGrid
      heading="How batch conversion works"
      numbered
      items={[
        {
          title: "Drop files or folders",
          description:
            "Drag and drop any number of files or entire folders into Picmal.",
        },
        {
          title: "Choose output format",
          description:
            "Select your target format and adjust quality settings if needed.",
        },
        {
          title: "Convert everything",
          description:
            "Click Convert and watch individual progress for each file.",
        },
      ]}
    />

    <SectionDivider />

    <!-- Key Features for Batch -->
    <CardGrid
      heading="Built for batch processing"
      items={[
        {
          title: "Folder drop support",
          description:
            "Drop entire folders — Picmal finds and converts all supported files inside, including nested subfolders.",
        },
        {
          title: "Individual progress",
          description:
            "Track conversion progress for each file individually. See which files are done and which are still processing.",
        },
        {
          title: "Mixed format input",
          description:
            "Drop a mix of HEIC, JPG, PNG, and other formats. Picmal detects each file type and converts them all.",
        },
        {
          title: "Watched folders",
          description:
            "Set up folders that automatically convert any new files added to them. Perfect for automated workflows.",
        },
      ]}
    />

    <SectionDivider />
    <MasonryTestimonials />
    <SectionDivider />

    <section
      id="pricing"
      class="relative z-10 px-6 py-16 sm:py-20 bg-background-subtle/50 border-y border-border"
    >
      <PricingSection />
    </section>

    <section id="faq" class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-8 text-center">Frequently Asked Questions</H2>
        <div
          class="bg-background-subtle/50 border border-border rounded-2xl p-6 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />
    <SupportedFormatsModal />

  </body>
</html>
