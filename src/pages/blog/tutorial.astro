---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import BlogNavigation from "../../components/BlogNavigation.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE } from "../../consts";
import "../../styles/global.css";
import H1 from "../../components/H1.astro";
import Paragraph from "../../components/Paragraph.astro";

const posts = (await getCollection("blog"))
  .filter((post) => post.data.category === "Tutorial")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Tutorials - ${SITE_TITLE} | Step-by-Step Image Conversion Guides`}
      description="Learn image conversion with our step-by-step tutorials. Master batch conversion, file formats, and optimization techniques."
    />
  </head>
  <body class="bg-background overflow-x-hidden">
    <Header />

    <!-- Hero with gradient -->
    <main class="relative z-10 pt-32 pb-20">

      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-16">
          <H1 class="mb-4">Tutorials</H1>
          <Paragraph class="max-w-2xl mx-auto">
            Step-by-step tutorials to help you master image conversion and
            optimization.
          </Paragraph>
        </div>

        <!-- Category Navigation -->
        <div class="mb-16">
          <BlogNavigation currentCategory="Tutorial" />
        </div>

        <!-- Blog Posts Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            posts.map((post) => (
              <article class="group h-full">
                <a
                  href={`/blog/${post.id}`}
                  class="flex flex-col h-full bg-background-subtle rounded-xl border border-border overflow-hidden hover:border-accent/30 focus-visible:border-accent focus-visible:outline-none active:scale-[0.99] motion-reduce:active:scale-100 transition-[colors,scale] duration-200"
                >
                  <div class="relative aspect-video overflow-hidden bg-background">
                    <Image
                      src={post.data.heroImage || "/images/blog/default.png"}
                      alt={post.data.title}
                      width={400}
                      height={225}
                      class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:group-hover:scale-100"
                    />
                  </div>
                  <div class="p-4 flex flex-col flex-1">
                    <div class="flex items-center gap-2 mb-3 text-small text-text-secondary">
                      <span class="px-2 py-1 bg-accent/10 text-accent rounded-xl font-medium">
                        Tutorial
                      </span>
                      <span>•</span>
                      <time datetime={post.data.pubDate.toISOString()}>
                        <FormattedDate date={post.data.pubDate} />
                      </time>
                    </div>
                    <h2 class="text-body font-semibold text-text text-balance group-hover:text-accent transition-colors duration-200 mb-2 leading-snug">
                      {post.data.title}
                    </h2>
                    {post.data.description && (
                      <p class="text-small text-text-secondary leading-relaxed line-clamp-3">
                        {post.data.description}
                      </p>
                    )}
                  </div>
                </a>
              </article>
            ))
          }
        </div>

        {
          posts.length === 0 && (
            <div class="text-center py-16">
              <Paragraph>No tutorial posts found.</Paragraph>
            </div>
          )
        }
      </div>
    </main>

    <Footer />
  </body>
</html>
