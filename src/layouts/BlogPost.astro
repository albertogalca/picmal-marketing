---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import ArticleSchema from "../components/schema/ArticleSchema.astro";

type Props = CollectionEntry<"blog">["data"] & { category?: string; slug?: string };

const { title, description, pubDate, updatedDate, heroImage, category, slug } =
  Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    {slug && (
      <ArticleSchema
        post={{ title, description, pubDate, updatedDate, heroImage, category }}
        url={Astro.site!.href}
        slug={slug}
      />
    )}
    <script>
      // Theme management
      const savedTheme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)"
      ).matches;

      if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-white text-slate-900"
  >
    <Header />

    <!-- Back to Blog Link -->
    <div class="relative z-10 px-6 pt-32 pb-6">
      <div class="max-w-3xl mx-auto">
        <a
          href="/blog"
          class="inline-flex items-center text-sm transition-colors cursor-pointer text-slate-500 hover:text-slate-900"
        >
          ← Back to blog
        </a>
      </div>
    </div>

    <!-- Article -->
    <article class="relative z-10 px-6 pb-20">
      <div class="max-w-3xl mx-auto">
        <!-- Header -->
        <header class="mb-8">
          <div class="flex items-center gap-3 mb-3 text-sm">
            {
              category && (
                <>
                  <span
                    class={
                      category === "Changelog"
                        ? "text-[#1B5BFF]"
                        : category === "Guide"
                          ? "text-emerald-600"
                          : category === "Tutorial"
                            ? "text-purple-600"
                            : "text-slate-600"
                    }
                  >
                    {category}
                  </span>
                  <span class="text-slate-500">•</span>
                </>
              )
            }
            <time datetime={pubDate.toISOString()} class="text-slate-500">
              <FormattedDate date={pubDate} />
            </time>
            {
              updatedDate && (
                <>
                  <span class="text-slate-500">•</span>
                  <span class="text-slate-500 italic">
                    Updated <FormattedDate date={updatedDate} />
                  </span>
                </>
              )
            }
          </div>

          <h1
            id="article-title"
            class="text-4xl md:text-5xl font-bold mb-4 leading-tight text-slate-900"
          >
            {title}
          </h1>

          {
            description && (
              <p class="text-lg leading-relaxed text-slate-700">
                {description}
              </p>
            )
          }
        </header>

        <!-- Content -->
        <div
          class="prose prose-lg max-w-none
                prose-headings:text-slate-900
                prose-p:text-slate-700
                prose-a:text-[#1B5BFF] hover:prose-a:text-[#1548CC]
                prose-strong:text-slate-900
                prose-code:text-[#1B5BFF] prose-code:bg-slate-100
                prose-pre:bg-slate-900
                prose-blockquote:border-l-[#1B5BFF] prose-blockquote:text-slate-600
                prose-th:text-slate-900
                prose-td:text-slate-700
                prose-img:rounded-lg prose-img:shadow-lg"
          role="main"
          aria-labelledby="article-title"
        >
          <slot />
        </div>

        <!-- Download CTA -->
        <div class="mt-12 pt-8 border-t border-slate-200">
          <div class="relative bg-black rounded-2xl p-6 sm:p-8 overflow-hidden">
            <!-- Picmal app interface - hidden on mobile -->
            <div class="absolute -bottom-30 -right-40 hidden lg:block">
              <Image
                src="/picmal-main.webp"
                alt="Picmal App Interface"
                width={480}
                height={360}
                class="w-120 h-auto rounded-tl-lg"
              />
            </div>

            <!-- Content -->
            <div class="relative z-10 max-w-full sm:max-w-md lg:max-w-xs">
              <h3
                class="text-xl sm:text-2xl font-bold text-white mb-3 leading-tight"
              >
                Use Picmal to easily convert images on your Mac
              </h3>
              <p class="text-slate-300 mb-6 text-base sm:text-lg">
                If you're not happy with your purchase, you can request a refund
                within 14 days.
              </p>
              <a
                href="https://albertogalca.gumroad.com/l/picmal"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block bg-[#1B5BFF] text-white px-6 sm:px-8 py-3 rounded-xl hover:bg-[#1548CC] transition-colors font-semibold text-base sm:text-lg cursor-pointer w-full sm:w-auto text-center"
              >
                Buy now
              </a>
            </div>
          </div>
        </div>
      </div>
    </article>

    <Footer />
  </body>
</html>
