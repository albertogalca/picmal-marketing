---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import H3 from "../components/H3.astro";
import Button from "../components/Button.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import Paragraph from "../components/Paragraph.astro";
import TrustBar from "../components/TrustBar.astro";
import SectionDivider from "../components/SectionDivider.astro";
import CTASection from "../components/CTASection.astro";
import BentoFeatures from "../components/BentoFeatures.astro";
import FeaturedOn from "../components/FeaturedOn.astro";

const SITE_TITLE =
  "HEIC Converter for Mac - Convert Apple HEIC Photos to JPG & PNG";
const SITE_DESCRIPTION =
  "Convert HEIC images from iPhone and iPad to JPG, PNG, or any format. Batch convert thousands of Apple Photos instantly. Native Mac app, works offline.";

const faqs = [
  {
    question: "What is HEIC format?",
    answer:
      "HEIC (High Efficiency Image Container) is Apple's default photo format on iPhone and iPad. It saves space compared to JPG but isn't compatible with all devices and software. That's why many people need to convert HEIC to JPG.",
  },
  {
    question: "Why do I need to convert HEIC files?",
    answer:
      "While HEIC is great for saving storage on Apple devices, it's not universally supported. You'll need to convert HEIC to JPG or PNG to share photos with Windows users, upload to websites, or use in applications that don't support HEIC.",
  },
  {
    question: "Can I convert all my iPhone photos at once?",
    answer:
      "Yes! Picmal excels at batch HEIC conversion. Just drag your entire photo library from iPhone or iCloud Photos, select your output format (JPG, PNG, WebP, etc.), and convert everything in seconds.",
  },
  {
    question: "Does converting HEIC to JPG reduce quality?",
    answer:
      "Picmal preserves maximum quality when converting HEIC to JPG. You can also choose compression levels if you need smaller file sizes for web use or email.",
  },
  {
    question: "Can I convert HEIC to other formats besides JPG?",
    answer:
      "Yes! Convert HEIC to JPG, PNG, WebP, AVIF, TIFF, BMP, or any other image format. Picmal supports 20+ formats with full batch processing.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <link
      rel="preload"
      href="/picmal-1.2.0-demo.mp4"
      as="video"
      type="video/mp4"
    />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text"
  >
    <Header />

    <!-- Hero Section -->
    <main
      id="main-content"
      class="relative z-10 pt-24 sm:pt-28 md:pt-32 pb-12 sm:pb-16 md:pb-20"
    >
      <div class="absolute inset-0 -z-10 overflow-hidden hero-gradient"></div>

      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-8 sm:mb-12">
          <div
            class="max-w-4xl mx-auto flex justify-center items-center flex-col"
          >
            <H1 class="mb-4 sm:mb-6 max-w-2xl mx-auto">
              Convert iPhone HEIC photos to JPG on Mac
            </H1>
            <p
              class="mb-8 sm:mb-10 max-w-2xl mx-auto text-base sm:text-lg md:text-xl leading-relaxed text-text-secondary px-4 sm:px-0"
            >
              The easiest way to convert Apple's HEIC format to JPG, PNG, or any
              format. Batch convert thousands of iPhone photos in seconds.
            </p>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col items-center gap-3 sm:gap-4">
            <div
              class="flex flex-col sm:flex-row gap-2 items-center justify-center"
            >
              <Button
                text="Get Picmal for $15.99"
                onclick="posthog.capture('buy_clicked_heic_converter_mac')"
              />
              <a
                href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg"
                class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-base py-3 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto"
              >
                <svg
                  class="w-4 h-4 inline-block mr-2"
                  fill="currentColor"
                  stroke="none"
                  viewBox="0 0 24 24"
                  ><path
                    d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8 4.35 4.35 0 0 1-2.59-4.03z"
                  ></path></svg
                >
                Download for Mac
              </a>
            </div>
            <p class="text-xs sm:text-sm text-text-secondary">
              One-time purchase • 14-day money back • macOS 12+
            </p>
          </div>

          <!-- Social Proof -->
          <div class="mt-6 sm:mt-8">
            <TrustBar />
          </div>
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-5xl mx-auto mb-6 sm:mb-8 rounded-lg sm:rounded-xl overflow-hidden border border-border"
        >
          <div style="aspect-ratio: 16/10;">
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover block dark:hidden"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal HEIC converter interface"
            >
            </video>
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover hidden dark:block"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal HEIC converter interface"
            >
            </video>
          </div>
        </div>
      </div>
    </main>

    <SectionDivider />

    <!-- Features Section -->
    <BentoFeatures />

    <SectionDivider />

    <!-- Additional Features Section -->
    <section class="relative z-10 px-6 py-20">
      <div class="max-w-6xl mx-auto">
        <H2 class="mb-4 text-center"
          >Why choose Picmal as your HEIC converter for Mac</H2
        >
        <Paragraph class="text-center mb-16 max-w-2xl mx-auto">
          Convert Apple HEIC photos instantly with the fastest native Mac app.
          No uploads, no internet required.
        </Paragraph>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Feature 1 -->
          <div class="bg-background-subtle rounded-xl p-8 border border-border">
            <H3 class="mb-4">Lightning-fast HEIC conversion</H3>
            <Paragraph class="mb-4">
              Convert HEIC to JPG in seconds, not minutes. Picmal uses your
              Mac's full processing power to handle thousands of iPhone photos
              at blazing speeds.
            </Paragraph>
            <ul class="space-y-2 text-text-secondary">
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>10-100x faster than online HEIC converters</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Convert entire iPhone photo libraries in minutes</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Parallel processing uses all CPU cores</span>
              </li>
            </ul>
          </div>

          <!-- Feature 2 -->
          <div class="bg-background-subtle rounded-xl p-8 border border-border">
            <H3 class="mb-4">Batch convert thousands of HEIC files</H3>
            <Paragraph class="mb-4">
              Import your entire iPhone photo library and convert all HEIC files
              at once. No file limits, no restrictions.
            </Paragraph>
            <ul class="space-y-2 text-text-secondary">
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Drag entire folders of HEIC images</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Right-click HEIC files in Finder to convert</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>No file size or quantity limits</span>
              </li>
            </ul>
          </div>

          <!-- Feature 3 -->
          <div class="bg-background-subtle rounded-xl p-8 border border-border">
            <H3 class="mb-4">100% offline and private</H3>
            <Paragraph class="mb-4">
              Unlike web-based HEIC converters, Picmal works completely offline.
              Your iPhone photos never leave your Mac, ensuring complete
              privacy.
            </Paragraph>
            <ul class="space-y-2 text-text-secondary">
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>No internet connection required</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Your personal photos stay on your Mac</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>No file uploads to third-party servers</span>
              </li>
            </ul>
          </div>

          <!-- Feature 4 -->
          <div class="bg-background-subtle rounded-xl p-8 border border-border">
            <H3 class="mb-4">Convert to any format</H3>
            <Paragraph class="mb-4">
              Don't just convert HEIC to JPG. Picmal supports conversion to PNG,
              WebP, AVIF, TIFF, and 20+ other formats with perfect quality.
            </Paragraph>
            <ul class="space-y-2 text-text-secondary">
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>HEIC to JPG for universal compatibility</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>HEIC to PNG for transparency support</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Modern formats: WebP, AVIF for web</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- Testimonials -->
    <MasonryTestimonials />

    <SectionDivider />

    <!-- Featured On Section -->
    <FeaturedOn />

    <SectionDivider />

    <!-- CTA Section -->
    <CTASection
      heading="Start converting HEIC photos on your Mac"
      analyticsEvent="buy_clicked_heic_converter_mac_bottom"
    />

    <SectionDivider />

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-6">HEIC conversion questions</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Everything you need to know about converting HEIC files on Mac.
          </Paragraph>
        </div>
        <div
          class="bg-background-subtle/50 border border-border rounded-lg p-4 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "picmal" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
