---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import PricingSection from "../components/PricingSection.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import { videoConversions, videoFormats } from "../data/videoConversions";
import ComparisonHero from "../components/ComparisonHero.astro";
import CardGrid from "../components/CardGrid.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ConversionGrid from "../components/ConversionGrid.astro";

const title = "Picmal: Video converter for Mac, MOV to MP4, MKV, AVI & more";
const description =
  "Convert video on your Mac: MOV, MKV, AVI, WebM, WMV, FLV and more to MP4. Compress with H.264 or H.265, batch process, burn in subtitles. Offline, no watermark, $19 one-time.";

const toMp4 = videoConversions.filter((c) => c.to === "mp4");
const other = videoConversions.filter((c) => c.to !== "mp4");

const faqs = [
  {
    question: "Which video formats can Picmal convert?",
    answer:
      "Picmal reads and writes MP4, MOV, AVI, MKV, WebM, M4V, MPG/MPEG, HEVC, FLV, WMV, 3GP, M2TS/MTS, VOB, TS and more, and can extract audio to MP3 or turn clips into GIFs. It uses H.264, H.265 (HEVC), VP9, and AV1.",
  },
  {
    question: "Can Picmal compress videos, not just convert them?",
    answer:
      "Yes. Picmal exposes a CRF quality slider, encoding-speed presets, codec choice, and frame-rate control, and shows an estimated output size before you encode, so you can shrink a video to a target size with predictable quality.",
  },
  {
    question: "Is there a file-size limit or watermark?",
    answer:
      "No. Unlike online converters, Picmal runs entirely on your Mac. No upload limits, no queues, no watermark on the output. Process files of any size, fully offline.",
  },
  {
    question: "Can I batch convert a folder of videos?",
    answer:
      "Yes. Drag in multiple videos or a whole folder and Picmal converts them all in one pass, each with its own progress.",
  },
  {
    question: "Can Picmal burn subtitles into a video?",
    answer:
      "Yes. Attach an SRT or VTT file and Picmal renders the subtitles directly into the frames, so they play on any device with no separate subtitle track.",
  },
  {
    question: "Do my videos leave my Mac?",
    answer:
      "No. All conversion and compression happens locally. Picmal works completely offline. Your videos never touch a server.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <ComparisonHero
      title="Convert video on your Mac, any format to MP4"
      subhead="MOV, MKV, AVI, WebM and more. Picmal converts to MP4 (H.264/H.265), compresses with a quality slider, and batch-processes whole folders. Offline, no watermark, no file-size limit."
      buyEvent="buy_clicked_video_converter_mac"
      defaultTab="convert"
    />

    <!-- Convert to MP4 -->
    <Section>
      <SectionHeading
        sublead="MP4 (H.264) plays on every device, browser, and editor. Pick your source format below."
      >
        Convert any video to MP4
      </SectionHeading>
      <ConversionGrid
        columns={4}
        links={toMp4.map((c) => ({
          href: `/convert/video/${c.slug}`,
          label: `${videoFormats[c.from].name} to MP4`,
        }))}
      />
    </Section>

    <!-- MP4, GIF & audio -->
    <Section>
      <SectionHeading
        sublead="Turn clips into shareable GIFs, extract audio, or re-encode for the web."
      >
        Convert to GIF, audio & web formats
      </SectionHeading>
      <ConversionGrid
        columns={3}
        links={other.map((c) => ({
          href: `/convert/video/${c.slug}`,
          label: `${videoFormats[c.from].name} to ${videoFormats[c.to].name}`,
        }))}
      />
    </Section>

    <!-- Why Picmal for video -->
    <CardGrid
      heading="More than a converter"
      items={[
        {
          title: "Real compression",
          description:
            "CRF quality slider, codec choice (H.264/H.265/VP9/AV1), and frame rate, with a size estimate before you encode.",
        },
        {
          title: "Subtitle burn-in",
          description:
            "Bake SRT or VTT subtitles straight into the frames so they play anywhere, with no separate track.",
        },
        {
          title: "No limits, no watermark",
          description:
            "Any file size, fully offline, no watermark. A one-time $19, not a subscription or an online upload.",
        },
      ]}
      linkText="Just need a smaller file? Compress video on Mac"
      linkHref="/compress-video-mac"
    />

    <MasonryTestimonials />

    <PricingSection />

    <Section id="faq" width="narrow">
      <SectionHeading
        sublead="Something not covered here? Write to support@picmal.app"
      >
        Frequently Asked Questions
      </SectionHeading>
      <Card>
        <FAQ faqs={faqs} />
      </Card>
    </Section>

    <Footer />
    <SupportedFormatsModal />
  </body>
</html>
