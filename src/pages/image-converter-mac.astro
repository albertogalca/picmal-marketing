---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Paragraph from "../components/Paragraph.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import PricingSection from "../components/PricingSection.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import ComparisonHero from "../components/ComparisonHero.astro";
import Section from "../components/Section.astro";
import RelatedGrid from "../components/RelatedGrid.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ConversionGrid from "../components/ConversionGrid.astro";
import FAQSection from "../components/FAQSection.astro";
import FAQSchema from "../components/schema/FAQSchema.astro";

const title = "Picmal: Image converter for Mac, convert any format";
const description =
  "Convert images between HEIC, JPG, PNG, WebP, AVIF, TIFF, GIF, and more on your Mac. Batch conversion, offline, no subscription. $29 one-time.";

const faqs = [
  {
    question: "What image formats does Picmal support?",
    answer:
      "Picmal supports 20+ image formats including HEIC, JPG, PNG, WebP, AVIF, TIFF, BMP, GIF, SVG, DNG, PSD, and more. It also converts video and audio files.",
  },
  {
    question: "Can I convert multiple images at once?",
    answer:
      "Yes. Picmal excels at batch conversion. Drag and drop hundreds of files or entire folders and convert them all at once, with individual progress tracking.",
  },
  {
    question: "Does Picmal work offline?",
    answer:
      "Yes. All processing happens locally on your Mac. Your files never leave your device. No internet connection required after installation.",
  },
  {
    question: "Is Picmal free?",
    answer:
      "Picmal is a one-time purchase of $29, no subscription. You can download the app to explore the interface. 14-day money-back guarantee.",
  },
  {
    question: "Does converting images lose quality?",
    answer:
      "It depends on the format. Converting to lossless formats like PNG or TIFF preserves full quality. For lossy formats like JPG or WebP, Picmal lets you adjust the quality slider.",
  },
  {
    question: "Can I also compress images?",
    answer:
      "Yes. Picmal can compress images in their current format without converting. Adjust the quality slider to reduce file size while keeping the original format.",
  },
];
---

<MarketingLayout
  title={title}
  description={description}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema faqs={faqs} />
  </Fragment>

  <ComparisonHero
    title="The image converter for Mac that just works"
    subhead="Convert between HEIC, JPG, PNG, WebP, AVIF, TIFF, and 20+ other formats. Batch processing, offline, no subscription."
    buyEvent="buy_clicked_image_converter_mac"
    defaultTab="convert"
  />

  <FeatureGrid
    heading="More than an image converter"
    subleadIntro="Convert, compress, and organize just about anything on your Mac."
  />

  <!-- Popular Conversions -->
  <Section>
    <SectionHeading sublead="Convert between any image format with a few clicks.">
      Popular conversions
    </SectionHeading>
    <ConversionGrid
      columns={4}
      links={[
        "heic-to-jpg",
        "heic-to-png",
        "heic-to-webp",
        "jpg-to-png",
        "jpg-to-webp",
        "png-to-webp",
        "webp-to-jpg",
        "avif-to-jpg",
        "tiff-to-jpg",
        "dng-to-jpg",
        "gif-to-png",
        "png-to-avif",
      ].map((slug) => ({
        href: `/convert/${slug}`,
        label: slug.replace("-to-", " to ").toUpperCase(),
      }))}
    />
    <div class="text-center mt-6 flex flex-col sm:flex-row gap-x-6 gap-y-2 items-center justify-center">
      <a href="/convert" class="link text-small"
        >View all conversions &rarr;</a
      >
      <a href="/raw-converter-mac" class="link text-small"
        >Convert camera RAW (CR2, NEF, ARW) &rarr;</a
      >
      <a href="/video-converter-mac" class="link text-small"
        >Convert video (MOV to MP4) &rarr;</a
      >
      <a href="/audio-converter-mac" class="link text-small"
        >Convert audio (FLAC, M4A to MP3) &rarr;</a
      >
    </div>
  </Section>

  <!-- Why a native app -->
  <Section width="narrow">
    <SectionHeading class="mb-8">Why not just use an online converter?</SectionHeading>
    <Paragraph class="mb-4"
      >You can drag a file onto a website and get it back in another format.
      For one or two files, that's fine. It stops being fine the moment you
      have a folder of them, or the file is something you'd rather not hand to
      a stranger's server.</Paragraph
    >
    <Paragraph class="mb-4"
      >Online converters upload your image, convert it somewhere you can't
      see, and hand it back, often with a size cap, a queue, a watermark, or
      an ad wall. Your photos sit on their machine for as long as they decide
      to keep them. Picmal does the whole thing on your Mac. Nothing uploads,
      nothing is queued, there's no file-size limit, and your files never
      leave the device.</Paragraph
    >
    <Paragraph
      >Drop in a few hundred HEIC photos from a trip and convert them to JPG in
      one pass, folder structure intact. And it's a one-time $29, not a
      subscription you forget to cancel.</Paragraph
    >
  </Section>

  <!-- Convert vs compress -->
  <Section width="narrow">
      <SectionHeading class="mb-8">Convert or compress?</SectionHeading>
      <Paragraph
        >Worth knowing the difference. <strong class="text-text"
          >Converting</strong
        > changes the format so a file opens where it didn't before. HEIC to JPG
        so Windows can read it, PNG to WebP to shave page weight. <strong
          class="text-text">Compressing</strong
        > keeps the format and just makes the file smaller.</Paragraph
      >
      <Paragraph
        >Picmal does both, and can do them at once. If your goal is purely a
        smaller file in the same format, start on the <a
          href="/compress"
          class="link">compress images page</a
        > instead.</Paragraph
      >
  </Section>

  <!-- Related guides -->
  <RelatedGrid
      heading="Related guides"
      links={[
        {
          href: "/blog/how-to-convert-heic-to-jpg-mac",
          label: "How to convert HEIC to JPG on Mac",
        },
        {
          href: "/blog/best-image-formats-for-web",
          label: "Best image formats for the web (and when to use each)",
        },
        {
          href: "/blog/batch-convert-images-mac",
          label: "How to batch convert HEIC photos on Mac",
        },
        {
          href: "/blog/convert-webp-to-jpg-mac",
          label: "How to convert WEBP to JPG on Mac",
        },
        {
          href: "/blog/convert-svg-to-png-mac",
          label: "How to convert SVG to PNG on Mac",
        },
      ]}
  />

  <MasonryTestimonials />

  <PricingSection />

  <FAQSection faqs={faqs} />

  <Fragment slot="after">
      <SupportedFormatsModal />
    </div>
  </Fragment>
</MarketingLayout>
