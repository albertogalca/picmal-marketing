---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import OrganizationSchema from "../../components/schema/OrganizationSchema.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import Button from "../../components/Button.astro";
import Paragraph from "../../components/Paragraph.astro";
import SectionDivider from "../../components/SectionDivider.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeaturedOn from "../../components/FeaturedOn.astro";
import BentoFeatures from "../../components/BentoFeatures.astro";
import TrustBar from "../../components/TrustBar.astro";
import PricingSection from "../../components/PricingSection.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonMeta from "../../components/ComparisonMeta.astro";

const SITE_TITLE = "Picmal: The Native Mac HandBrake Alternative";
const SITE_DESCRIPTION =
  "Looking for a HandBrake alternative on Mac? Picmal converts images, video, and audio with a native macOS interface. Shortcuts integration, folder monitoring. $15.99 one-time.";

const faqs = [
  {
    question: "Is Picmal a good HandBrake alternative?",
    answer:
      "If you want a native Mac app that handles images alongside video and audio, yes. Picmal offers a cleaner interface with Shortcuts integration. If you need free cross-platform video encoding with advanced options, HandBrake is hard to beat.",
  },
  {
    question: "Why pay for Picmal when HandBrake is free?",
    answer:
      "HandBrake is an excellent free tool for video encoding. Picmal adds image conversion, a native macOS interface, Shortcuts integration, folder monitoring, and Finder right-click actions. If you only need video encoding and don't mind the interface, HandBrake works great.",
  },
  {
    question: "Can Picmal convert images? Can HandBrake?",
    answer:
      "Picmal converts 20+ image formats (HEIC, JPG, PNG, WebP, etc.). HandBrake is video-only—it doesn't handle images at all.",
  },
  {
    question: "Does HandBrake have more video options than Picmal?",
    answer:
      "Yes. HandBrake offers advanced encoding controls, device presets, DVD/BluRay ripping, subtitle handling, and HDR support. Picmal focuses on simple conversions with sensible defaults.",
  },
  {
    question: "Does Picmal work on Windows or Linux like HandBrake?",
    answer:
      "No. Picmal is macOS-only with a native interface. HandBrake runs on Windows, Mac, and Linux.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Email support@picmal.app.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema />
    <link
      rel="preload"
      href="/picmal-1.2.0-demo.mp4"
      as="video"
      type="video/mp4"
    />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <!-- Hero Section -->
    <main id="main-content" class="relative z-10 pt-32 pb-12 sm:pb-16 md:pb-20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-8 sm:mb-12">
          <div
            class="max-w-4xl mx-auto flex justify-center items-center flex-col"
          >
            <H1 class="mb-4 sm:mb-6 max-w-3xl mx-auto">
              The native Mac HandBrake alternative
            </H1>
            <p
              class="mb-8 sm:mb-10 max-w-2xl mx-auto text-base sm:text-lg md:text-xl leading-relaxed text-text-secondary px-4 sm:px-0"
            >
              HandBrake is powerful and free. But if you want an app that feels
              like it belongs on Mac—and handles images too—Picmal gives you a
              native interface with Shortcuts integration and folder monitoring.
            </p>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col items-center gap-3 sm:gap-4">
            <div
              class="flex flex-col sm:flex-row gap-2 items-center justify-center"
            >
              <Button
                text="Get Picmal for $15.99"
                onclick="posthog.capture('buy_clicked_handbrake_comparison')"
              />
              <a
                href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg"
                class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-base py-3 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto"
              >
                <svg
                  class="w-4 h-4 inline-block mr-2"
                  fill="currentColor"
                  stroke="none"
                  viewBox="0 0 24 24"
                  ><path
                    d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8 4.35 4.35 0 0 1-2.59-4.03z"
                  ></path></svg
                >
                Download
              </a>
            </div>
            <p class="text-xs sm:text-sm text-text-secondary">
              One-time purchase • 14-day money back
            </p>
          </div>

          <!-- Social Proof Above Fold -->
          <div class="mt-6 sm:mt-8 hero-trust">
            <TrustBar />
          </div>
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-5xl mx-auto mb-6 sm:mb-8 rounded-lg sm:rounded-xl overflow-hidden border border-border"
        >
          <div class="aspect-[16/10]">
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover block dark:hidden"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal app interface"
            >
            </video>
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover hidden dark:block"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal app interface"
            >
            </video>
          </div>
        </div>
      </div>
    </main>

    <ComparisonVerdict
      competitor="HandBrake"
      summary="HandBrake is a free, open-source, cross-platform video transcoder with deep encoding controls. Picmal ($15.99 one-time) is a native macOS app that converts images, video, and audio with a simpler UI and Shortcuts automation. Neither uploads your files."
      picmalFor="You're on macOS, convert images alongside video, want native UI, Shortcuts, and folder monitoring."
      competitorFor="You need advanced video encoding (CRF tuning, filters, device presets), DVD/Blu-ray ripping, or cross-platform support (Windows/Linux)."
    />

    <SectionDivider />

    <!-- Comparison Table -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-4 text-center">Picmal vs HandBrake at a glance</H2>
        <Paragraph class="mb-8 text-center max-w-2xl mx-auto">
          HandBrake is a powerful free video encoder. Picmal is a native Mac app
          for all media types. Different tools for different needs.
        </Paragraph>

        <div
          class="bg-background-subtle/50 border border-border rounded-lg p-4 md:p-8"
        >
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left p-4 font-semibold text-text">Feature</th>
                  <th class="text-left p-4 font-semibold text-text">Picmal</th>
                  <th class="text-left p-4 font-semibold text-text"
                    >HandBrake</th
                  >
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr>
                  <td class="p-4 text-text-secondary">Price</td>
                  <td class="p-4 text-text">$15.99 one-time</td>
                  <td class="p-4 text-text">Free (open source)</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Platforms</td>
                  <td class="p-4 text-text">macOS only</td>
                  <td class="p-4 text-text">Windows, Mac, Linux</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Privacy</td>
                  <td class="p-4 text-text">100% offline</td>
                  <td class="p-4 text-text">100% offline</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Interface</td>
                  <td class="p-4 text-text">Native macOS, polished UI</td>
                  <td class="p-4 text-text">Cross-platform, functional</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Image conversion</td>
                  <td class="p-4 text-text">Yes—20+ formats</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video conversion</td>
                  <td class="p-4 text-text">Yes—common formats</td>
                  <td class="p-4 text-text">Yes—advanced encoding options</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Audio conversion</td>
                  <td class="p-4 text-text">Yes—MP3, WAV, FLAC, etc.</td>
                  <td class="p-4 text-text">Audio within video only</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">DVD/BluRay ripping</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text">Yes (unprotected)</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Device presets</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text">Yes—Apple, Android, web, etc.</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video filters</td>
                  <td class="p-4 text-text">Basic</td>
                  <td class="p-4 text-text"
                    >Advanced (deinterlace, denoise, HDR)</td
                  >
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Subtitle support</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text">Yes—SRT, SSA, VobSub, CEA-608</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Metadata removal</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">Limited</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Shortcuts integration</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Folder monitoring</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Finder right-click</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Who Picmal Is For / Who Should Stick with HandBrake -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-4">Which one is right for you?</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Both are excellent tools. Here's an honest comparison to help you
            decide.
          </Paragraph>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Picmal Column -->
          <div
            class="bg-background-subtle border border-border rounded-xl p-6 md:p-8"
          >
            <div class="mb-6">
              <h3 class="text-2xl font-semibold text-text mb-2">
                Choose Picmal
              </h3>
              <p class="text-text-secondary">
                Best for Mac users who want a native experience
              </p>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want to convert images, videos, and audio in one app
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You use Shortcuts for automation workflows
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You care about a well-designed UI that feels like Mac
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want folder monitoring and Finder integration
                </span>
              </li>
            </ul>
          </div>

          <!-- HandBrake Column -->
          <div
            class="bg-background-subtle border border-border rounded-xl p-6 md:p-8"
          >
            <div class="mb-6">
              <h3 class="text-2xl font-semibold text-text mb-2">
                Choose HandBrake
              </h3>
              <p class="text-text-secondary">
                Best for free cross-platform video encoding
              </p>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You only need video transcoding and encoding
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text"> You use Windows or Linux </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You don't want to pay for an app
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need DVD/BluRay ripping or subtitle support
                </span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- BentoFeatures -->
    <BentoFeatures />

    <SectionDivider />

    <!-- Testimonials Section -->
    <MasonryTestimonials />

    <SectionDivider />

    <!-- Featured On Section -->
    <section class="relative z-10">
      <FeaturedOn />
    </section>

    <SectionDivider />

    <!-- Pricing -->
    <section id="pricing" class="relative z-10 px-6 py-20">
      <PricingSection />
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-6">Frequently asked questions</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Can't find what you're looking for? Email support@picmal.app
          </Paragraph>
        </div>
        <div
          class="bg-background-subtle/50 border border-border rounded-lg p-4 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <ComparisonMeta
      lastUpdated="2026-04-22"
      sources={[
        { label: "HandBrake official site", href: "https://handbrake.fr/" },
        {
          label: "HandBrake documentation",
          href: "https://handbrake.fr/docs/",
        },
        { label: "Picmal pricing", href: "https://picmal.app/pricing.md" },
      ]}
    />

    <Footer />

    <SupportedFormatsModal />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "cantimplorastudio" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
