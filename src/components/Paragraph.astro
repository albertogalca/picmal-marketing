---
import { twMerge } from "tailwind-merge";

interface Props {
  class?: string;
  size?: "base" | "small";
}

const { class: className, size = "base" } = Astro.props;

const sizeClasses = {
  base: "text-sm sm:text-base md:text-lg",
  small: "text-xs md:text-base",
};

const defaultClasses = `${sizeClasses[size]} leading-relaxed text-text-secondary`;
const mergedClasses = twMerge(defaultClasses, className);
---

<p class={mergedClasses}>
  <slot />
</p>
