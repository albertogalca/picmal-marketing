---
import H3 from "./H3.astro";
import Paragraph from "./Paragraph.astro";

export interface Props {
  icon: string;
  title: string;
  description: string;
  iconBgClass?: string;
  iconTextClass?: string;
  titleClass?: string;
  descriptionClass?: string;
}

const {
  icon,
  title,
  description,
  iconBgClass = "bg-white/50 border border-blue-ribbon-950/15",
  iconTextClass = "text-black",
  titleClass = "mb-2",
  descriptionClass = "mb-10 ",
} = Astro.props;
---

<div>
  <div
    class={`w-12 h-12 rounded-lg flex items-center justify-center mb-4 ${iconBgClass}`}
  >
    <svg
      class={`w-6 h-6 ${iconTextClass}`}
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width={2}
        d={icon}></path>
    </svg>
  </div>
  <H3 class={titleClass}>
    {title}
  </H3>
  <Paragraph class={descriptionClass}>
    {description}
  </Paragraph>
</div>
