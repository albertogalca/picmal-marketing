---
import { getCollection } from "astro:content";
import { TIERS } from "../../config/pricing";
import { DMG_URL } from "../../config/download";
import { softwareId, personRef, orgRef } from "../../utils/schemaIds";

interface Props {
  url: string;
}

const { url } = Astro.props;

// Derive the current version + release date from the changelog collection so
// the schema never goes stale. Sorted the same way as the homepage release badge.
const changelogEntries = await getCollection("changelog");
const latestRelease = changelogEntries.sort((a, b) =>
  b.data.version.localeCompare(a.data.version, undefined, {
    numeric: true,
    sensitivity: "base",
  }),
)[0];

const softwareVersion = latestRelease?.data.version ?? "1.0.0";
const dateModified = (latestRelease?.data.pubDate ?? new Date("2024-01-15"))
  .toISOString()
  .split("T")[0];

// No rating is marked up here, on purpose. Reviews on our own product page are
// ineligible for review rich results anyway (Google treats self-collected
// reviews about yourself as self-serving), so individual Review bodies are not
// marked up. The aggregateRating went too: ratingValue was the hardcoded string
// "4.8" while reviewCount counted real testimonials, and testimonials.json has
// no per-item rating field to average. Google requires aggregate ratings to come
// from real scores, and AggregateRating is still a live rich result, so a made-up
// value on every page was a manual-action risk. offers/AggregateOffer below
// already satisfies the "at least one of aggregateRating, offers or review" rule.
// To bring a rating back: add a 1-5 rating field to each testimonial (a star
// question on the Tally form), then average those and nothing else.

// One SoftwareApplication for the whole site, addressed by @id. This used to be
// two nodes: this one carried offers and description, MasonryTestimonials
// emitted a second one carrying only the rating. Neither had an @id, so nothing
// obliged a crawler to merge them, and the price and the rating could be read
// as belonging to two different products.
const productSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": softwareId(url),
  name: "Picmal",
  url: new URL("/", url).href,
  description:
    "All-in-one media tool for Mac. Batch convert, compress, and create images, videos, audio, and PDF files offline on your Mac.",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "macOS 15.0 or later",
  // AggregateOffer, not a single Offer: the ladder runs from 1 to 10 Macs, so a
  // lone "39" would misreport both the entry price and the ceiling.
  offers: {
    "@type": "AggregateOffer",
    lowPrice: String(TIERS[0].price),
    highPrice: String(TIERS[TIERS.length - 1].price),
    offerCount: TIERS.length,
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: new URL("/", url).href,
    priceValidUntil: "2026-12-31",
  },
  // References, not copies. OrganizationSchema defines both nodes in full;
  // re-declaring them here made a second Alberto and a second Picmal that
  // nothing tied back to the originals.
  author: personRef(url),
  publisher: orgRef(url),
  softwareVersion,
  datePublished: "2024-01-15",
  dateModified,
  screenshot: new URL("/og.png", url).href,
  downloadUrl: DMG_URL,
  fileSize: "120MB",
  installUrl: DMG_URL,
  softwareRequirements: "macOS 15.0 or later",
  // Keep this list true and in sync with the FAQ (FAQSchema.astro), the feature
  // grid and llms.txt. It is the copy a model reads first and a human never
  // sees, so a stale or overstated line here is the one that gets quoted back.
  // Two things it used to get wrong: it claimed lossless compression, which the
  // FAQ correctly contradicts (video is H.264, audio is AAC, and the quality
  // slider is a size/fidelity tradeoff), and it applied the image-only "30+"
  // count to every media type.
  featureList: [
    "Batch convert images, video, audio and PDFs",
    "Adjustable-quality compression for images, video, audio and PDF",
    "Offline processing, nothing is uploaded",
    "Over 100 formats across images, video, audio, RAW and PDF",
    "PDF tools: combine, split by page range, images to PDF, reorder pages",
    "Video tools: combine clips, crop, watermark, burn-in subtitles",
    "Folder watching for automatic conversion",
    "Finder, Shortcuts and Raycast integration",
    "Command-line tool (picmal-cli) for scripting and automation",
    "Color space conversion",
    "Metadata control: strip all, keep essential, or keep all",
  ],
  keywords:
    "image converter, video converter, audio converter, Mac app, batch conversion, offline converter, HEIC converter, media compression",
};
---

<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
