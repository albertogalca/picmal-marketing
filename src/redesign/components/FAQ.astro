---
// Answers are trusted site copy with inline links (same contract as FAQ.astro).
interface Props { items: { question: string; answer: string }[]; open?: number }
const { items, open } = Astro.props;
---

<div class="pm-faq">
  {items.map((it, i) => (
    <details class="pm-faq__item" open={open === i}>
      <summary><span>{it.question}</span><svg class="pm-faq__chev" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
      <div class="pm-faq__a" set:html={it.answer} />
    </details>
  ))}
</div>
