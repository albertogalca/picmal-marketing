---
export interface Props {
  title: string;
  items: Array<{
    label: string;
    description: string;
  }>;
}

const { title, items } = Astro.props;
---

<div class="bg-background-subtle rounded-2xl border border-border p-8">
  <h3 class="text-h3 mb-6 text-text">{title}</h3>
  <div class="space-y-4">
    {
      items.map((item, index) => (
        <div
          class="flex items-start gap-3 group hover:translate-x-1 transition-all duration-300 hover:bg-background/50 -mx-2 px-2 py-2 rounded-xl"
        >
          <div class="flex-shrink-0 w-6 h-6 rounded-full bg-accent/10 border border-accent/30 flex items-center justify-center mt-0.5 group-hover:bg-accent/20 group-hover:border-accent/50 transition-all duration-300">
            <svg
              class="w-3 h-3 text-accent group-hover:scale-110 transition-transform duration-300"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="3"
                d="M5 13l4 4L19 7"
              />
            </svg>
          </div>
          <div class="flex-grow">
            <p class="font-semibold text-text mb-1">{item.label}</p>
            <p class="text-small text-text-secondary leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</div>
