---
import H3 from "./H3.astro";
import Paragraph from "./Paragraph.astro";

interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQ[];
  size?: "base" | "lead";
}

const { faqs, size = "base" } = Astro.props;
---

<div class="border-t border-border">
  {
    faqs.map((faq) => (
      <div class="border-b border-border">
        <details class="group">
          <summary class="w-full py-5 sm:py-6 flex items-center justify-between text-left cursor-pointer list-none rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
            <H3 class="pr-4 text-[17px] leading-6 font-medium tracking-normal">{faq.question}</H3>
            <div
              class="flex-shrink-0 transition-transform duration-200 group-open:rotate-180"
              aria-hidden="true"
            >
              <svg
                class="w-4 h-4 text-text-secondary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width={2}
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </div>
          </summary>
          <div class="pb-6 pr-8 max-w-2xl">
            <Paragraph size={size} set:html={faq.answer} />
          </div>
        </details>
      </div>
    ))
  }
</div>

<style>
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  details > summary::marker {
    content: "";
  }
</style>
