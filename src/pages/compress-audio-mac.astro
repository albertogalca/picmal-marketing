---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import PricingSection from "../components/PricingSection.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import ComparisonHero from "../components/ComparisonHero.astro";
import BlockGrid from "../components/BlockGrid.astro";
import FAQSection from "../components/FAQSection.astro";
import FAQSchema from "../components/schema/FAQSchema.astro";

const title = "Compress Audio on Mac: Shrink MP3, M4A, WAV, FLAC";
const description =
  "Compress MP3, M4A, WAV and FLAC on your Mac. Set the bitrate, force mono, batch a whole folder. Offline, no upload limit. $29 one-time.";

const faqs = [
  {
    question: "How much can Picmal shrink an audio file?",
    answer:
      "A lot, depending on the source. Lowering the bitrate (e.g. 320 kbps → 128 kbps) roughly halves an MP3; forcing mono on a voice recording halves it again; and converting an uncompressed WAV to MP3 or AAC can cut size by 80–90%.",
  },
  {
    question: "Does compressing audio lose quality?",
    answer:
      "Lowering the bitrate of a lossy format trades some quality for size. At 192–320 kbps it's transparent for music, and 64–96 kbps is plenty for speech. For archival, compress to FLAC instead, which is lossless.",
  },
  {
    question: "How do I make a voice memo or podcast smaller?",
    answer:
      "Turn on force mono and pick a speech-friendly bitrate (64–96 kbps). Voice recordings don't need stereo or high bitrates, so the file comes out a fraction of the size with no audible difference.",
  },
  {
    question: "Can I control bitrate and sample rate?",
    answer:
      "Yes. Pick VBR/ABR/CBR mode and a target bitrate, set the sample rate (8 kHz up to 96 kHz) and bit depth (16/24/32-bit), and force mono when you don't need stereo.",
  },
  {
    question: "Can I batch compress a whole folder of audio?",
    answer:
      "Yes. Drop multiple files or an entire folder into Picmal and compress them all with the same settings in one pass.",
  },
  {
    question: "Are my files uploaded anywhere?",
    answer:
      "No. All compression happens locally on your Mac. No uploads, no per-file limits. It's a one-time $29, not a subscription.",
  },
];
---

<MarketingLayout
  title={title}
  description={description}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema faqs={faqs} />
  </Fragment>

  <ComparisonHero
    title="Compress audio on your Mac"
    subhead="Shrink MP3, M4A, WAV, FLAC and more with bitrate control, force mono, and sample-rate options. Perfect for podcasts, voice memos, and audiobooks. Batch, offline, no upload limit."
    buyEvent="buy_clicked_compress_audio_mac"
    defaultTab="compress"
  />

  <!-- How It Works -->
  <BlockGrid ordered
    heading="Compress audio in 3 steps"
    items={[
      {
        title: "Drop your audio",
        description: "Drag in one file or a whole folder of recordings.",
      },
      {
        title: "Pick bitrate & mode",
        description:
          "Choose a bitrate and VBR/ABR/CBR mode, or force mono for voice.",
      },
      {
        title: "Compress",
        description: "Click Compress. Everything runs on your Mac.",
      },
    ]}
  />

  <!-- Controls -->
  <BlockGrid
    heading="Tuned for every kind of audio"
    items={[
      {
        icon: "ph:equalizer-duotone",
        title: "Bitrate & VBR/ABR/CBR",
        description:
          "Target an exact bitrate or let VBR allocate bits where they matter for the best quality per megabyte.",
      },
      {
        icon: "ph:microphone-duotone",
        title: "Force mono",
        description:
          "Collapse stereo to mono for podcasts and voice memos, roughly half the size, no audible loss.",
      },
      {
        icon: "ph:waveform-duotone",
        title: "Sample rate & bit depth",
        description:
          "From 8 kHz telephony up to 96 kHz hi-res, 16/24/32-bit, match the source to the use.",
      },
      {
        icon: "ph:seal-check-duotone",
        title: "Lossless option",
        description:
          "Need to shrink without any loss? Compress to FLAC for roughly half the size of WAV, bit-for-bit identical.",
      },
    ]}
    linkText="Need to convert audio formats too? See the audio converter"
    linkHref="/audio-converter-mac"
  />

  <MasonryTestimonials />

  <PricingSection />

  <FAQSection faqs={faqs} />

  <Fragment slot="after">
    <SupportedFormatsModal />
  </Fragment>
</MarketingLayout>
