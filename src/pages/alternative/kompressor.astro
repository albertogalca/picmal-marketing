---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import OrganizationSchema from "../../components/schema/OrganizationSchema.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import PricingSection from "../../components/PricingSection.astro";
import FounderLetter from "../../components/FounderLetter.astro";
import Section from "../../components/Section.astro";
import Card from "../../components/Card.astro";
import H3 from "../../components/H3.astro";
import Paragraph from "../../components/Paragraph.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";

const SITE_DESCRIPTION =
  "Want a Kompressor alternative that does more than compress images? Picmal converts, compresses, and lightly edits images, video, and audio on your Mac, and has PDF tools too. Everything runs offline. $15.99 once, 14-day refund.";

const faqs = [
  {
    question: "Is Picmal a good Kompressor alternative?",
    answer:
      "If you need more than image compression, yes. Picmal converts and compresses images, video, audio, and PDFs in one app, with Shortcuts, folder monitoring, and Finder right-click. If images are all you need, Kompressor is free and does that well.",
  },
  {
    question: "Does Picmal have real-time preview like Kompressor?",
    answer:
      "No. Picmal batches files without a per-file preview. If you want to see the before and after for each image before committing, Kompressor's live preview is genuinely useful.",
  },
  {
    question: "Why pay for Picmal when Kompressor is free?",
    answer:
      "Kompressor is free and does images only. Picmal is $15.99 and covers video, audio, and PDFs alongside images. It also converts formats, strips metadata, and works with Shortcuts and folder monitoring. If image compression is all you need, Kompressor is a fine choice.",
  },
  {
    question: "Can Kompressor convert video files?",
    answer:
      "No. Kompressor does images only. For video, audio, or format conversion, Picmal handles those.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Email support@picmal.app within 14 days and I'll refund you in full, no questions asked.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead
      title="Picmal: The Kompressor alternative that does more than compress images"
      description={SITE_DESCRIPTION}
    />
    <OrganizationSchema url={Astro.site!.href} />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <ComparisonHero
      title="The Kompressor alternative that does more than compress images"
      subhead="Kompressor compresses images, for free, and does it well. If you also need to convert formats, work with video and audio, or handle PDFs, and you want Shortcuts and folder monitoring, Picmal covers all of it. Everything runs on your Mac."
      buyEvent="buy_clicked_kompressor_comparison"
    />

    <ComparisonVerdict
      competitor="Kompressor"
      summary="Kompressor is a free Mac image compressor with a live quality preview for each file. Picmal costs $15.99 once and does more. It converts and compresses images, video, audio, and PDFs, with Shortcuts, folder monitoring, and Finder right-click."
      picmalFor="You need more than image compression. Think video, audio, PDF tools, and format conversion, plus Shortcuts and folder monitoring."
      competitorFor="You only compress images, you want a real-time before and after preview, and free matters to you."
    />

    <!-- Comparison Table -->
    <Section width="default">
      <SectionHeading>
        Picmal vs Kompressor at a glance
        <Fragment slot="sublead">
          Both run offline on your Mac. Kompressor does one thing, compressing
          images with a live quality preview. Picmal does more: convert,
          compress, and edit across images, video, audio, and PDFs.
        </Fragment>
      </SectionHeading>
      <Card padding="p-4 md:p-8">
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left p-4 font-semibold text-text">Feature</th>
                  <th class="text-left p-4 font-semibold text-text">Picmal</th>
                  <th class="text-left p-4 font-semibold text-text"
                    >Kompressor</th
                  >
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr>
                  <td class="p-4 text-text-secondary">What it's for</td>
                  <td class="p-4 text-text">Convert, compress & edit</td>
                  <td class="p-4 text-text">Compressing images</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Price</td>
                  <td class="p-4 text-text">$15.99 one-time</td>
                  <td class="p-4 text-text">Free</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Privacy</td>
                  <td class="p-4 text-text">100% offline</td>
                  <td class="p-4 text-text">100% offline</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Interface</td>
                  <td class="p-4 text-text">Simple drag and drop</td>
                  <td class="p-4 text-text"
                    >Original design with a real-time preview</td
                  >
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Image formats</td>
                  <td class="p-4 text-text">20+</td>
                  <td class="p-4 text-text">50+ input, 20+ output</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video conversion</td>
                  <td class="p-4 text-text">Yes, MP4, MOV, MKV, and more</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Audio conversion</td>
                  <td class="p-4 text-text">Yes, MP3, WAV, FLAC, and more</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Compression</td>
                  <td class="p-4 text-text"
                    >Images, video, audio & PDF (never bigger)</td
                  >
                  <td class="p-4 text-text">Images</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">PDF tools</td>
                  <td class="p-4 text-text"
                    >Compress, combine, images→PDF, PDF→PNG</td
                  >
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Real-time preview</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text"
                    >Yes, adjust quality and see the result</td
                  >
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video codec control</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">N/A</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Metadata removal</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">Yes</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Finder right-click</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Shortcuts integration</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Folder monitoring</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">macOS</td>
                  <td class="p-4 text-text">14+</td>
                  <td class="p-4 text-text">13+</td>
                </tr>
              </tbody>
            </table>
          </div>
      </Card>
    </Section>

    <!-- Who Picmal Is For / Who Should Stick with Kompressor -->
    <Section width="default">
      <SectionHeading>
        Which one is right for you?
        <Fragment slot="sublead">
            Here's where each one makes more sense.
        </Fragment>
      </SectionHeading>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Picmal Column -->
          <Card>
            <div class="mb-6">
              <H3 class="mb-2">
                Choose Picmal
              </H3>
              <Paragraph color="secondary">
                More than image compression
              </Paragraph>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need a simple interface that just works
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want one app to convert, compress, and edit images, video,
                  audio, and PDFs
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You use automation features like folder monitoring or
                  Shortcuts
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need advanced options like video codec control
                </span>
              </li>
            </ul>
          </Card>

          <!-- Kompressor Column -->
          <Card>
            <div class="mb-6">
              <H3 class="mb-2">
                Choose Kompressor
              </H3>
              <Paragraph color="secondary">
                Free, images only, with a live quality preview
              </Paragraph>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You like its original interface and the way it feels to use
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You don't want to pay for an app
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You only work with images, no video or audio
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want real-time preview while adjusting compression quality
                </span>
              </li>
            </ul>
          </Card>
        </div>
    </Section>

    <!-- Features -->
    <FeatureGrid
      heading="Everything else Picmal does"
      subleadIntro="One app for images, video, audio, and PDFs. Convert, compress, and edit, all on your Mac."
    />

    <!-- Testimonials Section -->
    <MasonryTestimonials />

    <!-- Pricing -->
    <PricingSection />

    <!-- Founder letter -->
    <FounderLetter />

    <!-- FAQ Section -->
    <Section id="faq" width="narrow">
      <SectionHeading
        sublead="Can't find what you're looking for? Email support@picmal.app"
      >
        Frequently asked questions
      </SectionHeading>
      <Card>
        <FAQ faqs={faqs} />
      </Card>
    </Section>

    <Footer />

    <SupportedFormatsModal />

  </body>
</html>
