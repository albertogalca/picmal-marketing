---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Paragraph from "../components/Paragraph.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import BentoFeatures from "../components/BentoFeatures.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import SectionDivider from "../components/SectionDivider.astro";
import PricingSection from "../components/PricingSection.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import ComparisonHero from "../components/ComparisonHero.astro";

const title = "Image Converter for Mac — Convert Any Format | Picmal";
const description =
  "Convert images between HEIC, JPG, PNG, WebP, AVIF, TIFF, GIF, and more on your Mac. Batch conversion, offline, no subscription. $15.99 one-time.";

const faqs = [
  {
    question: "What image formats does Picmal support?",
    answer:
      "Picmal supports 20+ image formats including HEIC, JPG, PNG, WebP, AVIF, TIFF, BMP, GIF, SVG, DNG, PSD, and more. It also converts video and audio files.",
  },
  {
    question: "Can I convert multiple images at once?",
    answer:
      "Yes. Picmal excels at batch conversion — drag and drop hundreds of files or entire folders and convert them all at once with individual progress tracking.",
  },
  {
    question: "Does Picmal work offline?",
    answer:
      "Yes. All processing happens locally on your Mac. Your files never leave your device. No internet connection required after installation.",
  },
  {
    question: "Is Picmal free?",
    answer:
      "Picmal is a one-time purchase of $15.99 — no subscription. You can download the app to explore the interface. 14-day money-back guarantee.",
  },
  {
    question: "Does converting images lose quality?",
    answer:
      "It depends on the format. Converting to lossless formats like PNG or TIFF preserves full quality. For lossy formats like JPG or WebP, Picmal lets you adjust the quality slider.",
  },
  {
    question: "Can I also compress images?",
    answer:
      "Yes. Picmal can compress images in their current format without converting. Adjust the quality slider to reduce file size while maintaining the original format.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

        <ComparisonHero
      title="The image converter for Mac that just works"
      subhead="Convert between HEIC, JPG, PNG, WebP, AVIF, TIFF, and 20+ other formats. Batch processing, offline, no subscription."
      buyEvent="buy_clicked_image_converter_mac"
      defaultTab="convert"
    >
      <Breadcrumb
        slot="breadcrumb"
        items={[{ label: "Home", href: "/" }, { label: "Image Converter for Mac" }]}
      />
    </ComparisonHero>

    <SectionDivider />
    <BentoFeatures />
    <SectionDivider />

    <!-- Popular Conversions -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-5xl mx-auto">
        <H2 class="mb-4 text-center">Popular conversions</H2>
        <Paragraph class="mb-8 text-center max-w-2xl mx-auto"
          >Convert between any image format with a few clicks.</Paragraph
        >
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          {
            [
              "heic-to-jpg",
              "heic-to-png",
              "heic-to-webp",
              "jpg-to-png",
              "jpg-to-webp",
              "png-to-webp",
              "webp-to-jpg",
              "avif-to-jpg",
              "tiff-to-jpg",
              "dng-to-jpg",
              "gif-to-png",
              "png-to-avif",
            ].map((slug) => (
              <a
                href={`/convert/${slug}`}
                class="bg-background-subtle/50 border border-border rounded-xl p-4 text-center transition-colors hover:border-accent/30"
              >
                <span class="text-small font-medium text-text">
                  {slug.replace("-to-", " to ").toUpperCase()}
                </span>
              </a>
            ))
          }
        </div>
        <div class="text-center mt-6 flex flex-col sm:flex-row gap-x-6 gap-y-2 items-center justify-center">
          <a href="/convert" class="text-small text-accent hover:underline"
            >View all conversions &rarr;</a
          >
          <a href="/raw-converter-mac" class="text-small text-accent hover:underline"
            >Convert camera RAW (CR2, NEF, ARW) &rarr;</a
          >
          <a href="/video-converter-mac" class="text-small text-accent hover:underline"
            >Convert video (MOV to MP4) &rarr;</a
          >
          <a href="/audio-converter-mac" class="text-small text-accent hover:underline"
            >Convert audio (FLAC, M4A to MP3) &rarr;</a
          >
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- Why a native app -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-6 text-center">Why not just use an online converter?</H2>
        <Paragraph class="mb-4"
          >You can drag a file onto a website and get it back in another format.
          For one or two files, that's fine. It stops being fine the moment you
          have a folder of them, or the file is something you'd rather not hand
          to a stranger's server.</Paragraph
        >
        <Paragraph class="mb-4"
          >Online converters upload your image, convert it somewhere you can't
          see, and hand it back — often with a size cap, a queue, a watermark,
          or an ad wall. Your photos sit on their machine for as long as they
          decide to keep them. Picmal does the whole thing on your Mac. Nothing
          uploads, nothing is queued, there's no file-size limit, and your files
          never leave the device.</Paragraph
        >
        <Paragraph
          >Drop in a few hundred HEIC photos from a trip and convert them to JPG
          in one pass, folder structure intact. And it's a one-time $15.99, not
          a subscription you forget to cancel.</Paragraph
        >
      </div>
    </section>

    <SectionDivider />

    <!-- Convert vs compress -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-6 text-center">Convert or compress?</H2>
        <Paragraph class="mb-4"
          >Worth knowing the difference. <strong class="text-text"
            >Converting</strong
          > changes the format so a file opens where it didn't before — HEIC to
          JPG so Windows can read it, PNG to WebP to shave page weight. <strong
            class="text-text">Compressing</strong
          > keeps the format and just makes the file smaller.</Paragraph
        >
        <Paragraph
          >Picmal does both, and can do them at once. If your goal is purely a
          smaller file in the same format, start on the <a
            href="/compress-images-mac"
            class="text-accent hover:underline">compress images page</a
          > instead.</Paragraph
        >
      </div>
    </section>

    <SectionDivider />

    <!-- Related guides -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto text-center">
        <H2 class="mb-6">Related guides</H2>
        <div class="flex flex-col gap-3">
          <a
            href="/blog/how-to-convert-heic-to-jpg-mac"
            class="text-accent hover:underline"
            >How to convert HEIC to JPG on Mac &rarr;</a
          >
          <a
            href="/blog/best-image-formats-for-web"
            class="text-accent hover:underline"
            >Best image formats for the web (and when to use each) &rarr;</a
          >
          <a
            href="/blog/batch-convert-images-mac"
            class="text-accent hover:underline"
            >How to batch convert images on Mac &rarr;</a
          >
        </div>
      </div>
    </section>

    <SectionDivider />
    <MasonryTestimonials />
    <SectionDivider />

    <section
      id="pricing"
      class="relative z-10 px-6 py-16 sm:py-20 bg-background-subtle/50 border-y border-border"
    >
      <PricingSection />
    </section>

    <section id="faq" class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-8 text-center">Frequently asked questions</H2>
        <div
          class="bg-background-subtle/50 border border-border rounded-2xl p-6 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />
    <SupportedFormatsModal />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "cantimplorastudio" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
