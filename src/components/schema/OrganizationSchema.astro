---
interface Props {
  url: string;
}

const { url } = Astro.props;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Picmal",
  url: url,
  logo: new URL("/logo.webp", url).href,
  sameAs: ["https://albertogalca.com/", "https://github.com/albertogalca"],
  description:
    "All-in-one media converter for Mac. Batch convert and compress images, videos, and audio files offline on your Mac.",
  founder: {
    "@type": "Person",
    name: "Alberto Gallego",
    url: "https://albertogalca.com/",
  },
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(organizationSchema)}
/>
