---
// Redesign preview (branch redesign-preview). Every route here renders from
// src/redesign/ and only exists on the dev server: a production build gets
// no paths, so nothing under /next is deployed, indexed, or put in the sitemap.
// Delete this file and src/redesign/ to remove the preview entirely.
import Layout from "../../redesign/components/Layout.astro";
import Home from "../../redesign/views/Home.astro";
import Convert from "../../redesign/views/Convert.astro";
import Blog from "../../redesign/views/Blog.astro";
import Article from "../../redesign/views/Article.astro";
import Changelog from "../../redesign/views/Changelog.astro";
import Alternative from "../../redesign/views/Alternative.astro";
import Tool from "../../redesign/views/Tool.astro";
import { conversions } from "../../data/conversions";
import { getPublishedPosts } from "../../utils/posts";

export async function getStaticPaths() {
  if (import.meta.env.PROD) return [];
  const posts = await getPublishedPosts();
  return [
    { params: { path: undefined }, props: { view: "home", title: "Home" } },
    { params: { path: "blog" }, props: { view: "blog", title: "Blog", active: "Blog" } },
    ...posts.map((post) => ({ params: { path: `blog/${post.id}` }, props: { view: "article", title: post.data.title, active: "Blog", post } })),
    { params: { path: "changelog" }, props: { view: "changelog", title: "Changelog" } },
    ...conversions.map((conversion) => ({ params: { path: `convert/${conversion.slug}` }, props: { view: "convert", title: conversion.slug, conversion } })),
    { params: { path: "alternative/tinypng" }, props: { view: "alternative", title: "TinyPNG alternative" } },
    { params: { path: "tools/exif-viewer" }, props: { view: "tool", title: "EXIF viewer" } },
  ];
}

const { view, title, active, post, conversion } = Astro.props as any;
---

<Layout title={title} active={active}>
  {view === "home" && <Home />}
  {view === "blog" && <Blog />}
  {view === "article" && <Article post={post} />}
  {view === "changelog" && <Changelog />}
  {view === "convert" && <Convert conversion={conversion} />}
  {view === "alternative" && <Alternative />}
  {view === "tool" && <Tool />}
</Layout>
