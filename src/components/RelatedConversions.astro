---
import { conversions, formats, isConversionIndexed } from "../data/conversions";

interface Props {
  tags?: string[];
  limit?: number;
}

const { tags = [], limit = 4 } = Astro.props;

// Blog tags use display names ("HEIC", "WebP"); conversion from/to use lowercase
// format keys ("heic", "webp"). Match indexed conversions whose source or target
// format appears in the post's tags, so the widget only shows when it's relevant.
const tagKeys = new Set(tags.map((t) => t.toLowerCase()));

const related = conversions
  .filter((c) => isConversionIndexed(c.slug))
  .filter((c) => tagKeys.has(c.from) || tagKeys.has(c.to))
  .slice(0, limit);
---

{/* Rendered inside the closing CTASection, under its buttons. It used to be a
    boxed block of its own with its own pitch, the third pitch at the end of a
    post. Here it is only the links: the CTA above already says why. */}
{
  related.length > 0 && (
    <nav
      aria-label="Converters for these formats"
      class="mt-10 pt-8 border-t border-border"
    >
      <p class="text-small text-text-secondary mb-3">
        Or go straight to the converter:
      </p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-small">
        {related.map((c) => (
          <li>
            <a href={`/convert/${c.slug}`} class="link">
              {formats[c.from].name} to {formats[c.to].name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
