---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Paragraph from "../components/Paragraph.astro";
import Button from "../components/Button.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import TrustBar from "../components/TrustBar.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import SectionDivider from "../components/SectionDivider.astro";
import PricingSection from "../components/PricingSection.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import { audioConversions, audioFormats } from "../data/audioConversions";

const title = "Audio Converter for Mac — FLAC, M4A, WAV to MP3 & More | Picmal";
const description =
  "Convert audio on your Mac — FLAC, M4A, WAV, WMA, OGG, Opus to MP3, plus lossless FLAC/ALAC for Apple Music. Bitrate control, batch, fully offline. $15.99 one-time, no subscription.";

const toMp3 = audioConversions.filter((c) => c.to === "mp3");
const other = audioConversions.filter((c) => c.to !== "mp3");

const faqs = [
  {
    question: "Which audio formats can Picmal convert?",
    answer:
      "Picmal reads and writes MP3, AAC/M4A, ALAC, WAV, FLAC, OGG, Opus, AIFF, AC3, WMA and many more. It converts between any of them and can compress with bitrate control.",
  },
  {
    question: "Can Picmal create lossless audio for Apple Music?",
    answer:
      "Yes. Convert FLAC, WAV, or AIFF to ALAC (Apple Lossless) and you get a bit-perfect .m4a — exactly the lossless format Apple Music expects for your library.",
  },
  {
    question: "Can I control the audio quality and bitrate?",
    answer:
      "Yes. Pick a bitrate and VBR/ABR/CBR mode, set sample rate (up to 96 kHz) and bit depth (16/24/32-bit), or force mono to roughly halve the size of voice recordings.",
  },
  {
    question: "Is there a file-size limit or upload?",
    answer:
      "No. Picmal runs entirely on your Mac — no uploads, no queues, no per-file limits. Convert files of any size, fully offline.",
  },
  {
    question: "Can I batch convert a whole folder of audio files?",
    answer:
      "Yes. Drag in many files or an entire folder and Picmal converts them all in one pass, each with its own progress.",
  },
  {
    question: "Do my files leave my Mac?",
    answer:
      "No. All conversion happens locally. Picmal works completely offline — your audio never touches a server.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <link
      rel="preload"
      href="/picmal-1.2.0-demo.mp4"
      as="video"
      type="video/mp4"
    />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <main id="main-content" class="relative z-10 pt-32 pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <Breadcrumb
          items={[
            { label: "Home", href: "/" },
            { label: "Audio Converter for Mac" },
          ]}
        />

        <div class="text-center mb-12">
          <H1 class="mb-6 max-w-3xl mx-auto"
            >Convert audio on your Mac</H1
          >
          <Paragraph class="max-w-2xl mx-auto mb-8">
            FLAC, M4A, WAV, WMA, OGG, Opus and more — Picmal converts to MP3 for
            universal playback, or to ALAC for lossless Apple Music. Bitrate
            control, batch, fully offline.
          </Paragraph>
          <div
            class="flex flex-col sm:flex-row gap-3 items-center justify-center mb-6"
          >
            <Button
              text="Get Picmal for $15.99"
              onclick="posthog.capture('buy_clicked_audio_converter_mac')"
            />
            <a
              href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg"
              class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-body py-3 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto"
            >
              <svg
                class="size-4 inline-block mr-2"
                fill="currentColor"
                stroke="none"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8 4.35 4.35 0 0 1-2.59-4.03z"
                ></path></svg
              >
              Download
            </a>
          </div>
          <TrustBar />
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-5xl mx-auto rounded-lg sm:rounded-xl overflow-hidden border border-border"
        >
          <div class="aspect-[16/10]">
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal audio conversion interface"></video>
          </div>
        </div>
      </div>
    </main>

    <SectionDivider />

    <!-- Convert to MP3 -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-3 text-center">Convert any audio to MP3</H2>
        <Paragraph class="text-center max-w-2xl mx-auto mb-8">
          MP3 plays on every device, app, and player. Pick your source format
          below.
        </Paragraph>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          {
            toMp3.map((c) => (
              <a
                href={`/convert/audio/${c.slug}`}
                class="bg-background-subtle/50 border border-border rounded-lg p-4 text-center transition-colors hover:border-accent/30"
              >
                <span class="text-body-sm font-medium text-text">
                  {audioFormats[c.from].name} to MP3
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- Lossless, Apple Music & ringtones -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-3 text-center">Lossless, Apple Music & ringtones</H2>
        <Paragraph class="text-center max-w-2xl mx-auto mb-8">
          Make editable WAV, lossless FLAC/ALAC for Apple Music, or a custom
          iPhone ringtone.
        </Paragraph>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          {
            other.map((c) => (
              <a
                href={`/convert/audio/${c.slug}`}
                class="bg-background-subtle/50 border border-border rounded-lg p-4 text-center transition-colors hover:border-accent/30"
              >
                <span class="text-body-sm font-medium text-text">
                  {audioFormats[c.from].name} to {audioFormats[c.to].name}
                </span>
              </a>
            ))
          }
        </div>
        <div class="text-center mt-8">
          <a
            href="/compress-audio-mac"
            class="text-body-sm text-accent hover:underline"
            >Just need a smaller file? Compress audio on Mac &rarr;</a
          >
        </div>
      </div>
    </section>

    <SectionDivider />
    <MasonryTestimonials />
    <SectionDivider />

    <section
      id="pricing"
      class="relative z-10 px-6 py-16 sm:py-20 bg-background-subtle/50 border-y border-border"
    >
      <PricingSection />
    </section>

    <section id="faq" class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-8 text-center">Frequently asked questions</H2>
        <div
          class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />
    <SupportedFormatsModal />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "cantimplorastudio" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
