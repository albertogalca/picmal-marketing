---
import type { CollectionEntry } from "astro:content";
import { personRef, orgRef } from "../../utils/schemaIds";

interface Props {
  post: CollectionEntry<"blog">["data"];
  url: string;
  slug: string;
}

const { post, url, slug } = Astro.props;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description,
  image: post.heroImage
    ? new URL(post.heroImage.src, url).href
    : new URL("/og.png", url).href,
  // Same two nodes the rest of the site uses, referenced by @id rather than
  // redefined per post. 45 posts each minting their own Alberto is 45 people.
  author: personRef(url),
  publisher: orgRef(url),
  datePublished: post.pubDate.toISOString(),
  dateModified: post.updatedDate
    ? post.updatedDate.toISOString()
    : post.pubDate.toISOString(),
  url: new URL(`/blog/${slug}`, url).href,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(`/blog/${slug}`, url).href,
  },
  articleSection: post.category || "Guide",
};
---

<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
