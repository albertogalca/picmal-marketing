---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import WebSiteSchema from "../components/schema/WebSiteSchema.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import FAQSchema, { faqs } from "../components/schema/FAQSchema.astro";
import HeroCTA from "../components/HeroCTA.astro";
import DemoReel from "../components/DemoReel.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import ReleaseBadge from "../components/ReleaseBadge.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import CompressFormatsModal from "../components/CompressFormatsModal.astro";
import PricingSection from "../components/PricingSection.astro";
import FounderLetter from "../components/FounderLetter.astro";
import FeaturedReview from "../components/FeaturedReview.astro";
import CTASection from "../components/CTASection.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import H3 from "../components/H3.astro";
import H4 from "../components/H4.astro";
import Paragraph from "../components/Paragraph.astro";
import { getPublishedPosts } from "../utils/posts";
import FAQSection from "../components/FAQSection.astro";

const FEATURED_GUIDES = [
  {
    label: "Images",
    slugs: ["reduce-image-file-size-mac", "how-to-convert-heic-to-jpg-mac"],
  },
  {
    label: "Video and audio",
    slugs: [
      "how-to-compress-video-mac",
      "how-to-extract-audio-from-video-mac",
    ],
  },
  {
    label: "Batch and choosing",
    slugs: ["batch-convert-images-mac", "best-media-converter-mac-2026"],
  },
];

const allPosts = await getPublishedPosts();
const postsById = new Map(allPosts.map((post) => [post.id, post]));
// A scheduled or renamed post drops out rather than rendering an empty row.
const guideGroups = FEATURED_GUIDES.map((group) => ({
  label: group.label,
  posts: group.slugs
    .map((slug) => postsById.get(slug))
    .filter((post) => post !== undefined),
})).filter((group) => group.posts.length > 0);

const SITE_DESCRIPTION =
  "Convert, compress, and edit images, video, audio, and PDFs right on your Mac, instead of trusting sketchy websites. Works offline, no account, no subscription.";
---

<MarketingLayout
  title="Picmal: convert and compress media on your Mac, offline"
  description={SITE_DESCRIPTION}
>
  <Fragment slot="head">
    <WebSiteSchema url={Astro.site!.href} />
        <ProductSchema url={Astro.site!.href} />
        <FAQSchema />
  </Fragment>

  {/* The hero used to be `<main class="relative z-10 pt-32 pb-20">` with a
      hand-rolled `max-w-7xl mx-auto px-6 xl:px-0` inside, which is exactly
      what `Section width="wide"` renders. Section calls itself the single
      source of truth for section rhythm, and the hero was the one block
      opting out, which is why its padding never matched the rest.
      `pt-32` for header clearance is the same override every other page
      uses. */}
  <Section width="wide" class="pt-32 sm:pt-32">
    <div class="max-w-3xl">
      <div class="hero-reveal" style="--d: 0ms">
        <ReleaseBadge class="mb-6" />
      </div>
      <div class="hero-reveal" style="--d: 80ms">
        <SectionHeading
          level={1}
          align="left"
          class="mb-8"
          headingClass="mb-6"
          subleadClass="max-w-xl"
        >
          {/* H1 under test. Live line is A3.

              A3 moves the category INTO the H1. A2c had better rhythm, but
              it named an interaction and an absence and never said what
              the software is, which left the whole category load on the
              sublead: the largest element on the page carried none of it.
              Most arrivals here are cold, off a format query, and they
              read one line before deciding.

              With the category in the H1, the sublead is free to stop
              repeating it. Its job now is proof, not definition: the media
              types, and the batch/speed claim that beats a web uploader.
              Do not let both lines name the category again.

              A2a  Upload, wait, download, wait. Or drag, click, done.
              A2b  Online: upload, wait, download, wait. Picmal: drag, click, done.
              A2c  Drag, click, done. Nothing gets uploaded.
              A2d  Done before a website finishes uploading.
              A3   Convert and compress anything on your Mac. Nothing gets uploaded.

              A2c is the one to revert to if A3 tests worse: it was picked
              deliberately, not by default.

              Earlier bets, if the upload angle is not the one: privacy,
              breadth, pay-once, batch size, native-app craft.
          */}
          Convert and compress anything on your Mac. Nothing gets uploaded.
          <Fragment slot="sublead">
            Images, video, audio and PDFs. Batch hundreds at once, in the
            time a website would still be uploading.
          </Fragment>
        </SectionHeading>
      </div>
      <HeroCTA buyEvent="buy_clicked" pricingHref="#pricing" />
    </div>

    <!-- Demo reel: the video plus a dock of the other demos. The dock
         floats over the video from sm up, stacks under it on phones.
         Markup and behaviour live in DemoReel; the entrance animation
         stays here because it belongs to the hero, not to the reel. -->
    <div class="hero-reveal mt-12" style="--d: 240ms">
      <DemoReel />
    </div>

    <!-- Featured review: the video shows what it does, this vouches that
         it's a real, reviewed app. Highest-authority outlet goes here. -->
    <div class="hero-reveal mt-16" style="--d: 320ms">
      <FeaturedReview publication="MacStories" />
    </div>
  </Section>

  <!-- Testimonials -->
  {/* No trust bar here: the hero already shows the faces and the count, and
      the wall of quotes below is the answer to the question. */}
  <MasonryTestimonials
    heading="Tired of uploading your files to a website, waiting, then downloading them again?"
  />

  <!-- Features -->
  <FeatureGrid />

  <!-- Pricing -->
  <PricingSection />

  {/* The second press quote (TheSweetBits, after the price) is gone. One
      outlet in the hero plus thirty user quotes already answer "is this a
      legit app?"; a second five-star card in the same shape was a repeat. */}

  <!-- Founder letter -->
  <FounderLetter />

  {/* The covers are deliberately not here. Six 16:9 images this far down a
      long page carried weight without carrying meaning, and they still do
      their job on /blog and in RelatedGrid. What is left is the routing: a
      rule, a label, and the titles. */}
  <Section id="guides" width="wide">
    <SectionHeading
      class="mb-10"
      align="left"
      headingClass="max-w-2xl"
      subleadClass="max-w-2xl"
    >
      Free ways to convert and compress without Picmal
      <Fragment slot="sublead">
        The guides walk you through the free path on your Mac, and say where
        it stops being worth the effort. <a class="link" href="/blog"
          >See all of them</a
        >.
      </Fragment>
    </SectionHeading>

    <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        guideGroups.map((group) => (
          <div>
            {/* Full-ink rule, not `border-border`: it has to read as an
                editorial divider over the label, and the token hairline
                disappears at this weight. */}
            <H3 class="text-caption font-mono font-semibold uppercase tracking-[0.11em] border-t border-text pt-3 mb-6">
              {group.label}
            </H3>

            <div class="flex flex-col gap-6">
              {group.posts.map((post) => (
                <a
                  href={`/blog/${post.id}`}
                  class="group block rounded-lg transition-[color] duration-200 ease-out motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                >
                  <H4 class="text-body font-semibold leading-snug mb-1.5 transition-[color] duration-200 ease-out group-hover:text-accent motion-reduce:transition-none">
                    {post.data.title}
                  </H4>
                  {/* 46ch is the site-wide cap for flat text blocks (see
                      BlockGrid): three columns at max-w-7xl run to ~60ch
                      without it. */}
                  <Paragraph size="small" class="max-w-[46ch] line-clamp-2">
                    {post.data.description}
                  </Paragraph>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <FAQSection
    faqs={faqs}
    heading="Frequently asked questions"
  />

  <!-- The homepage was the one page with no closing ask: it went from the
       FAQ straight into the footer. A reader who opened every answer has
       already decided; give them the button instead of a sitemap. -->
  <CTASection
    heading="Stop uploading your files"
    analyticsEvent="buy_clicked_home_bottom"
  />

  <Fragment slot="after">
    <!-- Modals sit outside main on purpose: page-level overlays, not content. -->
        <SupportedFormatsModal />
        <CompressFormatsModal />
  </Fragment>
</MarketingLayout>
