---
import { getEntry, render } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import "../../styles/global.css";
import H1 from "../../components/H1.astro";
import Paragraph from "../../components/Paragraph.astro";

const changelog = await getEntry("blog", "changelog");
if (!changelog) {
  throw new Error("Changelog not found");
}
const { Content } = await render(changelog);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Changelog - ${SITE_TITLE}`}
      description="Stay updated with the latest Picmal updates, new features, and improvements in our changelog."
    />
  </head>
  <body class="bg-background">
    <Header />

    <!-- Hero with gradient -->
    <main class="relative z-10 pt-32 pb-20">
      <div class="absolute inset-0 -z-10 overflow-hidden hero-gradient">
      </div>

      <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-16">
          <H1 class="mb-4">Changelog</H1>
          <Paragraph class="max-w-2xl mx-auto">
            Latest updates, new features, and improvements to Picmal.
          </Paragraph>
        </div>

        <!-- Timeline Changelog -->
        <div class="relative">
          <!-- Timeline line -->
          <div
            class="absolute left-4 top-0 bottom-0 w-0.5 bg-gradient-to-b from-accent via-accent/50 to-transparent"
            aria-hidden="true"
          >
          </div>

          <!-- Changelog Content with Timeline -->
          <div
            class="timeline-content space-y-8 prose prose-lg max-w-none
                   prose-headings:text-text prose-headings:font-bold
                   prose-p:text-text-secondary prose-p:leading-relaxed
                   prose-h3:text-xl prose-h3:mb-3
                   prose-h4:text-lg prose-h4:mb-2
                   prose-a:text-accent prose-a:no-underline hover:prose-a:underline
                   prose-img:rounded-xl prose-img:my-6
                   prose-video:rounded-xl prose-video:my-6
                   prose-li:text-text-secondary prose-li:leading-relaxed
                   prose-ul:space-y-2
                   prose-strong:text-text prose-strong:font-semibold
                   prose-code:text-accent prose-code:bg-accent/10 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
                   prose-pre:bg-background-subtle prose-pre:border prose-pre:border-text/10
                   prose-blockquote:border-l-accent prose-blockquote:text-text-secondary prose-blockquote:bg-background-subtle/50
                   [&>hr]:hidden
                   [&>h2]:relative [&>h2]:pl-12 [&>h2]:flex [&>h2]:items-center
                   [&>h2]:before:content-[''] [&>h2]:before:absolute [&>h2]:before:left-[10px]
                   [&>h2]:before:top-1/2 [&>h2]:before:-translate-y-1/2 [&>h2]:before:w-3 [&>h2]:before:h-3 [&>h2]:before:z-10
                   [&>h2]:before:rounded-full [&>h2]:before:bg-accent [&>h2]:before:ring-4 [&>h2]:before:ring-background
                   [&>h2]:after:content-[''] [&>h2]:after:absolute [&>h2]:after:left-[6px]
                   [&>h2]:after:top-1/2 [&>h2]:after:-translate-y-1/2 [&>h2]:after:w-5 [&>h2]:after:h-5
                   [&>h2]:after:rounded-full [&>h2]:after:bg-accent/20 [&>h2]:after:animate-pulse
                   [&>h2~*]:pl-12"
          >
            <Content />
          </div>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
