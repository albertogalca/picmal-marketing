---
import { getCollection, render } from "astro:content";
import SectionHeader from "../components/SectionHeader.astro";
import ArtCard from "../components/ArtCard.astro";
import { sortEntries, getEntrySlug } from "../../utils/changelog";

const entries = sortEntries(await getCollection("changelog")).slice(0, 12);
const rendered = await Promise.all(entries.map(async (e) => ({ e, Content: (await render(e)).Content })));
const fmt = (d?: Date) => d?.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<div class="pm-wrap">
  <div style="padding-top: 96px"><SectionHeader level={1} title="Changelog." subtitle="Every release, since 1.0." /></div>
  <div class="pm-mt-16">
    {rendered.map(({ e, Content }, i) => (
      <article class="pm-release" id={getEntrySlug(e)}>
        <div class="pm-release__side"><div class="pm-release__v">v{e.data.version}</div><div class="pm-release__date">{fmt(e.data.pubDate)}</div></div>
        <div class="pm-release__body">
          {e.data.title && <h2 style="font: 600 20px/28px var(--pm-font-sans); color: var(--pm-ink); margin: 0 0 12px">{e.data.title}</h2>}
          {i === 0 && <div class="pm-release__art"><ArtCard title={`v${e.data.version}`} texture="flow" seed={e.data.version} /></div>}
          <div class="pm-prose"><Content /></div>
        </div>
      </article>
    ))}
  </div>
</div>
