---
import { cn } from "../utils/cn";
import { DEFAULT_PLAN } from "../config/pricing";

export interface Props {
  class?: string;
  href?: string;
  text?: string;
  size?: "small" | "normal";
  variant?: "primary" | "secondary" | "overlay";
  type?: "link" | "submit" | "button";
  disabled?: boolean;
  icon?: string;
  iconType?: "stroke" | "fill";
  id?: string;
  title?: string;
  ariaLabel?: string;
  target?: string;
  rel?: string;
  onclick?: string;
  download?: boolean | string;
}

const {
  class: className = "",
  href = DEFAULT_PLAN.checkoutUrl,
  text = "",
  size = "normal",
  variant = "primary",
  type = "link",
  disabled = false,
  icon,
  iconType = "stroke",
  id,
  title,
  ariaLabel,
  target = "_blank",
  rel = "noopener noreferrer",
  onclick,
  download,
} = Astro.props;

const isIconOnly = !!icon && !text;

const sizeClasses = {
  small: "text-small py-2 px-4 gap-1.5",
  normal: "text-body py-3 px-6 gap-2",
};

// Icon-only buttons: square, sized to meet/approach a 44px touch target.
const iconOnlySizeClasses = {
  small: "p-0 w-10 h-10",
  normal: "p-0 w-12 h-12",
};

const iconSizeClasses = {
  small: "w-4 h-4",
  normal: "w-5 h-5",
};

const variantClasses = {
  primary: cn(
    "text-white font-semibold rounded-lg",
    "bg-[linear-gradient(180deg,#0A8FFF_14%,#0F5CF1_81.56%)] hover:bg-[linear-gradient(180deg,#0980E6_14%,#0D52D9_81.56%)]",
    "dark:bg-[linear-gradient(180deg,#0A8FFF_14%,#0F5CF1_81.56%)] dark:hover:bg-[linear-gradient(180deg,#0980E6_14%,#0D52D9_81.56%)]",
    "shadow-[0_1px_2px_rgba(0,0,0,0.12),0_5px_14px_-3px_rgba(10,114,255,0.35),inset_0_1px_0_rgba(255,255,255,0.22)]",
    "hover:shadow-[0_2px_5px_rgba(0,0,0,0.14),0_10px_22px_-4px_rgba(10,114,255,0.45),inset_0_1px_0_rgba(255,255,255,0.28)]",
    "dark:shadow-[0_1px_2px_rgba(0,0,0,0.45),0_5px_16px_-3px_rgba(59,130,246,0.5),inset_0_1px_0_rgba(255,255,255,0.18)]",
    "dark:hover:shadow-[0_2px_6px_rgba(0,0,0,0.55),0_12px_26px_-4px_rgba(59,130,246,0.6),inset_0_1px_0_rgba(255,255,255,0.26)]",
  ),
  secondary: cn(
    "text-text font-semibold rounded-lg border",
    "bg-background border-border shadow-xs hover:bg-background-subtle hover:border-border/70 hover:shadow-sm",
    "dark:bg-white/[0.06] dark:border-white/[0.10] dark:shadow-[inset_0_1px_0_rgba(255,255,255,0.07)]",
    "dark:hover:bg-white/[0.10] dark:hover:border-white/[0.16] dark:hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.10)]",
  ),
  overlay: cn(
    "font-semibold bg-white/85 text-black backdrop-blur-md ring-1 ring-black/[0.06]",
    "shadow-[0_2px_8px_rgba(0,0,0,0.25),inset_0_1px_0_rgba(255,255,255,0.5)]",
    "hover:bg-white hover:shadow-[0_4px_14px_rgba(0,0,0,0.3),inset_0_1px_0_rgba(255,255,255,0.6)]",
  ),
};

const layoutClasses = isIconOnly
  ? iconOnlySizeClasses[size]
  : sizeClasses[size];

const baseClasses = cn(
  "inline-flex items-center justify-center rounded-xl font-[590] cursor-pointer",
  "transition-[scale,box-shadow,background-color,border-color] duration-200 ease-out motion-reduce:transition-none",
  "active:scale-[0.96] active:shadow-sm motion-reduce:active:scale-100",
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
  "disabled:opacity-60 disabled:cursor-not-allowed disabled:shadow-none disabled:active:scale-100",
  layoutClasses,
  variantClasses[variant],
  className,
);

// Icon-only buttons need an accessible name; fall back to title if no aria-label.
const accessibleLabel = ariaLabel ?? (isIconOnly ? title : undefined);

const isStroke = iconType === "stroke";
---

{
  type === "link" ? (
    <a
      href={disabled ? undefined : href}
      target={target}
      rel={rel}
      class={baseClasses}
      id={id}
      title={title}
      aria-label={accessibleLabel}
      aria-disabled={disabled || undefined}
      tabindex={disabled ? -1 : undefined}
      onclick={onclick}
      download={download}
    >
      {icon && (
        <svg
          class={iconSizeClasses[size]}
          fill={isStroke ? "none" : "currentColor"}
          stroke={isStroke ? "currentColor" : "none"}
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap={isStroke ? "round" : undefined}
            stroke-linejoin={isStroke ? "round" : undefined}
            stroke-width={isStroke ? 2 : undefined}
            d={icon}
          />
        </svg>
      )}
      {text}
    </a>
  ) : (
    <button
      disabled={disabled}
      type={type === "submit" ? "submit" : "button"}
      class={baseClasses}
      id={id}
      title={title}
      aria-label={accessibleLabel}
    >
      {icon && (
        <svg
          class={iconSizeClasses[size]}
          fill={isStroke ? "none" : "currentColor"}
          stroke={isStroke ? "currentColor" : "none"}
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap={isStroke ? "round" : undefined}
            stroke-linejoin={isStroke ? "round" : undefined}
            stroke-width={isStroke ? 2 : undefined}
            d={icon}
          />
        </svg>
      )}
      {text}
    </button>
  )
}
