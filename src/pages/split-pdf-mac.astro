---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import PricingSection from "../components/PricingSection.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import ComparisonHero from "../components/ComparisonHero.astro";
import CardGrid from "../components/CardGrid.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import SectionHeading from "../components/SectionHeading.astro";

const title = "Picmal: Split PDF on Mac, by page ranges or every page";
const description =
  "Split a PDF on your Mac by page ranges or into single pages, batch, offline, no upload. $19 one-time, no subscription.";

const faqs = [
  {
    question: "How do I split a PDF on my Mac?",
    answer:
      "Drop the PDF into Picmal, choose how to split it, either by page ranges or one file per page, and click Split. Picmal writes out the new PDFs right there. It all runs on your Mac. A lot of people try to do this in Preview first, dragging thumbnails around, but it gets fiddly fast. Picmal makes it one step.",
  },
  {
    question: "Can I split by specific page ranges?",
    answer:
      "Yes. Type the ranges you want, like 1-3,5,8- and Picmal gives you one PDF per range. The 8- shorthand means page 8 to the end, so you can pull out exactly the sections you need in a single pass.",
  },
  {
    question: "Can I extract every page as its own file?",
    answer:
      "Yes. Pick burst mode and Picmal splits the PDF so every page becomes its own separate PDF, numbered in order. Handy when you need to hand off pages one at a time.",
  },
  {
    question: "Does splitting a PDF lose quality?",
    answer:
      "No. Picmal copies the pages as they are, so the text stays sharp and selectable and images keep their original quality. Splitting just separates the pages, it doesn't re-render or recompress them.",
  },
  {
    question: "Can I split a PDF from Shortcuts?",
    answer:
      "Yes. Picmal ships a Split PDF action for the Shortcuts app, so you can build a one-click workflow or a Quick Action in Finder that splits PDFs without opening the app.",
  },
  {
    question: "Can I split a whole batch of PDFs at once?",
    answer:
      "Yes. Drag in several PDFs or a whole folder and Picmal splits all of them in one pass, each set of output files saved alongside its source.",
  },
  {
    question: "Are my PDFs uploaded anywhere?",
    answer:
      "No. Everything happens locally on your Mac. No uploads, no per-file limits, nothing leaves your machine. It's a one-time $19, not a subscription.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <ComparisonHero
      title="Split a PDF on your Mac"
      subhead="Break a PDF into pieces by page ranges, or burst every page into its own file. Great for pulling one section out of a long document or splitting a scan into single pages. Batch, offline, no upload."
      buyEvent="buy_clicked_split_pdf_mac"
      defaultTab="pdf"
    />

    <!-- How It Works -->
    <CardGrid
      heading="Split a PDF in 3 steps"
      numbered
      items={[
        {
          title: "Drop your PDF",
          description: "Drag in one file or a whole folder of documents.",
        },
        {
          title: "Choose how to split",
          description:
            "Enter page ranges like 1-3,5,8- or pick burst to get one file per page.",
        },
        {
          title: "Split",
          description:
            "Click Split and Picmal writes the new PDFs. It all runs on your Mac.",
        },
      ]}
    />

    <!-- Why Picmal -->
    <CardGrid
      heading="Split by range, or burst the whole thing"
      items={[
        {
          title: "Split by page ranges",
          description:
            "Type ranges like 1-3,5,8- and get one PDF per range. Pull out exactly the sections you need.",
        },
        {
          title: "Burst into single pages",
          description:
            "Turn a PDF into one file per page, numbered in order, in a single pass.",
        },
        {
          title: "Batch a whole folder",
          description:
            "Split dozens of PDFs at once, each set of output files saved next to its source.",
        },
        {
          title: "Stays on your Mac",
          description:
            "No uploads, no per-file limits, nothing leaves your machine. Just drag, click, done.",
        },
      ]}
      linkText="Need to combine PDFs instead? Merge PDF on Mac"
      linkHref="/merge-pdf-mac"
    />

    <MasonryTestimonials />

    <PricingSection />

    <Section id="faq" width="narrow">
      <SectionHeading
        sublead="Something not covered here? Write to support@picmal.app"
      >
        Frequently Asked Questions
      </SectionHeading>
      <Card>
        <FAQ faqs={faqs} />
      </Card>
    </Section>

    <Footer />
    <SupportedFormatsModal />
  </body>
</html>
