---
// ponytail: analytics is Seline (prod only). Events fire via window.seline?.track(...)
---

{
  import.meta.env.PROD && (
    <script
      is:inline
      async
      src="https://cdn.seline.com/seline.js"
      data-token="0545957829e3e8e"
      data-cookie="true"
    />
  )
}

<!-- Affonso affiliate tracking, first-party mode: content blockers block
     *.affonso.io, so the pixel loads and reports through our /r proxy
     (functions/r/[[path]].js). The cookie window is an Affonso program
     setting, not something to edit here. -->
{
  import.meta.env.PROD && (
    <script
      is:inline
      async
      defer
      src="/r/pixel.js"
      data-affonso="cmsv7goeg000f7f4l751rl9f8"
      data-cookie_duration="60"
      data-api-base="/r"
    />
  )
}

<!--
  Affiliate attribution: capture ?ref=CODE into a 60-day first-party cookie, then
  append ref=<code> to every /api/checkout link. licencio resolves the code to an
  approved Affiliate and freezes commission at sale time (unknown codes ignored).

  Purchase attribution: data-cookie above makes Seline store its visitor id in a
  first-party seline_vid cookie, sent on as client_reference_id (there is no
  login, so no email to identify with). Seline only reads the Checkout Session
  metadata key seline_visitor_id, so licencio copies client_reference_id into
  that metadata key when it builds the session.
-->
<script is:inline>
  try {
    var refParam = new URLSearchParams(location.search).get("ref");
    if (refParam)
      document.cookie =
        "ref=" +
        encodeURIComponent(refParam) +
        "; max-age=5184000; path=/; samesite=lax"; // 60 days
  } catch (_) {}

  document.addEventListener(
    "click",
    function (e) {
      var a = e.target.closest && e.target.closest('a[href*="/api/checkout"]');
      if (!a) return;
      try {
        var url = new URL(a.href);
        var ref = document.cookie.match(/(?:^|;\s*)ref=([^;]*)/);
        if (ref) url.searchParams.set("ref", decodeURIComponent(ref[1]));
        // Read at click time, not page load. getVisitorId() is the documented
        // way to get it (seline.com/docs/stripe) and it answers as soon as
        // seline.js has an id — including on a first-ever visit, where the
        // seline_vid cookie has not come back from the pageview response yet.
        // The cookie alone lost exactly those first clicks; it stays on as the
        // fallback, since it still holds a valid id from an earlier visit when
        // seline.js is blocked or has not finished loading.
        var vid =
          (window.seline &&
            window.seline.getVisitorId &&
            window.seline.getVisitorId()) ||
          (document.cookie.match(/(?:^|;\s*)seline_vid=([^;]*)/) || [])[1];
        if (vid)
          url.searchParams.set("client_reference_id", decodeURIComponent(vid));
        // Affonso attribution: its pixel drops an affonso_referral cookie on
        // this domain; licencio must copy this param into the Checkout
        // Session's metadata.affonso_referral for commissions to attribute.
        var aff = document.cookie.match(/(?:^|;\s*)affonso_referral=([^;]*)/);
        if (aff)
          url.searchParams.set("affonso_referral", decodeURIComponent(aff[1]));
        a.href = url.toString();
      } catch (_) {}
    },
    true,
  );
</script>
