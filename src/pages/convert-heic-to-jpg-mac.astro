---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Paragraph from "../components/Paragraph.astro";
import Button from "../components/Button.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import CTASection from "../components/CTASection.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import TrustBar from "../components/TrustBar.astro";
import SectionDivider from "../components/SectionDivider.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";

const title = "How to Convert HEIC to JPG on Mac — 4 Methods | Picmal";
const description = "Learn how to convert HEIC to JPG on Mac using Picmal, Preview, Automator, and Finder. Step-by-step guide with batch conversion tips.";

const faqs = [
  {
    question: "What's the fastest way to convert HEIC to JPG on Mac?",
    answer: "For a single file, use Preview (File > Export > JPEG). For batch conversion of multiple files, Picmal is the fastest — drag, drop, and convert hundreds of files at once.",
  },
  {
    question: "Can I stop my iPhone from saving photos as HEIC?",
    answer: "Yes. Go to Settings > Camera > Formats and select 'Most Compatible'. Your iPhone will save photos as JPG going forward. Existing HEIC photos will need to be converted.",
  },
  {
    question: "Does macOS have a built-in HEIC to JPG converter?",
    answer: "Preview can export individual files as JPG. Automator can batch convert with some setup. For a simple drag-and-drop batch solution, Picmal is the easiest option.",
  },
  {
    question: "Will converting HEIC to JPG increase file size?",
    answer: "Usually yes. HEIC files are about 50% smaller than JPG at the same quality. A 2MB HEIC photo might become a 3-4MB JPG. You can use Picmal's quality slider to control the output size.",
  },
  {
    question: "Can I convert HEIC to JPG without installing anything?",
    answer: "Yes — Preview is built into macOS. Open the HEIC file in Preview, go to File > Export, choose JPEG, and save. But this only works for one file at a time.",
  },
  {
    question: "How do I batch convert HEIC to JPG?",
    answer: "With Picmal: open the app, drag and drop all your HEIC files or folders, select JPG output, and click Convert. All files are processed at once with individual progress tracking.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "How to Convert HEIC to JPG on Mac",
  description: "4 methods to convert HEIC photos to JPG on your Mac.",
  step: [
    { "@type": "HowToStep", name: "Method 1: Picmal (batch)", text: "Open Picmal, drag and drop HEIC files, select JPG, and click Convert. Best for multiple files." },
    { "@type": "HowToStep", name: "Method 2: Preview (single file)", text: "Open HEIC in Preview, go to File > Export, choose JPEG format, and save." },
    { "@type": "HowToStep", name: "Method 3: Automator", text: "Create an Automator workflow with 'Change Type of Images' action set to JPEG." },
    { "@type": "HowToStep", name: "Method 4: Finder Quick Action", text: "Right-click HEIC files in Finder, select Quick Actions > Convert Image, choose JPEG." },
  ],
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  </head>

  <body class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden">
    <div class="fixed inset-0 -z-20 apple-gradient"></div>
    <Header />

    <main id="main-content" class="relative z-10 pt-32 pb-16">
      <div class="max-w-4xl mx-auto px-6">
        <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "How to Convert HEIC to JPG on Mac" }]} />

        <div class="text-center mb-12">
          <H1 class="mb-6 max-w-3xl mx-auto">How to convert HEIC to JPG on Mac</H1>
          <Paragraph class="max-w-2xl mx-auto mb-8">
            4 ways to convert HEIC photos to JPG on your Mac — from built-in tools for single files to Picmal for batch converting hundreds at once.
          </Paragraph>
          <div class="flex flex-col sm:flex-row gap-3 items-center justify-center mb-6">
            <Button text="Get Picmal for $15.99" onclick="posthog.capture('buy_clicked_convert_heic_to_jpg_mac')" class="apple-button-primary" />
            <a href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg" class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-base py-3 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto">
              <svg class="size-4 inline-block mr-2" fill="currentColor" stroke="none" viewBox="0 0 24 24" aria-hidden="true"><path d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8 4.35 4.35 0 0 1-2.59-4.03z"></path></svg>
              Download
            </a>
          </div>
          <TrustBar />
        </div>

        <!-- Method 1: Picmal -->
        <section class="mb-12">
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8">
            <H2 class="mb-4">Method 1: Picmal (best for batch)</H2>
            <Paragraph class="mb-6">
              Picmal is the fastest way to batch convert HEIC to JPG on Mac. Drag and drop hundreds of files and convert them all at once.
            </Paragraph>
            <ol class="space-y-3 list-decimal list-inside text-text">
              <li>Download and open Picmal</li>
              <li>Drag and drop your HEIC files or folders into the app</li>
              <li>Select JPG as the output format</li>
              <li>Adjust quality with the slider (90%+ recommended)</li>
              <li>Click Convert — all files are processed at once</li>
            </ol>
          </div>
        </section>

        <!-- Method 2: Preview -->
        <section class="mb-12">
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8">
            <H2 class="mb-4">Method 2: Preview (single files)</H2>
            <Paragraph class="mb-6">
              macOS Preview can convert individual HEIC files. Good for one-off conversions.
            </Paragraph>
            <ol class="space-y-3 list-decimal list-inside text-text">
              <li>Open your HEIC file in Preview (double-click it)</li>
              <li>Go to File &gt; Export</li>
              <li>Change the format to JPEG</li>
              <li>Adjust quality and click Save</li>
            </ol>
            <Paragraph class="mt-4 text-sm">
              Limitation: Preview only handles one file at a time. For multiple files, use Picmal or Automator.
            </Paragraph>
          </div>
        </section>

        <!-- Method 3: Automator -->
        <section class="mb-12">
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8">
            <H2 class="mb-4">Method 3: Automator (requires setup)</H2>
            <Paragraph class="mb-6">
              Automator can batch convert files but requires creating a workflow first.
            </Paragraph>
            <ol class="space-y-3 list-decimal list-inside text-text">
              <li>Open Automator and create a new "Quick Action"</li>
              <li>Add the "Change Type of Images" action</li>
              <li>Set the type to JPEG</li>
              <li>Save the workflow</li>
              <li>Right-click HEIC files in Finder and select your workflow</li>
            </ol>
            <Paragraph class="mt-4 text-sm">
              Limitation: Requires one-time setup. No quality control or progress tracking.
            </Paragraph>
          </div>
        </section>

        <!-- Method 4: Finder -->
        <section class="mb-12">
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8">
            <H2 class="mb-4">Method 4: Finder Quick Action (macOS 12+)</H2>
            <Paragraph class="mb-6">
              macOS Monterey and later include a built-in Quick Action for image conversion.
            </Paragraph>
            <ol class="space-y-3 list-decimal list-inside text-text">
              <li>Select HEIC files in Finder</li>
              <li>Right-click and choose Quick Actions &gt; Convert Image</li>
              <li>Select JPEG and your preferred size</li>
              <li>Click Convert</li>
            </ol>
            <Paragraph class="mt-4 text-sm">
              Limitation: Limited format options and no quality slider. Best for quick, simple conversions.
            </Paragraph>
          </div>
        </section>

        <!-- Comparison -->
        <section class="mb-12">
          <H2 class="mb-6 text-center">Which method should you use?</H2>
          <div class="bg-background-subtle/50 border border-border rounded-xl p-4 md:p-8">
            <div class="overflow-x-auto">
              <table class="w-full border-collapse">
                <thead>
                  <tr class="border-b border-border">
                    <th class="text-left p-3 font-semibold text-text">Method</th>
                    <th class="text-left p-3 font-semibold text-text">Batch</th>
                    <th class="text-left p-3 font-semibold text-text">Quality control</th>
                    <th class="text-left p-3 font-semibold text-text">Setup</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border">
                  <tr>
                    <td class="p-3 text-text">Picmal</td>
                    <td class="p-3 text-text">Unlimited</td>
                    <td class="p-3 text-text">Yes (slider)</td>
                    <td class="p-3 text-text">None</td>
                  </tr>
                  <tr>
                    <td class="p-3 text-text">Preview</td>
                    <td class="p-3 text-text-secondary">One at a time</td>
                    <td class="p-3 text-text">Yes</td>
                    <td class="p-3 text-text">None</td>
                  </tr>
                  <tr>
                    <td class="p-3 text-text">Automator</td>
                    <td class="p-3 text-text">Yes</td>
                    <td class="p-3 text-text-secondary">No</td>
                    <td class="p-3 text-text-secondary">Requires workflow</td>
                  </tr>
                  <tr>
                    <td class="p-3 text-text">Finder Quick Action</td>
                    <td class="p-3 text-text">Yes</td>
                    <td class="p-3 text-text-secondary">No</td>
                    <td class="p-3 text-text">None (macOS 12+)</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <CTASection
          heading="Convert HEIC to JPG the easy way"
          analyticsEvent="buy_clicked_convert_heic_to_jpg_mac_bottom"
        />
      </div>
    </main>

    <SectionDivider />

    <section id="faq" class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-8 text-center">Frequently Asked Questions</H2>
        <div class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8">
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />
    <SupportedFormatsModal />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "picmal" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
