---
export const faqs = [
  // Eight, down from thirteen (Sep 2026). The license question folded into the
  // trial one, "internet connection" into "where are my files processed",
  // "compress videos and audio" into "compress without converting", and the
  // resize and PDF questions went: the feature grid above answers both.
  {
    question: "Is there a free trial?",
    answer:
      "Yes. Download the app and press Try free: 7 days with every tool, on that Mac, no card and no account. After that it's $29 once, paste the key in and it's yours, no recurring fees. And if it's not for you, email support@picmal.app within 14 days for a full refund.",
  },
  {
    question: "Is Picmal available for Windows or Linux?",
    answer: "Mac only. No plans to change that.",
  },
  {
    question: "What formats does Picmal support?",
    answer:
      "Over 100. On the image side: JPEG, PNG, WebP, AVIF, HEIC, PSD, RAW, SVG, PDF, and more. Video: MP4, MOV, AVI, MKV, WebM, and others. Audio: MP3, WAV, AAC, FLAC, OGG, OPUS, plus a bunch more.",
  },
  {
    question: "Where are my files processed?",
    answer:
      "On your Mac. Nothing gets uploaded, and once it's installed Picmal runs entirely offline.",
  },
  {
    question: "Can I convert multiple files at once?",
    answer:
      "Yes. Drag in a pile of files or whole folders and convert them all at once. Each file shows its own progress so you can see what's happening.",
  },
  {
    question: "Can I compress without converting?",
    answer:
      "Yes. Pick Compress, set the quality slider, and the file stays in its original format, just smaller. Images, video (H.264), audio (AAC) and PDFs.",
  },
  {
    question: "Can I remove metadata from my files?",
    answer:
      "Yes. Picmal strips GPS coordinates, camera info and timestamps from images. Smaller files, less data floating around.",
  },
  {
    question: "What macOS versions are supported?",
    answer:
      "macOS 15.0 (Sequoia) or later. Runs natively on Apple Silicon and works fine on Intel Macs too. If you're on an older version, update macOS to install the latest Picmal.",
  },
];

// Pages with their own FAQ block pass it in so the schema matches the visible content.
const pageFaqs = Astro.props.faqs ?? faqs;

// FAQ.astro renders answers with set:html, so some answers carry an <a>.
// Schema wants the text, not the markup.
const stripHtml = (html: string) =>
  html
    .replace(/<[^>]*>/g, "")
    .replace(/&nbsp;/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: pageFaqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: stripHtml(faq.answer),
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
