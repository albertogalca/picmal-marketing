---
import Button from "./Button.astro";

interface Props {
  /** PostHog event fired on the buy click, e.g. "buy_clicked_video_converter_mac" */
  buyEvent: string;
  /** PostHog event fired on the download click */
  downloadEvent?: string;
  /** Extra classes for the wrapper (e.g. "mb-6" for spacing before the trust bar) */
  class?: string;
}

const {
  buyEvent,
  downloadEvent = "download_clicked",
  class: className = "",
} = Astro.props;

// Download is the locked demo — keep it as a quiet text link so it never
// competes with the buy CTA, and route it through the branded /download page
// that sets license expectations. See CRO audit (June 2026).
const DOWNLOAD_URL = "/download";
---

<div class:list={["flex flex-col items-center gap-3", className]}>
  <Button
    text="Get Picmal for $15.99"
    class="w-full sm:w-auto"
    onclick={`posthog.capture('${buyEvent}')`}
  />
  <a
    href={DOWNLOAD_URL}
    class="inline-flex items-center gap-1.5 text-small text-text-secondary hover:text-text transition-colors rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    onclick={`posthog.capture('${downloadEvent}')`}
  >
    or download to take a look
    <span aria-hidden="true">&rarr;</span>
  </a>
</div>
