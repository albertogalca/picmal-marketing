---
import { Image } from "astro:assets";
import H3 from "./H3.astro";
import Button from "./Button.astro";
import Paragraph from "./Paragraph.astro";

export interface Props {
  showImage?: boolean;
  variant?: "dark" | "light";
  title?: string;
  description?: string;
  buttonText?: string;
  className?: string;
}

const {
  showImage = true,
  variant = "dark",
  title = "Use Picmal to easily convert images on your Mac",
  description = "If you're not happy with your purchase, you can request a refund within 14 days.",
  buttonText = "Buy now",
  className = "",
} = Astro.props;

const isDark = variant === "dark";
---

<div
  class={`relative bg-background-subtle rounded-lg p-6 sm:p-8 overflow-hidden ${className}`}
>
  <!-- Picmal app interface - hidden on mobile -->
  {
    showImage && (
      <div class="absolute -bottom-30 -right-40 hidden md:block border border-text-secondary/10 rounded-lg">
        <Image
          src="/convert_demo.png"
          alt="Picmal App Interface"
          width={480}
          height={360}
          class="w-130 h-auto rounded-tl-lg"
        />
      </div>
    )
  }

  <!-- Content -->
  <div class="relative z-10 max-w-full sm:max-w-md md:max-w-xs text-left">
    <H3 class="mb-2">
      {title}
    </H3>
    <Paragraph class="mb-8 text-text-secondary">
      {description}
    </Paragraph>
    <Button text={buttonText} />
  </div>
</div>
