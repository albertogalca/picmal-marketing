---
import BaseHead from "./BaseHead.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import H1 from "./H1.astro";
import Paragraph from "./Paragraph.astro";

export interface Props {
  meta: {
    title: string;
    description: string;
    date: string;
  };
}

const { meta } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={meta.title} description={meta.description} />
  </head>
  <body class="bg-background">
    <Header />

    <!-- Back to Home Link -->
    <div class="relative z-10 px-6 pt-32 pb-6">
      <div class="max-w-4xl mx-auto">
        <a
          href="/"
          class="inline-flex items-center text-small transition-colors cursor-pointer text-text-secondary hover:text-text"
        >
          ← Back to home
        </a>
      </div>
    </div>

    <!-- Page Content -->
    <article class="relative z-10 px-6 pb-20">
      <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <header class="mb-8">
          <H1 class="mb-4">
            {meta.title}
          </H1>
          <Paragraph size="small">
            {meta.date}
          </Paragraph>
        </header>

        <!-- Content -->
        <div
          class="prose prose-muted max-w-none
              prose-headings:text-text prose-headings:font-semibold
              prose-p:text-text/65 prose-p:leading-relaxed
              prose-strong:text-text
              prose-code:text-accent prose-code:bg-gray-100
              prose-pre:bg-black
              prose-blockquote:border-l-accent prose-blockquote:text-text-secondary prose-blockquote:bg-background-subtle
              prose-th:text-text
              prose-td:text-text/65
              prose-ul:text-text/65
              prose-ol:text-text/65
              prose-li:text-text/65
              prose-img:rounded-lg"
        >
          <slot />
        </div>
      </div>
    </article>

    <Footer />
  </body>
</html>
