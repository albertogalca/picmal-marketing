---
import DynamicPricing from "./DynamicPricing.astro";
import FAQ from "./FAQ.astro";
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";

const pricingBlurb =
  "One purchase includes all updates. If you change your mind, you can ask for a refund within 14 days.";

const licenseFaqs = [
  {
    question: "How does the license work?",
    answer:
      "You pay once and keep it. No renewals, no subscriptions. The license activates on one Mac at a time, but you can move it between machines whenever you want.",
  },
  {
    question: "How many devices can I use Picmal on?",
    answer:
      "Depends on the tier you pick: 1, 2, 3, or 5 Macs. You can swap between machines anytime.",
  },
  {
    question: "What happens if I get a new Mac?",
    answer:
      "Open Picmal on your old Mac, go to Picmal → Register license to deactivate, then activate on the new one. Takes about ten seconds.",
  },
  {
    question: "Can I get a refund?",
    answer: "14 days, no questions asked. Email support@picmal.app.",
  },
];
---

<Section id="pricing" width="medium" bg="subtle">
  <!-- Mobile-only Pricing Header -->
  <SectionHeading
    class="md:hidden"
    headingClass="text-pretty"
    subleadClass="max-w-md"
    sublead={pricingBlurb}
  >
    Pay once and you're all set
  </SectionHeading>

  <div
    class="flex flex-col md:flex-row justify-between gap-12 md:gap-16 items-center md:items-start"
  >
    <!-- Pricing Card -->
    <div class="w-full max-w-md md:max-w-none md:w-auto order-1 md:order-2">
      <div class="md:sticky md:top-8">
        <DynamicPricing />
      </div>
    </div>

    <!-- Benefits & FAQ -->
    <div class="w-full md:max-w-md text-left order-2 md:order-1 space-y-6">
      <SectionHeading
        align="left"
        class="hidden md:block mb-0"
        headingClass="text-pretty"
        sublead={pricingBlurb}
      >
        Pay once and you're all set
      </SectionHeading>
      <FAQ faqs={licenseFaqs} />
    </div>
  </div>
</Section>
