---
import H2 from "./H2.astro";
import Paragraph from "./Paragraph.astro";

interface Item {
  title: string;
  description: string;
}

interface Props {
  /** Section heading (H2) */
  heading?: string;
  /** Optional intro paragraph under the heading */
  intro?: string;
  /** Show numbered circles (1, 2, 3…) and center each card */
  numbered?: boolean;
  /** The cards */
  items: Item[];
  /** Optional trailing centered link text (arrow appended automatically) */
  linkText?: string;
  /** Trailing link href */
  linkHref?: string;
  /** Drop the section's own padding/width chrome so it slots into an existing container */
  bare?: boolean;
  /** Extra classes on the <section> */
  class?: string;
}

const {
  heading,
  intro,
  numbered = false,
  items,
  linkText,
  linkHref,
  bare = false,
  class: className = "",
} = Astro.props;

// 3+ items → up to 3 columns; 2 items → 2 columns. 4 is the exception: three
// columns leave the fourth card alone on its own row next to a hole, so 4 sits
// as a 2x2 block.
const colClass =
  items.length >= 3 && items.length !== 4
    ? "sm:grid-cols-2 lg:grid-cols-3"
    : "sm:grid-cols-2";
---

<section class:list={[!bare && "relative z-10 px-6 py-16 sm:py-20", className]}>
  <div class:list={[!bare && "max-w-6xl mx-auto"]}>
    {heading && <H2 class:list={[intro ? "mb-4" : "mb-8", "text-center"]}>{heading}</H2>}
    {
      intro && (
        <Paragraph class="mb-8 text-center max-w-2xl mx-auto">{intro}</Paragraph>
      )
    }

    <div class:list={["grid gap-6", colClass]}>
      {
        items.map((item, i) => (
          <div
            class:list={[
              "bg-background-subtle/40 border border-border rounded-2xl p-7",
              numbered && "text-center",
            ]}
          >
            {numbered && (
              <div class="w-11 h-11 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-5 text-h4 font-semibold tabular-nums">
                {i + 1}
              </div>
            )}
            <h3 class="text-h4 text-text mb-2">{item.title}</h3>
            <Paragraph class="text-text-secondary">{item.description}</Paragraph>
          </div>
        ))
      }
    </div>

    {
      linkText && linkHref && (
        <div class="text-center mt-8">
          <a href={linkHref} class="text-small text-accent hover:underline">
            {linkText} <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      )
    }
  </div>
</section>
