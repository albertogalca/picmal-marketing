---
import testimonials from "../data/testimonials.json";
import H2 from "./H2.astro";
import TestimonialCard from "./TestimonialCard.astro";
import TrustBar from "./TrustBar.astro";
import Section from "./Section.astro";

interface Props {
  heading?: string;
  showTrustBar?: boolean;
  trustSuffix?: string;
}
const { heading, showTrustBar = false, trustSuffix } = Astro.props;

const userTestimonials = testimonials.filter((t) => t.type !== "press");

const reviewSchemas = userTestimonials.map((t) => ({
  "@type": "Review",
  author: { "@type": "Person", name: t.name },
  reviewBody: t.content,
  reviewRating: {
    "@type": "Rating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "1",
  },
}));

const aggregateRatingSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Picmal",
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.8",
    reviewCount: String(userTestimonials.length),
    bestRating: "5",
    worstRating: "1",
  },
  review: reviewSchemas,
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(aggregateRatingSchema)}
/>

<Section id="testimonials" width="wide">
  <div class="text-center mb-12">
    {
      heading ? (
        <>
          <H2 class="mb-6 max-w-3xl mx-auto">{heading}</H2>
          {showTrustBar && <TrustBar prefix="" suffix={trustSuffix} />}
        </>
      ) : (
        <>
          <H2 class="mb-6 max-w-3xl mx-auto">
            What people are <br /> saying about Picmal
          </H2>
          {showTrustBar && <TrustBar prefix="" suffix={trustSuffix} />}
        </>
      )
    }
  </div>

  <div class="masonry-grid">
    {
      testimonials.map((testimonial) => {
        const isPress = testimonial.type === "press";
        const hasLink = !!testimonial.link;
        const wrapAsLink = hasLink && !isPress;
        const CardWrapper = wrapAsLink ? "a" : "div";

        return (
          <div class="masonry-item">
            <CardWrapper
              href={wrapAsLink ? testimonial.link : undefined}
              target={wrapAsLink ? "_blank" : undefined}
              rel={wrapAsLink ? "nofollow noreferrer" : undefined}
              class:list={[
                "block",
                wrapAsLink &&
                  "rounded-xl cursor-pointer hover:opacity-80 active:scale-[0.98] transition-[opacity,scale] duration-200 ease-out motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50",
              ]}
            >
              <TestimonialCard testimonial={testimonial} align="left" />
            </CardWrapper>
          </div>
        );
      })
    }
  </div>
</Section>

<style>
  .masonry-grid {
    columns: 1;
    column-gap: 3rem;
  }

  @media (min-width: 640px) {
    .masonry-grid {
      columns: 2;
    }
  }

  @media (min-width: 1024px) {
    .masonry-grid {
      columns: 3;
    }
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 3rem;
  }
</style>
