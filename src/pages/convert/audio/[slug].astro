---
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import FAQ from "../../../components/FAQ.astro";
import CardGrid from "../../../components/CardGrid.astro";
import ComparisonHero from "../../../components/ComparisonHero.astro";
import ProductSchema from "../../../components/schema/ProductSchema.astro";
import Section from "../../../components/Section.astro";
import Card from "../../../components/Card.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import BenefitsCard from "../../../components/BenefitsCard.astro";
import ConversionGrid from "../../../components/ConversionGrid.astro";
import {
  audioConversions,
  audioFormats,
  getRelatedAudioConversions,
  isAudioConversionIndexed,
} from "../../../data/audioConversions";

export function getStaticPaths() {
  return audioConversions.map((c) => ({
    params: { slug: c.slug },
    props: { conversion: c },
  }));
}

const { conversion } = Astro.props;

// Blog post cross-links for audio conversion pages
const blogGuides: Record<string, { title: string; slug: string }> = {
  "flac-to-alac": {
    title: "How to Convert FLAC to ALAC on Mac (4 Free Methods)",
    slug: "convert-flac-to-alac-mac",
  },
  "wav-to-mp3": {
    title: "How to Convert WAV to MP3 on Mac (3 Free Methods)",
    slug: "convert-wav-to-mp3-mac",
  },
};
const blogGuide = blogGuides[conversion.slug];
const from = audioFormats[conversion.from];
const to = audioFormats[conversion.to];
const related = getRelatedAudioConversions(conversion.slug, 6);

const title = conversion.metaTitle;
const description = conversion.metaDescription;

// Low-demand templated pairs are de-indexed to concentrate site quality on winners.
const noindex = !isAudioConversionIndexed(conversion.slug);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: conversion.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <main id="main-content">
    <ComparisonHero
      pricingHref="/#pricing"
      title={`Convert ${from.name} to ${to.name} on Mac`}
      subhead={conversion.whyConvert}
      buyEvent={`buy_clicked_audio_${conversion.slug}`}
      defaultTab="convert"
    />

    <!-- Benefits -->
    <Section width="narrow">
      <BenefitsCard
        heading={`Why convert ${from.name} to ${to.name} with Picmal`}
        benefits={conversion.benefits}
      />
    </Section>

    <!-- How it works -->
    <CardGrid
      numbered
      heading="Convert in 3 steps"
      items={[
        {
          title: `Drop your ${from.name} files`,
          description: "Drag and drop one file or a whole folder.",
        },
        {
          title: `Choose ${to.name}`,
          description: "Pick the output format and quality.",
        },
        {
          title: "Convert",
          description: "Click Convert. Everything runs on your Mac.",
        },
      ]}
    />

    <!-- FAQ -->
    <Section id="faq" width="narrow">
      <SectionHeading
        sublead="Something not covered here? Write to support@picmal.app"
      >
        Frequently Asked Questions
      </SectionHeading>
      <Card>
        <FAQ faqs={conversion.faqs} />
      </Card>
    </Section>

    {
      blogGuide && (
        <Section width="narrow">
          <Card>
            <SectionHeading
              align="left"
              class="mb-6"
              sublead="Step-by-step instructions with the free methods alongside Picmal."
            >
              In-depth guide
            </SectionHeading>
            <a
              href={`/blog/${blogGuide.slug}`}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-background border border-border text-small font-medium text-text hover:border-accent/30 hover:bg-accent/[0.03] transition-colors duration-200 motion-reduce:transition-none"
            >
              Read: {blogGuide.title} &rarr;
            </a>
          </Card>
        </Section>
      )
    }

    <!-- Related audio conversions -->
    <Section>
      <SectionHeading class="mb-8">More audio conversions</SectionHeading>
      <ConversionGrid
        links={related.map((c) => ({
          href: `/convert/audio/${c.slug}`,
          label: `${audioFormats[c.from].name} to ${audioFormats[c.to].name}`,
        }))}
        linkText="All audio conversions"
        linkHref="/audio-converter-mac"
      />
    </Section>

    </main>

    <Footer />
  </body>
</html>
