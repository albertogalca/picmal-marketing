---
import { Image } from "astro:assets";
import Paragraph from "./Paragraph.astro";
import users from "../data/users.json";
import { getGravatarUrl } from "../utils/gravatar";
import { getCustomerCount } from "../utils/lemonsqueezy";

const displayUsers = users.slice(0, 8);
const customerCount = await getCustomerCount();
---

<div class="flex flex-col md:flex-row items-center justify-center gap-3">
  <!-- Avatar Stack -->
  <div class="flex items-center -space-x-2">
    {
      displayUsers.map((user: any) => (
        <Image
          src={getGravatarUrl(user.email, 64)}
          alt=""
          width={32}
          height={32}
          class="w-8 h-8 rounded-full ring-2 ring-background object-cover"
          loading="eager"
        />
      ))
    }
  </div>

  <!-- Text -->
  <Paragraph size="small" class="text-text-secondary">
    Trusted by <span class="font-semibold text-text">{customerCount}+ Mac users</span>
  </Paragraph>
</div>
