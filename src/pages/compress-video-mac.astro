---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import H3 from "../components/H3.astro";
import Button from "../components/Button.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import Paragraph from "../components/Paragraph.astro";
import TrustBar from "../components/TrustBar.astro";
import SectionDivider from "../components/SectionDivider.astro";
import CTASection from "../components/CTASection.astro";
import BentoFeatures from "../components/BentoFeatures.astro";
import FeaturedOn from "../components/FeaturedOn.astro";

const SITE_TITLE = "Compress Video on Mac - Reduce File Size Up to 90%";
const SITE_DESCRIPTION =
  "Compress MOV, MP4, MKV, and other video files on Mac. Reduce file sizes by up to 90% while maintaining quality. Hardware-accelerated, batch processing, 100% offline.";

const faqs = [
  {
    question: "How much can I compress a video file?",
    answer:
      "Video compression results vary based on the original format and your quality settings. Typically, you can reduce file sizes by 50-90% while maintaining good visual quality. Modern codecs like H.265 (HEVC) and AV1 offer superior compression compared to H.264.",
  },
  {
    question: "Will video compression affect quality?",
    answer:
      "Picmal gives you full control over the quality-to-size tradeoff. You can preserve near-original quality or compress aggressively for smaller files. Hardware-accelerated encoding ensures optimal quality at any compression level.",
  },
  {
    question: "Can I compress 4K videos?",
    answer:
      "Yes! Picmal handles 4K and even 8K videos with hardware acceleration on Apple Silicon and Intel Macs. You can downscale to 1080p or 720p for dramatic file size reductions, or compress 4K while maintaining resolution.",
  },
  {
    question: "How long does video compression take?",
    answer:
      "Compression time depends on video length, resolution, and your Mac's specs. With VideoToolbox hardware acceleration, a 5-minute 1080p video typically compresses in 30-60 seconds. Batch compression processes multiple videos in parallel.",
  },
  {
    question: "What's the best format for compressed videos?",
    answer:
      "For maximum compression with good quality, use MP4 with H.265 (HEVC) codec. For web use, WebM with VP9 offers excellent compression. For universal compatibility, MP4 with H.264 works everywhere but produces larger files.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <link
      rel="preload"
      href="/picmal-1.2.0-demo.mp4"
      as="video"
      type="video/mp4"
    />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <!-- Subtle gradient background - Apple style -->
    <div class="fixed inset-0 -z-20 apple-gradient"></div>

    <Header />

    <!-- Hero Section -->
    <main id="main-content" class="relative z-10 pt-32 pb-12 sm:pb-16 md:pb-20">

      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-8 sm:mb-12">
          <div
            class="max-w-4xl mx-auto flex justify-center items-center flex-col"
          >
            <H1 class="mb-4 sm:mb-6 max-w-2xl mx-auto hero-title">
              Compress videos on Mac without losing quality
            </H1>
            <p
              class="mb-8 sm:mb-10 max-w-2xl mx-auto text-base sm:text-lg md:text-xl leading-relaxed text-text-secondary px-4 sm:px-0 hero-subtitle"
            >
              Reduce video file sizes by up to 90% with hardware-accelerated
              compression. Perfect for sharing, uploading, and storage. Works
              completely offline.
            </p>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col items-center gap-3 sm:gap-4 hero-cta">
            <div
              class="flex flex-col sm:flex-row gap-2 items-center justify-center"
            >
              <Button
                text="Get Picmal for $15.99"
                onclick="posthog.capture('buy_clicked_compress_video_mac')"
                class="apple-button-primary"
              />
              <a
                href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg"
                class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-base py-3 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto apple-button-secondary"
              >
                <svg
                  class="w-4 h-4 inline-block mr-2"
                  fill="currentColor"
                  stroke="none"
                  viewBox="0 0 24 24"
                  ><path
                    d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8a4.35 4.35 0 0 1-2.59-4.03z"
                  ></path></svg
                >
                Download for Mac
              </a>
            </div>
            <p class="text-xs sm:text-sm text-text-secondary">
              One-time purchase • 14-day money back • macOS 14+
            </p>
          </div>

          <!-- Social Proof -->
          <div class="mt-6 sm:mt-8 hero-trust">
            <TrustBar />
          </div>
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-5xl mx-auto mb-6 sm:mb-8 rounded-lg sm:rounded-xl overflow-hidden border border-border hero-video"
        >
          <div class="aspect-[16/10]">
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover block dark:hidden"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal video compression interface"
            >
            </video>
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover hidden dark:block"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal video compression interface"
            >
            </video>
          </div>
        </div>
      </div>
    </main>

    <SectionDivider />

    <!-- Features Section -->
    <BentoFeatures />

    <SectionDivider />

    <!-- Additional Features Section -->
    <section class="relative z-10 px-6 py-20">
      <div class="max-w-6xl mx-auto">
