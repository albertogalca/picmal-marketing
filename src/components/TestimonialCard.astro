---
import crypto from "crypto";
import { Image } from "astro:assets";
import Paragraph from "./Paragraph.astro";

interface Props {
  name: string;
  email?: string;
  content: string;
  image?: string;
  link?: string;
}

const { name, email, content, image, link } = Astro.props;

function getGravatarUrl(email: string, size: number = 80): string {
  const hash = crypto
    .createHash("md5")
    .update(email.toLowerCase().trim())
    .digest("hex");
  return `https://gravatar.com/avatar/${hash}?s=${size}&d=mp&r=g`;
}
---

<div
  class="rounded-lg p-6 md:p-8 min-w-[280px] max-w-[280px] md:min-w-[380px] md:max-w-[380px]"
>
  <!-- Quote -->
  <Paragraph class="mb-6 text-center">
    &ldquo;{content}&rdquo;
  </Paragraph>

  <!-- Author info -->
  <div class="flex items-center gap-4 justify-center">
    <Image
      src={image || getGravatarUrl(email || "", 80)}
      alt={`Photo of ${name}`}
      width={80}
      height={80}
      class="w-10 h-10 rounded-full flex-shrink-0"
      loading="lazy"
    />
    <div class="flex items-center gap-2">
      <Paragraph class="font-semibold">{name}</Paragraph>
      {
        link && (
          <a
            href={link}
            target="_blank"
            rel="nofollow noreferrer"
            class="inline-flex p-1 -m-1 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-current"
            aria-label={`View ${name}'s testimonial source`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 opacity-60 hover:opacity-100 transition-opacity"
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</div>
