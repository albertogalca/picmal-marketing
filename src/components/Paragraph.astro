---
import { cn } from "../utils/cn";

interface Props {
  class?: string;
  size?: "base" | "small" | "lead";
}

const { class: className, size = "base" } = Astro.props;

const sizeClasses = {
  base: "text-body",
  small: "text-small",
  lead: "text-body-big",
};

const defaultClasses = `${sizeClasses[size]} text-text-secondary text-pretty`;
const mergedClasses = cn(defaultClasses, className);
---

<p class={mergedClasses}>
  <slot />
</p>
