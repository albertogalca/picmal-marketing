---
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import FAQ from "../../../components/FAQ.astro";
import H1 from "../../../components/H1.astro";
import H2 from "../../../components/H2.astro";
import Paragraph from "../../../components/Paragraph.astro";
import Button from "../../../components/Button.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import ProductSchema from "../../../components/schema/ProductSchema.astro";
import TrustBar from "../../../components/TrustBar.astro";
import {
  videoConversions,
  videoFormats,
  getRelatedVideoConversions,
} from "../../../data/videoConversions";

export function getStaticPaths() {
  return videoConversions.map((c) => ({
    params: { slug: c.slug },
    props: { conversion: c },
  }));
}

const { conversion } = Astro.props;
const from = videoFormats[conversion.from];
const to = videoFormats[conversion.to];
const related = getRelatedVideoConversions(conversion.slug, 6);

const title = conversion.metaTitle;
const description = conversion.metaDescription;

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: `How to Convert ${from.name} to ${to.name} on Mac`,
  description,
  step: [
    {
      "@type": "HowToStep",
      name: "Open Picmal",
      text: "Download and open Picmal on your Mac.",
    },
    {
      "@type": "HowToStep",
      name: "Add your files",
      text: `Drag and drop your ${from.name} files into Picmal.`,
    },
    {
      "@type": "HowToStep",
      name: "Convert",
      text: `Select ${to.name} as the output format and click Convert.`,
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: conversion.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <main id="main-content" class="relative z-10 pt-32 pb-16 sm:pb-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <Breadcrumb
          items={[
            { label: "Home", href: "/" },
            { label: "Video Converter", href: "/video-converter-mac" },
            { label: `${from.name} to ${to.name}` },
          ]}
        />

        <!-- Hero -->
        <div class="text-center mb-16 sm:mb-20">
          <div class="flex items-center justify-center gap-3 mb-8">
            <span
              class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-background-subtle border border-border text-sm font-mono font-medium text-text tracking-wide"
            >
              .{from.extension}
            </span>
            <svg
              class="w-5 h-5 text-text-secondary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
            <span
              class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-accent/10 border border-accent/20 text-sm font-mono font-medium text-accent tracking-wide"
            >
              .{to.extension}
            </span>
          </div>

          <H1 class="mb-6 max-w-3xl mx-auto"
            >Convert {from.name} to {to.name} on Mac</H1
          >
          <Paragraph
            class="mb-6 sm:mb-8 max-w-xl mx-auto text-base sm:text-lg md:text-xl leading-relaxed text-text-secondary px-4 sm:px-0 text-pretty"
          >
            {conversion.whyConvert}
          </Paragraph>
          <div
            class="flex flex-col sm:flex-row gap-3 items-center justify-center mb-6"
          >
            <Button
              text="Get Picmal for $15.99"
              onclick={`posthog.capture('buy_clicked_video_${conversion.slug}')`}
            />
            <a
              href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg"
              class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-base py-3 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto"
            >
              <svg
                class="size-4 inline-block mr-2"
                fill="currentColor"
                stroke="none"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8 4.35 4.35 0 0 1-2.59-4.03z"
                ></path></svg
              >
              Download
            </a>
          </div>
          <TrustBar />
        </div>

        <!-- Benefits -->
        <section class="mb-16 sm:mb-20">
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8"
          >
            <H2 class="mb-6">Why convert {from.name} to {to.name} with Picmal</H2>
            <ul class="space-y-3">
              {
                conversion.benefits.map((benefit) => (
                  <li class="flex items-start gap-3">
                    <svg
                      class="w-5 h-5 text-accent shrink-0 mt-0.5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                    <span class="text-text-secondary">{benefit}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </section>

        <!-- How it works -->
        <section class="mb-16 sm:mb-20">
          <H2 class="mb-8 text-center">Convert in 3 steps</H2>
          <div class="grid md:grid-cols-3 gap-6">
            {
              [
                {
                  n: 1,
                  t: `Drop your ${from.name} files`,
                  d: "Drag and drop one file or a whole folder.",
                },
                {
                  n: 2,
                  t: `Choose ${to.name}`,
                  d: "Pick the output format and quality.",
                },
                {
                  n: 3,
                  t: "Convert",
                  d: "Click Convert — everything runs on your Mac.",
                },
              ].map((step) => (
                <div class="bg-background-subtle/50 border border-border rounded-xl p-6 text-center">
                  <div class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-4 font-semibold">
                    {step.n}
                  </div>
                  <h3 class="font-semibold text-text mb-2">{step.t}</h3>
                  <Paragraph>{step.d}</Paragraph>
                </div>
              ))
            }
          </div>
        </section>

        <!-- FAQ -->
        <section class="mb-16 sm:mb-20">
          <H2 class="mb-8 text-center">Frequently asked questions</H2>
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8"
          >
            <FAQ faqs={conversion.faqs} />
          </div>
        </section>

        <!-- Related video conversions -->
        <section class="mb-8">
          <H2 class="mb-6 text-center">More video conversions</H2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {
              related.map((c) => (
                <a
                  href={`/convert/video/${c.slug}`}
                  class="bg-background-subtle/50 border border-border rounded-lg p-4 text-center transition-colors hover:border-accent/30"
                >
                  <span class="text-sm font-medium text-text">
                    {videoFormats[c.from].name} to {videoFormats[c.to].name}
                  </span>
                </a>
              ))
            }
          </div>
          <div class="text-center mt-6">
            <a
              href="/video-converter-mac"
              class="text-sm text-accent hover:underline"
              >All video conversions &rarr;</a
            >
          </div>
        </section>
      </div>
    </main>

    <Footer />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "cantimplorastudio" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
