---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Paragraph from "../components/Paragraph.astro";
import Button from "../components/Button.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import TrustBar from "../components/TrustBar.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import SectionDivider from "../components/SectionDivider.astro";
import PricingSection from "../components/PricingSection.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";

const title =
  "Batch Image Converter for Mac — Convert Hundreds at Once | Picmal";
const description =
  "Batch convert images on your Mac. Drop hundreds of files or entire folders — HEIC, JPG, PNG, WebP, AVIF, TIFF, and more. Offline. $15.99 one-time.";

const faqs = [
  {
    question: "How many images can I batch convert at once?",
    answer:
      "There's no limit. Picmal handles hundreds or thousands of files at once. Drag and drop entire folders and Picmal converts everything inside.",
  },
  {
    question: "Can I convert mixed formats in one batch?",
    answer:
      "Yes. Drop a mix of HEIC, JPG, PNG, and other formats — Picmal detects each file's format and converts them all to your chosen output format.",
  },
  {
    question: "How fast is batch conversion?",
    answer:
      "Picmal uses your Mac's hardware acceleration for fast processing. A typical batch of 100 photos converts in seconds on Apple Silicon Macs.",
  },
  {
    question: "Can I drop entire folders?",
    answer:
      "Yes. Drag and drop folders directly into Picmal. It processes all supported files inside, including nested subfolders.",
  },
  {
    question: "Does batch conversion affect quality?",
    answer:
      "No. Each file is converted with the same quality settings you choose. You can adjust the quality slider before starting the batch.",
  },
  {
    question: "Can I also batch compress without converting?",
    answer:
      "Yes. Select compression mode to reduce file sizes while keeping the original format. Works with JPG, PNG, WebP, and more.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <link
      rel="preload"
      href="/picmal-1.2.0-demo.mp4"
      as="video"
      type="video/mp4"
    />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <main id="main-content" class="relative z-10 pt-32 pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <Breadcrumb
          items={[
            { label: "Home", href: "/" },
            { label: "Batch Image Converter for Mac" },
          ]}
        />

        <div class="text-center mb-12">
          <H1 class="mb-6 max-w-3xl mx-auto"
            >Batch convert hundreds of images on your Mac</H1
          >
          <Paragraph class="max-w-2xl mx-auto mb-8">
            Drop entire folders into Picmal and convert everything at once.
            HEIC, JPG, PNG, WebP, AVIF, TIFF — all formats supported. Offline,
            no subscription.
          </Paragraph>
          <div
            class="flex flex-col sm:flex-row gap-3 items-center justify-center mb-6"
          >
            <Button
              text="Get Picmal for $15.99"
              onclick="posthog.capture('buy_clicked_batch_converter_mac')"
            />
            <a
              href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg"
              class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-base py-3 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto"
            >
              <svg
                class="size-4 inline-block mr-2"
                fill="currentColor"
                stroke="none"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8 4.35 4.35 0 0 1-2.59-4.03z"
                ></path></svg
              >
              Download
            </a>
          </div>
          <TrustBar />
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-5xl mx-auto rounded-lg sm:rounded-xl overflow-hidden border border-border"
        >
          <div class="aspect-[16/10]">
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal batch conversion interface"></video>
          </div>
        </div>
      </div>
    </main>

    <SectionDivider />

    <!-- How Batch Works -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-8 text-center">How batch conversion works</H2>
        <div class="grid md:grid-cols-3 gap-6">
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6 text-center"
          >
            <div
              class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-4 font-semibold"
            >
              1
            </div>
            <h3 class="font-semibold text-text mb-2">Drop files or folders</h3>
            <Paragraph
              >Drag and drop any number of files or entire folders into Picmal.</Paragraph
            >
          </div>
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6 text-center"
          >
            <div
              class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-4 font-semibold"
            >
              2
            </div>
            <h3 class="font-semibold text-text mb-2">Choose output format</h3>
            <Paragraph
              >Select your target format and adjust quality settings if needed.</Paragraph
            >
          </div>
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6 text-center"
          >
            <div
              class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-4 font-semibold"
            >
              3
            </div>
            <h3 class="font-semibold text-text mb-2">Convert everything</h3>
            <Paragraph
              >Click Convert and watch individual progress for each file.</Paragraph
            >
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- Key Features for Batch -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-8 text-center">Built for batch processing</H2>
        <div class="grid md:grid-cols-2 gap-6">
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6"
          >
            <h3 class="font-semibold text-text mb-2">Folder drop support</h3>
            <Paragraph
              >Drop entire folders — Picmal finds and converts all supported
              files inside, including nested subfolders.</Paragraph
            >
          </div>
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6"
          >
            <h3 class="font-semibold text-text mb-2">Individual progress</h3>
            <Paragraph
              >Track conversion progress for each file individually. See which
              files are done and which are still processing.</Paragraph
            >
          </div>
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6"
          >
            <h3 class="font-semibold text-text mb-2">Mixed format input</h3>
            <Paragraph
              >Drop a mix of HEIC, JPG, PNG, and other formats. Picmal detects
              each file type and converts them all.</Paragraph
            >
          </div>
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6"
          >
            <h3 class="font-semibold text-text mb-2">Watched folders</h3>
            <Paragraph
              >Set up folders that automatically convert any new files added to
              them. Perfect for automated workflows.</Paragraph
            >
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />
    <MasonryTestimonials />
    <SectionDivider />

    <section
      id="pricing"
      class="relative z-10 px-6 py-16 sm:py-20 bg-background-subtle/50 border-y border-border"
    >
      <PricingSection />
    </section>

    <section id="faq" class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-8 text-center">Frequently Asked Questions</H2>
        <div
          class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />
    <SupportedFormatsModal />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "cantimplorastudio" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
