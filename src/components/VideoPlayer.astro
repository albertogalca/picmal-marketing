---
interface Props {
  src: string;
  className?: string;
  isDark?: boolean;
}

const { src, className = "", isDark = false } = Astro.props;
---

<div class={`relative max-w-5xl mx-auto ${className}`}>
  <div
    class="absolute inset-0 bg-gradient-to-r from-accent/10 to-accent-dark/15 rounded-lg blur-3xl"
  >
  </div>
  <div
    class="relative backdrop-blur-xl border rounded-lg shadow-2xl overflow-hidden bg-gradient-to-br from-white/90 to-[#F2F6FF]/90 border-[#CBDEFF]/30"
  >
    <div
      class="relative rounded-lg overflow-hidden group cursor-pointer video-container aspect-video"
    >
      <video
        class="absolute inset-0 w-full h-full object-cover video-element"
        preload="metadata"
        muted
      >
        <source src={src} type="video/mp4" />
        Your browser does not support the video tag.
      </video>
      <div
        class="absolute inset-0 flex items-center justify-center bg-black/10 group-hover:bg-black/20 transition-all duration-300 play-overlay"
      >
        <div
          class="w-16 h-16 bg-white/95 rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300"
        >
          <svg
            class="w-6 h-6 text-accent ml-0.5"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const videoContainers = document.querySelectorAll(".video-container");

    videoContainers.forEach((container) => {
      const video = container.querySelector(
        ".video-element"
      ) as HTMLVideoElement;
      const playOverlay = container.querySelector(
        ".play-overlay"
      ) as HTMLElement;
      let isPlaying = false;

      const handleVideoClick = () => {
        if (video) {
          if (isPlaying) {
            video.pause();
            isPlaying = false;
            playOverlay.style.display = "flex";
          } else {
            video.play();
            isPlaying = true;
            playOverlay.style.display = "none";
          }
        }
      };

      const handleLoadedData = () => {
        if (video) {
          video.currentTime = 0;
        }
      };

      // Event listeners
      container.addEventListener("click", handleVideoClick);

      video.addEventListener("play", () => {
        isPlaying = true;
        playOverlay.style.display = "none";
      });

      video.addEventListener("pause", () => {
        isPlaying = false;
        playOverlay.style.display = "flex";
      });

      video.addEventListener("loadeddata", handleLoadedData);
    });
  });
</script>
