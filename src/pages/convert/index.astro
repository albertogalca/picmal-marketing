---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import Paragraph from "../../components/Paragraph.astro";
import Button from "../../components/Button.astro";
import PicmalCTA from "../../components/PicmalCTA.astro";
import { getAllConversions, formats } from "../../data/conversions";
import type { FormatInfo } from "../../data/conversions";

const SITE_TITLE = "Image Format Converter for Mac | 30+ Formats Supported";
const SITE_DESCRIPTION =
  "Convert between 30+ image formats on Mac. HEIC, WebP, AVIF, PNG, JPG, DNG, TIFF, and more. 100% offline, batch processing, privacy-focused.";

const allConversions = getAllConversions();

// Group conversions by target format
const conversionsByTarget = allConversions.reduce(
  (acc, { from, to }) => {
    if (!acc[to]) {
      acc[to] = [];
    }
    acc[to].push(from);
    return acc;
  },
  {} as Record<string, string[]>
);

// Popular conversions to highlight
const popularConversions = [
  { from: "heic", to: "jpg", label: "HEIC to JPG" },
  { from: "webp", to: "jpg", label: "WebP to JPG" },
  { from: "png", to: "jpg", label: "PNG to JPG" },
  { from: "avif", to: "jpg", label: "AVIF to JPG" },
  { from: "dng", to: "jpg", label: "DNG to JPG" },
  { from: "heic", to: "png", label: "HEIC to PNG" },
  { from: "jpg", to: "webp", label: "JPG to WebP" },
  { from: "png", to: "webp", label: "PNG to WebP" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body class="bg-background">
    <Header />

    <!-- Hero Section with gradient -->
    <main class="relative z-10 pt-32 pb-20">
      <div class="absolute inset-0 -z-10 overflow-hidden hero-gradient"></div>

      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-16">
          <H1 class="mb-4">Convert any image format on Mac</H1>
          <Paragraph class="max-w-2xl mx-auto">
            Support for 30+ image formats including HEIC, WebP, AVIF, PNG, JPG,
            DNG, TIFF, and more. Convert images instantly with 100% offline
            processing.
          </Paragraph>
        </div>

        <div class="flex flex-col items-center gap-4">
          <Button text="Buy for Mac" />
          <p class="text-sm text-text-secondary">
            One-time purchase • 14-day money back guarantee
          </p>
        </div>
      </div>
    </main>

    <!-- Popular Conversions Section -->
    <section class="relative z-10 px-6 py-24 bg-background-subtle">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-10">Popular Conversions</H2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {
            popularConversions.map(({ from, to, label }) => (
              <a
                href={`/convert/${from}-to-${to}`}
                class="block p-6 bg-background rounded-xl border border-text/10 hover:border-accent/30 transition-all duration-300 group"
              >
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="font-semibold text-text text-lg group-hover:text-accent transition-colors">
                      {label}
                    </h3>
                    <p class="text-text-secondary text-sm mt-1">
                      {formats[from].name} → {formats[to].name}
                    </p>
                  </div>
                  <svg
                    class="w-5 h-5 text-accent"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- All Conversions by Format Section -->
    <section class="relative z-10 px-6 py-24 bg-background">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-16">All Supported Conversions</H2>

        <div class="space-y-12">
          {
            Object.entries(conversionsByTarget)
              .sort()
              .map(([target, sources]) => (
                <div class="border-b border-gray-100 pb-12 last:border-0 last:pb-0">
                  <h3 class="font-semibold text-text text-2xl mb-3">
                    Convert to {formats[target].name.toUpperCase()}
                  </h3>
                  <p class="text-text-secondary mb-6">
                    {formats[target].description}
                  </p>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-16 gap-y-3">
                    {sources.sort().map((source) => (
                      <a
                        href={`/convert/${source}-to-${target}`}
                        class="text-accent hover:underline transition-colors"
                      >
                        {formats[source].name} to {formats[target].name}
                      </a>
                    ))}
                  </div>
                </div>
              ))
          }
        </div>
      </div>
    </section>

    <!-- Supported Formats Section -->
    <section class="relative z-10 px-6 py-24 bg-background-subtle">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-10">Supported Image Formats</H2>

        <div class="space-y-6">
          {
            Object.entries(formats).map(([_, format]: [string, FormatInfo]) => (
              <div class="bg-background p-6 rounded-xl border border-text/10">
                <h3 class="font-semibold text-text text-lg mb-1">
                  {format.name}
                </h3>
                <p class="text-sm text-text-secondary mb-2">
                  {format.fullName}
                </p>
                <p class="text-sm text-text-secondary mb-4">
                  {format.description}
                </p>
                <div class="flex flex-wrap gap-2">
                  <span class="text-xs px-2 py-1 bg-background-subtle text-text rounded-full">
                    {format.quality === "lossy" ? "Lossy" : "Lossless"}
                  </span>
                  {format.supports_transparency && (
                    <span class="text-xs px-2 py-1 bg-accent/10 text-accent rounded-full">
                      Transparency
                    </span>
                  )}
                  {format.supports_animation && (
                    <span class="text-xs px-2 py-1 bg-accent/10 text-accent rounded-full">
                      Animation
                    </span>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="relative z-10 px-6 py-24 bg-background">
      <div class="max-w-4xl mx-auto">
        <PicmalCTA
          variant="dark"
          title="Convert images effortlessly on your Mac"
          description="If you're not happy with your purchase, you can request a refund within 14 days. No questions asked."
          buttonText="Buy for Mac"
        />
      </div>
    </section>

    <Footer />
  </body>
</html>
