---
import { twMerge } from "tailwind-merge";

export interface Props {
  class?: string;
  id?: string;
}

const { class: className = "", id } = Astro.props;
const defaultClasses =
  "font-semibold tracking-tight text-text leading-[1.1] text-balance text-fluid-h1";
const mergedClasses = twMerge(defaultClasses, className);
---

<h1 id={id} class={mergedClasses}>
  <slot />
</h1>
