---
import PixelField from "./PixelField.astro";
import Button from "./Button.astro";
import { DEFAULT_TIER } from "../../config/pricing";

interface Props { title?: string; subtitle?: string; ground?: "brand" | "night"; texture?: string; seed?: string }
const { title = "Drag the files in. Get them back converted.", subtitle = "7-day free trial · $29 once · 14-day refund", ground = "brand", texture = "skyline", seed = "cta" } = Astro.props;
const tone = ground === "brand" ? "paper" : "glow";
---

<section class:list={["pm-cta", `pm-cta--${ground}`]}>
  <div class="pm-cta__field"><PixelField width={1040} height={128} texture={texture} seed={seed} tone={tone} rise={0.9} /></div>
  <div class="pm-cta__body">
    <h2 class="pm-cta__title">{title}</h2>
    <p class="pm-cta__sub">{subtitle}</p>
    <div class="pm-cta__actions">
      <Button href={DEFAULT_TIER.checkoutUrl} variant="on-brand">Get Picmal for ${DEFAULT_TIER.price}</Button>
      <Button href="/download" variant="ghost-brand">Try free for 7 days</Button>
    </div>
  </div>
</section>
