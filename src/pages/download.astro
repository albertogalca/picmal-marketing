---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { DMG_URL } from "../config/download";
import H1 from "../components/H1.astro";
import Paragraph from "../components/Paragraph.astro";
import Button from "../components/Button.astro";
import TrustBar from "../components/TrustBar.astro";
import CopyCommand from "../components/CopyCommand.astro";
import BlockGrid from "../components/BlockGrid.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";


const steps = [
  {
    title: "Open the disk image",
    description:
      "Double-click the downloaded Picmal.dmg and drag Picmal into your Applications folder.",
  },
  {
    title: "Launch Picmal",
    description:
      "Open Picmal from Applications and press Try free in the sidebar. Every tool runs for 7 days on that Mac.",
  },
  {
    title: "Add your license to keep converting",
    description:
      "The app runs free for 7 days. After that it needs a license: $29 once, at the top of this page. Paste the key in and you're running in about ten seconds.",
  },
];
---

<MarketingLayout
  title="Picmal: Download for Mac"
  description="Download Picmal for Mac. Free to install, one payment of $29 to unlock. Batch convert and compress images, video, audio, and PDFs, all offline."
  mainClass="relative z-10 pt-32 pb-16 sm:pb-20"
>
  <Fragment slot="head">
    {/* Was noindex. This is the page that answers "download picmal for mac",
            and a noindexed page cannot rank for it or carry a rich result, so the
            query went to the homepage or nowhere. ProductSchema already holds the
            downloadUrl, fileSize, softwareVersion and offers this page is about,
            so it is reused rather than hand-rolled: same #software node, one
            entity, no second definition to drift. */}
        <ProductSchema url={Astro.site!.href} />
  </Fragment>

  <div class="max-w-3xl mx-auto px-6 text-center">
    <H1 class="mb-6">Download Picmal for Mac</H1>
    <Paragraph size="lead" class="mb-8 max-w-xl mx-auto">
      Picmal is free for 7 days on your Mac. To keep converting after that
      you need a license, which is a single $29 payment. Don't like it? Full
      refund within 14 days.
    </Paragraph>

    <div class="flex flex-col items-center gap-3">
      <Button
        href={DMG_URL}
        text="Download Picmal (.dmg)"
        class="w-full sm:w-auto"
        onclick={import.meta.env.PROD
          ? "window.seline?.track('download_dmg', { source: 'download_page' })"
          : undefined}
      />
      <a
        href="/#pricing"
        class="inline-flex items-center gap-1.5 text-small text-text-secondary hover:text-text transition-colors rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        or get a license for $29
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="mt-6">
      <TrustBar />
    </div>

    <!-- The download is a DMG from GitHub, outside the App Store. Saying
         it is notarized answers the "will macOS block this?" question at
         the exact moment it gets asked. Verified via notarytool on every
         release; see the "publish outside the App Store" post. -->
    <p class="mt-6 text-small text-text-secondary">
      Signed and notarized by Apple, so it opens without security warnings.
    </p>

    <p class="mt-2 text-small text-text-secondary">
      Requires macOS 15.0 (Sequoia) or later · Apple Silicon &amp; Intel
    </p>

    <!-- Picmal is in homebrew-cask since 14 Sep 2026 (PR #286940). Same
         signed DMG, installed from the terminal instead of by hand. -->
    <p class="mt-8 text-small text-text-secondary">
      Prefer the terminal? Picmal is on Homebrew.
    </p>
    <div class="mt-3 flex justify-center">
      <CopyCommand
        command="brew install --cask picmal"
        label="Copy the Homebrew install command"
      />
    </div>
  </div>

  <!-- Install steps -->
  <BlockGrid ordered heading="Installing Picmal" items={steps} />
</MarketingLayout>
