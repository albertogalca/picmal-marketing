---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import OrganizationSchema from "../../components/schema/OrganizationSchema.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeaturedOn from "../../components/FeaturedOn.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import PricingSection from "../../components/PricingSection.astro";
import FounderLetter from "../../components/FounderLetter.astro";
import Section from "../../components/Section.astro";
import Card from "../../components/Card.astro";
import H3 from "../../components/H3.astro";
import Paragraph from "../../components/Paragraph.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";

const SITE_DESCRIPTION =
  "Want a How To Convert alternative on your Mac? Picmal converts, compresses, and edits images, video, and audio, plus PDF tools, all on your Mac. Nothing gets uploaded. $15.99 once, no subscription. 14-day refund.";

const faqs = [
  {
    question: "Is Picmal a good How To Convert alternative?",
    answer:
      "For media files on a Mac, yes. Picmal converts and compresses images, video, audio, and PDFs, and it ties into macOS with Shortcuts and folder monitoring. If you need to convert Word documents or emails, How To Convert does that and Picmal doesn't.",
  },
  {
    question: "Does Picmal work offline like How To Convert?",
    answer:
      "Yes. Both apps do the work on your Mac. Your files never go to a server.",
  },
  {
    question: "Why is Picmal cheaper than How To Convert?",
    answer:
      "Picmal is $15.99, How To Convert is $29. Picmal does one platform and sticks to media. How To Convert runs on three platforms and adds document and email conversions. You're paying for that wider scope.",
  },
  {
    question: "Can Picmal convert documents like PDFs or Word files?",
    answer:
      "Picmal can compress PDFs, combine them, turn images into a PDF, and export pages to PNG. It doesn't convert document formats, so no Word, DOCX, or Markdown. For that, reach for How To Convert or Pandoc.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Email support@picmal.app within 14 days and I'll refund you, no questions asked.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead
      title="Picmal: A native Mac alternative to How To Convert"
      description={SITE_DESCRIPTION}
    />
    <!-- Grape Nuts: handwritten signature in the founder letter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Grape+Nuts&display=swap"
    />
    <OrganizationSchema url={Astro.site!.href} />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <ComparisonHero
      title="A native Mac alternative to How To Convert"
      subhead="How To Convert does documents, emails, and three platforms. Picmal does media, so images, video, audio, and PDFs, on the Mac only, with a native interface and Shortcuts. Nearly half the price."
      buyEvent="buy_clicked_howtoconvert_comparison"
    />

    <ComparisonVerdict
      competitor="How To Convert"
      summary="How To Convert handles documents, emails, and media across Windows, Mac, and Linux. Picmal ($15.99, paid once) is Mac only and sticks to media, so images, video, audio, and PDFs, with a native interface, Shortcuts, and folder monitoring."
      picmalFor="You're on a Mac and mostly work with media files. You want something that feels native, with Shortcuts and folder monitoring, for less than $20."
      competitorFor="You convert documents or emails, or you need the same app on Windows or Linux too."
    />

    <!-- Comparison Table -->
    <Section width="default">
      <SectionHeading>
        Picmal vs How To Convert at a glance
        <Fragment slot="sublead">
          How To Convert is broad. It supports thousands of format combinations
          across five categories. But if you're on a Mac and you live in media,
          converting, compressing, and editing images, video, and audio, Picmal
          is the more focused, native pick.
        </Fragment>
      </SectionHeading>
      <Card padding="p-4 md:p-8">
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left p-4 font-semibold text-text">Feature</th>
                  <th class="text-left p-4 font-semibold text-text">Picmal</th>
                  <th class="text-left p-4 font-semibold text-text"
                    >How To Convert</th
                  >
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr>
                  <td class="p-4 text-text-secondary">Price</td>
                  <td class="p-4 text-text">$15.99 one-time</td>
                  <td class="p-4 text-text">$29 one-time</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Platforms</td>
                  <td class="p-4 text-text">macOS only</td>
                  <td class="p-4 text-text">Mac, Windows, Linux</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Privacy</td>
                  <td class="p-4 text-text">100% offline</td>
                  <td class="p-4 text-text">100% offline</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Interface</td>
                  <td class="p-4 text-text">Native macOS, single window</td>
                  <td class="p-4 text-text">Cross-platform wrapper</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Image formats</td>
                  <td class="p-4 text-text">20+</td>
                  <td class="p-4 text-text">40+</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video formats</td>
                  <td class="p-4 text-text">20+</td>
                  <td class="p-4 text-text">50+</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Document conversions</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text">Yes (DOCX, PDF, MD, etc.)</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Email conversions</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text">Yes (EML, MSG)</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Metadata removal</td>
                  <td class="p-4 text-text"
                    >Yes, strip location data before sharing</td
                  >
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Finder right-click</td>
                  <td class="p-4 text-text"
                    >Yes, convert without opening the app</td
                  >
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Shortcuts integration</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Folder monitoring</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Device license</td>
                  <td class="p-4 text-text">1 Mac</td>
                  <td class="p-4 text-text">5 devices</td>
                </tr>
              </tbody>
            </table>
          </div>
      </Card>
    </Section>

    <!-- Who Picmal Is For / Who Should Stick with How To Convert -->
    <Section width="default">
      <SectionHeading>
        Which one is right for you?
        <Fragment slot="sublead">
            Here's where each one makes more sense.
        </Fragment>
      </SectionHeading>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Picmal Column -->
          <Card>
            <div class="mb-6">
              <H3 class="mb-2">
                Choose Picmal
              </H3>
              <Paragraph color="secondary">
                Best for Mac users who care about design and automation
              </Paragraph>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want an app that feels native to macOS, not a
                  cross-platform wrapper
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need system integrations like Shortcuts or folder
                  monitoring
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You convert, compress, and edit images, video, and audio,
                  plus PDF tools, and you don't need documents
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You'd rather have a focused tool from one developer who
                  builds for one platform
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text"> You want to save $13 </span>
              </li>
            </ul>
          </Card>

          <!-- How To Convert Column -->
          <Card>
            <div class="mb-6">
              <H3 class="mb-2">
                Choose How To Convert
              </H3>
              <Paragraph color="secondary">
                Best for cross-platform users with a wide range of formats
              </Paragraph>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You work on Windows or Linux (or all three)
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need document conversions (Word, PDF, Markdown, ebooks)
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need email format conversions (EML, MSG)
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want a single license that covers 5 devices
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  Format variety matters more than native feel
                </span>
              </li>
            </ul>
          </Card>
        </div>
    </Section>

    <!-- Features -->
    <FeatureGrid
      heading="Everything else Picmal does"
      subleadIntro="One app for images, video, audio, and PDFs. Convert, compress, and edit, all on your Mac."
    />

    <!-- Testimonials Section -->
    <MasonryTestimonials />

    <section
      id="featured"
      class="absolute w-px h-px overflow-hidden -m-px p-0 border-0"
      style="clip:rect(0 0 0 0); clip-path:inset(50%)"
      aria-hidden="true"
    >
      <FeaturedOn />
    </section>

    <!-- Pricing -->
    <PricingSection />

    <!-- Founder letter -->
    <FounderLetter />

    <!-- FAQ Section -->
    <Section id="faq" width="narrow">
      <SectionHeading
        sublead="Can't find what you're looking for? Email support@picmal.app"
      >
        Frequently asked questions
      </SectionHeading>
      <Card>
        <FAQ faqs={faqs} />
      </Card>
    </Section>

    <Footer />

    <SupportedFormatsModal />

  </body>
</html>
