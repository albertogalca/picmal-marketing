---
import Button from "./Button.astro";

// Email capture → Loops "Picmal Newsletter" mailing list, via Loops' own public
// form endpoint. No API key in the client, no backend.
// Contract: POST application/x-www-form-urlencoded `email=...&mailingLists=<id>`,
// returns { success: true }. The list MUST be passed explicitly — the form's
// "Select a list" setting in Loops is ignored on raw API POSTs.
const SUBSCRIBE_ENDPOINT =
  "https://app.loops.so/api/newsletter-form/cmiluz55e9uluzv0ibuw5hwgv";
const NEWSLETTER_LIST_ID = "cmrhv19wy17l10j22epyc5r8v";
---

<form
  id="newsletter-form"
  class="mt-6 max-w-xs"
  data-endpoint={SUBSCRIBE_ENDPOINT}
  data-list={NEWSLETTER_LIST_ID}
  novalidate
>
  <label for="newsletter-email" class="block text-body text-text mb-2">
    Join here and I will send you occasional updates about Picmal and other
    things I make. No spam, ever.
  </label>
  <div class="flex gap-2">
    <input
      id="newsletter-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
      class="min-w-0 flex-1 rounded-xl border border-border bg-background px-3 py-2 text-body text-text placeholder:text-text-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    />
    <Button type="submit" text="Subscribe" size="small" class="shrink-0" />
  </div>
  <!-- Honeypot: hidden from users, bots fill it. -->
  <input
    type="text"
    name="website"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    class="hidden"
  />
  <p
    id="newsletter-msg"
    class="mt-2 text-small text-text-secondary"
    role="status"
    aria-live="polite"
  >
  </p>
</form>

<script>
  function initNewsletter() {
    const form = document.getElementById(
      "newsletter-form",
    ) as HTMLFormElement | null;
    if (!form || form.dataset.bound) return;
    form.dataset.bound = "true";

    const msg = document.getElementById("newsletter-msg") as HTMLElement;
    const button = form.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const email = String(data.get("email") || "").trim();
      const website = String(data.get("website") || "");

      // Honeypot: a real user never fills this. Fake success, never hit Loops.
      if (website) {
        form.reset();
        msg.textContent = "Thanks — you're on the list.";
        return;
      }
      if (!email) {
        msg.textContent = "Please enter your email.";
        return;
      }

      button.disabled = true;
      msg.textContent = "Subscribing…";

      try {
        const res = await fetch(form.dataset.endpoint!, {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams({ email, mailingLists: form.dataset.list! }),
        });
        const out = await res.json().catch(() => ({}));
        if (res.ok && out.success) {
          form.reset();
          msg.textContent = "Thanks — you're on the list.";
          if (import.meta.env.PROD)
            window.posthog?.capture("newsletter_subscribed");
        } else {
          msg.textContent = out.message || "Something went wrong. Try again.";
          button.disabled = false;
        }
      } catch {
        msg.textContent = "Network error. Try again.";
        button.disabled = false;
      }
    });
  }

  initNewsletter();
  document.addEventListener("astro:page-load", initNewsletter);
</script>
