---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Paragraph from "../components/Paragraph.astro";
import HeroCTA from "../components/HeroCTA.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import TrustBar from "../components/TrustBar.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import SectionDivider from "../components/SectionDivider.astro";
import PricingSection from "../components/PricingSection.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";

const title =
  "Compress Audio on Mac — Shrink MP3, M4A, WAV & More | Picmal";
const description =
  "Compress MP3, M4A, WAV, FLAC and more on your Mac. Bitrate control, force mono, sample-rate options, batch processing. Offline, no upload limit. $15.99 one-time, no subscription.";

const faqs = [
  {
    question: "How much can Picmal shrink an audio file?",
    answer:
      "A lot, depending on the source. Lowering the bitrate (e.g. 320 kbps → 128 kbps) roughly halves an MP3; forcing mono on a voice recording halves it again; and converting an uncompressed WAV to MP3 or AAC can cut size by 80–90%.",
  },
  {
    question: "Does compressing audio lose quality?",
    answer:
      "Lowering the bitrate of a lossy format trades some quality for size — at 192–320 kbps it's transparent for music, and 64–96 kbps is plenty for speech. For archival, compress to FLAC instead, which is lossless.",
  },
  {
    question: "How do I make a voice memo or podcast smaller?",
    answer:
      "Turn on force mono and pick a speech-friendly bitrate (64–96 kbps). Voice recordings don't need stereo or high bitrates, so the file comes out a fraction of the size with no audible difference.",
  },
  {
    question: "Can I control bitrate and sample rate?",
    answer:
      "Yes. Pick VBR/ABR/CBR mode and a target bitrate, set the sample rate (8 kHz up to 96 kHz) and bit depth (16/24/32-bit), and force mono when you don't need stereo.",
  },
  {
    question: "Can I batch compress a whole folder of audio?",
    answer:
      "Yes. Drop multiple files or an entire folder into Picmal and compress them all with the same settings in one pass.",
  },
  {
    question: "Are my files uploaded anywhere?",
    answer:
      "No. All compression happens locally on your Mac — no uploads, no per-file limits. It's a one-time $15.99, not a subscription.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <link
      rel="preload"
      href="/picmal-1.2.0-demo.mp4"
      as="video"
      type="video/mp4"
    />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <main id="main-content" class="relative z-10 pt-32 pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <Breadcrumb
          items={[
            { label: "Home", href: "/" },
            { label: "Compress Audio on Mac" },
          ]}
        />

        <div class="text-center mb-12">
          <H1 class="mb-6 max-w-3xl mx-auto"
            >Compress audio on your Mac</H1
          >
          <Paragraph class="max-w-2xl mx-auto mb-8">
            Shrink MP3, M4A, WAV, FLAC and more with bitrate control, force
            mono, and sample-rate options. Perfect for podcasts, voice memos,
            and audiobooks. Batch, offline, no upload limit.
          </Paragraph>
          <HeroCTA buyEvent="buy_clicked_compress_audio_mac" class="mb-6" />
          <TrustBar />
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-5xl mx-auto rounded-lg sm:rounded-xl overflow-hidden border border-border"
        >
          <div class="aspect-[16/10]">
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal audio compression interface"></video>
          </div>
        </div>
      </div>
    </main>

    <SectionDivider />

    <!-- How It Works -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-8 text-center">Compress audio in 3 steps</H2>
        <div class="grid md:grid-cols-3 gap-6">
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6 text-center"
          >
            <div
              class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-4 font-semibold"
            >
              1
            </div>
            <h3 class="font-semibold text-text mb-2">Drop your audio</h3>
            <Paragraph
              >Drag in one file or a whole folder of recordings.</Paragraph
            >
          </div>
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6 text-center"
          >
            <div
              class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-4 font-semibold"
            >
              2
            </div>
            <h3 class="font-semibold text-text mb-2">Pick bitrate & mode</h3>
            <Paragraph
              >Choose a bitrate and VBR/ABR/CBR mode, or force mono for
              voice.</Paragraph
            >
          </div>
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6 text-center"
          >
            <div
              class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-4 font-semibold"
            >
              3
            </div>
            <h3 class="font-semibold text-text mb-2">Compress</h3>
            <Paragraph>Click Compress — everything runs on your Mac.</Paragraph>
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- Controls -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-8 text-center">Tuned for every kind of audio</H2>
        <div class="grid sm:grid-cols-2 gap-6">
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6">
            <h3 class="font-semibold text-text mb-2">Bitrate & VBR/ABR/CBR</h3>
            <Paragraph
              >Target an exact bitrate or let VBR allocate bits where they
              matter for the best quality per megabyte.</Paragraph
            >
          </div>
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6">
            <h3 class="font-semibold text-text mb-2">Force mono</h3>
            <Paragraph
              >Collapse stereo to mono for podcasts and voice memos — roughly
              half the size, no audible loss.</Paragraph
            >
          </div>
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6">
            <h3 class="font-semibold text-text mb-2">Sample rate & bit depth</h3>
            <Paragraph
              >From 8 kHz telephony up to 96 kHz hi-res, 16/24/32-bit — match the
              source to the use.</Paragraph
            >
          </div>
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6">
            <h3 class="font-semibold text-text mb-2">Lossless option</h3>
            <Paragraph
              >Need to shrink without any loss? Compress to FLAC for
              roughly half the size of WAV, bit-for-bit identical.</Paragraph
            >
          </div>
        </div>
        <div class="text-center mt-8">
          <a
            href="/audio-converter-mac"
            class="text-body-sm text-accent hover:underline"
            >Need to convert audio formats too? See the audio converter &rarr;</a
          >
        </div>
      </div>
    </section>

    <SectionDivider />
    <MasonryTestimonials />
    <SectionDivider />

    <section
      id="pricing"
      class="relative z-10 px-6 py-16 sm:py-20 bg-background-subtle/50 border-y border-border"
    >
      <PricingSection />
    </section>

    <section id="faq" class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-8 text-center">Frequently asked questions</H2>
        <div
          class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />
    <SupportedFormatsModal />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "cantimplorastudio" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
