---
import { getCollection } from "astro:content";
import { TIERS } from "../../config/pricing";

interface Props {
  url: string;
}

const { url } = Astro.props;

// Derive the current version + release date from the changelog collection so
// the schema never goes stale. Sorted the same way as the homepage release badge.
const changelogEntries = await getCollection("changelog");
const latestRelease = changelogEntries.sort((a, b) =>
  b.data.version.localeCompare(a.data.version, undefined, {
    numeric: true,
    sensitivity: "base",
  }),
)[0];

const softwareVersion = latestRelease?.data.version ?? "1.0.0";
const dateModified = (latestRelease?.data.pubDate ?? new Date("2024-01-15"))
  .toISOString()
  .split("T")[0];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Picmal",
  url: new URL("/", url).href,
  description:
    "All-in-one media tool for Mac. Batch convert, compress, and create images, videos, audio, and PDF files offline on your Mac.",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "macOS 15.0 or later",
  // AggregateOffer, not a single Offer: the ladder runs from 1 to 10 Macs, so a
  // lone "39" would misreport both the entry price and the ceiling.
  offers: {
    "@type": "AggregateOffer",
    lowPrice: String(TIERS[0].price),
    highPrice: String(TIERS[TIERS.length - 1].price),
    offerCount: TIERS.length,
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: new URL("/", url).href,
    priceValidUntil: "2026-12-31",
  },
  author: {
    "@type": "Person",
    name: "Alberto Gallego",
    url: "https://albertogalca.com",
  },
  publisher: {
    "@type": "Organization",
    name: "Picmal",
    logo: {
      "@type": "ImageObject",
      url: new URL("/logo.webp", url).href,
    },
  },
  softwareVersion,
  datePublished: "2024-01-15",
  dateModified,
  screenshot: new URL("/og.png", url).href,
  downloadUrl:
    "https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg",
  fileSize: "25MB",
  installUrl:
    "https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg",
  softwareRequirements: "macOS 15.0 or later",
  featureList: [
    "Batch convert images, videos, and audio files",
    "Compress media files without quality loss",
    "Offline processing for privacy",
    "Support for 30+ image, video, and audio formats",
    "Folder watching for automatic conversion",
    "Shortcuts integration",
    "Color space conversion",
    "Metadata preservation",
  ],
  keywords:
    "image converter, video converter, audio converter, Mac app, batch conversion, offline converter, HEIC converter, media compression",
};
---

<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
