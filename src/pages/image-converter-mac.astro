---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Paragraph from "../components/Paragraph.astro";
import Button from "../components/Button.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import BentoFeatures from "../components/BentoFeatures.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import TrustBar from "../components/TrustBar.astro";
import SectionDivider from "../components/SectionDivider.astro";
import PricingSection from "../components/PricingSection.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";

const title = "Image Converter for Mac — Convert Any Format | Picmal";
const description =
  "Convert images between HEIC, JPG, PNG, WebP, AVIF, TIFF, GIF, and more on your Mac. Batch conversion, offline, no subscription. $15.99 one-time.";

const faqs = [
  {
    question: "What image formats does Picmal support?",
    answer:
      "Picmal supports 20+ image formats including HEIC, JPG, PNG, WebP, AVIF, TIFF, BMP, GIF, SVG, DNG, PSD, and more. It also converts video and audio files.",
  },
  {
    question: "Can I convert multiple images at once?",
    answer:
      "Yes. Picmal excels at batch conversion — drag and drop hundreds of files or entire folders and convert them all at once with individual progress tracking.",
  },
  {
    question: "Does Picmal work offline?",
    answer:
      "Yes. All processing happens locally on your Mac. Your files never leave your device. No internet connection required after installation.",
  },
  {
    question: "Is Picmal free?",
    answer:
      "Picmal is a one-time purchase of $15.99 — no subscription. You can download the app to explore the interface. 14-day money-back guarantee.",
  },
  {
    question: "Does converting images lose quality?",
    answer:
      "It depends on the format. Converting to lossless formats like PNG or TIFF preserves full quality. For lossy formats like JPG or WebP, Picmal lets you adjust the quality slider.",
  },
  {
    question: "Can I also compress images?",
    answer:
      "Yes. Picmal can compress images in their current format without converting. Adjust the quality slider to reduce file size while maintaining the original format.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <link
      rel="preload"
      href="/picmal-1.2.0-demo.mp4"
      as="video"
      type="video/mp4"
    />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <main id="main-content" class="relative z-10 pt-32 pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <Breadcrumb
          items={[
            { label: "Home", href: "/" },
            { label: "Image Converter for Mac" },
          ]}
        />

        <div class="text-center mb-12">
          <H1 class="mb-6 max-w-3xl mx-auto"
            >The image converter for Mac that just works</H1
          >
          <Paragraph class="max-w-2xl mx-auto mb-8">
            Convert between HEIC, JPG, PNG, WebP, AVIF, TIFF, and 20+ other
            formats. Batch processing, offline, no subscription.
          </Paragraph>
          <div
            class="flex flex-col sm:flex-row gap-3 items-center justify-center mb-6"
          >
            <Button
              text="Get Picmal for $15.99"
              onclick="posthog.capture('buy_clicked_image_converter_mac')"
            />
            <a
              href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg"
              class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-base py-3 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto"
            >
              <svg
                class="size-4 inline-block mr-2"
                fill="currentColor"
                stroke="none"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8 4.35 4.35 0 0 1-2.59-4.03z"
                ></path></svg
              >
              Download
            </a>
          </div>
          <TrustBar />
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-5xl mx-auto rounded-lg sm:rounded-xl overflow-hidden border border-border"
        >
          <div class="aspect-[16/10]">
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal app interface"></video>
          </div>
        </div>
      </div>
    </main>

    <SectionDivider />
    <BentoFeatures />
    <SectionDivider />

    <!-- Popular Conversions -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-5xl mx-auto">
        <H2 class="mb-4 text-center">Popular Conversions</H2>
        <Paragraph class="mb-8 text-center max-w-2xl mx-auto"
          >Convert between any image format with a few clicks.</Paragraph
        >
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          {
            [
              "heic-to-jpg",
              "heic-to-png",
              "heic-to-webp",
              "jpg-to-png",
              "jpg-to-webp",
              "png-to-webp",
              "webp-to-jpg",
              "avif-to-jpg",
              "tiff-to-jpg",
              "dng-to-jpg",
              "gif-to-png",
              "png-to-avif",
            ].map((slug) => (
              <a
                href={`/convert/${slug}`}
                class="bg-background-subtle/50 border border-border rounded-lg p-4 text-center transition-colors hover:border-accent/30"
              >
                <span class="text-sm font-medium text-text">
                  {slug.replace("-to-", " to ").toUpperCase()}
                </span>
              </a>
            ))
          }
        </div>
        <div class="text-center mt-6">
          <a href="/convert" class="text-sm text-accent hover:underline"
            >View all conversions &rarr;</a
          >
        </div>
      </div>
    </section>

    <SectionDivider />
    <MasonryTestimonials />
    <SectionDivider />

    <section
      id="pricing"
      class="relative z-10 px-6 py-16 sm:py-20 bg-background-subtle/50 border-y border-border"
    >
      <PricingSection />
    </section>

    <section id="faq" class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-8 text-center">Frequently Asked Questions</H2>
        <div
          class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />
    <SupportedFormatsModal />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "cantimplorastudio" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
