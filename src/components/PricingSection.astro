---
import H2 from "./H2.astro";
import Paragraph from "./Paragraph.astro";
import DynamicPricing from "./DynamicPricing.astro";
import FAQ from "./FAQ.astro";

const licenseFaqs = [
  {
    question: "How does the license work?",
    answer:
      "Pay once, use forever—no renewals or subscriptions. Your license works on one Mac at a time, but you can transfer it between devices whenever you need.",
  },
  {
    question: "How many devices can I use Picmal on?",
    answer:
      "Each license covers a set number of Macs. Pick the tier that fits—1, 3, or 5 devices. You can transfer between Macs anytime.",
  },
  {
    question: "What happens if I get a new Mac?",
    answer:
      "Deactivate on your old Mac (Picmal → Register license), then activate on your new one. Takes seconds.",
  },
  {
    question: "Can I get a refund?",
    answer:
      "Yes—14-day money-back guarantee, no questions asked. Email support@picmal.app and you're covered.",
  },
];
---

<div class="max-w-5xl mx-auto">
  <!-- Pricing Header -->
  <div class="text-center md:text-left mb-12 md:mb-0">
    <H2 class="mb-4 md:hidden">Pay once, own forever</H2>
    <Paragraph class="max-w-md mx-auto md:hidden">
      One purchase. Yours forever. All updates included, no subscriptions, no
      renewals. 14-day money-back guarantee.
    </Paragraph>
  </div>

  <div
    class="flex flex-col md:flex-row justify-between gap-12 md:gap-16 items-center md:items-start"
  >
    <!-- Pricing Card -->
    <div class="w-full max-w-md md:max-w-none md:w-auto order-1 md:order-2">
      <div class="md:sticky md:top-8">
        <DynamicPricing />
      </div>
    </div>

    <!-- Benefits & FAQ -->
    <div class="w-full md:max-w-md space-y-6 text-left order-2 md:order-1">
      <div class="hidden md:block space-y-6">
        <div>
          <H2 class="mb-4">Pay once, <br />own forever</H2>
          <Paragraph>
            One purchase. Yours forever. All updates included, no subscriptions,
            no renewals. 14-day money-back guarantee.
          </Paragraph>
        </div>
        <FAQ faqs={licenseFaqs} />
      </div>
      <div class="md:hidden">
        <FAQ faqs={licenseFaqs} />
      </div>
    </div>
  </div>
</div>
