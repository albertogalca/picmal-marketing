---
import Logo from "./pm/Logo.astro";
import NewsletterSignup from "./NewsletterSignup.astro";
import FeaturedOn from "./FeaturedOn.astro";
import { TOOLS } from "../data/tools";

// The site's internal link map: every convert, compression, feature, tool,
// alternative and company page is reachable from here on every page. The
// redesign (Oct 2026) keeps every link and puts them on a dark band, in both
// themes, so the footer reads as its own place and not as more page.
const groups = [
  [{ title: "Convert & Compress", links: [
    ["/convert", "All conversions"], ["/compress", "All compression"], ["/image-converter-mac", "Image converter for Mac"],
    ["/heic-converter-mac", "HEIC converter for Mac"], ["/raw-converter-mac", "RAW converter for Mac"], ["/video-converter-mac", "Video converter for Mac"],
    ["/audio-converter-mac", "Audio converter for Mac"], ["/compress-images-mac", "Compress images on Mac"], ["/compress-video-mac", "Compress video on Mac"],
    ["/compress-audio-mac", "Compress audio on Mac"]] }],
  [{ title: "More in Picmal", links: [
    ["/extract-audio-from-video-mac", "Extract audio from video"], ["/resize-image-mac", "Resize images on Mac"], ["/remove-metadata-from-photos-mac", "Remove photo metadata"],
    ["/merge-pdf-mac", "Merge PDF on Mac"], ["/split-pdf-mac", "Split PDF on Mac"], ["/images-to-pdf-mac", "Images to PDF"],
    ["/add-watermark-to-video-mac", "Add watermark to video"], ["/app-icon-generator-mac", "App icon generator"]] },
   { title: "Free tools", href: "/tools", links: TOOLS.map((t) => [t.href, t.title]) }],
  [{ title: "Alternatives", links: [
    ["/alternative/cloudconvert", "CloudConvert alternative"], ["/alternative/compresto", "Compresto alternative"], ["/alternative/ffworks", "ffWorks alternative"],
    ["/alternative/handbrake", "HandBrake alternative"], ["/alternative/howtoconvert", "How to Convert alternative"], ["/alternative/imageoptim", "ImageOptim alternative"],
    ["/alternative/kompressor", "Kompressor alternative"], ["/alternative/permute", "Permute alternative"], ["/alternative/tinypng", "TinyPNG alternative"],
    ["/alternative/xnconvert", "XnConvert alternative"], ["/alternative/zipic", "Zipic alternative"]] }],
  [{ title: "Company", links: [
    ["/about", "About"], ["/contact", "Contact"], ["/blog", "Blog"], ["/changelog", "Changelog"], ["/press-kit", "Press kit"],
    ["/download", "Download"], ["/affiliate", "Earn 30% as affiliate"], ["/education", "Educational discount"]] }],
] as { title: string; href?: string; links: string[][] }[][];
---

<footer class="pm-footer-band dark">
  <div class="pm-wrap"><div class="pm-footer">
    <div class="pm-footer__cols">
      <div class="pm-footer__brand">
        <Logo size={24} wordmark />
        <div class="pm-footer__news"><NewsletterSignup /></div>
      </div>
      {groups.map((col) => (
        <div class="pm-footer__col">
          {col.map((g) => (
            <div class="pm-footer__group">
              <div class="pm-footer__title">{g.href ? <a href={g.href}>{g.title}</a> : g.title}</div>
              <ul>{g.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
            </div>
          ))}
        </div>
      ))}
    </div>
    <div class="pm-footer__featured"><FeaturedOn /></div>
    <div class="pm-footer__base">
      <span class="pm-footer__copy">&copy; {new Date().getFullYear()} Picmal - All rights reserved.<button type="button" class="pm-footer__theme" id="pm-theme" aria-label="Toggle color theme">Dark Mode</button></span>
      <span class="pm-footer__legal"><a href="/terms">Terms of use</a><a href="/privacy">Privacy policy</a><a href="/legal/open-source">Open source</a></span>
    </div>
  </div></div>
</footer>

<script is:inline>
  // Theme: follow the OS until the visitor picks, then remember the pick.
  const html = document.documentElement;
  function applyTheme(theme) {
    html.classList.remove("light", "dark");
    html.classList.add(theme);
    html.style.colorScheme = theme;
    const label = document.getElementById("pm-theme");
    if (label) label.textContent = theme === "dark" ? "Light Mode" : "Dark Mode";
  }
  window.toggleTheme = function toggleTheme() {
    const next = html.classList.contains("dark") ? "light" : "dark";
    applyTheme(next);
    localStorage.setItem("theme", next);
  };
  function initTheme() {
    applyTheme(localStorage.getItem("theme") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"));
  }
  initTheme();
  document.getElementById("pm-theme")?.addEventListener("click", () => window.toggleTheme());
  document.addEventListener("astro:page-load", initTheme);
</script>
