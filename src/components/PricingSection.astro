---
import Card from "./Card.astro";
import { UPGRADE, licenseFaqs } from "../config/pricing";
import FAQ from "./FAQ.astro";
import Paragraph from "./Paragraph.astro";
import PricingPlans from "./PricingPlans.astro";
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";


---

<Section id="pricing" width="medium" bg="subtle">
  <SectionHeading class="mb-4">
    Pay once and you're all set
  </SectionHeading>

  {/* Reads as a note under the heading, not a second CTA: only the action is
      accented, so it never competes with the buy button below. */}
  <Paragraph size="lead" class="text-center mb-10">
    Already own Picmal? <a class="link" href={UPGRADE.url}
      >Add more Macs <span aria-hidden="true">&rarr;</span></a
    >
  </Paragraph>

  <PricingPlans />

  <div class="max-w-3xl mx-auto mt-16">
    <Card>
      <FAQ faqs={licenseFaqs} />
    </Card>
  </div>
</Section>
