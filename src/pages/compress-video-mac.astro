---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Paragraph from "../components/Paragraph.astro";
import Button from "../components/Button.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import TrustBar from "../components/TrustBar.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import SectionDivider from "../components/SectionDivider.astro";
import PricingSection from "../components/PricingSection.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";

const title =
  "Compress Video on Mac — Reduce File Size Without Losing Quality | Picmal";
const description =
  "Compress MP4, MOV, MKV and more on your Mac. H.264/H.265 with a quality slider, target a size for email, batch process. Offline, no watermark, no upload limit. $15.99 one-time.";

const faqs = [
  {
    question: "How much can Picmal shrink a video?",
    answer:
      "It depends on the source and your settings, but 50–80% is common. Switching to H.265 (HEVC) alone cuts size roughly in half versus H.264 at the same quality, and lowering the CRF, resolution, or frame rate shrinks it further.",
  },
  {
    question: "Does compressing a video lose quality?",
    answer:
      "Only as much as you choose. Picmal uses a CRF quality slider — at CRF 18–20 the result is visually lossless. Picmal also shows an estimated output size before you encode, so you can dial in the size/quality trade-off without guessing.",
  },
  {
    question: "Can I compress a video to send by email?",
    answer:
      "Yes. Most email providers cap attachments around 25 MB. Lower the CRF, drop the resolution, or reduce the frame rate and watch the live size estimate until your clip fits, then export.",
  },
  {
    question: "Which video formats can Picmal compress?",
    answer:
      "MP4, MOV, MKV, AVI, WebM, M4V, MPG, HEVC, FLV, WMV, 3GP, M2TS/MTS, VOB, TS and more. You can keep the same container or switch it while compressing.",
  },
  {
    question: "Can I batch compress multiple videos?",
    answer:
      "Yes. Drop multiple videos or a whole folder into Picmal and compress them all with the same settings in one pass.",
  },
  {
    question: "Is there an upload, watermark, or size limit?",
    answer:
      "No. Picmal compresses entirely on your Mac — no uploads, no queues, no watermark, and no file-size cap. It's a one-time $15.99, not a subscription.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <link
      rel="preload"
      href="/picmal-1.2.0-demo.mp4"
      as="video"
      type="video/mp4"
    />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <main id="main-content" class="relative z-10 pt-32 pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <Breadcrumb
          items={[
            { label: "Home", href: "/" },
            { label: "Compress Video on Mac" },
          ]}
        />

        <div class="text-center mb-12">
          <H1 class="mb-6 max-w-3xl mx-auto"
            >Compress video on your Mac without losing quality</H1
          >
          <Paragraph class="max-w-2xl mx-auto mb-8">
            Shrink MP4, MOV, MKV and more with a quality slider and a live size
            estimate. Make a clip small enough to email, or batch-compress a
            whole folder. Offline, no watermark, no upload limit.
          </Paragraph>
          <div
            class="flex flex-col sm:flex-row gap-3 items-center justify-center mb-6"
          >
            <Button
              text="Get Picmal for $15.99"
              onclick="posthog.capture('buy_clicked_compress_video_mac')"
            />
            <a
              href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg"
              class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-body py-3 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto"
            >
              <svg
                class="size-4 inline-block mr-2"
                fill="currentColor"
                stroke="none"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8 4.35 4.35 0 0 1-2.59-4.03z"
                ></path></svg
              >
              Download
            </a>
          </div>
          <TrustBar />
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-5xl mx-auto rounded-lg sm:rounded-xl overflow-hidden border border-border"
        >
          <div class="aspect-[16/10]">
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal video compression interface"></video>
          </div>
        </div>
      </div>
    </main>

    <SectionDivider />

    <!-- How It Works -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-8 text-center">Compress a video in 3 steps</H2>
        <div class="grid md:grid-cols-3 gap-6">
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6 text-center"
          >
            <div
              class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-4 font-semibold"
            >
              1
            </div>
            <h3 class="font-semibold text-text mb-2">Drop your video</h3>
            <Paragraph
              >Drag in one clip or a whole folder of videos.</Paragraph
            >
          </div>
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6 text-center"
          >
            <div
              class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-4 font-semibold"
            >
              2
            </div>
            <h3 class="font-semibold text-text mb-2">Set quality & codec</h3>
            <Paragraph
              >Pick a CRF level and codec (H.264/H.265). Watch the size estimate
              update live.</Paragraph
            >
          </div>
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6 text-center"
          >
            <div
              class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-4 font-semibold"
            >
              3
            </div>
            <h3 class="font-semibold text-text mb-2">Compress</h3>
            <Paragraph>Click Compress — everything runs on your Mac.</Paragraph>
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- Controls -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-8 text-center">Real control over the trade-off</H2>
        <div class="grid sm:grid-cols-2 gap-6">
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6">
            <h3 class="font-semibold text-text mb-2">CRF quality slider</h3>
            <Paragraph
              >0–51 scale. CRF 18–20 is visually lossless; push higher for
              smaller files when you need them.</Paragraph
            >
          </div>
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6">
            <h3 class="font-semibold text-text mb-2">Modern codecs</h3>
            <Paragraph
              >H.264 for compatibility, H.265/HEVC for ~50% smaller files, VP9
              and AV1 for the web.</Paragraph
            >
          </div>
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6">
            <h3 class="font-semibold text-text mb-2">Frame-rate reduction</h3>
            <Paragraph
              >Drop 60 fps to 30 fps to shrink screen recordings and tutorials
              that don't need cinematic motion.</Paragraph
            >
          </div>
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6">
            <h3 class="font-semibold text-text mb-2">Size estimate first</h3>
            <Paragraph
              >See the projected output size before you encode — perfect for
              hitting an email or upload limit.</Paragraph
            >
          </div>
        </div>
        <div class="text-center mt-8">
          <a
            href="/video-converter-mac"
            class="text-body-sm text-accent hover:underline"
            >Need to convert video formats too? See the video converter &rarr;</a
          >
        </div>
      </div>
    </section>

    <SectionDivider />
    <MasonryTestimonials />
    <SectionDivider />

    <section
      id="pricing"
      class="relative z-10 px-6 py-16 sm:py-20 bg-background-subtle/50 border-y border-border"
    >
      <PricingSection />
    </section>

    <section id="faq" class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-8 text-center">Frequently asked questions</H2>
        <div
          class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />
    <SupportedFormatsModal />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "cantimplorastudio" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
