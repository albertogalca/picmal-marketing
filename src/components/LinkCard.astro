---
export interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<a href={href} class="block group rounded-lg border border-gray-200 p-6">
  <h3
    class="font-semibold text-body mb-2 group-hover:text-accent transition-colors"
  >
    {title}
  </h3>
  <p class="text-text-secondary text-body-sm">
    {description}
  </p>
</a>
