---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import FAQSchema, { faqs } from "../components/schema/FAQSchema.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Button from "../components/Button.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import Paragraph from "../components/Paragraph.astro";
import FeaturedOn from "../components/FeaturedOn.astro";
import DynamicPricing from "../components/DynamicPricing.astro";
import SectionDivider from "../components/SectionDivider.astro";
import BentoFeatures from "../components/BentoFeatures.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import TrustBar from "../components/TrustBar.astro";

const SITE_TITLE = "Picmal - All-in-one media converter for Mac";
const SITE_DESCRIPTION =
  "Batch convert and compress your images, videos and audios offline on your Mac.";

const licenseFaqs = [
  {
    question: "How does the license work?",
    answer:
      "When you purchase a Picmal license, you can use it indefinitely without any additional fees. This means you won't need to renew your license or make any regular payments to continue using it. You can move your license between devices, but you must first deactivate the license on the current device before activating it on a new one.",
  },
  {
    question: "How many devices can I use Picmal on?",
    answer:
      "Each license lets you use Picmal on that number of different Macs — for example, the 3-device license works on three Macs, the 5-device license on five, and so on.",
  },
  {
    question: "Can I use Picmal on multiple Macs?",
    answer:
      "While your license is tied to one active device at a time, you can transfer it between your Macs. Simply deactivate the license from your current Mac and activate it on another Mac when needed.",
  },
  {
    question: "What happens if I get a new Mac?",
    answer:
      "You can easily transfer your Picmal license to your new Mac. Just deactivate the license on your old Mac (via Picmal → Register license), then install Picmal on your new Mac and activate it with your existing license key.",
  },
  {
    question: "Can I get a refund?",
    answer:
      "Yes, there is a 14-day money-back guarantee. No questions asked. If you're not satisfied with Picmal, send your refund request to support@picmal.app and I'd love to hear your feedback too!",
  },
];
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema />
    <link
      rel="preload"
      href="/picmal-1.2.0-demo.mp4"
      as="video"
      type="video/mp4"
    />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <!-- Subtle gradient background - Apple style -->
    <div class="fixed inset-0 -z-20 apple-gradient"></div>

    <Header />

    <!-- Hero Section -->
    <main id="main-content" class="relative z-10 pt-32 pb-16 sm:pb-20">
      <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12 sm:mb-16">
          <div
            class="max-w-4xl mx-auto flex justify-center items-center flex-col"
          >
            <H1 class="mb-6 max-w-3xl mx-auto hero-title"
              >All-in-one media converter for Mac</H1
            >
            <p
              class="mb-6 sm:mb-8 max-w-xl mx-auto text-base sm:text-lg md:text-xl leading-relaxed text-text-secondary px-4 sm:px-0 text-pretty hero-subtitle"
            >
              Batch convert images, videos and audio offline on your Mac.
            </p>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col items-center gap-4 sm:gap-6 hero-cta">
            <div
              class="flex flex-col sm:flex-row gap-3 items-center justify-center w-full sm:w-auto"
            >
              <Button
                text="Get Picmal for $15.99"
                id="buy-cta-button"
                class="apple-button-primary"
              />
              <a
                href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg"
                class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-base sm:text-lg py-3 sm:py-4 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto apple-button-secondary"
                id="download-cta-button"
              >
                <svg
                  class="size-4 inline-block mr-2"
                  fill="currentColor"
                  stroke="none"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  ><path
                    d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8 4.35 4.35 0 0 1-2.59-4.03z"
                  ></path></svg
                >
                Download
              </a>
            </div>

            <!-- Social Proof & Guarantee -->
            <div class="flex flex-col items-center gap-3">
              <TrustBar />
              <p class="text-xs sm:text-sm text-text-secondary text-pretty">
                One-time purchase • 14-day money back
              </p>
            </div>
          </div>
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-5xl mx-auto mt-12 sm:mt-16 rounded-lg sm:rounded-xl overflow-hidden border border-border hero-video"
        >
          <div class="aspect-[16/10]">
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover block dark:hidden"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal app interface"
            >
            </video>
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover hidden dark:block"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal app interface"
            >
            </video>
          </div>
        </div>
      </div>
    </main>

    <SectionDivider />

    <section id="features" class="relative z-10">
      <BentoFeatures />
    </section>

    <SectionDivider />

    <section id="testimonials" class="relative z-10">
      <MasonryTestimonials />
    </section>

    <SectionDivider />

    <section id="featured" class="relative z-10">
      <FeaturedOn />
    </section>

    <SectionDivider />

    <!-- Pricing -->
    <section id="pricing" class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-5xl mx-auto">
        <!-- Pricing Header -->
        <div class="text-center md:text-left mb-12 md:mb-0">
          <H2 class="mb-4 md:hidden">Pay once, own forever</H2>
          <Paragraph class="max-w-md mx-auto md:hidden">
            Buy Picmal once and use it forever with all future updates included.
            14-day money-back guarantee.
          </Paragraph>
        </div>

        <div
          class="flex flex-col md:flex-row justify-between gap-12 md:gap-16 items-center md:items-start"
        >
          <!-- Pricing Card -->
          <div
            class="w-full max-w-md md:max-w-none md:w-auto order-1 md:order-2"
          >
            <div class="md:sticky md:top-8">
              <DynamicPricing />
            </div>
          </div>

          <!-- Benefits & FAQ -->
          <div
            class="w-full md:max-w-md space-y-6 text-left order-2 md:order-1"
          >
            <div class="hidden md:block space-y-6">
              <div>
                <H2 class="mb-4">Pay once, <br />own forever</H2>
                <Paragraph>
                  Buy Picmal once and use it forever with all future updates
                  included. 14-day money-back guarantee.
                </Paragraph>
              </div>
              <FAQ faqs={licenseFaqs} />
            </div>
            <div class="md:hidden">
              <FAQ faqs={licenseFaqs} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-4">Frequently Asked Questions</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Can't find what you're looking for? Email support@picmal.app
          </Paragraph>
        </div>
        <div
          class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />

    <!-- Modal rendered at page level to avoid z-index issues -->
    <SupportedFormatsModal />

    <style>
      /* ==========================================
         APPLE-INSPIRED MINIMALIST DESIGN
         ========================================== */

      body {
        opacity: 0;
        transition: opacity 0.4s ease-in;
      }

      body.loaded {
        opacity: 1;
      }

      /* ==========================================
         SUBTLE GRADIENT BACKGROUND
         ========================================== */
      .apple-gradient {
        background: radial-gradient(
          ellipse 80% 50% at 50% 0%,
          hsla(220, 20%, 96%, 0.4),
          transparent
        );
      }

      .dark .apple-gradient {
        background: radial-gradient(
          ellipse 80% 50% at 50% 0%,
          hsla(220, 20%, 14%, 0.4),
          transparent
        );
      }

      /* ==========================================
         GENTLE ENTRANCE ANIMATIONS - APPLE STYLE
         ========================================== */
      .hero-title {
        animation: appleReveal 600ms ease-out 100ms both;
      }

      .hero-subtitle {
        animation: appleReveal 600ms ease-out 200ms both;
      }

      .hero-cta {
        animation: appleReveal 600ms ease-out 300ms both;
      }

      .hero-trust {
        animation: appleReveal 600ms ease-out 400ms both;
      }

      .hero-video {
        animation: appleReveal 600ms ease-out 500ms both;
      }

      @keyframes appleReveal {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* ==========================================
         REFINED BUTTON INTERACTIONS
         ========================================== */
      .apple-button-primary {
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          background-color 0.2s ease;
      }

      .apple-button-primary:hover {
        transform: translateY(-1px);
        box-shadow:
          0 10px 15px -3px rgba(0, 0, 0, 0.1),
          0 4px 6px -4px rgba(0, 0, 0, 0.1);
      }

      .apple-button-primary:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 2px;
      }

      .dark .apple-button-primary:hover {
        box-shadow:
          0 10px 15px -3px rgba(0, 0, 0, 0.3),
          0 4px 6px -4px rgba(0, 0, 0, 0.3);
      }

      .apple-button-secondary {
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          background-color 0.2s ease,
          border-color 0.2s ease;
      }

      .apple-button-secondary:hover {
        transform: translateY(-1px);
        box-shadow:
          0 4px 6px -1px rgba(0, 0, 0, 0.1),
          0 2px 4px -2px rgba(0, 0, 0, 0.1);
      }

      .apple-button-secondary:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 2px;
      }

      .dark .apple-button-secondary:hover {
        box-shadow:
          0 4px 6px -1px rgba(0, 0, 0, 0.2),
          0 2px 4px -2px rgba(0, 0, 0, 0.2);
      }

      /* ==========================================
         SCROLL-TRIGGERED ANIMATIONS (SUBTLE)
         ========================================== */
      .scroll-reveal {
        opacity: 0;
        transform: translateY(20px);
        transition:
          opacity 500ms ease-out,
          transform 500ms ease-out;
      }

      .scroll-reveal.revealed {
        opacity: 1;
        transform: translateY(0);
      }

      /* ==========================================
         VIDEO PRESENTATION
         ========================================== */
      .hero-video {
        transition: box-shadow 0.3s ease;
      }

      .hero-video:hover {
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      }

      .dark .hero-video:hover {
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      }

      /* ==========================================
         ACCESSIBILITY & REDUCED MOTION
         ========================================== */
      @media (prefers-reduced-motion: reduce) {
        .hero-title,
        .hero-subtitle,
        .hero-cta,
        .hero-trust,
        .hero-video,
        .scroll-reveal {
          animation: none !important;
          transition: none !important;
          opacity: 1 !important;
          transform: none !important;
        }
      }

      /* ==========================================
         RESPONSIVE
         ========================================== */
      @media (max-width: 640px) {
        .apple-button-primary,
        .apple-button-secondary {
          width: 100%;
        }
      }
    </style>

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "picmal" };
    </script>
    <script
      src="https://lmsqueezy.com/affiliate.js"
      defer
      onerror="console.warn('Failed to load Lemon Squeezy affiliate script')"
    ></script>

    <!-- PostHog Analytics with keyboard accessibility -->
    <script>
      // Track buy button clicks (both mouse and keyboard)
      const buyButton = document.getElementById("buy-cta-button");
      if (buyButton && typeof posthog !== "undefined") {
        buyButton.addEventListener("click", () => {
          posthog.capture("buy_clicked");
        });
      }

      // Track download button clicks
      const downloadButton = document.getElementById("download-cta-button");
      if (downloadButton && typeof posthog !== "undefined") {
        downloadButton.addEventListener("click", () => {
          posthog.capture("download_clicked");
        });
      }
    </script>

    <!-- Minimal Interactions -->
    <script>
      // Scroll-triggered animations with Intersection Observer
      function initScrollReveal() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("revealed");
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: "0px 0px -80px 0px",
          },
        );

        const sections = document.querySelectorAll(
          "section:not(#main-content)",
        );
        sections.forEach((section) => {
          section.classList.add("scroll-reveal");
          observer.observe(section);
        });
      }

      // Initialize
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initScrollReveal);
      } else {
        initScrollReveal();
      }

      // Smooth page load
      window.addEventListener("load", () => {
        document.body.classList.add("loaded");
      });
    </script>
  </body>
</html>
