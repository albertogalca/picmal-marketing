---
const route = Astro.locals.starlightRoute;

function stripHtml(url: string) {
  return url.replace(/\.html(\?|#|$)/, "$1");
}

const head = route.head.map((entry) => {
  if (entry.tag === "title") {
    return { ...entry, content: `Picmal: ${route.entry.data.title}` };
  }
  if (
    entry.tag === "link" &&
    entry.attrs?.rel === "canonical" &&
    typeof entry.attrs.href === "string"
  ) {
    return { ...entry, attrs: { ...entry.attrs, href: stripHtml(entry.attrs.href) } };
  }
  if (
    entry.tag === "meta" &&
    entry.attrs?.property === "og:url" &&
    typeof entry.attrs.content === "string"
  ) {
    return { ...entry, attrs: { ...entry.attrs, content: stripHtml(entry.attrs.content) } };
  }
  return entry;
});
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

<!-- Affonso affiliate tracking (first-party /r proxy, see Seline.astro) —
     docs pages don't go through BaseHead, and the pixel must load on every page. -->
{
  import.meta.env.PROD && (
    <script
      is:inline
      async
      defer
      src="/r/pixel.js"
      data-affonso="cmsv7goeg000f7f4l751rl9f8"
      data-cookie_duration="60"
      data-api-base="/r"
    />
  )
}
