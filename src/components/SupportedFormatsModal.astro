---
import H2 from "./H2.astro";
import H3 from "./H3.astro";
import Paragraph from "./Paragraph.astro";

// Modal component for displaying supported formats
const imageFormats = {
  input: [
    "JPEG",
    "PNG",
    "GIF",
    "BMP",
    "TIFF",
    "WebP",
    "AVIF",
    "HEIC",
    "HEIF",
    "ICO",
    "PSD",
    "AI",
    "EPS",
    "PDF",
    "CR2",
    "NEF",
    "ARW",
    "RAF",
    "DNG",
    "JXL",
    "QOI",
    "JP2",
    "TGA",
    "DDS",
    "EXR",
    "SGI",
    "PCX",
    "XBM",
    "XPM",
    "PBM",
    "PGM",
    "PPM",
    "PNM",
    "SVG",
  ],
  output: [
    "JPEG",
    "PNG",
    "GIF",
    "BMP",
    "TIFF",
    "WebP",
    "AVIF",
    "HEIC",
    "SVG",
    "PDF",
    "ICO",
    "JP2",
    "TGA",
    "JXL",
    "DDS",
    "EXR",
    "QOI",
    "PSD",
  ],
