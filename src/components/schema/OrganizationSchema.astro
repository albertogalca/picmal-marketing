---
import { orgId, personNode } from "../../utils/schemaIds";

interface Props {
  url: string;
}

const { url } = Astro.props;

// This component owns the one full Person definition for the site. Everything
// else references it by @id (see src/utils/schemaIds.ts).
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": orgId(url),
  name: "Picmal",
  // The studio name only lived in about.astro's own duplicate node. Kept here
  // so removing that duplicate lost nothing.
  alternateName: "Cantimplora Studio",
  url: url,
  logo: new URL("/logo.webp", url).href,
  description:
    "All-in-one media tool for Mac. Batch convert, compress, and create images, videos, audio, and PDF files offline on your Mac.",
  founder: personNode(url),
  // Legal entity, registered address and support inbox. Same details already
  // published on /terms, /privacy and /contact: this is the machine-readable
  // copy so an agent can verify the business without parsing a legal page.
  legalName: "Cantimplora Studio, LLC",
  email: "support@picmal.app",
  address: {
    "@type": "PostalAddress",
    streetAddress: "30 N Gould St Ste R",
    addressLocality: "Sheridan",
    addressRegion: "WY",
    postalCode: "82801",
    addressCountry: "US",
  },
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "customer support",
      email: "support@picmal.app",
      url: new URL("/contact", url).href,
      availableLanguage: ["English", "Spanish"],
    },
    {
      "@type": "ContactPoint",
      contactType: "sales",
      email: "support@picmal.app",
      url: new URL("/contact", url).href,
      availableLanguage: ["English", "Spanish"],
    },
  ],
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(organizationSchema)}
/>
