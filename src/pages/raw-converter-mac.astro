---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Paragraph from "../components/Paragraph.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import SectionDivider from "../components/SectionDivider.astro";
import PricingSection from "../components/PricingSection.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import { formats, RAW_INPUT_FORMATS } from "../data/conversions";
import ComparisonHero from "../components/ComparisonHero.astro";

const title = "RAW Converter for Mac — Convert CR2, NEF, ARW to JPG | Picmal";
const description =
  "Convert camera RAW files — CR2, CR3, NEF, ARW, RAF, RW2, ORF, PEF, DNG — to JPG on your Mac. Batch process entire shoots offline with correct white balance. $15.99 one-time, no Lightroom subscription.";

// Build the RAW format cards from the source of truth (8 camera formats + DNG).
const rawCards = [...RAW_INPUT_FORMATS, "dng"].map((ext) => ({
  slug: `${ext}-to-jpg`,
  name: formats[ext].name,
  brand: formats[ext].brand ?? "Adobe",
}));

const faqs = [
  {
    question: "Which RAW formats can Picmal convert?",
    answer:
      "Picmal decodes Canon CR2 and CR3, Nikon NEF, Sony ARW, Fujifilm RAF, Panasonic RW2, Olympus ORF, Pentax PEF, and Adobe DNG — and exports them to JPG, PNG, or TIFF.",
  },
  {
    question: "Do I need Lightroom or Photoshop to convert RAW files?",
    answer:
      "No. Picmal decodes RAW files directly on your Mac with correct white balance and demosaicing. It's a one-time purchase of $15.99 — no Adobe subscription required just to get shareable JPGs from your shoots.",
  },
  {
    question: "Will the colors look right when I convert RAW to JPG?",
    answer:
      "Yes. Picmal reads the camera white balance embedded in each RAW file and applies proper demosaicing and gamma, so your JPGs reflect what the camera intended — not the flat, washed-out look of an unprocessed raw preview.",
  },
  {
    question: "Can I batch convert an entire shoot at once?",
    answer:
      "Yes. Drag hundreds of RAW files, or a whole folder straight from your memory card, into Picmal and convert them all to JPG in a single pass — ideal for culling and delivering shoots.",
  },
  {
    question: "Can Picmal convert a JPG back into a RAW file?",
    answer:
      "No. RAW files contain unprocessed sensor data that only your camera can produce — no software can rebuild a true RAW file from a JPG. Picmal converts RAW to standard formats like JPG, PNG, and TIFF, not the other way around.",
  },
  {
    question: "Do my photos leave my Mac?",
    answer:
      "No. All decoding and conversion happens locally on your Mac. Picmal works completely offline — your raw files never touch any server.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

        <ComparisonHero
      title="Convert camera RAW to JPG on your Mac"
      subhead="CR2, NEF, ARW, RAF and more — Picmal decodes your camera's raw files with correct white balance and batch-exports an entire shoot to JPG. Fast, offline, and private. No Lightroom subscription."
      buyEvent="buy_clicked_raw_converter_mac"
      defaultTab="convert"
    />

    <SectionDivider />

    <!-- How It Works -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-8 text-center">Convert your shoot in 3 steps</H2>
        <div class="grid md:grid-cols-3 gap-6">
          <div
            class="bg-background-subtle/50 border border-border rounded-2xl p-6 text-center"
          >
            <div
              class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-4 font-semibold"
            >
              1
            </div>
            <h3 class="font-semibold text-text mb-2">Drop your RAW files</h3>
            <Paragraph
              >Drag a whole folder straight from your memory card or Finder.</Paragraph
            >
          </div>
          <div
            class="bg-background-subtle/50 border border-border rounded-2xl p-6 text-center"
          >
            <div
              class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-4 font-semibold"
            >
              2
            </div>
            <h3 class="font-semibold text-text mb-2">Choose JPG & quality</h3>
            <Paragraph
              >Pick JPG (or PNG/TIFF) and set the quality you need.</Paragraph
            >
          </div>
          <div
            class="bg-background-subtle/50 border border-border rounded-2xl p-6 text-center"
          >
            <div
              class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-4 font-semibold"
            >
              3
            </div>
            <h3 class="font-semibold text-text mb-2">Convert the batch</h3>
            <Paragraph
              >Click Convert and the whole shoot is ready in minutes.</Paragraph
            >
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- RAW Format Options -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-3 text-center">Convert any camera RAW format</H2>
        <Paragraph class="text-center max-w-2xl mx-auto mb-8">
          Pick your camera's format below. RAW files are input-only — Picmal
          decodes them to JPG, but no app can turn a JPG back into RAW.
        </Paragraph>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          {
            rawCards.map((card) => (
              <a
                href={`/convert/${card.slug}`}
                class="bg-background-subtle/50 border border-border rounded-xl p-4 text-center transition-colors hover:border-accent/30"
              >
                <span class="block text-small font-medium text-text">
                  {card.name} to JPG
                </span>
                <span class="block text-small text-text-secondary mt-1">
                  {card.brand}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- Why Picmal for RAW -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-8 text-center">Built for photographers, not subscriptions</H2>
        <div class="grid sm:grid-cols-3 gap-6">
          <div class="bg-background-subtle/50 border border-border rounded-2xl p-6">
            <h3 class="font-semibold text-text mb-2">No monthly fee</h3>
            <Paragraph
              >A one-time $15.99 — not a subscription like Lightroom or Capture
              One. Just get your JPGs and move on.</Paragraph
            >
          </div>
          <div class="bg-background-subtle/50 border border-border rounded-2xl p-6">
            <h3 class="font-semibold text-text mb-2">Correct colors</h3>
            <Paragraph
              >Camera white balance, demosaicing, and gamma applied — your JPGs
              look the way the shot was meant to.</Paragraph
            >
          </div>
          <div class="bg-background-subtle/50 border border-border rounded-2xl p-6">
            <h3 class="font-semibold text-text mb-2">Whole shoots, offline</h3>
            <Paragraph
              >Batch hundreds of raw files at once, entirely on your Mac. Nothing
              uploaded, nothing phoned home.</Paragraph
            >
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />
    <MasonryTestimonials />
    <SectionDivider />

    <section
      id="pricing"
      class="relative z-10 px-6 py-16 sm:py-20 bg-background-subtle/50 border-y border-border"
    >
      <PricingSection />
    </section>

    <section id="faq" class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-8 text-center">Frequently asked questions</H2>
        <div
          class="bg-background-subtle/50 border border-border rounded-2xl p-6 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />
    <SupportedFormatsModal />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "cantimplorastudio" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
