{
  "name": "picmal-marketing",
  "compatibility_date": "2025-12-05",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "picmal.app", "custom_domain": true },
    { "pattern": "www.picmal.app", "custom_domain": true }
  ]
}
