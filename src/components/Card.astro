---
import { cn } from "../utils/cn";

/**
 * Card — the standard panel surface (subtle bg + hairline border + 8px radius).
 * Replaces the `bg-background-subtle/50 border border-border rounded-2xl p-…`
 * string repeated across the site. Tune padding per use via the `padding` prop.
 */
interface Props {
  padding?: string;
  class?: string;
}

const { padding = "p-6 md:p-8", class: className } = Astro.props;
---

<div
  class={cn(
    "bg-background-subtle/50 border border-border rounded-2xl",
    padding,
    className,
  )}
>
  <slot />
</div>
