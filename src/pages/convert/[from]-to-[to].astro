---
import type { GetStaticPaths } from "astro";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import Paragraph from "../../components/Paragraph.astro";
import Button from "../../components/Button.astro";
import FAQ from "../../components/FAQ.astro";
import CTASection from "../../components/CTASection.astro";
import SectionDivider from "../../components/SectionDivider.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import TrustBar from "../../components/TrustBar.astro";
import BentoFeatures from "../../components/BentoFeatures.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeaturedOn from "../../components/FeaturedOn.astro";
import {
  getAllConversions,
  generateConversionData,
  formats,
  getRelatedConversions,
} from "../../data/conversions";
import H3 from "../../components/H3.astro";

export const getStaticPaths: GetStaticPaths = () => {
  const allConversions = getAllConversions();

  return allConversions.map(({ from, to }) => ({
    params: { from, to },
    props: {
      conversionData: generateConversionData(from, to),
      fromFormat: formats[from],
      toFormat: formats[to],
    },
  }));
};

const { conversionData, fromFormat, toFormat } = Astro.props as {
  conversionData: any;
  fromFormat: any;
  toFormat: any;
};
const { from, to } = Astro.params as { from: string; to: string };

// Get smart related conversions
const relatedConversions = getRelatedConversions(from, to, 6);

// Generate comparison table data
const comparisonFeatures = [
  {
    feature: "Privacy",
    online: "Upload required",
    picmal: "100% Offline",
  },
  {
    feature: "Speed",
    online: "Internet-dependent",
    picmal: "Instant",
  },
  {
    feature: "Batch Processing",
    online: "Limited",
    picmal: "Unlimited",
  },
  {
    feature: "File Size Limit",
    online: "Usually 10-50MB",
    picmal: "No limit",
  },
  {
    feature: "Quality Control",
    online: "Basic",
    picmal: "Advanced",
  },
  {
    feature: "Ads",
    online: "Yes",
    picmal: "No",
  },
];

// Add format-specific comparison features
if (from === "heic" || from === "dng") {
  comparisonFeatures.splice(2, 0, {
    feature: fromFormat.name + " Support",
    online: "Limited",
    picmal: "Full native support",
  });
}

if (fromFormat.supports_transparency && !toFormat.supports_transparency) {
  comparisonFeatures.splice(4, 0, {
    feature: "Transparency Handling",
    online: "Limited options",
    picmal: "Custom background colors",
  });
}

// Check if there are any limitations
const hasAnimationLoss =
  fromFormat.supports_animation && !toFormat.supports_animation;
const hasTransparencyLoss =
  fromFormat.supports_transparency && !toFormat.supports_transparency;
const hasQualityLoss =
  fromFormat.quality === "lossless" && toFormat.quality === "lossy";
const hasAnyLimitations =
  hasAnimationLoss || hasTransparencyLoss || hasQualityLoss;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={conversionData.title}
      description={conversionData.description}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "HowTo",
        name: `How to Convert ${fromFormat.name} to ${toFormat.name} on Mac`,
        description: `Simple steps to convert ${fromFormat.name} images to ${toFormat.name} format using Picmal on macOS`,
        step: [
          {
            "@type": "HowToStep",
            name: "Download Picmal",
            text: "Download and install Picmal for Mac from the official website",
          },
          {
            "@type": "HowToStep",
            name: `Add ${fromFormat.name} Files`,
            text: `Drag and drop your ${fromFormat.name} images into Picmal`,
          },
          {
            "@type": "HowToStep",
            name: `Select ${toFormat.name} Format`,
            text: `Choose ${toFormat.name} as your output format`,
          },
          {
            "@type": "HowToStep",
            name: "Convert",
            text: `Click convert and get your ${toFormat.name} files instantly`,
          },
        ],
        tool: {
          "@type": "HowToTool",
          name: "Picmal for Mac",
        },
      })}
    />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text"
  >
    <Header />

    <!-- Hero Section -->
    <main class="relative z-10 pt-32 pb-12 sm:pb-16 md:pb-20">
      <!-- Gradient background -->
      <div class="absolute inset-0 -z-10 overflow-hidden hero-gradient"></div>

      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <!-- Breadcrumb -->
        <div class="mb-6 sm:mb-8">
          <Breadcrumb
            items={[
              { label: "Home", href: "/" },
              { label: "Convert", href: "/convert" },
              { label: `${fromFormat.name} to ${toFormat.name}` },
            ]}
          />
        </div>

        <div class="text-center mb-8 sm:mb-12">
          <div
            class="max-w-4xl mx-auto flex justify-center items-center flex-col"
          >
            <H1 class="mb-4 sm:mb-6 max-w-3xl mx-auto">
              Convert {fromFormat.name} to {toFormat.name} on Mac
            </H1>
            <p
              class="mb-8 sm:mb-10 max-w-2xl mx-auto text-base sm:text-lg md:text-xl leading-relaxed text-text-secondary px-4 sm:px-0"
            >
              Tired of online converters that compromise your privacy or
              quality? Picmal converts {fromFormat.name} files to {
                toFormat.name
              } instantly—offline, fast, and private.
            </p>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col items-center gap-3 sm:gap-4">
            <div
              class="flex flex-col sm:flex-row gap-2 items-center justify-center"
            >
              <Button
                text="Get Picmal for $15.99"
                onclick="posthog.capture('buy_clicked')"
              />
            </div>
            <p class="text-xs sm:text-sm text-text-secondary">
              One-time purchase • 14-day money back guarantee
            </p>
          </div>
        </div>

        <!-- Trust Bar -->
        <div class="mb-8 sm:mb-12">
          <TrustBar />
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-5xl mx-auto mb-6 sm:mb-8 rounded-lg sm:rounded-xl overflow-hidden border border-border"
        >
          <div style="aspect-ratio: 16/10;">
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover block dark:hidden"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal app interface"
            >
            </video>
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover hidden dark:block"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal app interface"
            >
            </video>
          </div>
        </div>
      </div>
    </main>

    <SectionDivider />

    <!-- Features Section -->
    <BentoFeatures />

    <SectionDivider />

    <!-- Why You Might Need This Section -->
    <section class="relative z-10 px-4 sm:px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10 sm:mb-12">
          <H2 class="mb-4">Why Convert {fromFormat.name} to {toFormat.name}?</H2
          >
        </div>

        <div class="space-y-6">
          <Paragraph>
            {conversionData.why_convert}
          </Paragraph>

          <div class="space-y-4">
            <h3 class="font-semibold text-text text-lg">Common Reasons:</h3>
            <ul class="space-y-3 list-none pl-0">
              {
                conversionData.use_cases.map((useCase: string) => (
                  <li class="flex items-start gap-3">
                    <svg
                      class="w-5 h-5 text-accent mt-0.5 flex-shrink-0"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <Paragraph class="flex-1">{useCase}</Paragraph>
                  </li>
                ))
              }
            </ul>
          </div>

          <div
            class="bg-background-subtle/50 border border-border rounded-lg p-6"
          >
            <Paragraph class="italic text-text-secondary">
              <strong class="text-text not-italic">Quick Summary:</strong>
              {fromFormat.name} is great for {fromFormat.useCase.toLowerCase()},
              but {toFormat.name} excels at {toFormat.useCase.toLowerCase()}.
              Converting makes sense when you need {
                toFormat.advantages[0].toLowerCase()
              }.
            </Paragraph>
          </div>
        </div>
      </div>
    </section>

    <!-- What Happens When You Convert Section -->
    <section class="relative z-10 px-4 sm:px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10 sm:mb-12">
          <H2 class="mb-4">What to Expect When Converting</H2>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-8">
          <div class="space-y-4">
            <h3 class="font-semibold text-text text-lg flex items-center gap-2">
              <svg
                class="w-5 h-5 text-accent"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
              </svg>
              File Size Impact
            </h3>
            <Paragraph>{conversionData.size_reduction}</Paragraph>
            <Paragraph size="small" class="text-text-secondary">
              Typical file size: {fromFormat.typical_size} ({fromFormat.name}) → {
                toFormat.typical_size
              } ({toFormat.name})
            </Paragraph>
          </div>

          <div class="space-y-4">
            <h3 class="font-semibold text-text text-lg flex items-center gap-2">
              <svg
                class="w-5 h-5 text-accent"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Quality Considerations
            </h3>
            <Paragraph>{conversionData.quality_impact}</Paragraph>
            <Paragraph size="small" class="text-text-secondary">
              Source format: {fromFormat.quality} compression • Target format: {
                toFormat.quality
              } compression
            </Paragraph>
          </div>
        </div>

        <div
          class="bg-background-subtle/50 border border-border rounded-lg p-6"
        >
          <h3 class="font-semibold text-text mb-4">What You'll Keep & Lose:</h3>
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <h4
                class="font-semibold text-text text-sm mb-3 flex items-center gap-2"
              >
                <svg
                  class="w-4 h-4 text-green-500"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
                You'll Keep:
              </h4>
              <ul class="space-y-2 text-sm">
                <li class="flex items-start gap-2">
                  <span class="text-green-500">✓</span>
                  <span>Image dimensions</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-500">✓</span>
                  <span>EXIF metadata (location, date, camera settings)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-500">✓</span>
                  <span>Color accuracy</span>
                </li>
                {
                  toFormat.supports_transparency && (
                    <li class="flex items-start gap-2">
                      <span class="text-green-500">✓</span>
                      <span>Transparency (if present)</span>
                    </li>
                  )
                }
              </ul>
            </div>
            <div>
              <h4
                class="font-semibold text-text text-sm mb-3 flex items-center gap-2"
              >
                <svg
                  class="w-4 h-4 text-orange-500"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                    clip-rule="evenodd"></path>
                </svg>
                Limitations:
              </h4>
              <ul class="space-y-2 text-sm">
                {
                  hasAnimationLoss && (
                    <li class="flex items-start gap-2">
                      <span class="text-orange-500">✗</span>
                      <span>
                        Animation/Live Photos (converted to still image)
                      </span>
                    </li>
                  )
                }
                {
                  hasTransparencyLoss && (
                    <li class="flex items-start gap-2">
                      <span class="text-orange-500">✗</span>
                      <span>
                        Transparency (replaced with white/custom background)
                      </span>
                    </li>
                  )
                }
                {
                  hasQualityLoss && (
                    <li class="flex items-start gap-2">
                      <span class="text-orange-500">✗</span>
                      <span>Some quality loss due to lossy compression</span>
                    </li>
                  )
                }
                {
                  !hasAnyLimitations && (
                    <li class="flex items-start gap-2">
                      <span class="text-green-500">✓</span>
                      <span>
                        No major limitations - {toFormat.name} supports all
                        features of {fromFormat.name}
                      </span>
                    </li>
                  )
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- When NOT to Convert Section (Trust Building) -->
    <section
      class="relative z-10 px-4 sm:px-6 py-16 sm:py-20 bg-background-subtle/30"
    >
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10 sm:mb-12">
          <H2 class="mb-4">When You Should Keep {fromFormat.name}</H2>
        </div>

        <div class="space-y-6">
          <Paragraph>
            We believe in helping you make the <em>right</em> choice, not just our
            choice. Here's when keeping {fromFormat.name} makes more sense:
          </Paragraph>

          <div class="bg-background border border-border rounded-lg p-6">
            <h3 class="font-semibold text-text mb-4">
              Stick with {fromFormat.name} if:
            </h3>
            <ul class="space-y-3">
              {
                fromFormat.advantages.map((advantage: string) => (
                  <li class="flex items-start gap-3">
                    <svg
                      class="w-5 h-5 text-accent mt-0.5 flex-shrink-0"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                    <Paragraph class="flex-1">
                      You prioritize: <strong>{advantage}</strong>
                    </Paragraph>
                  </li>
                ))
              }
              {
                fromFormat.common_uses.length > 0 && (
                  <li class="flex items-start gap-3">
                    <svg
                      class="w-5 h-5 text-accent mt-0.5 flex-shrink-0"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                    <Paragraph class="flex-1">
                      Your workflow is centered around:{" "}
                      <strong>
                        {fromFormat.common_uses.slice(0, 2).join(", ")}
                      </strong>
                    </Paragraph>
                  </li>
                )
              }
            </ul>
          </div>

          <div class="bg-background border border-border rounded-lg p-6">
            <h3 class="font-semibold text-text mb-4">
              Choose {toFormat.name} when:
            </h3>
            <ul class="space-y-3">
              {
                toFormat.advantages.map((advantage: string) => (
                  <li class="flex items-start gap-3">
                    <svg
                      class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <Paragraph class="flex-1">
                      You need: <strong>{advantage}</strong>
                    </Paragraph>
                  </li>
                ))
              }
            </ul>
          </div>

          <Paragraph class="text-text-secondary italic">
            <strong class="text-text not-italic">Bottom line:</strong> If you're staying
            in the {fromFormat.common_uses[0]?.toLowerCase() || fromFormat.name} ecosystem
            and {fromFormat.advantages[0]?.toLowerCase()}, keep your files as {
              fromFormat.name
            }. But if you need {toFormat.useCase.toLowerCase()}, converting to {
              toFormat.name
            } is the way to go.
          </Paragraph>
        </div>
      </div>
    </section>

    <!-- How to Section -->
    <section class="relative z-10 px-4 sm:px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10 sm:mb-12">
          <H2 class="mb-4"
            >How to Convert {fromFormat.name} to {toFormat.name}</H2
          >
        </div>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div
              class="flex-shrink-0 flex h-10 w-10 items-center justify-center rounded-lg bg-accent text-white font-semibold"
            >
              1
            </div>
            <div>
              <H3 class="font-semibold text-text mb-1">
                Download Picmal for Mac
              </H3>
              <Paragraph>Get the native Mac app that works offline</Paragraph>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div
              class="flex-shrink-0 flex h-10 w-10 items-center justify-center rounded-lg bg-accent text-white font-semibold"
            >
              2
            </div>
            <div>
              <H3 class="font-semibold text-text mb-1">
                Drag and drop your {fromFormat.name} files
              </H3>
              <Paragraph>Add single images or entire folders</Paragraph>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div
              class="flex-shrink-0 flex h-10 w-10 items-center justify-center rounded-lg bg-accent text-white font-semibold"
            >
              3
            </div>
            <div>
              <H3 class="font-semibold text-text mb-1">
                Choose {toFormat.name}
              </H3>
              <Paragraph>
                Select {toFormat.name} as your output format in the row "To"
              </Paragraph>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div
              class="flex-shrink-0 flex h-10 w-10 items-center justify-center rounded-lg bg-accent text-white font-semibold"
            >
              4
            </div>
            <div>
              <H3 class="font-semibold text-text mb-1">
                Simply click on 'Convert'
              </H3>
              <Paragraph>All processing happens locally on your Mac</Paragraph>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Comparison Section -->
    <section class="relative z-10 px-4 sm:px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10 sm:mb-12">
          <H2 class="mb-4">
            Why Choose Picmal for {fromFormat.name} to {toFormat.name} Conversion?
          </H2>
        </div>

        <div class="overflow-x-auto rounded-lg border border-border">
          <table
            class="w-full text-left border-collapse bg-background-subtle/50"
          >
            <thead>
              <tr class="border-b border-gray-200">
                <th class="py-4 px-4 font-semibold text-text text-base">
                  Feature
                </th>
                <th class="py-4 px-4 font-semibold text-text text-base">
                  Online Converters
                </th>
                <th class="py-4 px-4 font-semibold text-text text-base">
                  Picmal
                </th>
              </tr>
            </thead>
            <tbody>
              {
                comparisonFeatures.map((feature) => (
                  <tr class="border-b border-gray-200">
                    <td class="py-4 px-4 text-text font-semibold">
                      {feature.feature}
                    </td>
                    <td class="py-4 px-4 text-text-secondary">
                      {feature.online}
                    </td>
                    <td class="py-4 px-4 text-text font-semibold">
                      {feature.picmal}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Use Cases Section -->
    <section class="relative z-10 px-4 sm:px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10 sm:mb-12">
          <H2 class="mb-4">
            Perfect for {
              toFormat.name === "jpg"
                ? "Universal photo sharing and web use"
                : toFormat.useCase
            }
          </H2>
        </div>

        <div class="space-y-8">
          {
            conversionData.use_cases.map((useCase: string, index: number) => (
              <div>
                <h3 class="font-semibold text-text text-base mb-2">
                  {useCase}
                </h3>
                <Paragraph>
                  {index === 0 && conversionData.why_convert}
                  {index === 1 &&
                    `Batch process multiple ${fromFormat.name} files efficiently. ${conversionData.size_reduction}.`}
                  {index === 2 &&
                    `Share your converted ${toFormat.name} files across all platforms and devices without compatibility concerns.`}
                  {index === 3 &&
                    to === "jpg" &&
                    "Optimize images for faster website loading and better user experience."}
                  {index === 4 &&
                    `Efficiently manage your image library by converting ${fromFormat.name} files to ${toFormat.name} format.`}
                </Paragraph>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- Testimonials Section -->
    <MasonryTestimonials />

    <SectionDivider />

    <!-- Featured On Section -->
    <FeaturedOn />

    <SectionDivider />

    <!-- FAQ Section -->
    <section class="relative z-10 px-4 sm:px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 sm:mb-12">
          <H2 class="mb-4">Frequently asked questions</H2>
        </div>
        <div
          class="bg-background-subtle/50 border border-border rounded-lg p-4 md:p-8"
        >
          <FAQ faqs={conversionData.faqs} />
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- CTA Section -->
    <CTASection
      heading={`Start converting ${fromFormat.name} to ${toFormat.name} now`}
      analyticsEvent={`buy_clicked_convert_${from}_to_${to}_bottom`}
    />

    <SectionDivider />

    <!-- More Conversions Section -->
    <section class="relative z-10 px-4 sm:px-6 py-16 sm:py-20">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-10 sm:mb-12">
          <H2 class="mb-4">More format conversions</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Need to convert other formats? Picmal supports 30+ image formats for
            all your conversion needs.
          </Paragraph>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
          {
            relatedConversions.map((conversion) => (
              <a
                href={`/convert/${conversion.from}-to-${conversion.to}`}
                class="block p-4 bg-background-subtle/50 border border-border rounded-lg hover:border-accent hover:bg-background-subtle transition-all group"
              >
                <div class="flex items-center gap-3">
                  <svg
                    class="w-5 h-5 text-accent group-hover:scale-110 transition-transform"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 10V3L4 14h7v7l9-11h-7z"
                    />
                  </svg>
                  <span class="font-semibold text-text">
                    {conversion.label}
                  </span>
                </div>
              </a>
            ))
          }
        </div>

        <div class="flex justify-center w-full mt-8">
          <a
            href="/convert"
            class="inline-flex items-center gap-2 text-accent hover:text-accent/80 font-semibold transition-colors"
          >
            View all format conversions
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
    <Footer />
  </body>
</html>
