---
import { Image } from "astro:assets";
import NewsletterSignup from "./NewsletterSignup.astro";

const today = new Date();
---

<footer class="py-16 bg-background transition-colors">
  <div class="max-w-7xl mx-auto px-6 xl:px-0">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8">
      <div class="col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <Image
            src="/logo.webp"
            alt="Picmal Logo"
            width={32}
            height={32}
            class="h-8 w-8 rounded-lg"
            loading="lazy"
          />
          <span class="text-pretty text-text font-semibold text-body"
            >Picmal</span
          >
        </div>
        <NewsletterSignup />
        <p class="text-body-sm text-text-secondary mt-8">
          &copy; {today.getFullYear()} - All rights reserved.
        </p>
        <div class="pt-8 text-body-sm text-text-secondary">
          <button
            onclick="toggleTheme()"
            class="flex items-center gap-2 py-2 -my-2 rounded-md hover:text-text transition-[color,scale] active:scale-[0.96] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-text/40 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            type="button"
            aria-label="Toggle color theme"
          >
            <svg
              class="w-4 h-4 hidden dark:block"
              fill="currentColor"
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path
                d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                fill-rule="evenodd"
                clip-rule="evenodd"></path>
            </svg>
            <svg
              class="w-4 h-4 block dark:hidden"
              fill="currentColor"
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path
                d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
              ></path>
            </svg>
            <span class="hidden dark:block">Light Mode</span>
            <span class="block dark:hidden">Dark Mode</span>
          </button>
        </div>
      </div>

      <div>
        <p class="text-eyebrow uppercase text-text mb-4">Convert & Compress</p>
        <ul class="space-y-3 text-body text-text-secondary">
          <li>
            <a href="/convert" class="transition-colors hover:text-text"
              >All conversions</a
            >
          </li>
          <li>
            <a href="/compress" class="transition-colors hover:text-text"
              >All compression</a
            >
          </li>
          <li>
            <a
              href="/image-converter-mac"
              class="transition-colors hover:text-text"
              >Image converter for Mac</a
            >
          </li>
          <li>
            <a
              href="/heic-converter-mac"
              class="transition-colors hover:text-text"
              >HEIC converter for Mac</a
            >
          </li>
          <li>
            <a
              href="/raw-converter-mac"
              class="transition-colors hover:text-text">RAW converter for Mac</a
            >
          </li>
          <li>
            <a
              href="/video-converter-mac"
              class="transition-colors hover:text-text"
              >Video converter for Mac</a
            >
          </li>
          <li>
            <a
              href="/audio-converter-mac"
              class="transition-colors hover:text-text"
              >Audio converter for Mac</a
            >
          </li>
          <li>
            <a
              href="/compress-images-mac"
              class="transition-colors hover:text-text"
              >Compress images for Mac</a
            >
          </li>
          <li>
            <a
              href="/compress-video-mac"
              class="transition-colors hover:text-text"
              >Compress video for Mac</a
            >
          </li>
          <li>
            <a
              href="/compress-audio-mac"
              class="transition-colors hover:text-text"
              >Compress audio for Mac</a
            >
          </li>
        </ul>
      </div>
      <div>
        <p class="text-eyebrow uppercase text-text mb-4">
          Tools & Alternatives
        </p>
        <ul class="space-y-3 text-body text-text-secondary">
          <li>
            <a href="/tools" class="transition-colors hover:text-text"
              >All tools</a
            >
          </li>
          <li>
            <a
              href="/tools/image-format-selector"
              class="transition-colors hover:text-text">Image format selector</a
            >
          </li>
          <li>
            <a
              href="/tools/image-file-size-calculator"
              class="transition-colors hover:text-text"
              >Image file size calculator</a
            >
          </li>
          <li>
            <a
              href="/tools/image-format-support-matrix"
              class="transition-colors hover:text-text"
              >Image format support matrix</a
            >
          </li>
          <li>
            <a
              href="/alternative/compresto"
              class="transition-colors hover:text-text">Compresto alternative</a
            >
          </li>
          <li>
            <a
              href="/alternative/ffworks"
              class="transition-colors hover:text-text">ffWorks alternative</a
            >
          </li>
          <li>
            <a
              href="/alternative/handbrake"
              class="transition-colors hover:text-text">HandBrake alternative</a
            >
          </li>
          <li>
            <a
              href="/alternative/howtoconvert"
              class="transition-colors hover:text-text"
              >How to Convert alternative</a
            >
          </li>
          <li>
            <a
              href="/alternative/kompressor"
              class="transition-colors hover:text-text"
              >Kompressor alternative</a
            >
          </li>
          <li>
            <a
              href="/alternative/permute"
              class="transition-colors hover:text-text">Permute alternative</a
            >
          </li>
          <li>
            <a
              href="/alternative/xnconvert"
              class="transition-colors hover:text-text">XnConvert alternative</a
            >
          </li>
        </ul>
      </div>
      <div>
        <p class="text-eyebrow uppercase text-text mb-4">Company</p>
        <ul class="space-y-3 text-body text-text-secondary">
          <li>
            <a href="/about" class="transition-colors hover:text-text">About</a>
          </li>
          <li>
            <a href="/blog" class="transition-colors hover:text-text">Blog</a>
          </li>
          <li>
            <a href="/changelog" class="transition-colors hover:text-text"
              >Changelog</a
            >
          </li>
          <li>
            <a
              href="mailto:support@picmal.app"
              class="transition-colors hover:text-text">Get in touch</a
            >
          </li>
          <li>
            <a href="/press" class="transition-colors hover:text-text"
              >Press kit</a
            >
          </li>
          <li>
            <a href="/affiliate" class="transition-colors hover:text-text"
              >Earn 25% as affiliate</a
            >
          </li>
          <li>
            <a href="/terms" class="transition-colors hover:text-text"
              >Terms of use</a
            >
          </li>
          <li>
            <a href="/privacy" class="transition-colors hover:text-text"
              >Privacy policy</a
            >
          </li>
          <li>
            <a
              href="/legal/open-source"
              class="transition-colors hover:text-text">Open source</a
            >
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>

<script>
  const html = document.documentElement;

  function setTheme(theme) {
    html.classList.remove("light", "dark");
    html.classList.add(theme);
    html.style.colorScheme = theme;
    localStorage.setItem("theme", theme);
  }

  function initTheme() {
    const savedTheme = localStorage.getItem("theme") || "light";
    setTheme(savedTheme);
  }

  window.toggleTheme = function toggleTheme() {
    const currentTheme = html.classList.contains("dark") ? "dark" : "light";
    const newTheme = currentTheme === "dark" ? "light" : "dark";
    setTheme(newTheme);
  };

  initTheme();
  document.addEventListener("astro:page-load", initTheme);
</script>
