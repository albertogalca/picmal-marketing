---
import Paragraph from "./Paragraph.astro";
---

<div
  class="bg-gradient-to-br from-gray-50 to-white border border-gray-200 rounded-xl p-6"
>
  <div class="text-center mb-6">
    <h4 class="font-bold text-text text-lg mb-2">
      Reduce File Size Without Losing Quality
    </h4>
    <Paragraph class="text-sm">
      See the difference Picmal makes with smart compression
    </Paragraph>
  </div>

  <div class="flex flex-col md:flex-row items-center justify-center gap-6">
    <!-- Before -->
    <div class="flex-1 max-w-[200px]">
      <div class="relative">
        <div
          class="aspect-square bg-gradient-to-br from-red-50 to-red-100 rounded-xl border-2 border-red-200 flex flex-col items-center justify-center p-6"
        >
          <svg
            class="w-12 h-12 text-red-400 mb-3"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
          </svg>
          <div class="text-center">
            <div class="text-3xl font-bold text-red-600 mb-1">12.4MB</div>
            <Paragraph class="text-xs text-red-600 font-semibold">
              Original
            </Paragraph>
          </div>
        </div>
        <div
          class="absolute -top-2 -right-2 bg-red-500 text-text text-xs font-bold px-2 py-1 rounded-full"
        >
          BEFORE
        </div>
      </div>
    </div>

    <!-- Arrow with savings -->
    <div class="flex flex-col items-center">
      <svg
        class="w-8 h-8 text-green-500 mb-2 hidden md:block"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
      </svg>
      <div
        class="bg-green-500 text-text text-sm font-bold px-4 py-2 rounded-full"
      >
        -85%
      </div>
    </div>

    <!-- After -->
    <div class="flex-1 max-w-[200px]">
      <div class="relative">
        <div
          class="aspect-square bg-gradient-to-br from-green-50 to-green-100 rounded-xl border-2 border-green-200 flex flex-col items-center justify-center p-6"
        >
          <svg
            class="w-12 h-12 text-green-500 mb-3"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <div class="text-center">
            <div class="text-3xl font-bold text-green-600 mb-1">1.8MB</div>
            <Paragraph class="text-xs text-green-600 font-semibold">
              Compressed
            </Paragraph>
          </div>
        </div>
        <div
          class="absolute -top-2 -right-2 bg-green-500 text-text text-xs font-bold px-2 py-1 rounded-full"
        >
          AFTER
        </div>
      </div>
    </div>
  </div>
</div>
