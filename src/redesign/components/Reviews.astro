---
import testimonials from "../../data/testimonials.json";
import PixelAvatar from "./PixelAvatar.astro";

// Every user quote from testimonials.json. The six picks MasonryTestimonials
// leads with (25, 9, 6, 19, 27, 21) come first; the rest open under them on
// "Show all". Reviewers without a photo get a PixelAvatar from their name.
// Press quotes carry their publication's logo and link to the review.
const PICKS = [25, 9, 6, 19, 27, 21];
type T = { id: number; name?: string; content: string; image?: string; type?: string; publication?: string; logo?: string; link?: string; logoInvertDark?: boolean };
const all = testimonials as T[];
const press = all.filter((t) => t.type === "press");
const users = all.filter((t) => t.type !== "press");
const ordered = [
  ...PICKS.map((id) => users.find((t) => t.id === id)).filter(Boolean),
  ...users.filter((t) => !PICKS.includes(t.id)),
] as T[];
const lead = press.find((p) => p.publication === "MacStories");
const second = press.filter((p) => p !== lead);
---

<div class="pm-reviews" data-pm-reviews>
  {lead && (
    <figure class="pm-reviews__press">
      <blockquote>&ldquo;{lead.content.split(". ")[0]}.&rdquo;</blockquote>
      <figcaption><a href={lead.link} target="_blank" rel="noreferrer" class="pm-press-logo"><img src={lead.logo} alt={lead.publication} width="120" height="37" /></a></figcaption>
    </figure>
  )}
  <div class="pm-reviews__wall">
    {second.map((p) => (
      <figure class="pm-review pm-review--press">
        <blockquote class="pm-review__quote">{p.content}</blockquote>
        <figcaption class="pm-review__by"><a href={p.link} target="_blank" rel="noreferrer" class="pm-press-logo"><img src={p.logo} alt={p.publication} height="22" class:list={[p.logoInvertDark && "pm-invert-dark"]} /></a></figcaption>
      </figure>
    ))}
    {ordered.map((t, i) => (
      <figure class="pm-review" data-rest={i >= PICKS.length ? "" : undefined}>
        <blockquote class="pm-review__quote">{t.content}</blockquote>
        <figcaption class="pm-review__by">
          {t.image ? <img class="pm-review__photo" src={t.image} alt="" width="28" height="28" /> : <PixelAvatar name={t.name ?? "?"} />}
          <span class="pm-review__who"><span class="pm-review__name">{t.name}</span><span class="pm-review__source">Picmal user</span></span>
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="pm-reviews__more"><button type="button" class="pm-btn pm-btn--secondary pm-btn--sm" data-more aria-expanded="false">Show all {ordered.length} reviews</button></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-pm-reviews]").forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>("[data-more]")!;
    const rest = [...root.querySelectorAll<HTMLElement>("[data-rest]")];
    rest.forEach((r) => (r.hidden = true));
    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      rest.forEach((r) => (r.hidden = open));
      btn.setAttribute("aria-expanded", String(!open));
      btn.textContent = open ? `Show all ${rest.length + 6} reviews` : "Show fewer";
    });
  });
</script>
