---
import { Image } from "astro:assets";
import H3 from "./H3.astro";
import Button from "./Button.astro";

export interface Props {
  showImage?: boolean;
  variant?: "dark" | "light";
  title?: string;
  description?: string;
  buttonText?: string;
  className?: string;
}

const {
  showImage = true,
  variant = "dark",
  title = "Use Picmal to easily convert images on your Mac",
  description = "If you're not happy with your purchase, you can request a refund within 14 days.",
  buttonText = "Buy now",
  className = "",
} = Astro.props;

const isDark = variant === "dark";
---

<div
  class={`relative ${isDark ? "bg-black" : "bg-gradient-to-r from-blue-50 to-indigo-50"} rounded-2xl p-6 sm:p-8 overflow-hidden ${className}`}
>
  <!-- Picmal app interface - hidden on mobile -->
  {
    showImage && (
      <div class="absolute -bottom-30 -right-40 hidden lg:block">
        <Image
          src="/picmal-main.webp"
          alt="Picmal App Interface"
          width={480}
          height={360}
          class="w-120 h-auto rounded-tl-lg"
        />
      </div>
    )
  }

  <!-- Content -->
  <div class="relative z-10 max-w-full sm:max-w-md lg:max-w-xs text-left">
    <H3 class="mb-3 text-white">
      {title}
    </H3>
    <p class="mb-8 text-white/75 font-medium leading-relaxed">
      {description}
    </p>
    <Button text={buttonText} />
  </div>
</div>
