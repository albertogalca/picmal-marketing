---
import Logo from "./Logo.astro";
import Button from "./Button.astro";
import { DEFAULT_TIER } from "../../config/pricing";

interface Props { active?: string }
const { active } = Astro.props;
// Same four destinations as the live Header, pointed at the preview where one exists.
const links = [
  { label: "Features", href: "/next#features" },
  { label: "Pricing", href: "/next#pricing" },
  { label: "Blog", href: "/next/blog" },
  { label: "Docs", href: "/docs" },
];
---

<header class="pm-wrap">
  <div class="pm-nav">
    <a class="pm-nav__brand" href="/next"><Logo size={24} wordmark /></a>
    <nav class="pm-nav__links" aria-label="Main">
      {links.map((l) => <a href={l.href} class={l.label === active ? "is-active" : undefined} aria-current={l.label === active ? "page" : undefined}>{l.label}</a>)}
    </nav>
    <div class="pm-nav__actions">
      <Button href="/download" variant="secondary" size="sm">Try free</Button>
      <Button href={DEFAULT_TIER.checkoutUrl} size="sm">Get Picmal for ${DEFAULT_TIER.price}</Button>
    </div>
  </div>
</header>
