---
import { Image } from "astro:assets";

const currentPage = Astro.url.pathname;
---

<nav
  class="fixed top-0 left-0 right-0 z-50 px-6 py-6 backdrop-blur-md transition-colors duration-300 bg-white/90 border-b border-slate-200/50"
>
  <div class="max-w-6xl mx-auto flex items-center justify-between">
    <div class="flex items-center space-x-2">
      <a href="/" class="flex items-center space-x-2 cursor-pointer">
        <Image
          src="/logo.webp"
          alt="Picmal Logo"
          width={40}
          height={40}
          class="rounded-lg w-10 h-10 object-cover"
        />
        <div class="text-xl font-semibold text-slate-900">Picmal</div>
      </a>
    </div>

    <div class="hidden xl:flex items-center space-x-6 2xl:space-x-8">
      <a
        href="/#features"
        class="transition-colors cursor-pointer text-slate-600 hover:text-slate-900 font-medium"
      >
        Features
      </a>
      <a
        href="/#pricing"
        class="transition-colors cursor-pointer text-slate-600 hover:text-slate-900 font-medium"
      >
        Pricing
      </a>
      <a
        href="/#testimonials"
        class="transition-colors cursor-pointer text-slate-600 hover:text-slate-900 font-medium"
      >
        Testimonials
      </a>
      <a
        href="/#faq"
        class="transition-colors cursor-pointer text-slate-600 hover:text-slate-900 font-medium"
      >
        FAQ
      </a>
      <a
        href="/#about"
        class="transition-colors cursor-pointer text-slate-600 hover:text-slate-900 font-medium"
      >
        About
      </a>
      <a
        href="/blog?category=Changelog"
        class="transition-colors cursor-pointer text-slate-600 hover:text-slate-900 font-medium"
      >
        Changelog
      </a>
      <a
        href="/blog"
        class={`transition-colors cursor-pointer font-medium ${
          currentPage.startsWith("/blog")
            ? "text-[#1B5BFF] "
            : "text-slate-600 hover:text-slate-900 "
        }`}
      >
        Blog
      </a>
    </div>

    <div class="flex items-center space-x-3">
      <!-- Buy button - hidden on mobile, shown on xl+ -->
      <a
        href="https://albertogalca.gumroad.com/l/picmal"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden xl:inline-block bg-[#1B5BFF] text-white px-6 py-2 rounded-lg hover:bg-[#1548CC] transition-colors font-medium"
      >
        Buy for Mac
      </a>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        class="xl:hidden inline-flex items-center justify-center p-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden xl:hidden">
    <div class="px-2 pt-2 pb-3 space-y-1">
      <a
        href="/#features"
        class="block px-3 py-2 rounded-md text-base font-medium text-slate-600 hover:text-slate-900"
      >
        Features
      </a>
      <a
        href="/#pricing"
        class="block px-3 py-2 rounded-md text-base font-medium text-slate-600 hover:text-slate-900"
      >
        Pricing
      </a>
      <a
        href="/#testimonials"
        class="block px-3 py-2 rounded-md text-base font-medium text-slate-600 hover:text-slate-900"
      >
        Testimonials
      </a>
      <a
        href="/#faq"
        class="block px-3 py-2 rounded-md text-base font-medium text-slate-600 hover:text-slate-900"
      >
        FAQ
      </a>
      <a
        href="/#about"
        class="block px-3 py-2 rounded-md text-base font-medium text-slate-600 hover:text-slate-900"
      >
        About
      </a>
      <a
        href="/blog?category=Changelog"
        class="block px-3 py-2 rounded-md text-base font-medium text-slate-600 hover:text-slate-900"
      >
        Changelog
      </a>
      <a
        href="/blog"
        class="block px-3 py-2 rounded-md text-base font-medium text-slate-600 hover:text-slate-900"
      >
        Blog
      </a>
      <a
        href="https://albertogalca.gumroad.com/l/picmal"
        target="_blank"
        rel="noopener noreferrer"
        class="block mx-3 my-2 px-6 py-2 rounded-lg text-base font-medium bg-[#1B5BFF] text-white hover:bg-[#1548CC] transition-colors text-center"
      >
        Buy for Mac
      </a>
    </div>
  </div>
</nav>

<script>
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");

  // Mobile menu functionality
  mobileMenuButton?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });
</script>
