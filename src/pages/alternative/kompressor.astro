---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import OrganizationSchema from "../../components/schema/OrganizationSchema.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import Paragraph from "../../components/Paragraph.astro";
import SectionDivider from "../../components/SectionDivider.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeaturedOn from "../../components/FeaturedOn.astro";
import BentoFeatures from "../../components/BentoFeatures.astro";
import PricingSection from "../../components/PricingSection.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";

const SITE_TITLE = "Picmal: The Kompressor Alternative for Video and Audio";
const SITE_DESCRIPTION =
  "Looking for a Kompressor alternative that does more than convert? Picmal is an all-in-one Mac media toolkit that converts, compresses, and lightly edits images, video, and audio — plus PDF tools. $15.99 one-time. 14-day refund.";

const faqs = [
  {
    question: "Is Picmal a good Kompressor alternative?",
    answer:
      "If you need more than image compression, yes. Picmal converts and compresses images, video, audio, and PDFs in one app, with Shortcuts, folder monitoring, and Finder right-click. Kompressor is a great free option if images are all you need.",
  },
  {
    question: "Does Picmal have real-time preview like Kompressor?",
    answer:
      "No — Picmal batches files without the per-file preview. If seeing the before/after for each image before committing matters to you, Kompressor's live preview is genuinely useful.",
  },
  {
    question: "Why pay for Picmal when Kompressor is free?",
    answer:
      "Kompressor is image-only and free. Picmal is $15.99 and covers video, audio, and PDFs alongside images — plus format conversion, metadata removal, Shortcuts, and folder monitoring. If image compression is all you need, Kompressor is a perfectly good choice.",
  },
  {
    question: "Can Kompressor convert video files?",
    answer:
      "No. Kompressor is image-only. For video — or audio, or format conversion — Picmal covers those.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Email support@picmal.app.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <ComparisonHero
      title="The Kompressor alternative that does more than convert"
      subhead="Kompressor compresses images and does it well, for free. If you also need to convert formats, work with video and audio, or handle PDFs — and want Shortcuts and folder monitoring — Picmal covers all of that."
      buyEvent="buy_clicked_kompressor_comparison"
    />

    <ComparisonVerdict
      competitor="Kompressor"
      summary="Kompressor is a free Mac image compressor with a live quality preview per file. Picmal ($15.99 one-time) covers more ground: it converts and compresses images, video, audio, and PDFs, with Shortcuts, folder monitoring, and Finder right-click."
      picmalFor="You need more than image compression — video, audio, PDF tools, format conversion — or want Shortcuts and folder monitoring in the mix."
      competitorFor="You only compress images, want real-time before/after preview, and free is important."
    />

    <SectionDivider />

    <!-- Comparison Table -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-4 text-center">Picmal vs Kompressor at a glance</H2>
        <Paragraph class="mb-8 text-center max-w-2xl mx-auto">
          Both run offline on Mac. Kompressor focuses on one thing: compressing
          images, with a live quality preview. Picmal covers more: convert,
          compress, and edit across images, video, audio, and PDFs.
        </Paragraph>

        <div
          class="bg-background-subtle/50 border border-border rounded-2xl p-4 md:p-8"
        >
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left p-4 font-semibold text-text">Feature</th>
                  <th class="text-left p-4 font-semibold text-text">Picmal</th>
                  <th class="text-left p-4 font-semibold text-text"
                    >Kompressor</th
                  >
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr>
                  <td class="p-4 text-text-secondary">Primary purpose</td>
                  <td class="p-4 text-text">Convert, compress & edit</td>
                  <td class="p-4 text-text">Image compression</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Price</td>
                  <td class="p-4 text-text">$15.99 one-time</td>
                  <td class="p-4 text-text">Free</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Privacy</td>
                  <td class="p-4 text-text">100% offline</td>
                  <td class="p-4 text-text">100% offline</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Interface</td>
                  <td class="p-4 text-text">Simple drag-and-drop</td>
                  <td class="p-4 text-text"
                    >Unique design with real-time preview</td
                  >
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Image formats</td>
                  <td class="p-4 text-text">20+</td>
                  <td class="p-4 text-text">50+ input, 20+ output</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video conversion</td>
                  <td class="p-4 text-text">Yes—MP4, MOV, MKV, and more</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Audio conversion</td>
                  <td class="p-4 text-text">Yes—MP3, WAV, FLAC, and more</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Compression</td>
                  <td class="p-4 text-text"
                    >Images, video, audio & PDF (never bigger)</td
                  >
                  <td class="p-4 text-text">Images</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">PDF tools</td>
                  <td class="p-4 text-text"
                    >Compress, combine, images→PDF, PDF→PNG</td
                  >
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Real-time preview</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text"
                    >Yes—adjust quality and see results</td
                  >
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video codec control</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">N/A</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Metadata removal</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">Yes</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Finder right-click</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Shortcuts integration</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Folder monitoring</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">macOS</td>
                  <td class="p-4 text-text">14+</td>
                  <td class="p-4 text-text">13+</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Who Picmal Is For / Who Should Stick with Kompressor -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-4">Which one is right for you?</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Here's where each one makes more sense.
          </Paragraph>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Picmal Column -->
          <div
            class="bg-background-subtle border border-border rounded-2xl p-6 md:p-8"
          >
            <div class="mb-6">
              <h3 class="text-h3 text-text mb-2">
                Choose Picmal
              </h3>
              <p class="text-text-secondary">
                More than image compression
              </p>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need a simple interface that just works
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want one app to convert, compress, and edit images, video,
                  audio, and PDFs
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You use automation features like folder monitoring or
                  Shortcuts
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need advanced options like video codec control
                </span>
              </li>
            </ul>
          </div>

          <!-- Kompressor Column -->
          <div
            class="bg-background-subtle border border-border rounded-2xl p-6 md:p-8"
          >
            <div class="mb-6">
              <h3 class="text-h3 text-text mb-2">
                Choose Kompressor
              </h3>
              <p class="text-text-secondary">
                Free, image-only, with live quality preview
              </p>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want an original interface with great user experience
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You don't want to pay for an app
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You only need image conversion (no video or audio)
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want real-time preview while adjusting compression quality
                </span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- BentoFeatures -->
    <BentoFeatures />

    <SectionDivider />

    <!-- Testimonials Section -->
    <MasonryTestimonials />

    <section
      id="featured"
      class="absolute w-px h-px overflow-hidden -m-px p-0 border-0"
      style="clip:rect(0 0 0 0); clip-path:inset(50%)"
      aria-hidden="true"
    >
      <FeaturedOn />
    </section>

    <SectionDivider />

    <!-- Pricing -->
    <section id="pricing" class="relative z-10 px-6 py-20">
      <PricingSection />
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-6">Frequently asked questions</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Can't find what you're looking for? Email support@picmal.app
          </Paragraph>
        </div>
        <div
          class="bg-background-subtle/50 border border-border rounded-2xl p-4 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />

    <SupportedFormatsModal />

  </body>
</html>
