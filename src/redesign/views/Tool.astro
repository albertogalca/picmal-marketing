---
import SectionHeader from "../components/SectionHeader.astro";
import PixelGlyph from "../components/PixelGlyph.astro";
import DataTable from "../components/DataTable.astro";
import CtaBand from "../components/CtaBand.astro";

// Layout only. The live parser (exifr, in tools/exif-viewer.astro) drops into
// the dropzone unchanged when this template ships.
---

<div class="pm-wrap">
  <div style="padding-top: 96px">
    <div class="pm-kicker">Free tool</div>
    <SectionHeader level={1} title="EXIF viewer." subtitle="See everything hidden inside a photo." />
    <p class="pm-lede">Drop a photo and see everything hidden inside it: the camera, the settings, the timestamp, and usually the exact spot on earth where it was taken.</p>
  </div>
  <div class="pm-grid2 pm-mt-8">
    <div class="pm-drop" role="button" tabindex="0">
      <PixelGlyph name="image" cell={4} />
      <div class="pm-drop__title">Drop a photo, or click to choose one</div>
      <div class="pm-drop__hint">JPG, HEIC, PNG, TIFF, WebP, and most camera RAW files</div>
      <div class="pm-drop__note"><PixelGlyph name="shield" bare cell={2} />Nothing is uploaded</div>
    </div>
    <DataTable head={["Example result", ""]} rows={[["Camera", "Drop a photo"], ["Lens", ""], ["Exposure", ""], ["Taken", ""], ["Location", ""]]} />
  </div>
  <div class="pm-section"><CtaBand ground="night" title="Strip metadata from a whole folder." seed="exif" /></div>
</div>
