---
import Paragraph from "./Paragraph.astro";

interface Props {
  name: string;
  email?: string;
  content: string;
  image?: string;
  link?: string;
}

const { name, content, image, link } = Astro.props;

function getInitialsAvatar(name: string): string {
  const words = name.replace(/^@/, "").split(/\s+/);
  const initials = words
    .slice(0, 2)
    .map((w) => w[0] ?? "")
    .join("")
    .toUpperCase();
  const palette = ["#4F46E5", "#7C3AED", "#0891B2", "#059669", "#D97706", "#DC2626", "#DB2777"];
  const bg = palette[name.charCodeAt(0) % palette.length];
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 80 80"><rect width="80" height="80" rx="40" fill="${bg}"/><text x="40" y="54" text-anchor="middle" font-family="system-ui,sans-serif" font-size="30" font-weight="600" fill="white">${initials}</text></svg>`;
  return `data:image/svg+xml;base64,${Buffer.from(svg).toString("base64")}`;
}

const avatarSrc = image ?? getInitialsAvatar(name);
const isInitials = !image;
---

<div
  class="rounded-lg p-6 md:p-8 min-w-[280px] max-w-[280px] md:min-w-[380px] md:max-w-[380px]"
>
  <Paragraph class="mb-6 text-center">
    &ldquo;{content}&rdquo;
  </Paragraph>

  <div class="flex items-center gap-4 justify-center">
    <img
      src={avatarSrc}
      alt={isInitials ? `Avatar of ${name}` : `Photo of ${name}`}
      width={40}
      height={40}
      class="w-10 h-10 rounded-full flex-shrink-0 object-cover"
      loading="lazy"
    />
    <div class="flex items-center gap-2">
      <Paragraph class="font-semibold">{name}</Paragraph>
      {
        link && (
          <a
            href={link}
            target="_blank"
            rel="nofollow noreferrer"
            class="inline-flex p-1 -m-1 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-current"
            aria-label={`View ${name}'s testimonial source`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 opacity-60 hover:opacity-100 transition-opacity"
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</div>
