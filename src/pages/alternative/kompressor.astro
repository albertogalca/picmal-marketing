---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import OrganizationSchema from "../../components/schema/OrganizationSchema.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import HeroCTA from "../../components/HeroCTA.astro";
import Paragraph from "../../components/Paragraph.astro";
import SectionDivider from "../../components/SectionDivider.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeaturedOn from "../../components/FeaturedOn.astro";
import BentoFeatures from "../../components/BentoFeatures.astro";
import TrustBar from "../../components/TrustBar.astro";
import PricingSection from "../../components/PricingSection.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonMeta from "../../components/ComparisonMeta.astro";

const SITE_TITLE = "Picmal: The Kompressor Alternative for Video and Audio";
const SITE_DESCRIPTION =
  "Looking for a Kompressor alternative that handles video and audio? Picmal converts images, video, and audio with Shortcuts integration and folder monitoring. $15.99 one-time. 14-day refund.";

const faqs = [
  {
    question: "Is Picmal a good Kompressor alternative?",
    answer:
      "If you need video and audio conversion, yes. Picmal handles images, video, and audio in one app with automation features like Shortcuts and folder monitoring. If you only convert images and want a free app with real-time preview, Kompressor is a great choice.",
  },
  {
    question: "Does Picmal have real-time preview like Kompressor?",
    answer:
      "No. Picmal focuses on fast batch conversion rather than previewing individual files. If real-time quality adjustment is important to you, Kompressor offers that feature.",
  },
  {
    question: "Why pay for Picmal when Kompressor is free?",
    answer:
      "Picmal adds video and audio conversion, Shortcuts integration, folder monitoring, and Finder right-click actions. If you only need image conversion, Kompressor is an excellent free option.",
  },
  {
    question: "Can Kompressor convert video files?",
    answer:
      "No. Kompressor is image-only. If you need to convert MP4, MOV, or other video formats, Picmal handles those along with images and audio.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Email support@picmal.app.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema />
    <link
      rel="preload"
      href="/picmal-1.2.0-demo.mp4"
      as="video"
      type="video/mp4"
    />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <!-- Hero Section -->
    <main id="main-content" class="relative z-10 pt-32 pb-12 sm:pb-16 md:pb-20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-8 sm:mb-12">
          <div
            class="max-w-4xl mx-auto flex justify-center items-center flex-col"
          >
            <H1 class="mb-4 sm:mb-6 max-w-3xl mx-auto">
              The Kompressor alternative for video and audio
            </H1>
            <p
              class="mb-8 sm:mb-10 max-w-2xl mx-auto text-body-big leading-relaxed text-text-secondary px-4 sm:px-0"
            >
              Kompressor is great for images. But if you also need video and
              audio conversion with automation features like Shortcuts and
              folder monitoring, Picmal has you covered.
            </p>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col items-center gap-3 sm:gap-4">
            <HeroCTA buyEvent="buy_clicked_kompressor_comparison" />
            <p class="text-small sm:text-small text-text-secondary">
              One-time purchase • 14-day money back
            </p>
          </div>

          <!-- Social Proof Above Fold -->
          <div class="mt-6 sm:mt-8 hero-trust">
            <TrustBar />
          </div>
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-5xl mx-auto mb-6 sm:mb-8 rounded-lg sm:rounded-xl overflow-hidden border border-border"
        >
          <div class="aspect-[16/10]">
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover block dark:hidden"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal app interface"
            >
            </video>
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover hidden dark:block"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal app interface"
            >
            </video>
          </div>
        </div>
      </div>
    </main>

    <ComparisonVerdict
      competitor="Kompressor"
      summary="Kompressor is a free Mac image compressor with real-time quality preview. Picmal ($15.99 one-time) is broader: it converts and compresses images, video, and audio, and adds Shortcuts, folder monitoring, and Finder right-click actions."
      picmalFor="You convert or compress video and audio (not just images), or need automation across Shortcuts and watched folders."
      competitorFor="You only compress images and want a free tool with a live quality preview."
    />

    <SectionDivider />

    <!-- Comparison Table -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-4 text-center">Picmal vs Kompressor at a glance</H2>
        <Paragraph class="mb-8 text-center max-w-2xl mx-auto">
          Both apps are native macOS converters that work offline. The main
          difference: Picmal handles all media types while Kompressor focuses
          exclusively on images.
        </Paragraph>

        <div
          class="bg-background-subtle/50 border border-border rounded-lg p-4 md:p-8"
        >
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left p-4 font-semibold text-text">Feature</th>
                  <th class="text-left p-4 font-semibold text-text">Picmal</th>
                  <th class="text-left p-4 font-semibold text-text"
                    >Kompressor</th
                  >
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr>
                  <td class="p-4 text-text-secondary">Price</td>
                  <td class="p-4 text-text">$15.99 one-time</td>
                  <td class="p-4 text-text">Free</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Privacy</td>
                  <td class="p-4 text-text">100% offline</td>
                  <td class="p-4 text-text">100% offline</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Interface</td>
                  <td class="p-4 text-text">Simple drag-and-drop</td>
                  <td class="p-4 text-text"
                    >Unique design with real-time preview</td
                  >
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Image formats</td>
                  <td class="p-4 text-text">20+</td>
                  <td class="p-4 text-text">50+ input, 20+ output</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video conversion</td>
                  <td class="p-4 text-text">Yes—MP4, MOV, MKV, and more</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Audio conversion</td>
                  <td class="p-4 text-text">Yes—MP3, WAV, FLAC, and more</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Real-time preview</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text"
                    >Yes—adjust quality and see results</td
                  >
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video codec control</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">N/A</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Metadata removal</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">Yes</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Finder right-click</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Shortcuts integration</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Folder monitoring</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">macOS</td>
                  <td class="p-4 text-text">14+</td>
                  <td class="p-4 text-text">13+</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Who Picmal Is For / Who Should Stick with Kompressor -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-4">Which one is right for you?</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Both are excellent native Mac apps. Here's an honest comparison to
            help you decide.
          </Paragraph>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Picmal Column -->
          <div
            class="bg-background-subtle border border-border rounded-xl p-6 md:p-8"
          >
            <div class="mb-6">
              <h3 class="text-h3 text-text mb-2">
                Choose Picmal
              </h3>
              <p class="text-text-secondary">
                Best for all media types and automation
              </p>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need a simple interface that just works
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need to convert videos and audio files
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You use automation features like folder monitoring or
                  Shortcuts
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need advanced options like video codec control
                </span>
              </li>
            </ul>
          </div>

          <!-- Kompressor Column -->
          <div
            class="bg-background-subtle border border-border rounded-xl p-6 md:p-8"
          >
            <div class="mb-6">
              <h3 class="text-h3 text-text mb-2">
                Choose Kompressor
              </h3>
              <p class="text-text-secondary">
                Best for image-only conversion with preview
              </p>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want an original interface with great user experience
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You don't want to pay for an app
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You only need image conversion (no video or audio)
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want real-time preview while adjusting compression quality
                </span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- BentoFeatures -->
    <BentoFeatures />

    <SectionDivider />

    <!-- Testimonials Section -->
    <MasonryTestimonials />

    <SectionDivider />

    <!-- Featured On Section -->
    <section class="relative z-10">
      <FeaturedOn />
    </section>

    <SectionDivider />

    <!-- Pricing -->
    <section id="pricing" class="relative z-10 px-6 py-20">
      <PricingSection />
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-6">Frequently asked questions</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Can't find what you're looking for? Email support@picmal.app
          </Paragraph>
        </div>
        <div
          class="bg-background-subtle/50 border border-border rounded-lg p-4 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <ComparisonMeta
      lastUpdated="2026-04-22"
      sources={[
        {
          label: "Kompressor on the Mac App Store",
          href: "https://apps.apple.com/app/kompressor-image-compressor/id1526047227",
        },
        { label: "Picmal pricing", href: "https://picmal.app/pricing.md" },
      ]}
    />

    <Footer />

    <SupportedFormatsModal />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "cantimplorastudio" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
