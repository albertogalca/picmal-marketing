---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import CTASection from "../components/CTASection.astro";
import H1 from "../components/H1.astro";
import { SITE_TITLE } from "../consts";
import "../styles/global.css";

interface NavLink {
  title: string;
  version: string;
  url: string;
}

interface RelatedLink {
  label: string;
  href: string;
}

interface Props {
  version: string;
  title: string;
  pubDate?: Date;
  description: string;
  slug: string;
  related?: RelatedLink[];
  prev?: NavLink; // newer release
  next?: NavLink; // older release
}

const { version, title, pubDate, description, slug, related, prev, next } =
  Astro.props;

const downloadUrl = `https://github.com/albertogalca/picmal-releases/releases/download/v${version}/Picmal.dmg`;
const hasDownload =
  version.localeCompare("1.2.7", undefined, { numeric: true }) >= 0;

const relatedLinks = related ?? [];

const pageTitle = `${title} – ${SITE_TITLE} ${version} Changelog`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: `${title} (Picmal ${version})`,
  description,
  ...(pubDate && { datePublished: pubDate.toISOString() }),
  url: new URL(`/changelog/${slug}`, Astro.site!).href,
  author: { "@type": "Organization", name: SITE_TITLE },
  publisher: {
    "@type": "Organization",
    name: SITE_TITLE,
    url: Astro.site!.href,
  },
  about: {
    "@type": "SoftwareApplication",
    name: SITE_TITLE,
    applicationCategory: "MultimediaApplication",
    operatingSystem: "macOS",
    softwareVersion: version,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={pageTitle}
      description={description}
      ogType="article"
      publishedTime={pubDate ? pubDate.toISOString() : undefined}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(articleSchema)}
    />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <article class="relative z-10 px-6 pt-44 pb-20">
      <div class="max-w-3xl mx-auto">
        <Breadcrumb
          items={[
            { label: "Home", href: "/" },
            { label: "Changelog", href: "/changelog" },
            { label: `v${version}` },
          ]}
        />

        <!-- Header -->
        <header class="mb-8">
          <div class="flex flex-wrap items-center gap-3 mb-6 text-body-sm">
            <span
              class="inline-block text-caption font-mono px-2 py-1 rounded-md bg-accent/10 text-accent"
            >
              v{version}
            </span>
            {
              pubDate && (
                <>
                  <span class="text-text-secondary">•</span>
                  <time
                    datetime={pubDate.toISOString()}
                    class="text-text-secondary"
                  >
                    <FormattedDate date={pubDate} />
                  </time>
                </>
              )
            }
            {
              hasDownload && (
                <>
                  <span class="text-text-secondary">•</span>
                  <a
                    href={downloadUrl}
                    class="flex items-center gap-1.5 text-text-secondary rounded-sm transition-colors duration-150 hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                      <polyline points="7 10 12 15 17 10" />
                      <line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                    Download
                  </a>
                </>
              )
            }
          </div>

          <H1 id="article-title" class="mb-4">{title}</H1>
        </header>

        <!-- Content -->
        <div
          class="prose max-w-none
              prose-headings:text-text prose-headings:font-semibold
              prose-p:text-text/65 prose-p:leading-relaxed
              prose-strong:text-text
              prose-ul:text-text/65
              prose-ol:text-text/65
              prose-li:text-text/65
              prose-img:rounded-lg prose-img:border prose-img:border-border"
          role="main"
          aria-labelledby="article-title"
        >
          <slot />
        </div>

        <!-- Related pages -->
        {
          relatedLinks.length > 0 && (
            <nav
              class="mt-12 pt-8 border-t border-border"
              aria-label="Related pages"
            >
              <h2 class="text-body-sm font-semibold text-text-secondary uppercase tracking-wide mb-4">
                Related
              </h2>
              <ul class="flex flex-wrap gap-3">
                {relatedLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="group inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-border text-body-sm text-text transition-colors duration-200 hover:bg-background-subtle hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                    >
                      {link.label}
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        class="text-text-secondary transition-transform duration-200 motion-safe:group-hover:translate-x-0.5"
                      >
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <!-- Prev / Next releases -->
        {
          (prev || next) && (
            <nav
              class="mt-12 pt-8 border-t border-border grid grid-cols-1 sm:grid-cols-2 gap-4"
              aria-label="More releases"
            >
              {next ? (
                <a
                  href={next.url}
                  class="group flex flex-col gap-1 p-4 rounded-xl border border-border transition-colors duration-200 hover:bg-background-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                >
                  <span class="text-caption text-text-secondary">
                    ← Older · v{next.version}
                  </span>
                  <span class="text-body-sm text-text group-hover:text-accent transition-colors">
                    {next.title}
                  </span>
                </a>
              ) : (
                <span />
              )}
              {prev && (
                <a
                  href={prev.url}
                  class="group flex flex-col gap-1 p-4 rounded-xl border border-border transition-colors duration-200 hover:bg-background-subtle sm:text-right focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                >
                  <span class="text-caption text-text-secondary">
                    Newer · v{prev.version} →
                  </span>
                  <span class="text-body-sm text-text group-hover:text-accent transition-colors">
                    {prev.title}
                  </span>
                </a>
              )}
            </nav>
          )
        }

        <div class="mt-6 text-center">
          <a
            href="/changelog"
            class="text-body-sm text-text-secondary underline underline-offset-4 rounded-sm transition-colors hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            View all releases
          </a>
        </div>

        <!-- Download CTA -->
        <div class="mt-12">
          <CTASection
            heading="Use Picmal to easily convert your media on your Mac"
            analyticsEvent={`buy_clicked_changelog_${slug}`}
          />
        </div>
      </div>
    </article>

    <Footer />
  </body>
</html>
