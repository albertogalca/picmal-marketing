---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import BlogNavigation from "../../components/BlogNavigation.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import "../../styles/global.css";
import H1 from "../../components/H1.astro";
import Paragraph from "../../components/Paragraph.astro";

const posts = (await getCollection("blog"))
  .filter((post) => post.data.category === "Changelog")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Changelog - ${SITE_TITLE} | Latest Updates & New Features`}
      description="Stay updated with the latest Picmal updates, new features, and improvements in our changelog."
    />
  </head>
  <body class="bg-white">
    <Header />
    <main class="relative z-10 px-6 pt-32 pb-16">
      <div class="max-w-3xl mx-auto">
        <!-- Blog Header -->
        <div class="mb-12">
          <H1 class="mb-4"> Changelog </H1>
          <Paragraph>
            Latest updates, new features, and improvements to Picmal.
          </Paragraph>
        </div>

        <!-- Category Navigation -->
        <BlogNavigation currentCategory="Changelog" />

        <!-- Blog Posts Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {
            posts.map((post) => (
              <article class="group cursor-pointer bg-white rounded-none border-none p-0 m-0">
                <a
                  href={`/blog/${post.id}`}
                  class="block bg-white rounded-none border-none p-0 m-0"
                >
                  {post.data.heroImage ? (
                    <div class="relative aspect-video overflow-hidden mb-4 rounded-md bg-gray-200">
                      <Image
                        src={post.data.heroImage}
                        alt={post.data.title}
                        width={400}
                        height={225}
                        class="w-full h-full object-cover"
                      />
                    </div>
                  ) : (
                    <div class="relative aspect-video overflow-hidden mb-4 rounded-md bg-gray-200" />
                  )}
                  <div class="flex items-center gap-3 mb-2 text-sm">
                    <span class="text-[#1B5BFF]">Changelog</span>
                    <span class="text-gray-300">•</span>
                    <time
                      class="text-gray-500"
                      datetime={post.data.pubDate.toISOString()}
                    >
                      <FormattedDate date={post.data.pubDate} />
                    </time>
                  </div>
                  <h3 class="text-xl font-bold text-black group-hover:text-[#1B5BFF] transition-colors mb-2 leading-snug">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <Paragraph size="small">{post.data.description}</Paragraph>
                  )}
                </a>
              </article>
            ))
          }
        </div>

        {
          posts.length === 0 && (
            <div class="text-center py-16">
              <Paragraph>No changelog posts found.</Paragraph>
            </div>
          )
        }
      </div>
    </main>
    <Footer />
  </body>
</html>
