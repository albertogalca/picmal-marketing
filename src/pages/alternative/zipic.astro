---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import PricingSection from "../../components/PricingSection.astro";
import FounderLetter from "../../components/FounderLetter.astro";
import Section from "../../components/Section.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import AlternativeVerdict from "../../components/AlternativeVerdict.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";
import FAQSection from "../../components/FAQSection.astro";

const SITE_DESCRIPTION =
  "Looking for a Zipic alternative? Picmal converts, compresses, and edits images, video, audio, and PDFs on your Mac, not images alone. $29 once, no subscription. Everything runs offline. 14-day refund.";

const faqs = [
  {
    question: "Is Picmal a good Zipic alternative?",
    answer:
      "If you only ever compress images, Zipic is a fine app and does that job well. Picmal covers images, video, audio, and PDFs in one place, converting and compressing both, for $29. If your files aren't all images, Picmal is the better fit.",
  },
  {
    question: "Does Picmal compress images as well as Zipic?",
    answer:
      "Yes. Picmal compresses JPG, PNG, WebP, HEIC, AVIF, GIF, TIFF, and more, in batches, with quality control. Zipic is tuned specifically for image compression and has more knobs for that one job. Picmal trades a bit of that depth for handling video, audio, and PDFs too.",
  },
  {
    question: "How much does Picmal cost compared to Zipic?",
    answer:
      "Picmal is $29 for one Mac or $39 for two, paid once, updates included. Zipic's personal license is $29.99 one-time for 2 devices. Neither is a subscription, which is a nice thing to be able to say about two Mac apps in 2026.",
  },
  {
    question: "Does Zipic handle video and audio?",
    answer:
      "No. Zipic is images only. Picmal converts and compresses video (MP4, MOV, MKV, and more) and audio (MP3, WAV, FLAC, and more), plus PDF compress, merge, and split.",
  },
  {
    question: "Does Picmal have Raycast and Shortcuts integration like Zipic?",
    answer:
      "Yes. Picmal has a Raycast extension with Convert Files, Compress Files, Combine PDFs, and Images to PDF, plus Apple Shortcuts actions, Finder right-click, folder monitoring, and a command line tool.",
  },
  {
    question: "Do my images get uploaded anywhere?",
    answer:
      "No. Both apps process everything locally on your Mac. No uploads, no account, no servers. That's the whole point of using a native app instead of a website.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Email support@picmal.app.",
  },
];
---

<MarketingLayout
  title="Picmal: The Zipic alternative that does more than images"
  description={SITE_DESCRIPTION}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
        <FAQSchema />
  </Fragment>

  <ComparisonHero
    title="The Zipic alternative that does more than images"
    subhead="Zipic compresses images, and it's good at it. If your folder also has video, audio, and PDFs in it, Picmal handles all of them for $29. Files never leave your Mac."
    buyEvent="buy_clicked_zipic_comparison"
  />

  <ComparisonVerdict
    competitor="Zipic"
    summary="Zipic is a focused image compressor with some genuinely clever touches, clipboard auto-compress and dropping files on the notch. Picmal ($29, pay once) compresses images too, and adds format conversion, video, audio, PDF tools, and light editing, for about the same price."
    picmalFor="Your work isn't only images. You've got video to shrink, audio to convert, PDFs to merge, and you'd rather buy one app than four."
    competitorFor="You compress images all day, nothing else, and you want the deepest set of image-specific controls."
  />

  <!-- Comparison Table -->
  <Section width="default">
    <SectionHeading>
      Picmal vs Zipic at a glance
      <Fragment slot="sublead">
        Zipic is an image compressor. Picmal converts, compresses, and edits
        images, video, audio, and PDFs. Both are native Mac apps, both run
        fully offline, both handle batches.
      </Fragment>
    </SectionHeading>
    <ComparisonTable
      competitor="Zipic"
      rows={[
      {
        feature: "Price",
        picmal: "$29 one-time",
        competitor: "$29.99 one-time, 2 devices",
      },
      {
        feature: "What it's for",
        picmal: "Convert, compress &amp; edit",
        competitor: "Image compression",
      },
      {
        feature: "Privacy",
        picmal: "100% offline",
        competitor: "100% offline",
      },
      {
        feature: "Image formats",
        picmal: "JPG, PNG, WebP, HEIC, AVIF, JXL, GIF, TIFF, and more",
        competitor: "12 image formats",
      },
      {
        feature: "Image conversion",
        picmal: "Yes",
        competitor: "Yes",
      },
      {
        feature: "Video",
        picmal: "Convert &amp; compress",
        competitor: "No",
      },
      {
        feature: "Audio",
        picmal: "Convert &amp; compress",
        competitor: "No",
      },
      {
        feature: "PDF support",
        picmal: "Compress, merge, split, images to PDF",
        competitor: "Compression only",
      },
      {
        feature: "Resize",
        picmal: "Yes",
        competitor: "Yes",
      },
      {
        feature: "Watermark",
        picmal: "Yes, on video",
        competitor: "No",
      },
      {
        feature: "Metadata removal",
        picmal: "Yes",
        competitor: "Yes",
      },
      {
        feature: "Folder monitoring",
        picmal: "Yes",
        competitor: "Yes",
      },
      {
        feature: "Shortcuts integration",
        picmal: "Yes",
        competitor: "Yes",
      },
      {
        feature: "Raycast extension",
        picmal: "Yes",
        competitor: "Yes",
      },
      {
        feature: "Finder right-click",
        picmal: "Yes",
        competitor: "Yes",
      },
      {
        feature: "Command line",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "Try before you buy",
        picmal: "14-day refund, no questions",
        competitor: "7-day trial, then 25 images a day",
      },
      {
        feature: "macOS",
        picmal: "15+",
        competitor: "13+",
      },
    ]}
    />
  </Section>

  <!-- Who Picmal Is For / Who Should Stick with Zipic -->
  <AlternativeVerdict
    sublead="Here's where each one makes more sense."
    picmal={{
      heading: "Choose Picmal",
      lead: "Your files aren't only images",
      items: [
        "You also need to convert or compress video and audio",
        "You work with PDFs and want to compress, merge, and split them",
        "You'd rather pay once for every file type than for one",
        "You automate things with Shortcuts, Raycast, or the terminal",
      ],
    }}
    rival={{
      heading: "Choose Zipic",
      lead: "Image compression is the whole job",
      items: [
        "You only ever touch images, never video, audio, or PDFs",
        "You want the deepest set of image-specific compression controls",
        "You're on macOS 13 and can't upgrade to 14 yet",
      ],
    }}
  />

  <!-- Features -->
  <FeatureGrid
    heading="Everything else Picmal does"
    subleadIntro="One app for images, video, audio, and PDFs. Convert, compress, and edit, all on your Mac."
  />

  <!-- Testimonials Section -->
  <MasonryTestimonials />

  <!-- Pricing -->
  <PricingSection />

  <!-- Founder letter -->
  <FounderLetter />

  <!-- FAQ Section -->
  <FAQSection
    faqs={faqs}
    heading="Frequently asked questions"
    sublead="Can't find what you're looking for? Email support@picmal.app"
  />

  <Fragment slot="after">
    <SupportedFormatsModal />
  </Fragment>
</MarketingLayout>
