---
import BaseHead from "../components/BaseHead.astro";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Paragraph from "../components/Paragraph.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { STUDENT_DISCOUNT } from "../config/pricing";

const title = "Picmal for Education";
const description = `Students and educators get ${STUDENT_DISCOUNT.percentOff}% off any Picmal license. Verify your school email and the code is sent straight to it.`;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <main id="main-content">
      <!-- sm:pt-32 as well, or Section's own `sm:py-20` wins the merge and the
           title tucks under the fixed header. -->
      <Section width="narrow" class="pt-32 sm:pt-32">
        <SectionHeading level={1} class="mb-10">
          Picmal for Education
          <Fragment slot="sublead">
            Students and educators get {STUDENT_DISCOUNT.percentOff}% off any
            license. Verify your school email to continue.
          </Fragment>
        </SectionHeading>

        <form
          id="student-form"
          class="max-w-md mx-auto"
          novalidate
          data-endpoint={STUDENT_DISCOUNT.endpoint}
          data-slug={STUDENT_DISCOUNT.productSlug}
          data-contact={STUDENT_DISCOUNT.contact}
        >
          <label
            for="student-email"
            class="block text-small font-semibold text-text mb-2"
          >
            School email
          </label>
          <input
            id="student-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="your.name@university.edu"
            class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-body text-text placeholder:text-text-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          />
          <Button
            id="student-submit"
            type="submit"
            text="Send me the code"
            class="w-full mt-3"
          />
        </form>

        <!-- Self-closed so `:empty` still matches before the first submit and
             the block doesn't carry a phantom margin. -->
        <p
          id="student-result"
          class="mt-4 text-small text-center max-w-md mx-auto empty:mt-0"
          role="status"
          aria-live="polite"
        />

        <Paragraph size="small" class="text-center max-w-md mx-auto mt-12">
          Some universities use a plain national domain that I can't recognise
          automatically. If yours does, email <a
            class="link"
            href={`mailto:${STUDENT_DISCOUNT.contact}`}>{STUDENT_DISCOUNT.contact}</a
          > from it and I'll send the code by hand.
        </Paragraph>
      </Section>
    </main>

    <Footer />
  </body>
</html>

<script>
  import { isAcademicEmail } from "../utils/academicEmail.ts";

  const form = document.getElementById("student-form") as HTMLFormElement | null;
  const input = document.getElementById("student-email") as HTMLInputElement | null;
  const submit = document.getElementById("student-submit") as HTMLButtonElement | null;
  const result = document.getElementById("student-result");

  // The address never leaves this page unless it passes here first — the same
  // regex licencio runs server-side, so an obvious miss costs no round trip.
  // licencio is the one that decides, and the only side that knows the code.
  //
  // Short on purpose: the standing note under the form already explains the
  // national-domain case, so repeating it here would say it twice on one screen.
  const REJECTED = "That doesn't look like a school email.";

  function show(message: string, tone: "text" | "text-secondary") {
    if (!result) return;
    result.className = `mt-4 text-small text-center max-w-md mx-auto text-${tone}`;
    result.innerHTML = message;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!input || !submit) return;

    const email = input.value.trim();
    const { endpoint, slug, contact = "" } = form.dataset;

    // Failures print in full ink, only "Sending…" is muted: an error the reader
    // has to squint at is an error they miss.
    if (!isAcademicEmail(email)) return show(REJECTED, "text");

    submit.disabled = true;
    show("Sending&hellip;", "text-secondary");
    try {
      const response = await fetch(endpoint!, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ product_slug: slug, email }),
      });

      if (response.ok) {
        show(`Sent. Check ${email} for your code.`, "text");
        (window as any).seline?.track("student_code_requested");
      } else if (response.status === 422) {
        show(REJECTED, "text");
      } else if (response.status === 429) {
        show("That's a few too many tries. Give it a minute.", "text");
      } else {
        throw new Error(String(response.status));
      }
    } catch {
      show(
        `Couldn't reach the server. Email <a class="link" href="mailto:${contact}">${contact}</a> ` +
          `and I'll send the code by hand.`,
        "text",
      );
    } finally {
      submit.disabled = false;
    }
  });
</script>
