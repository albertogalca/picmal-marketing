---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import BlogNavigation from "../../components/BlogNavigation.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import "../../styles/global.css";
import H1 from "../../components/H1.astro";
import Paragraph from "../../components/Paragraph.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-background">
    <Header />

    <!-- Hero with gradient -->
    <main class="relative z-10 pt-32 pb-20">
      <div class="absolute inset-0 -z-10 overflow-hidden hero-gradient"></div>

      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-16">
          <H1 class="mb-4">Blog</H1>
          <Paragraph class="max-w-2xl mx-auto">
            Updates, guides, and thoughts about building software for Mac.
          </Paragraph>
        </div>

        <!-- Category Navigation -->
        <BlogNavigation currentCategory="All" />

        <!-- Blog Posts Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
          {
            posts.map((post) => (
              <article class="group">
                <a
                  href={`/blog/${post.id}`}
                  class="block bg-background-subtle rounded-xl border border-text/10 overflow-hidden hover:border-accent/30 transition-all duration-300"
                >
                  <div class="relative aspect-video overflow-hidden bg-background">
                    <Image
                      src={post.data.heroImage || "/images/blog/default.png"}
                      alt={post.data.title}
                      width={400}
                      height={225}
                      class="w-full h-full object-cover"
                    />
                  </div>
                  <div class="p-4">
                    <div class="flex items-center gap-2 mb-3 text-xs text-text-secondary">
                      {post.data.category && (
                        <>
                          <span class="px-2 py-1 bg-accent/10 text-accent rounded-full font-medium">
                            {post.data.category}
                          </span>
                          <span>•</span>
                        </>
                      )}
                      <time datetime={post.data.pubDate.toISOString()}>
                        <FormattedDate date={post.data.pubDate} />
                      </time>
                    </div>
                    <h3 class="text-lg font-bold text-text transition-colors mb-2 leading-snug">
                      {post.data.title}
                    </h3>
                    {post.data.description && (
                      <p class="text-sm text-text-secondary leading-relaxed">
                        {post.data.description}
                      </p>
                    )}
                  </div>
                </a>
              </article>
            ))
          }
        </div>

        {
          posts.length === 0 && (
            <div class="text-center py-16">
              <Paragraph>No blog posts found.</Paragraph>
            </div>
          )
        }
      </div>
    </main>

    <Footer />
  </body>
</html>
