---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import BlogNavigation from "../../components/BlogNavigation.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import "../../styles/global.css";
import H1 from "../../components/H1.astro";
import Paragraph from "../../components/Paragraph.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-white">
    <Header />
    <main class="relative z-10 px-6 pt-32 pb-16">
      <div class="max-w-3xl mx-auto">
        <!-- Blog Header -->
        <div class="mb-12">
          <H1 class="mb-4">Blog</H1>
          <Paragraph>
            Updates, guides, and the occasional thought about building software
            for Mac.
          </Paragraph>
        </div>

        <!-- Category Navigation -->
        <BlogNavigation currentCategory="All" />

        <!-- Blog Posts Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {
            posts.map((post) => (
              <article class="group cursor-pointer bg-white rounded-none border-none p-0 m-0">
                <a
                  href={`/blog/${post.id}`}
                  class="block bg-white rounded-none border-none p-0 m-0"
                >
                  {post.data.heroImage ? (
                    <div class="relative aspect-video overflow-hidden mb-4 rounded-md bg-gray-200">
                      <Image
                        src={post.data.heroImage}
                        alt={post.data.title}
                        width={400}
                        height={225}
                        class="w-full h-full object-cover"
                      />
                    </div>
                  ) : (
                    <div class="relative aspect-video overflow-hidden mb-4 rounded-md bg-gray-200" />
                  )}
                  <div class="flex items-center gap-3 mb-2 text-sm">
                    {post.data.category && (
                      <>
                        <span
                          class={
                            post.data.category === "Changelog"
                              ? "text-[#1B5BFF]"
                              : post.data.category === "Guide"
                                ? "text-emerald-600"
                                : post.data.category === "Tutorial"
                                  ? "text-purple-600"
                                  : "text-gray-600"
                          }
                        >
                          {post.data.category}
                        </span>
                        <span class="text-gray-300">•</span>
                      </>
                    )}
                    <time
                      class="text-gray-500"
                      datetime={post.data.pubDate.toISOString()}
                    >
                      <FormattedDate date={post.data.pubDate} />
                    </time>
                  </div>
                  <h3 class="text-xl font-bold text-black group-hover:text-[#1B5BFF] transition-colors mb-2 leading-snug">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <Paragraph size="small">{post.data.description}</Paragraph>
                  )}
                </a>
              </article>
            ))
          }
        </div>

        {
          posts.length === 0 && (
            <div class="text-center py-16">
              <Paragraph>No blog posts found.</Paragraph>
            </div>
          )
        }
      </div>
    </main>
    <Footer />

    <style>
      /* Reset any button styling that might be affecting articles */
      article {
        background: white !important;
        border-radius: 0 !important;
        border: none !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      article a {
        background: white !important;
        border-radius: 0 !important;
        border: none !important;
        padding: 0 !important;
        margin: 0 !important;
        text-decoration: none !important;
      }

      .grid article {
        background: white !important;
        border-radius: 0 !important;
        border: none !important;
      }
    </style>
  </body>
</html>
