---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import OrganizationSchema from "../../components/schema/OrganizationSchema.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import Paragraph from "../../components/Paragraph.astro";
import SectionDivider from "../../components/SectionDivider.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeaturedOn from "../../components/FeaturedOn.astro";
import BentoFeatures from "../../components/BentoFeatures.astro";
import PricingSection from "../../components/PricingSection.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";

const SITE_TITLE = "Picmal: The All-in-One Permute Alternative for Mac";
const SITE_DESCRIPTION =
  "Looking for a Permute alternative? Picmal is your Mac's media toolkit—convert, compress, and edit images, video, audio, and PDFs in one app. 100% offline, native macOS UI, $15.99 one-time. 14-day refund.";

const faqs = [
  {
    question: "Is Picmal a good Permute alternative?",
    answer:
      "If you don't need timeline video editing like trimming, cropping, or merging — yes. Picmal converts, compresses, and handles images, video, audio, and PDFs in one window. Permute adds that editing layer; Picmal skips it.",
  },
  {
    question: "Does Picmal work offline like Permute?",
    answer:
      "Yes. Everything runs locally on your Mac — nothing is uploaded anywhere.",
  },
  {
    question: "Can Picmal convert and compress video and audio?",
    answer:
      "Yes. Picmal converts video (MP4, MOV, MKV, and more) and audio (MP3, WAV, FLAC, and more), and compresses all of them — images, video, audio, and PDFs — with a guarantee the output is never larger than the input. No timeline editing though: no trimming, cropping, or merging.",
  },
  {
    question: "Is Picmal actually cheaper than Permute?",
    answer:
      "Barely more expensive — $15.99 vs Permute's $14.99. Permute is also on Setapp if you pay for that. Picmal adds PDF tools, folder monitoring, Finder right-click, and metadata removal that Permute doesn't have.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Email support@picmal.app.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <ComparisonHero
      title="The all-in-one Permute alternative for Mac"
      subhead="Both apps are offline Mac converters at nearly the same price. Picmal adds compression for images, video, audio, and PDFs, plus Shortcuts and folder monitoring. Permute adds timeline video editing. Depends what you need."
      buyEvent="buy_clicked_permute_comparison"
    />

    <ComparisonVerdict
      competitor="Permute"
      summary="Picmal ($15.99) and Permute (~$14.99, also on Setapp) are both offline Mac converters at nearly identical prices. Picmal compresses images, video, audio, and PDFs, with Shortcuts, folder monitoring, and Finder right-click. Permute adds timeline editing — trim, crop, merge — and audio normalization."
      picmalFor="You convert and compress media on Mac and want Shortcuts, folder monitoring, and PDF tools — but don't need to trim or merge videos."
      competitorFor="You need to trim, crop, or merge videos, normalize audio, or already pay for Setapp."
    />

    <SectionDivider />

    <!-- Comparison Table -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-4 text-center">Picmal vs Permute at a glance</H2>
        <Paragraph class="mb-8 text-center max-w-2xl mx-auto">
          Permute is powerful at video editing. But sometimes you just want one
          app to convert and compress a file without thinking about it.
        </Paragraph>

        <div
          class="bg-background-subtle/50 border border-border rounded-2xl p-4 md:p-8"
        >
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left p-4 font-semibold text-text">Feature</th>
                  <th class="text-left p-4 font-semibold text-text">Picmal</th>
                  <th class="text-left p-4 font-semibold text-text">Permute</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr>
                  <td class="p-4 text-text-secondary">Price</td>
                  <td class="p-4 text-text">$15.99 one-time</td>
                  <td class="p-4 text-text">$14.99 one-time</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Also available via</td>
                  <td class="p-4 text-text-secondary">—</td>
                  <td class="p-4 text-text">Setapp ($9.99/mo)</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Privacy</td>
                  <td class="p-4 text-text">100% offline</td>
                  <td class="p-4 text-text">100% offline</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Interface</td>
                  <td class="p-4 text-text"
                    >Single window—no hunting through menus</td
                  >
                  <td class="p-4 text-text">Groups + presets</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Design quality</td>
                  <td class="p-4 text-text">Native macOS, polished UI</td>
                  <td class="p-4 text-text">Traditional</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Image formats</td>
                  <td class="p-4 text-text">20+</td>
                  <td class="p-4 text-text">15+</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video editing</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text">Trim, crop, stitch</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Metadata removal</td>
                  <td class="p-4 text-text"
                    >Yes—strip location data before sharing</td
                  >
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Finder right-click</td>
                  <td class="p-4 text-text"
                    >Yes—convert without opening the app</td
                  >
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">macOS</td>
                  <td class="p-4 text-text">14+</td>
                  <td class="p-4 text-text">11+</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Who Picmal Is For / Who Should Stick with Permute -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-4">Which one is right for you?</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Here's where each one makes more sense.
          </Paragraph>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Picmal Column -->
          <div
            class="bg-background-subtle border border-border rounded-2xl p-6 md:p-8"
          >
            <div class="mb-6">
              <h3 class="text-h3 text-text mb-2">
                Choose Picmal
              </h3>
              <p class="text-text-secondary">
                Convert, compress, and automate — no video editing
              </p>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You convert and compress — no need to trim or merge videos
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You use folder monitoring or Apple Shortcuts for automation
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want PDF tools — compress, combine, images-to-PDF
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  Your files stay on your Mac, nothing goes to a server
                </span>
              </li>
            </ul>
          </div>

          <!-- Permute Column -->
          <div
            class="bg-background-subtle border border-border rounded-2xl p-6 md:p-8"
          >
            <div class="mb-6">
              <h3 class="text-h3 text-text mb-2">
                Choose Permute
              </h3>
              <p class="text-text-secondary">
                Trim, crop, merge videos, normalize audio
              </p>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need video editing features like trimming, cropping, and
                  merging
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need scheduled conversions that run at specific times
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You require OCR text extraction from images
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need audio normalization and volume adjustment
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You already have a Setapp subscription
                </span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- BentoFeatures -->
    <BentoFeatures />

    <SectionDivider />

    <!-- Testimonials Section -->
    <MasonryTestimonials />

    <section
      id="featured"
      class="absolute w-px h-px overflow-hidden -m-px p-0 border-0"
      style="clip:rect(0 0 0 0); clip-path:inset(50%)"
      aria-hidden="true"
    >
      <FeaturedOn />
    </section>

    <SectionDivider />

    <!-- Pricing -->
    <section id="pricing" class="relative z-10 px-6 py-20">
      <PricingSection />
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-6">Frequently asked questions</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Can't find what you're looking for? Email support@picmal.app
          </Paragraph>
        </div>
        <div
          class="bg-background-subtle/50 border border-border rounded-2xl p-4 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />

    <SupportedFormatsModal />

  </body>
</html>
