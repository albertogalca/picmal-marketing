---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import OrganizationSchema from "../../components/schema/OrganizationSchema.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import PricingSection from "../../components/PricingSection.astro";
import FounderLetter from "../../components/FounderLetter.astro";
import Section from "../../components/Section.astro";
import Card from "../../components/Card.astro";
import H3 from "../../components/H3.astro";
import Paragraph from "../../components/Paragraph.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";

const SITE_DESCRIPTION =
  "Want a simpler ffWorks alternative? Picmal is one Mac app that converts, compresses, and edits images, video, audio, and PDFs. No 450 options to learn. $39 once, 14-day refund.";

const faqs = [
  {
    question: "Is Picmal a good ffWorks alternative?",
    answer:
      "If you want something that just works without configuring codecs, yes. Picmal converts, compresses, and handles images, video, audio, and PDFs in one window. ffWorks gives you 450 FFmpeg options. If you actually need that control, it's the right tool.",
  },
  {
    question: "Does Picmal have the same video options as ffWorks?",
    answer:
      "No, and that's the point. ffWorks hands you 450 FFmpeg options and 60 video filters. Picmal picks sensible defaults so you don't have to. Drag in your files, pick a format, done.",
  },
  {
    question: "Can Picmal convert images and PDFs? Can ffWorks?",
    answer:
      "Picmal converts 20+ image formats (HEIC, JPG, PNG, WebP, and more), decodes RAW files, and has PDF tools: compress, combine, images to PDF, PDF to PNG. ffWorks does video and audio only, no images, no PDFs.",
  },
  {
    question: "Does Picmal support 4K/8K video like ffWorks?",
    answer:
      "Picmal handles high-resolution video, but ffWorks gives you granular CRF tuning, VMAF quality metrics, and filter chains for professional 4K/8K work. If that's what you need, ffWorks is the better fit.",
  },
  {
    question: "Why choose Picmal over ffWorks?",
    answer:
      "Pick Picmal if you want one app for images, video, audio, and PDFs with a clean interface. Pick ffWorks if you need FFmpeg's full power for video encoding. They don't really compete. It depends what you're making.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Email support@picmal.app.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead
      title="Picmal: The simple ffWorks alternative for Mac"
      description={SITE_DESCRIPTION}
    />
    <OrganizationSchema url={Astro.site!.href} />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <ComparisonHero
      title="The simple ffWorks alternative for Mac"
      subhead="ffWorks gives you 450 FFmpeg options. Picmal gives you one window. Drop in your files, pick a format, and go. No codec knowledge needed, and it works for images, video, audio, and PDFs."
      buyEvent="buy_clicked_ffworks_comparison"
    />

    <ComparisonVerdict
      competitor="ffWorks"
      summary="ffWorks is a professional FFmpeg frontend: 450 encoding options, 60 video filters, VMAF quality metrics. Picmal ($39, paid once) skips the configuration and handles images, video, audio, and PDFs in one window, no codec knowledge needed."
      picmalFor="You want to drag in files and get a result without configuring codecs, and you also work with images, RAW files, and PDFs."
      competitorFor="You need full FFmpeg control: CRF tuning, VMAF, custom filter chains, professional 4K/8K workflows."
    />

    <!-- Comparison Table -->
    <Section width="default">
      <SectionHeading>
        Picmal vs ffWorks at a glance
        <Fragment slot="sublead">
          ffWorks is a professional FFmpeg GUI with hundreds of options. Picmal
          is a simpler app that covers more file types: images, video, audio,
          and PDFs in one window, no codec knowledge needed.
        </Fragment>
      </SectionHeading>
      <Card padding="p-4 md:p-8">
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left p-4 font-semibold text-text">Feature</th>
                  <th class="text-left p-4 font-semibold text-text">Picmal</th>
                  <th class="text-left p-4 font-semibold text-text">ffWorks</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr>
                  <td class="p-4 text-text-secondary">Price</td>
                  <td class="p-4 text-text">$39 one-time</td>
                  <td class="p-4 text-text">€22 (~$24) one-time</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Primary purpose</td>
                  <td class="p-4 text-text">Convert, compress &amp; edit</td>
                  <td class="p-4 text-text">Professional FFmpeg GUI</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Privacy</td>
                  <td class="p-4 text-text">100% offline</td>
                  <td class="p-4 text-text">100% offline</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Interface complexity</td>
                  <td class="p-4 text-text">Single window, minimal options</td>
                  <td class="p-4 text-text">450 options, 60 filters</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Image conversion</td>
                  <td class="p-4 text-text">Yes. 20+ formats</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video conversion</td>
                  <td class="p-4 text-text">Yes. Common formats</td>
                  <td class="p-4 text-text">Yes. Full FFmpeg support</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Audio conversion</td>
                  <td class="p-4 text-text">Yes. MP3, WAV, FLAC, and more</td>
                  <td class="p-4 text-text">Yes. Full FFmpeg support</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Compression</td>
                  <td class="p-4 text-text"
                    >Images, video, audio &amp; PDF ("never bigger")</td
                  >
                  <td class="p-4 text-text">Via encoding settings</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">PDF tools</td>
                  <td class="p-4 text-text"
                    >Compress, combine, images→PDF, PDF→PNG</td
                  >
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">RAW decode</td>
                  <td class="p-4 text-text">Yes. CR2, CR3, NEF, ARW, and more</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video filters</td>
                  <td class="p-4 text-text">Basic</td>
                  <td class="p-4 text-text"
                    >60 filters (color, crop, overlay)</td
                  >
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Quality metrics</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text">Yes. VMAF, PSNR, SSIM</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Hardware acceleration</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">Yes. VideoToolbox</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Metadata removal</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">Yes</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Shortcuts integration</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Folder monitoring</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">Drop zones</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Finder right-click</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">macOS</td>
                  <td class="p-4 text-text">15+</td>
                  <td class="p-4 text-text">10.13+</td>
                </tr>
              </tbody>
            </table>
          </div>
      </Card>
    </Section>

    <!-- Who Picmal Is For / Who Should Stick with ffWorks -->
    <Section width="default">
      <SectionHeading>
        Which one is right for you?
        <Fragment slot="sublead">
            Here's where each one makes more sense.
        </Fragment>
      </SectionHeading>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Picmal Column -->
          <Card>
            <div class="mb-6">
              <H3 class="mb-2">
                Choose Picmal
              </H3>
              <Paragraph color="secondary">
                You don't want to configure codecs
              </Paragraph>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You work with images, RAW files, video, audio, and PDFs and
                  want one app for all of them
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want a simple interface with Shortcuts integration
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  Your files stay on your Mac. Nothing uploads anywhere
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You don't need 450 encoding options
                </span>
              </li>
            </ul>
          </Card>

          <!-- ffWorks Column -->
          <Card>
            <div class="mb-6">
              <H3 class="mb-2">
                Choose ffWorks
              </H3>
              <Paragraph color="secondary">
                Best for professional video encoding
              </Paragraph>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want full FFmpeg power with 450 options and 60 filters
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You only work with video and need professional-grade control
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need quality metrics like VMAF, PSNR, and SSIM
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need advanced video filters and color adjustments
                </span>
              </li>
            </ul>
          </Card>
        </div>
    </Section>

    <!-- Features -->
    <FeatureGrid
      heading="Everything else Picmal does"
      subleadIntro="One app for images, video, audio, and PDFs. Convert, compress, and edit, all on your Mac."
    />

    <!-- Testimonials Section -->
    <MasonryTestimonials />

    <!-- Pricing -->
    <PricingSection />

    <!-- Founder letter -->
    <FounderLetter />

    <!-- FAQ Section -->
    <Section id="faq" width="narrow">
      <SectionHeading
        sublead="Can't find what you're looking for? Email support@picmal.app"
      >
        Frequently asked questions
      </SectionHeading>
      <Card>
        <FAQ faqs={faqs} />
      </Card>
    </Section>

    <Footer />

    <SupportedFormatsModal />

  </body>
</html>
