---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import H3 from "../components/H3.astro";
import Button from "../components/Button.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import Paragraph from "../components/Paragraph.astro";
import TrustBar from "../components/TrustBar.astro";
import SectionDivider from "../components/SectionDivider.astro";
import CTASection from "../components/CTASection.astro";

const SITE_TITLE = "Video Converter for Mac - Convert MOV, MP4, MKV & More";
const SITE_DESCRIPTION =
  "Native macOS video converter supporting MOV, MP4, MKV, AVI, WebM, and more. Batch convert videos offline with custom codecs and quality settings.";

const faqs = [
  {
    question: "What video formats can I convert?",
    answer:
      "Picmal supports all major video formats including MOV, MP4, MKV, AVI, WebM, MPEG, FLV, and more. Convert between any formats with full codec control.",
  },
  {
    question: "Can I convert multiple videos at once?",
    answer:
      "Yes! Picmal supports batch video conversion. Drop multiple video files or entire folders and convert them all at once with the same settings.",
  },
  {
    question: "Can I compress videos while converting?",
    answer:
      "Absolutely. Picmal lets you convert and compress in one operation. Adjust quality, resolution, bitrate, and codec settings to get the perfect balance of file size and quality.",
  },
  {
    question: "Does video conversion affect quality?",
    answer:
      "Quality depends on your settings. Picmal can preserve original quality or compress videos to smaller sizes. You have full control over codecs (H.264, H.265, VP9), bitrate, and resolution.",
  },
  {
    question: "How long does video conversion take?",
    answer:
      "Conversion time depends on video length, resolution, and your Mac's specs. Picmal uses hardware acceleration when available (VideoToolbox on Apple Silicon) for maximum speed. A 5-minute 1080p video typically converts in 30-60 seconds.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <link
      rel="preload"
      href="/picmal-1.2.0-demo.mp4"
      as="video"
      type="video/mp4"
    />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text"
  >
    <Header />

    <!-- Hero Section -->
    <main
      id="main-content"
      class="relative z-10 pt-24 sm:pt-28 md:pt-32 pb-12 sm:pb-16 md:pb-20"
    >
      <div class="absolute inset-0 -z-10 overflow-hidden hero-gradient"></div>

      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-8 sm:mb-12">
          <div
            class="max-w-4xl mx-auto flex justify-center items-center flex-col"
          >
            <H1 class="mb-4 sm:mb-6 max-w-2xl mx-auto">
              Professional video converter for Mac
            </H1>
            <p
              class="mb-8 sm:mb-10 max-w-2xl mx-auto text-base sm:text-lg md:text-xl leading-relaxed text-text-secondary px-4 sm:px-0"
            >
              Convert MOV, MP4, MKV, AVI, and 20+ video formats. Batch process
              videos offline with full codec control and hardware acceleration.
            </p>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col items-center gap-3 sm:gap-4">
            <div
              class="flex flex-col sm:flex-row gap-2 items-center justify-center"
            >
              <Button
                text="Get Picmal for $15.99"
                onclick="posthog.capture('buy_clicked_video_converter_mac')"
              />
              <a
                href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg"
                class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-base py-3 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto"
              >
                <svg
                  class="w-4 h-4 inline-block mr-2"
                  fill="currentColor"
                  stroke="none"
                  viewBox="0 0 24 24"
                  ><path
                    d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8a4.35 4.35 0 0 1-2.59-4.03z"
                  ></path></svg
                >
                Download for Mac
              </a>
            </div>
            <p class="text-xs sm:text-sm text-text-secondary">
              One-time purchase • 14-day money back • macOS 12+
            </p>
          </div>

          <!-- Social Proof -->
          <div class="mt-6 sm:mt-8">
            <TrustBar />
          </div>
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-5xl mx-auto mb-6 sm:mb-8 rounded-lg sm:rounded-xl overflow-hidden border border-border"
        >
          <div style="aspect-ratio: 16/10;">
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover block dark:hidden"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal video converter interface"
            >
            </video>
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover hidden dark:block"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal video converter interface"
            >
            </video>
          </div>
        </div>
      </div>
    </main>

    <SectionDivider />

    <!-- Features Section -->
    <section class="relative z-10 px-6 py-20">
      <div class="max-w-6xl mx-auto">
        <H2 class="mb-4 text-center"
          >Everything you need for video conversion</H2
        >
        <Paragraph class="text-center mb-16 max-w-2xl mx-auto">
          Professional-grade video converter with full codec control, built
          specifically for macOS.
        </Paragraph>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Feature 1 -->
          <div class="bg-background-subtle rounded-xl p-8 border border-border">
            <H3 class="mb-4">Convert any video format</H3>
            <Paragraph class="mb-4">
              Support for MOV, MP4, MKV, AVI, WebM, MPEG, FLV, and more. Convert
              between formats with full control over codecs, bitrate, and
              quality.
            </Paragraph>
            <ul class="space-y-2 text-text-secondary">
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Modern codecs: H.264, H.265 (HEVC), VP9, AV1</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Convert iPhone MOV to universal MP4</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Web-optimized formats: WebM, MP4</span>
              </li>
            </ul>
          </div>

          <!-- Feature 2 -->
          <div class="bg-background-subtle rounded-xl p-8 border border-border">
            <H3 class="mb-4">Hardware-accelerated encoding</H3>
            <Paragraph class="mb-4">
              Picmal uses VideoToolbox on Apple Silicon and Intel Macs for
              blazing-fast hardware acceleration. Convert videos 5-10x faster
              than software encoding.
            </Paragraph>
            <ul class="space-y-2 text-text-secondary">
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Native VideoToolbox acceleration</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Optimized for Apple Silicon M1/M2/M3</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Convert 4K videos without slowdown</span>
              </li>
            </ul>
          </div>

          <!-- Feature 3 -->
          <div class="bg-background-subtle rounded-xl p-8 border border-border">
            <H3 class="mb-4">Batch convert multiple videos</H3>
            <Paragraph class="mb-4">
              Convert multiple videos at once with the same settings. Perfect
              for processing entire folders of videos or creating multiple
              output formats.
            </Paragraph>
            <ul class="space-y-2 text-text-secondary">
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Drop folders to convert all videos</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Process multiple videos in parallel</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Save presets for repeated batch jobs</span>
              </li>
            </ul>
          </div>

          <!-- Feature 4 -->
          <div class="bg-background-subtle rounded-xl p-8 border border-border">
            <H3 class="mb-4">Full quality and size control</H3>
            <Paragraph class="mb-4">
              Fine-tune every aspect of your video output. Adjust resolution,
              bitrate, frame rate, codec, and quality to meet any requirement.
            </Paragraph>
            <ul class="space-y-2 text-text-secondary">
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Resize videos: 4K, 1080p, 720p, custom</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Control bitrate for file size optimization</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Presets for web, social media, archival</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- Use Cases Section -->
    <section class="relative z-10 px-6 py-20 bg-background-subtle/50">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-12 text-center">Common video conversion use cases</H2>

        <div class="grid gap-6">
          <div class="bg-background rounded-lg p-6 border border-border">
            <H3 class="mb-2">iPhone to universal format</H3>
            <Paragraph>
              Convert iPhone MOV videos to MP4 for compatibility with Windows,
              Android, and web platforms.
            </Paragraph>
          </div>

          <div class="bg-background rounded-lg p-6 border border-border">
            <H3 class="mb-2">Web video optimization</H3>
            <Paragraph>
              Compress large videos for websites. Convert to WebM or optimized
              MP4 with H.265 for smaller file sizes without quality loss.
            </Paragraph>
          </div>

          <div class="bg-background rounded-lg p-6 border border-border">
            <H3 class="mb-2">Social media preparation</H3>
            <Paragraph>
              Prepare videos for Instagram, YouTube, TikTok. Batch convert to
              platform-specific formats with optimal compression.
            </Paragraph>
          </div>

          <div class="bg-background rounded-lg p-6 border border-border">
            <H3 class="mb-2">4K downscaling</H3>
            <Paragraph>
              Convert 4K videos to 1080p or 720p for easier sharing via email or
              cloud storage. Reduce file size by 75% while maintaining quality.
            </Paragraph>
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- Testimonials -->
    <MasonryTestimonials />

    <SectionDivider />

    <!-- CTA Section -->
    <CTASection
      heading="Start converting videos on your Mac"
      analyticsEvent="buy_clicked_video_converter_mac_bottom"
    />

    <SectionDivider />

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-6">Video conversion questions</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Common questions about converting videos on Mac.
          </Paragraph>
        </div>
        <div
          class="bg-background-subtle/50 border border-border rounded-lg p-4 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "picmal" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
