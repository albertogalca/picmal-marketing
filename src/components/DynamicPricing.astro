---
import H3 from "./H3.astro";
import Paragraph from "./Paragraph.astro";
import Button from "./Button.astro";

// Pricing tiers configuration
const pricingTiers = [
  {
    devices: 1,
    price: 15.99,
    url: "https://cantimplorastudio.lemonsqueezy.com/buy/d5bc408c-c4b4-4162-beed-0c1ddc8e1dbc",
  },
  {
    devices: 2,
    price: 28.78,
    url: "https://cantimplorastudio.lemonsqueezy.com/buy/b7caae04-3793-444c-92b6-44c209b3d8e5",
  },
  {
    devices: 3,
    price: 40.77,
    url: "https://cantimplorastudio.lemonsqueezy.com/buy/00394b68-9753-4c9f-81a4-17ed7c192fea",
  },
  {
    devices: 5,
    price: 63.95,
    url: "https://cantimplorastudio.lemonsqueezy.com/buy/e77fee96-f07a-4f57-91ec-56836cf6d23b",
  },
];
---

<div class="bg-background-subtle rounded-lg p-4 md:p-8 border border-border">
  <div class="mb-8">
    <!-- Title -->
    <H3 class="mb-6">Select number of devices</H3>

    <!-- Price Display -->
    <div class="flex items-baseline gap-1 mb-8">
      <span id="current-price" class="text-4xl font-semibold text-text">
        ${pricingTiers[0].price.toFixed(2)}
      </span>
      <span class="text-text-secondary text-body">/ once</span>
    </div>

    <!-- Features List -->
    <ul class="space-y-2 mb-8">
      <li class="flex items-start gap-3">
        <div class="flex items-center gap-2 mb-4">
          <!-- Device Selector -->
          <div class="flex items-center gap-2">
            <button
              id="decrease-devices"
              class="w-7 h-7 rounded bg-background hover:bg-background-subtle border border-border hover:border-border/20 flex items-center justify-center transition-all disabled:opacity-50 disabled:cursor-not-allowed"
              aria-label="Decrease number of devices"
            >
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20 12H4"></path>
              </svg>
            </button>

            <div
              class="flex items-center justify-center min-w-[85px] h-7 rounded border border-border bg-background px-2.5"
            >
              <span id="device-count" class="text-body font-semibold">1</span>
              <span class="ml-1.5 text-body-sm text-text-secondary" id="device-label"
                >device</span
              >
            </div>

            <button
              id="increase-devices"
              class="w-7 h-7 rounded bg-background hover:bg-background-subtle border border-border hover:border-border/20 flex items-center justify-center transition-all disabled:opacity-50 disabled:cursor-not-allowed"
              aria-label="Increase number of devices"
            >
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 4v16m8-8H4"></path>
              </svg>
            </button>
          </div>

          <Paragraph>
            (<span id="seat-count-text">1 seat</span>)
          </Paragraph>
        </div>
      </li>

      <li class="flex items-start gap-3">
        <svg
          class="w-5 h-5 text-text-secondary flex-shrink-0 mt-0.5"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        <div>
          <Paragraph>
            Convert & compress images, videos, audio <button
              id="open-formats-modal"
              class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-text/5 hover:bg-text/10 cursor-pointer transition-all align-middle ml-0.5"
              type="button"
              aria-label="View supported formats"
              ><svg
                class="w-2.5 h-2.5 text-text-secondary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg></button
            >
          </Paragraph>
        </div>
      </li>
      <li class="flex items-start gap-3">
        <svg
          class="w-5 h-5 text-text-secondary flex-shrink-0 mt-0.5"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        <div>
          <Paragraph>Batch processing for multiple files</Paragraph>
        </div>
      </li>
      <li class="flex items-start gap-3">
        <svg
          class="w-5 h-5 text-text-secondary flex-shrink-0 mt-0.5"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        <div>
          <Paragraph>Works offline, no data leaves your Mac</Paragraph>
        </div>
      </li>
      <li class="flex items-start gap-3">
        <svg
          class="w-5 h-5 text-text-secondary flex-shrink-0 mt-0.5"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        <div>
          <Paragraph>Free updates included</Paragraph>
        </div>
      </li>
    </ul>

    <!-- CTA Button -->
    <Button id="buy-button" text="Buy for Mac" class="w-full mt-6" onclick="posthog.capture('buy_clicked')" />

    <script define:vars={{ pricingTiers }}>
      // Initialize state
      let currentTierIndex = 0;

      // Get DOM elements
      const decreaseBtn = document.getElementById("decrease-devices");
      const increaseBtn = document.getElementById("increase-devices");
      const deviceCountEl = document.getElementById("device-count");
      const deviceLabelEl = document.getElementById("device-label");
      const currentPriceEl = document.getElementById("current-price");
      const seatCountTextEl = document.getElementById("seat-count-text");
      const buyButton = document.getElementById("buy-button");

      // Update UI function
      function updateUI() {
        const tier = pricingTiers[currentTierIndex];

        // Update device count
        deviceCountEl.textContent = tier.devices;
        deviceLabelEl.textContent = tier.devices === 1 ? "device" : "devices";

        // Update price
        currentPriceEl.textContent = `$${tier.price.toFixed(2)}`;

        // Update feature list
        seatCountTextEl.textContent = `${tier.devices} ${tier.devices === 1 ? "seat" : "seats"}`;

        // Update buy button URL
        buyButton.href = tier.url;

        // Update button states
        decreaseBtn.disabled = currentTierIndex === 0;
        increaseBtn.disabled = currentTierIndex === pricingTiers.length - 1;
      }

      // Event listeners
      decreaseBtn.addEventListener("click", () => {
        if (currentTierIndex > 0) {
          currentTierIndex--;
          updateUI();
        }
      });

      increaseBtn.addEventListener("click", () => {
        if (currentTierIndex < pricingTiers.length - 1) {
          currentTierIndex++;
          updateUI();
        }
      });

      // Initial UI update
      updateUI();
    </script>
  </div>
</div>

<Paragraph size="small" class="text-center text-text-secondary mt-4">
  Prices in USD. VAT may apply. Secure payment via Lemon Squeezy.
</Paragraph>
