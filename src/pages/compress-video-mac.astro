                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Optimized for Apple Silicon M1/M2/M3</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
