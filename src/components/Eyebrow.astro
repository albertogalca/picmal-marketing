---
import { cn } from "../utils/cn";

export interface Props {
  class?: string;
  tag?: "p" | "span" | "div";
}

const { class: className = "", tag = "p" } = Astro.props;
const Tag = tag;
// Uppercase + accent color live here (the text-eyebrow token is
// transform/color-agnostic). Override color/margins via `class`.
const defaultClasses = "text-eyebrow uppercase text-accent";
const mergedClasses = cn(defaultClasses, className);
---

<Tag class={mergedClasses}>
  <slot />
</Tag>
