---
import H2 from "./H2.astro";
import Paragraph from "./Paragraph.astro";
import Button from "./Button.astro";
import { DEFAULT_TIER, type Tier } from "../config/pricing";
import { cn } from "../utils/cn";
import PixelField from "./pm/PixelField.astro";

interface Props {
  heading: string;
  analyticsEvent: string;
  /** The line under the heading. Defaults to the terms, which is the right
      answer on a page that has not already spent itself saying them. On
      /pricing it has, so that page passes something the reader has not read
      six times by the time they get here. */
  note?: string;
  /** Which licence the button buys. Defaults to the entry tier, which is what
      every general page should sell. A page written for one audience (studios,
      education) passes the tier that audience came for, so the closing button
      does not drop them back to 1 Mac. */
  tier?: Tier;
  /** Extra classes on the section. A blog post passes `p-0` so the panel
      lines up with its text column and the section spacing is its own. */
  class?: string;
}

const {
  heading,
  analyticsEvent,
  note = "7-day free trial · One-time purchase · 14-day money-back guarantee",
  tier = DEFAULT_TIER,
  class: className,
} = Astro.props;
---

{/* Redesign: a neutral card, left-aligned, with blue only in a strip of
    pixels along the bottom edge. The dune is seeded from the heading, so each
    page gets its own and it never changes between builds. */}
<section class={cn("relative z-10 px-6 py-16 sm:py-24", className)}>
  <div class="max-w-5xl mx-auto">
    <div class="relative overflow-hidden bg-surface border border-border rounded-2xl">
      <div class="p-8 md:p-12 pb-4 md:pb-6 max-w-2xl">
        <H2 class="mb-2">{heading}</H2>
        <Paragraph class="mb-8">{note}</Paragraph>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
          <Button
            text={`Get Picmal for $${tier.price}`}
            href={tier.checkoutUrl}
            class="w-full sm:w-auto"
            onclick={import.meta.env.PROD
              ? `window.seline?.track('${analyticsEvent}')`
              : undefined}
          />
          <Button
            text="Try free for 7 days"
            href="/download"
            variant="secondary"
            target="_self"
            class="w-full sm:w-auto"
            onclick={import.meta.env.PROD
              ? "window.seline?.track('trial_clicked', { source: 'bottom' })"
              : undefined}
          />
        </div>
        <slot />
      </div>
      <div class="h-[72px]" aria-hidden="true">
        <PixelField width={1024} height={72} cell={6} seed={heading} tone="accent" rise={0.7} density={0.8} class="w-full h-full" />
      </div>
    </div>
  </div>
</section>
