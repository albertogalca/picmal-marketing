---
import Button from "./Button.astro";
import { DEFAULT_TIER } from "../config/pricing";

interface Props {
  /** Seline event fired on the buy click, e.g. "buy_clicked_video_converter_mac" */
  buyEvent: string;
  /** Seline event fired on the download click */
  downloadEvent?: string;
  /** Where "Need 2, 5 or 10 Macs?" points. Same-page anchor by default; pages
      without their own PricingSection pass "/#pricing". */
  pricingHref?: string;
  /** Which CTA fired the event, so the funnel can tell hero from pricing card. */
  source?: string;
  /** Extra classes for the wrapper */
  class?: string;
}

const {
  buyEvent,
  downloadEvent = "download_clicked",
  pricingHref = "#pricing",
  source = "hero",
  class: className = "",
} = Astro.props;

// The buy button carries no href, so Button falls back to
// DEFAULT_TIER.checkoutUrl and the click lands on Stripe. Until Aug 2026 this
// button pointed at /#pricing: every recorded buy_clicked was a scroll, and the
// checkout link three screens down got zero clicks in W35.
//
// Download stays secondary and routes through /download, which sets license
// expectations before the DMG.
const DOWNLOAD_URL = "/download";
const APPLE_ICON =
  "M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 14.25 3.51 5.71 9.05 5.43c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 3.97l.01-.01zM12.03 5.38c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z";
---

<div class={className || undefined}>
  <div class="hero-reveal flex flex-col sm:flex-row gap-3" style="--d: 160ms">
    <Button
      text={`Get Picmal for $${DEFAULT_TIER.price}`}
      class="w-full sm:w-auto"
      onclick={import.meta.env.PROD
        ? `window.seline?.track('${buyEvent}', { macs: ${DEFAULT_TIER.macs}, source: '${source}' })`
        : undefined}
    />
    <Button
      text="Download"
      href={DOWNLOAD_URL}
      variant="secondary"
      target="_self"
      icon={APPLE_ICON}
      iconType="fill"
      class="w-full sm:w-auto"
      onclick={import.meta.env.PROD
        ? `window.seline?.track('${downloadEvent}')`
        : undefined}
    />
  </div>

  <!-- What it costs and where the files stay, in one line. Muted so it
       supports the CTAs without competing. -->
  <p
    class="hero-reveal mt-5 text-small text-text-secondary"
    style="--d: 200ms"
  >
    <svg
      class="inline-block w-4 h-4 mr-1.5 align-[-3px]"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
    {/* "No uploads" used to live here. The H1 says "Nothing gets uploaded"
        and the sublead says "while a website would still be uploading", so
        this was the third time in one screen. The line's job is the terms, so
        it keeps the ones nothing else states. */}
    {`$${DEFAULT_TIER.price} once, updates included. No account, no subscription, works offline. `}
    <a href={pricingHref} class="link">Need 2, 5 or 10 Macs?</a>
  </p>
</div>
