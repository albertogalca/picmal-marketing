---
interface Props {
  author?: string;
  authorRole?: string;
  lastUpdated: string;
  sources?: { label: string; href: string }[];
}

const {
  author = "Alberto Gallego",
  authorRole = "Maintainer of Picmal",
  lastUpdated,
  sources = [],
} = Astro.props;

const formatted = new Date(lastUpdated + "T00:00:00Z").toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<section class="relative z-10 px-6 py-6" aria-label="Author and sources">
  <div class="max-w-3xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-small text-text-secondary border-t border-border pt-4">
      <div class="flex items-center gap-2">
        <span>
          By <span class="text-text font-medium">{author}</span> · {authorRole}
        </span>
      </div>
      <div>
        <time datetime={lastUpdated}>Last reviewed: {formatted}</time>
      </div>
    </div>
    {sources.length > 0 && (
      <div class="mt-4 text-small text-text-secondary">
        <span class="font-medium text-text">Sources:</span>{" "}
        {sources.map((s, i) => (
          <>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="text-accent hover:underline"
            >{s.label}</a>{i < sources.length - 1 ? ", " : ""}
          </>
        ))}
      </div>
    )}
  </div>
</section>
