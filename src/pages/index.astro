---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import FAQSchema, { faqs } from "../components/schema/FAQSchema.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import FeatureCard from "../components/FeatureCard.astro";
import { Image } from "astro:assets";
import Button from "../components/Button.astro";
import Testimonials from "../components/Testimonials.astro";
import Paragraph from "../components/Paragraph.astro";
import FeaturedOn from "../components/FeaturedOn.astro";
import DynamicPricing from "../components/DynamicPricing.astro";

const SITE_TITLE = "Picmal - All-in-one media converter for Mac";
const SITE_DESCRIPTION =
  "Batch convert and compress your images, videos and audios offline on your Mac.";

const licenseFaqs = [
  {
    question: "How does the license work?",
    answer:
      "When you purchase a Picmal license, you can use it indefinitely without any additional fees. This means you won't need to renew your license or make any regular payments to continue using it. You can move your license between devices, but you must first deactivate the license on the current device before activating it on a new one.",
  },
  {
    question: "How many devices can I use Picmal on?",
    answer:
      "Each license lets you use Picmal on that number of different Macs — for example, the 2-device license works on two Macs, the 5-device license on five, and so on.",
  },
  {
    question: "Can I use Picmal on multiple Macs?",
    answer:
      "While your license is tied to one active device at a time, you can transfer it between your Macs. Simply deactivate the license from your current Mac and activate it on another Mac when needed.",
  },
  {
    question: "What happens if I get a new Mac?",
    answer:
      "You can easily transfer your Picmal license to your new Mac. Just deactivate the license on your old Mac (via Picmal → Register license), then install Picmal on your new Mac and activate it with your existing license key.",
  },
  {
    question: "Can I get a refund?",
    answer:
      "Yes, there is a 14-day money-back guarantee. No questions asked. If you're not satisfied with Picmal, send your refund request to support@picmal.app and I'd love to hear your feedback too!",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <FAQSchema />
    <link rel="preload" href="/picmal-1.2.0-demo.mp4" as="video" type="video/mp4" />
  </head>
  <body class="bg-background">
    <Header />

    <!-- Hero Section -->
    <main id="main-content" class="relative z-10 px-6 pt-32 pb-16">
      <!-- Background Images -->
      <div class="absolute inset-0 -z-10 overflow-hidden hidden md:block">
        <Image
          src="/background.png"
          alt=""
          class="w-full h-full object-cover block dark:hidden"
          width={1920}
          height={1080}
          loading="eager"
        />
        <Image
          src="/background_dark.png"
          alt=""
          class="w-full h-full object-cover hidden dark:block opacity-10"
          width={1920}
          height={1080}
          loading="eager"
        />
      </div>

      <div class="max-w-5xl mx-auto text-center">
        <div class="max-w-3xl mx-auto">
          <H1 class="mb-8">All-in-one media converter for Mac </H1>
          <Paragraph class="mb-10 max-w-md mx-auto leading-relaxed">
            Batch convert and compress your images, videos and audios offline on
            your Mac.
          </Paragraph>
        </div>

        <div class="flex flex-col items-center gap-5 mb-16">
          <div
            class="flex flex-col sm:flex-row gap-3 items-center justify-center"
          >
            <Button text="Buy for Mac" />
            <a
              href="/apps/picmal/updates/Picmal.dmg"
              class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-base py-3 bg-background-subtle text-text hover:bg-background border border-text/10 hover:border-text/20 hover:shadow-sm"
            >
              <svg
                class="w-4 h-4 inline-block mr-2"
                fill="currentColor"
                stroke="none"
                viewBox="0 0 24 24"
                ><path
                  d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8 4.35 4.35 0 0 1-2.59-4.03z"
                ></path></svg
              >
              Download
            </a>
          </div>
          <Paragraph size="small" class="text-text-secondary">
            One-time purchase • 14-day money back guarantee
          </Paragraph>
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-4xl mx-auto mb-12 rounded-xl overflow-hidden border border-text-secondary/20"
          style="aspect-ratio: 16/10;"
        >
          <video
            src="/picmal-1.2.0-demo.mp4"
            class="w-full h-full object-cover block dark:hidden"
            width="1920"
            height="1200"
            autoplay
            loop
            muted
            playsinline
            preload="auto"
            aria-label="Picmal app interface showing drag and drop conversion"
          >
          </video>
          <video
            src="/picmal-1.2.0-demo.mp4"
            class="w-full h-full object-cover hidden dark:block"
            width="1920"
            height="1200"
            autoplay
            loop
            muted
            playsinline
            preload="auto"
            aria-label="Picmal app interface showing drag and drop conversion"
          >
          </video>
        </div>
      </div>
    </main>

    <!-- Testimonials Marquee - Full Width -->
    <section class="relative z-10 pb-16">
      <Testimonials />
    </section>

    <!-- Convert Between Formats Section -->
    <section id="features" class="relative z-10 px-6 py-20">
      <div class="max-w-5xl mx-auto">
        <H2 class="mb-6 text-center">Convert between<br />100+ formats</H2>
        <Paragraph class="text-center mb-12 max-w-xl mx-auto">
          From PSD to PNG, MOV to MP4, or WAV to MP3. Handle any image, video,
          or audio format with professional-grade quality. No technical
          knowledge needed.
        </Paragraph>

        <!-- Demo Interface -->
        <div
          class="max-w-4xl mx-auto mb-12 rounded-xl overflow-hidden border border-text-secondary/20"
        >
          <video
            src="/convert.mp4"
            class="w-full h-auto block dark:hidden"
            autoplay
            loop
            muted
            playsinline
            aria-label="Picmal conversion interface showing PNG to WEBP conversion"
          >
          </video>
          <video
            src="/convert_dark.mp4"
            class="w-full h-auto hidden dark:block"
            autoplay
            loop
            muted
            playsinline
            aria-label="Picmal conversion interface showing PNG to WEBP conversion"
          >
          </video>
        </div>
      </div>
    </section>

    <!-- Compress Section -->
    <section class="relative z-10 px-6 py-20">
      <div class="max-w-5xl mx-auto">
        <H2 class="mb-6 text-center"
          >Compress without<br />compromising quality</H2
        >
        <Paragraph class="text-center mb-12 max-w-xl mx-auto">
          Reduce file sizes while maintaining quality. Perfect for web
          optimization, email attachments, or freeing up storage space. Works
          with images, videos, and audio files.
        </Paragraph>

        <!-- Compression Demo -->
        <div
          class="max-w-4xl mx-auto mb-12 rounded-xl overflow-hidden border border-text-secondary/20"
        >
          <video
            src="/compress.mp4"
            class="w-full h-auto block dark:hidden"
            autoplay
            loop
            muted
            playsinline
            aria-label="Picmal compression interface showing multiple images ready for compression"
          >
          </video>
          <video
            src="/compress_dark.mp4"
            class="w-full h-auto hidden dark:block"
            autoplay
            loop
            muted
            playsinline
            aria-label="Picmal compression interface showing multiple images ready for compression"
          >
          </video>
        </div>
      </div>
    </section>

    <!-- And More Features Section -->
    <section class="relative z-10 px-6 py-20">
      <div class="max-w-6xl mx-auto">
        <H2 class="mb-16 text-center">Why Picmal?</H2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-left">
          <FeatureCard
            title="Designed for Mac"
            description="Native macOS app that feels right at home with beautiful interface and smooth performance."
          >
            <svg
              slot="icon"
              viewBox="0 0 36 36"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <g clip-path="url(#clip0_1109_1361)">
                <path
                  d="M4.875 7.79134C4.875 7.40457 5.02865 7.03363 5.30214 6.76014C5.57563 6.48665 5.94656 6.33301 6.33333 6.33301H29.6667C30.0534 6.33301 30.4244 6.48665 30.6979 6.76014C30.9714 7.03363 31.125 7.40457 31.125 7.79134V28.208C31.125 28.5948 30.9714 28.9657 30.6979 29.2392C30.4244 29.5127 30.0534 29.6663 29.6667 29.6663H6.33333C5.94656 29.6663 5.57563 29.5127 5.30214 29.2392C5.02865 28.9657 4.875 28.5948 4.875 28.208V7.79134Z"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M10.708 12.167V13.6253"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M25.292 12.167V13.6253"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M18.7295 6.33301C17.7757 8.50009 16.892 11.354 16.542 19.458H20.1878C19.9107 23.6391 20.3249 26.7847 20.917 29.6663"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M10.708 23.1045C16.0557 26.0212 19.9436 26.0212 25.2913 23.1045"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </g>
              <defs>
                <clipPath id="clip0_1109_1361">
                  <rect
                    width="35"
                    height="35"
                    fill="white"
                    transform="translate(0.5 0.5)"></rect>
                </clipPath>
              </defs>
            </svg>
          </FeatureCard>

          <FeatureCard
            title="Batch processing"
            description="Drop hundreds of files at once and let Picmal handle the rest. Save hours of repetitive work."
          >
            <svg
              slot="icon"
              viewBox="0 0 36 36"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <g clip-path="url(#clip0_1109_1406)">
                <path
                  d="M19.4587 4.875V15.0833H28.2087L16.542 31.125V20.9167H7.79199L19.4587 4.875Z"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </g>
              <defs>
                <clipPath id="clip0_1109_1406">
                  <rect
                    width="35"
                    height="35"
                    fill="white"
                    transform="translate(0.5 0.5)"></rect>
                </clipPath>
              </defs>
            </svg>
          </FeatureCard>

          <FeatureCard
            title="Works offline"
            description="No internet needed. All processing happens locally on your Mac for maximum speed and privacy."
          >
            <svg
              slot="icon"
              viewBox="0 0 36 36"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <g clip-path="url(#clip0_1109_1376)">
                <path
                  d="M14.4712 8.59099C14.8212 8.43057 15.1887 8.28912 15.5678 8.17391C18.3095 7.33974 21.337 7.89245 23.507 9.63224C25.677 11.3677 26.6599 14.0174 26.0882 16.587H27.532C30.3218 16.587 32.5837 18.862 32.5837 21.6708C32.5837 23.0664 32.0251 24.3308 31.1209 25.2495M26.7503 26.756H10.2085C6.45762 26.7502 3.41699 23.8233 3.41699 20.2124C3.41699 16.6031 6.45762 13.6762 10.2085 13.6762C10.398 12.8274 10.748 12.0312 11.2293 11.3137"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M4.875 4.875L31.125 31.125"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </g>
              <defs>
                <clipPath id="clip0_1109_1376">
                  <rect
                    width="35"
                    height="35"
                    fill="white"
                    transform="translate(0.5 0.5)"></rect>
                </clipPath>
              </defs>
            </svg>
          </FeatureCard>

          <FeatureCard
            title="Custom output formats"
            description="Set your preferred format once and forget it. Picmal remembers your settings for future conversions."
          >
            <svg
              slot="icon"
              viewBox="0 0 36 36"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <g clip-path="url(#clip0_1109_1381)">
                <path
                  d="M6.33301 28.2083V31.125H29.6663V10.7083L17.9997 4.875L6.33301 10.7083V13.625"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M19.458 20.917H6.33301"
                  stroke-linecap="round"
