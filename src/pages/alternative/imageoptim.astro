---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import PricingSection from "../../components/PricingSection.astro";
import FounderLetter from "../../components/FounderLetter.astro";
import Section from "../../components/Section.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import AlternativeVerdict from "../../components/AlternativeVerdict.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";
import FAQSection from "../../components/FAQSection.astro";

const SITE_DESCRIPTION =
  "Looking for an ImageOptim alternative? ImageOptim is free and good at lossless image compression. Picmal adds format conversion, video, audio, and PDFs, with active development. $29 once.";

const faqs = [
  {
    question: "Is Picmal a good ImageOptim alternative?",
    answer:
      "It depends what you're missing. ImageOptim is free, local, and very good at squeezing PNG and JPEG without visible loss. If that's all you need, keep it. Picmal is worth $29 if you also need to convert formats, handle video, audio, or PDFs, or want the app to still be getting updates.",
  },
  {
    question: "Can ImageOptim convert between formats?",
    answer:
      "No. ImageOptim compresses an image and leaves it in the same format. It won't turn a HEIC into a JPG or a PNG into a WebP. That's the single most common reason people go looking for an alternative, and it's what Picmal does.",
  },
  {
    question: "Is ImageOptim still being updated?",
    answer:
      "Development has been very quiet for a long time. It still works well on the formats it supports, but it hasn't kept pace with newer ones like AVIF and JXL, or with changes in macOS. Picmal ships updates regularly, listed at picmal.app/changelog.",
  },
  {
    question: "Does Picmal compress as well as ImageOptim?",
    answer:
      "For everyday web and storage use, the difference isn't something you'll see. ImageOptim runs several open source optimisers in sequence and can shave out the last few percent on PNG, which matters if you're chasing absolute minimum size. Picmal trades that last few percent for covering video, audio, PDFs, and format conversion in one app.",
  },
  {
    question: "Do both keep files on my Mac?",
    answer:
      "Yes. This is one thing they genuinely share. Neither uploads your images anywhere, both work with no internet connection. If you're comparing either of them to a web converter, that's the real difference.",
  },
  {
    question: "Is ImageOptim free?",
    answer:
      "Yes, and open source. That's a real advantage and worth saying plainly. Picmal costs $29 once, so it only makes sense if the extra formats, media types, and integrations are worth that to you.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Email support@picmal.app.",
  },
];
---

<MarketingLayout
  title="Picmal: The ImageOptim alternative that also converts formats"
  description={SITE_DESCRIPTION}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
        <FAQSchema />
  </Fragment>

  <ComparisonHero
    title="The ImageOptim alternative that also converts formats"
    subhead="ImageOptim is free, local, and good at what it does. It just can't convert a HEIC to a JPG, touch a video, or compress a PDF. Picmal does all of that on your Mac for $29 once."
    buyEvent="buy_clicked_imageoptim_comparison"
  />

  <ComparisonVerdict
    competitor="ImageOptim"
    summary="ImageOptim is free, open source, runs entirely on your Mac, and squeezes PNG and JPEG about as hard as anything out there. Its limits are that it only compresses, only images, and development has been quiet for years. Picmal ($29, pay once) converts formats too, covers video, audio, and PDFs, and is actively maintained."
    picmalFor="You need to convert formats, not just compress. Or you've got video, audio, and PDFs to deal with and would rather not collect four apps."
    competitorFor="You compress PNGs and JPEGs for the web, you want the smallest possible file, and free and open source matters to you. It's a good tool, keep it."
  />

  <!-- Comparison Table -->
  <Section width="default">
    <SectionHeading>
      Picmal vs ImageOptim at a glance
      <Fragment slot="sublead">
        Both are Mac apps that keep your files on your Mac. ImageOptim
        compresses images. Picmal converts and compresses images, video, audio,
        and PDFs.
      </Fragment>
    </SectionHeading>
    <ComparisonTable
      competitor="ImageOptim"
      rows={[
      {
        feature: "Price",
        picmal: "$29 one-time",
        competitor: "Free, open source",
      },
      {
        feature: "Privacy",
        picmal: "100% offline",
        competitor: "100% offline",
      },
      {
        feature: "Image compression",
        picmal: "Yes",
        competitor: "Yes, its speciality",
      },
      {
        feature: "Image conversion",
        picmal: "Yes. HEIC, JPG, PNG, WebP, AVIF, and more",
        competitor: "No",
      },
      {
        feature: "Video",
        picmal: "Convert &amp; compress",
        competitor: "No",
      },
      {
        feature: "Audio",
        picmal: "Convert &amp; compress",
        competitor: "No",
      },
      {
        feature: "PDF",
        picmal: "Compress, merge, split, images to PDF",
        competitor: "No",
      },
      {
        feature: "Resize",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "Metadata removal",
        picmal: "Yes",
        competitor: "Yes",
      },
      {
        feature: "Batch processing",
        picmal: "Yes",
        competitor: "Yes",
      },
      {
        feature: "Folder monitoring",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "Shortcuts integration",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "Raycast extension",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "Finder right-click",
        picmal: "Yes",
        competitor: "Yes",
      },
      {
        feature: "Actively updated",
        picmal: "Yes",
        competitor: "Rarely",
      },
      {
        feature: "macOS",
        picmal: "15+",
        competitor: "13+",
      },
    ]}
    />
  </Section>

  <!-- Who each is for -->
  <AlternativeVerdict
    sublead="Here's where each one makes more sense."
    picmal={{
      heading: "Choose Picmal",
      lead: "Compression alone isn't the job",
      items: [
        "You need to convert formats, HEIC to JPG being the usual one",
        "You want newer formats like AVIF and JXL, not just PNG and JPEG",
        "Video, audio, or PDFs are part of the same pile of work",
        "You'd rather use something that's still being maintained",
      ],
    }}
    rival={{
      heading: "Stay with ImageOptim",
      lead: "Free, open source, and it does the job",
      items: [
        "You only ever compress PNG and JPEG for the web",
        "You want the last few percent of file size and nothing else",
        "Free and open source is the point, not a compromise",
      ],
    }}
  />

  <FeatureGrid
    heading="Everything else Picmal does"
    subleadIntro="One app for images, video, audio, and PDFs. Convert, compress, and edit, all on your Mac."
  />

  <MasonryTestimonials />

  <PricingSection />

  <FounderLetter />

  <FAQSection
    faqs={faqs}
    heading="Frequently asked questions"
    sublead="Can't find what you're looking for? Email support@picmal.app"
  />

  <Fragment slot="after">
    <SupportedFormatsModal />
  </Fragment>
</MarketingLayout>
