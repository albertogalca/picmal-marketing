---
import BaseHead from "./BaseHead.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import H1 from "./H1.astro";

export interface Props {
  meta: {
    title: string;
    description: string;
    date: string;
  };
}

const { meta } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={meta.title} description={meta.description} />
  </head>
  <body class="bg-white">
    <Header />

    <!-- Back to Home Link -->
    <div class="relative z-10 px-6 pt-32 pb-6">
      <div class="max-w-3xl mx-auto">
        <a
          href="/"
          class="inline-flex items-center text-sm transition-colors cursor-pointer text-gray-500 hover:text-black"
        >
          ← Back to home
        </a>
      </div>
    </div>

    <!-- Page Content -->
    <article class="relative z-10 px-6 pb-20">
      <div class="max-w-3xl mx-auto">
        <!-- Header -->
        <header class="mb-8">
          <H1 class="mb-4">
            {meta.title}
          </H1>
          <p class="text-sm text-gray-500 mb-6">
            {meta.date}
          </p>
        </header>

        <!-- Content -->
        <div
          class="prose prose-lg max-w-none
                    prose-headings:text-black
                    prose-p:text-gray-700
                    prose-a:text-[#1B5BFF] hover:prose-a:text-[#1548CC]
                    prose-strong:text-black
                    prose-code:text-[#1B5BFF] prose-code:bg-gray-100
                    prose-pre:bg-black
                    prose-blockquote:border-l-[#1B5BFF] prose-blockquote:text-gray-600
                    prose-th:text-black
                    prose-td:text-gray-700
                    prose-ul:text-gray-700
                    prose-ol:text-gray-700
                    prose-li:text-gray-700"
        >
          <slot />
        </div>
      </div>
    </article>

    <Footer />
  </body>
</html>
