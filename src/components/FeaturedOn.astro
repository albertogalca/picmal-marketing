---
import Paragraph from "./Paragraph.astro";
import { Image } from "astro:assets";
---

<div class="w-full pb-8">
  <div class="max-w-4xl mx-auto px-6">
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-6 sm:gap-12"
    >
      <!-- Featured On Label -->
      <Paragraph size="small" class="uppercase"> Featured on </Paragraph>

      <!-- Logos -->
      <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-8">
        <!-- Product Hunt -->
        <a
          href="https://www.producthunt.com/products/picmal?utm_source=picmal.app"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:opacity-80 transition-opacity"
        >
          <Image
            src="/ph-social_proof.webp"
            alt="Product Hunt"
            class="h-10 w-auto grayscale opacity-60 dark:invert dark:opacity-50"
            width={128}
            height={32}
            loading="lazy"
          />
        </a>

        <!-- TinyLaunch -->
        <a
          href="https://www.tinylaunch.com/launch/6236?utm_source=picmal.app"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:opacity-80 transition-opacity"
        >
          <Image
            src="/tl-social_proof.webp"
            alt="TinyLaunch"
            class="h-10 w-auto grayscale opacity-60 dark:invert dark:opacity-50"
            width={128}
            height={32}
            loading="lazy"
          />
        </a>

        <!-- Startup Fame -->
        <a
          href="https://startupfa.me/s/picmal?utm_source=picmal.app"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:opacity-80 transition-opacity"
        >
          <img
            src="https://startupfa.me/images/logo.svg"
            alt="Startup Fame"
            class="h-7 w-auto grayscale opacity-60 dark:invert dark:opacity-50"
            width="208"
            height="36"
            loading="lazy"
          />
        </a>
      </div>
    </div>
  </div>
</div>
