---
import { Image } from "astro:assets";

const logos = [
  {
    name: "Product Hunt",
    href: "https://www.producthunt.com/products/picmal?utm_source=picmal.app",
    src: "/ph-social_proof.webp",
    width: 208,
    height: 36,
  },
  {
    name: "TinyLaunch",
    href: "https://www.tinylaunch.com/launch/6236?utm_source=picmal.app",
    src: "/tl-social_proof.webp",
    width: 208,
    height: 36,
  },
  {
    name: "Startup Fame",
    href: "https://startupfa.me/s/picmal?utm_source=picmal.app",
    src: "https://startupfa.me/images/logo.svg",
    width: 208,
    height: 36,
  },
  {
    name: "Scout Forge",
    href: "https://scoutforge.net/reviews/picmal/",
    src: "/scoutforge_proof.webp",
    width: 208,
    height: 36,
  },
  {
    name: "LaunchIgniter",
    href: "https://launchigniter.com/product/picmal?ref=badge-picmal&utm_source=picmal.app",
    src: "/launchigniter_proof.webp",
    width: 208,
    height: 36,
  },
  {
    name: "DevHub",
    href: "https://devhub.best/projects/picmal",
    src: "/devhub_proof.svg",
    width: 36,
    height: 36,
  },
];
---

<div class="w-full py-8">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col items-center gap-10">
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
        {
          logos.map((logo) => (
            <a
              href={logo.href}
              target="_blank"
              rel="noopener noreferrer"
              class="logo-link w-auto h-auto flex items-center"
            >
              <Image
                src={logo.src}
                alt={logo.name}
                class="max-h-full w-auto min-w-[36px] max-w-[150px] object-contain h-auto"
                width={logo.width}
                height={logo.height}
                loading="lazy"
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .logo-link {
    opacity: 0.4;
    filter: grayscale(100%);
    transition: all 0.2s ease;
  }

  .logo-link:hover {
    opacity: 1;
    filter: grayscale(0%);
  }

  :global(.dark) .logo-link {
    filter: grayscale(100%) invert(1);
    opacity: 0.4;
  }

  :global(.dark) .logo-link:hover {
    filter: grayscale(0%) invert(1);
    opacity: 1;
  }
</style>
