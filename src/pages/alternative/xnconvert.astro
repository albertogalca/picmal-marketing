---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import PricingSection from "../../components/PricingSection.astro";
import FounderLetter from "../../components/FounderLetter.astro";
import Section from "../../components/Section.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import AlternativeVerdict from "../../components/AlternativeVerdict.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";
import FAQSection from "../../components/FAQSection.astro";

const SITE_DESCRIPTION =
  "Want an XnConvert alternative on your Mac? Picmal is a native app that converts, compresses, and edits images, video, audio, and PDFs. Works with Shortcuts. Everything runs offline. Pay $29 once.";

const faqs = [
  {
    question: "Is Picmal a good XnConvert alternative?",
    answer:
      "If you work with video and audio alongside images on a Mac, yes. XnConvert doesn't touch those. If you need 500+ image formats, 80+ editing actions, or the same app on Windows and Linux, XnConvert goes deeper on the image side.",
  },
  {
    question: "Why pay for Picmal when XnConvert is free?",
    answer:
      "XnConvert is free and great at bulk image editing with 80+ actions. Picmal is $29 and adds video, audio, PDF tools, compression, Shortcuts, and a Finder right-click. XnConvert has none of those. If images are all you need and you want deep editing, stick with XnConvert.",
  },
  {
    question: "Does XnConvert support more formats than Picmal?",
    answer:
      "For images, yes, by a lot. 500+ input formats against Picmal's 20+. But Picmal also handles video, audio, RAW decode, and PDFs, and XnConvert doesn't do any of those.",
  },
  {
    question: "Can Picmal add watermarks like XnConvert?",
    answer:
      "Picmal watermarks video. XnConvert watermarks images. Neither does both. XnConvert goes further on image editing overall, with 80+ actions, filters, and full metadata editing, so for bulk image work it's the stronger tool.",
  },
  {
    question: "Does Picmal work on Windows or Linux like XnConvert?",
    answer:
      "No. Picmal is Mac only. XnConvert runs on Windows and Linux too.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Just email support@picmal.app.",
  },
];
---

<MarketingLayout
  title="Picmal: The native Mac XnConvert alternative"
  description={SITE_DESCRIPTION}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
        <FAQSchema />
  </Fragment>

  <ComparisonHero
    title="The native Mac XnConvert alternative"
    subhead="XnConvert goes deep on bulk image editing. 500+ formats, 80+ actions, free. Picmal covers more media types. Video, audio, and PDFs alongside images, in a native Mac app that works with Shortcuts."
    buyEvent="buy_clicked_xnconvert_comparison"
  />

  <ComparisonVerdict
    competitor="XnConvert"
    summary="XnConvert is free, runs on every platform, and handles 500+ formats with 80+ editing actions for bulk image work. Picmal ($29, paid once) is Mac only and covers more media types. Video, audio, and PDFs alongside images, with a native interface and Shortcuts support."
    picmalFor="You work with video and audio alongside images, you want a native Mac feel with Shortcuts and a Finder right-click, and you're fine with fewer image editing options."
    competitorFor="You need 500+ image formats, 80+ editing actions, full metadata editing, scripting, or the same app on Windows and Linux, and free matters to you."
  />

  <!-- Comparison Table -->
  <Section width="default">
    <SectionHeading>
      Picmal vs XnConvert at a glance
      <Fragment slot="sublead">
        XnConvert is a bulk image processor with hundreds of editing actions.
        Picmal covers more media types, video, audio, and PDFs, with fewer
        image editing options. Pick based on what you actually need.
      </Fragment>
    </SectionHeading>
    <ComparisonTable
      competitor="XnConvert"
      rows={[
      {
        feature: "Price",
        picmal: "$29 one-time",
        competitor: "Free (personal), \u20ac15 (commercial)",
      },
      {
        feature: "Platforms",
        picmal: "macOS only",
        competitor: "Windows, Mac, Linux",
      },
      {
        feature: "Privacy",
        picmal: "100% offline",
        competitor: "100% offline",
      },
      {
        feature: "Interface",
        picmal: "Native macOS, minimal",
        competitor: "Cross-platform, feature-rich",
      },
      {
        feature: "Image formats",
        picmal: "20+",
        competitor: "500+ input, 70+ output",
      },
      {
        feature: "Video conversion",
        picmal: "Yes. MP4, MOV, MKV, and more",
        competitor: "No",
      },
      {
        feature: "Audio conversion",
        picmal: "Yes. MP3, WAV, FLAC, and more",
        competitor: "No",
      },
      {
        feature: "Editing actions",
        picmal: "Light (watermark, resize, rotate, metadata removal)",
        competitor: "80+ (watermarks, filters, transforms)",
      },
      {
        feature: "Watermarks",
        picmal: "Video only",
        competitor: "Yes",
      },
      {
        feature: "Metadata editing",
        picmal: "Removal only",
        competitor: "Full editing",
      },
      {
        feature: "Folder monitoring",
        picmal: "Yes",
        competitor: "Yes (watch folder)",
      },
      {
        feature: "Shortcuts integration",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "Finder right-click",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "Custom presets",
        picmal: "No",
        competitor: "Yes",
      },
      {
        feature: "macOS",
        picmal: "15+",
        competitor: "10.13+",
      },
    ]}
    />
  </Section>

  <!-- Who Picmal Is For / Who Should Stick with XnConvert -->
  <AlternativeVerdict
    sublead="Here's where each one makes more sense."
    picmal={{
      heading: "Choose Picmal",
      lead: "Video, audio, and PDFs alongside images. Mac native.",
      items: [
        "You want one native app to convert, compress, and edit",
        "You use Apple Shortcuts for automation",
        "You want a UI that actually feels like a Mac app",
        "You need video, audio, and PDF tools plus real compression",
      ],
    }}
    rival={{
      heading: "Choose XnConvert",
      lead: "Best for deep image processing and running on any platform",
      items: [
        "You use Windows or Linux",
        "You need deep bulk image editing, with transforms, filters, and full metadata editing",
        "You want 500+ format support with 80+ editing actions",
        "You prefer free software for personal use",
      ],
    }}
  />

  <!-- Features -->
  <FeatureGrid
    heading="Everything else Picmal does"
    subleadIntro="One app for images, video, audio, and PDFs. Convert, compress, and edit, all on your Mac."
  />

  <!-- Testimonials Section -->
  <MasonryTestimonials />

  <!-- Pricing -->
  <PricingSection />

  <!-- Founder letter -->
  <FounderLetter />

  <!-- FAQ Section -->
  <FAQSection
    faqs={faqs}
    heading="Frequently asked questions"
    sublead="Can't find what you're looking for? Email support@picmal.app"
  />

  <Fragment slot="after">
    <SupportedFormatsModal />
  </Fragment>
</MarketingLayout>
