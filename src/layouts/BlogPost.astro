---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import ArticleSchema from "../components/schema/ArticleSchema.astro";
import BlogFAQSchema from "../components/schema/BlogFAQSchema.astro";
import CTASection from "../components/CTASection.astro";
import H1 from "../components/H1.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import RelatedConversions from "../components/RelatedConversions.astro";

type Props = CollectionEntry<"blog">["data"] & {
  category?: string;
  slug?: string;
  tags?: string[];
  faqs?: { question: string; answer: string }[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category,
  slug,
  tags,
  faqs,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      ogType="article"
      publishedTime={pubDate.toISOString()}
      modifiedTime={updatedDate ? updatedDate.toISOString() : pubDate.toISOString()}
    />
    {
      slug && (
        <ArticleSchema
          post={{
            title,
            description,
            pubDate,
            updatedDate,
            heroImage,
            category,
          }}
          url={Astro.site!.href}
          slug={slug}
        />
      )
    }
    {faqs && faqs.length > 0 && <BlogFAQSchema faqs={faqs} />}
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <!-- Article -->
    <article class="relative z-10 px-6 pt-44 pb-20">
      <div class="max-w-3xl mx-auto">
        <!-- Breadcrumb -->
        <div class="article-breadcrumb">
          <Breadcrumb
            items={[
              { label: "Home", href: "/" },
              { label: "Blog", href: "/blog" },
              { label: title },
            ]}
          />
        </div>

        <!-- Header -->
        <header class="mb-8 article-header">
          {
            heroImage && (
              <div class="mb-6">
                <Image
                  src={heroImage}
                  alt={title}
                  width={800}
                  height={400}
                  class="w-full h-auto rounded-xl border border-border"
                />
              </div>
            )
          }
          <div class="flex items-center gap-3 mb-8 text-small">
            <a
              href="https://albertogalca.com/"
              rel="author"
              class="text-text-secondary transition-colors hover:text-text"
              >By Alberto Gallego</a
            >
            <span class="text-text-secondary">•</span>
            {
              category && (
                <>
                  <span class="px-2 py-1 bg-accent/10 text-accent rounded-xl font-medium">
                    {category}
                  </span>
                  <span class="text-text-secondary">•</span>
                </>
              )
            }
            <time datetime={pubDate.toISOString()} class="text-text-secondary">
              <FormattedDate date={pubDate} />
            </time>
            {
              updatedDate && (
                <>
                  <span class="text-text-secondary">•</span>
                  <span class="text-text-secondary italic">
                    Updated <FormattedDate date={updatedDate} />
                  </span>
                </>
              )
            }
          </div>

          <H1 id="article-title" class="mb-4">
            {title}
          </H1>
        </header>

        <!-- Content -->
        <div
          class="prose max-w-none article-content
              prose-headings:text-text prose-headings:font-semibold
              prose-p:text-text/65 prose-p:leading-relaxed
              prose-strong:text-text
              prose-pre:bg-black
              prose-blockquote:border-l-accent prose-blockquote:text-text-secondary prose-blockquote:bg-background-subtle
              prose-th:text-text
              prose-td:text-text/65
              prose-ul:text-text/65
              prose-ol:text-text/65
              prose-li:text-text/65
              prose-img:rounded-xl"
          role="main"
          aria-labelledby="article-title"
        >
          <slot />
        </div>

        <!-- Related conversion tools (tag-matched, indexed pages only) -->
        <RelatedConversions tags={tags} />

        <!-- Download CTA -->
        <div class="mt-12 article-cta">
          <CTASection
            heading="Use Picmal to easily convert your media on your Mac"
            analyticsEvent={`buy_clicked_blog_${slug || "post"}`}
          />
        </div>

        <!-- Related Posts -->
        <div class="article-related">
          {
            slug && (
              <RelatedPosts
                currentSlug={slug}
                category={category}
                tags={tags}
                limit={2}
              />
            )
          }
        </div>
      </div>
    </article>

    <Footer />
  </body>
</html>
