---
import { render, type CollectionEntry } from "astro:content";
import PostCard from "../components/PostCard.astro";
import CtaBand from "../components/CtaBand.astro";
import PixelField from "../components/PixelField.astro";
import { postCover, postCoverDark, displayCategory, getPublishedPosts } from "../../utils/posts";

interface Props { post: CollectionEntry<"blog"> }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
const cover = postCover(post);
const coverDark = postCoverDark(post);
const related = (await getPublishedPosts()).filter((p) => p.id !== post.id && p.data.category === post.data.category).slice(0, 3);
---

<div class="pm-wrap">
  <header class="pm-article-head" style="padding-top: 80px">
    {post.data.category && <div class="pm-article-head__kind">{displayCategory(post.data.category)}</div>}
    <h1 class="pm-article-head__title">{post.data.title}</h1>
    <p class="pm-article-head__lede">{post.data.description}</p>
    <div class="pm-article-head__meta">
      <img src="/founder-badge.png" alt="" width="24" height="24" style="border-radius: 50%" />
      <span>Alberto Gallego</span><span>{fmt(post.data.pubDate)}</span>{post.data.updatedDate && <span>Updated {fmt(post.data.updatedDate)}</span>}
    </div>
  </header>
  <div class="pm-post__img pm-mt-8" style="max-width: 800px">
    <img src={typeof cover === "string" ? cover : cover.src} alt="" class={coverDark ? "pm-light-only" : undefined} />
    {coverDark && <img src={coverDark} alt="" class="pm-dark-only" />}
  </div>
  <div style="display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 64px; margin-top: 64px; align-items: start" class="pm-article-grid">
    <article class="pm-prose"><Content /></article>
    {toc.length > 0 && (
      <nav class="pm-toc" style="position: sticky; top: 24px">
        <div class="pm-toc__title">On this page</div>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}
  </div>
  <div class="pm-section"><CtaBand /></div>
  {related.length > 0 && (
    <section class="pm-section">
      <div class="pm-kicker">Related guides</div>
      <div class="pm-grid3">{related.map((p) => <PostCard post={p} />)}</div>
    </section>
  )}
</div>
