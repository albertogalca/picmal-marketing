---
import { Image } from "astro:assets";
import { getPublishedPosts } from "../../utils/posts";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import "../../styles/global.css";
import SectionHeading from "../../components/SectionHeading.astro";
import SegmentedControl from "../../components/SegmentedControl.astro";
import Paragraph from "../../components/Paragraph.astro";

const posts = (await getPublishedPosts()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Categories come from the posts themselves, so a new category needs no code
// change here. "All" is always first.
const categories = [
  "All",
  ...new Set(posts.map((p) => p.data.category).filter(Boolean)),
];
const segments = categories.map((c) => ({ id: c, label: c }));

const blogListSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Picmal Blog",
  description:
    "Guides on image conversion, batch processing, format optimization, and Mac productivity tips.",
  url: new URL("/blog", Astro.site).href,
  isPartOf: {
    "@type": "WebSite",
    name: "Picmal",
    url: Astro.site?.href,
  },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: posts.length,
    itemListElement: posts.map((post, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: new URL(`/blog/${post.id}`, Astro.site).href,
      name: post.data.title,
    })),
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Picmal: Blog"
      description="Guides on converting and compressing images, video, audio, and PDFs on your Mac, plus format tips, batch-processing workflows, and product updates."
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(blogListSchema)}
    />
  </head>
  <body class="bg-background overflow-x-hidden">
    <Header />

    <main class="relative z-10 pt-32 pb-20">
      <div class="max-w-7xl mx-auto px-6">
        <SectionHeading
          level={1}
          sublead="Updates, guides, and thoughts about building a media conversion app for Mac"
        >
          Picmal Blog
        </SectionHeading>

        <!-- Category filter (client-side, no page reloads) -->
        {
          segments.length > 1 && (
            <div class="mb-12">
              <SegmentedControl
                segments={segments}
                activeId="All"
                ariaLabel="Blog categories"
                mode="radio"
                segmentClass="blog-cat-tab"
              />
            </div>
          )
        }

        <!-- Blog Posts Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            posts.map((post) => (
              <article class="h-full" data-category={post.data.category ?? ""}>
                <a
                  href={`/blog/${post.id}`}
                  class="flex flex-col h-full bg-background-subtle/50 border border-border rounded-2xl overflow-hidden transition-[scale] duration-200 active:scale-[0.98] motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                >
                  <div class="relative aspect-video overflow-hidden bg-background ring-1 ring-inset ring-black/10 dark:ring-white/10">
                    <Image
                      src={post.data.heroImage || "/images/blog/default.png"}
                      alt={post.data.title}
                      width={800}
                      height={450}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover"
                    />
                  </div>
                  <div class="p-4 flex flex-col flex-1">
                    <div class="flex items-center gap-2 mb-3 text-small text-text-secondary">
                      {post.data.category && (
                        <>
                          <span class="px-2 py-1 bg-accent/10 text-accent rounded-full font-medium">
                            {post.data.category}
                          </span>
                          <span>•</span>
                        </>
                      )}
                      <time datetime={post.data.pubDate.toISOString()}>
                        <FormattedDate date={post.data.pubDate} />
                      </time>
                    </div>
                    <h2 class="text-body font-semibold text-text text-balance mb-2 leading-snug">
                      {post.data.title}
                    </h2>
                    {post.data.description && (
                      <p class="text-small text-text-secondary leading-relaxed line-clamp-3">
                        {post.data.description}
                      </p>
                    )}
                  </div>
                </a>
              </article>
            ))
          }
        </div>

        <div
          id="blog-empty"
          class="text-center py-16"
          hidden={posts.length !== 0}
        >
          <Paragraph>No posts here yet.</Paragraph>
        </div>
      </div>
    </main>

    <Footer />

    <!-- Filter the grid by category without leaving the page. -->
    <script>
      const tabs =
        document.querySelectorAll<HTMLElement>(".blog-cat-tab");
      const articles =
        document.querySelectorAll<HTMLElement>("article[data-category]");
      const empty = document.getElementById("blog-empty");

      // SegmentedControl owns selection and keyboard; this owns the filtering.
      tabs[0]?.closest('[role="radiogroup"]')?.addEventListener(
        "segment-change",
        (event) => {
          const cat = (event as CustomEvent<{ id?: string }>).detail?.id;
          let visible = 0;
          articles.forEach((a) => {
            const show = cat === "All" || a.dataset.category === cat;
            a.hidden = !show;
            if (show) visible++;
          });
          if (empty) empty.hidden = visible !== 0;
        },
      );
    </script>
  </body>
</html>
