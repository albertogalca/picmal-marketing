---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CTASection from "../../components/CTASection.astro";
import "../../styles/global.css";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import Button from "../../components/Button.astro";
import Paragraph from "../../components/Paragraph.astro";

const SITE_TITLE =
  "Free Image Tools - Format Selection, Conversion Tips & More";
const SITE_DESCRIPTION =
  "Collection of free tools to help you work with images: format selector, conversion guides, and optimization tips.";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-background">
    <Header />

    <!-- Hero with gradient -->
    <main class="relative z-10 pt-32 pb-20">
      <div class="absolute inset-0 -z-10 overflow-hidden"></div>

      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-16">
          <H1 class="mb-4">Optimize your workflow</H1>
          <Paragraph class="max-w-2xl mx-auto">
            Simple, free tools to help you make better decisions about image
            formats and optimization.
          </Paragraph>
        </div>

        <!-- Tools Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
          <!-- Image Format Selector Tool -->
          <div
            class="bg-background-subtle border border-border rounded-lg p-6 hover:border-accent/30 transition-all duration-300"
          >
            <a
              href="/tools/image-format-selector"
              class="flex justify-between flex-col text-left h-full"
            >
              <header class="gap-2 flex flex-col mb-8">
                <H2 class="text-base md:text-xl mb-0">Image format selector</H2>
                <Paragraph>
                  Answer a few questions about your use case and get instant
                  recommendations for the best image format.
                </Paragraph>
              </header>
              <Button type="submit" text="Use it" />
            </a>
          </div>

          <!-- Compression Analyzer (Coming Soon) -->
          <div
            class="bg-background-subtle border border-border rounded-lg p-6 hover:border-accent/30 transition-all duration-300"
          >
            <div class="flex justify-between flex-col text-left h-full">
              <header class="gap-2 flex flex-col">
                <H2 class="text-base md:text-xl mb-0">
                  Compression analyzer
                </H2>
                <Paragraph class="mb-4">
                  Visualize how different compression levels affect your image
                  quality and file size.
                </Paragraph>
              </header>
              <Button
                disabled
                variant="secondary"
                type="submit"
                text="Use it"
              />
            </div>
          </div>

          <!-- Batch Processing Guide (Coming Soon) -->
          <div
            class="bg-background-subtle border border-border rounded-lg p-6 hover:border-accent/30 transition-all duration-300"
          >
            <div class="flex justify-between flex-col text-left h-full">
              <header class="gap-2 flex flex-col">
                <H2 class="text-base md:text-xl mb-0">
                  Batch processing guide
                </H2>
                <Paragraph class="mb-4">
                  Learn best practices for processing multiple images
                  efficiently.
                </Paragraph>
              </header>
              <Button
                disabled
                variant="secondary"
                type="submit"
                text="Use it"
              />
            </div>
          </div>

          <!-- Metadata Viewer (Coming Soon) -->
          <div
            class="bg-background-subtle border border-border rounded-lg p-6 hover:border-accent/30 transition-all duration-300"
          >
            <div class="flex justify-between flex-col text-left h-full">
              <header class="gap-2 flex flex-col">
                <H2 class="text-base md:text-xl mb-0"> Metadata viewer </H2>
                <Paragraph class="mb-4">
                  Check what metadata your images contain and learn how to
                  optimize it.
                </Paragraph>
              </header>
              <Button
                disabled
                variant="secondary"
                type="submit"
                text="Use it"
              />
            </div>
          </div>
        </div>

        <!-- CTA Section -->
        <div class="mt-16">
          <CTASection
            heading="Use Picmal to easily convert your media on your Mac"
            analyticsEvent="buy_clicked_tools_index"
          />
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
