---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import WebSiteSchema from "../components/schema/WebSiteSchema.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import FAQSchema, { faqs } from "../components/schema/FAQSchema.astro";
import Button from "../components/Button.astro";
import FAQ from "../components/FAQ.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import ReleaseBadge from "../components/ReleaseBadge.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import CompressFormatsModal from "../components/CompressFormatsModal.astro";
import PricingSection from "../components/PricingSection.astro";
import FounderLetter from "../components/FounderLetter.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import SectionHeading from "../components/SectionHeading.astro";

const SITE_DESCRIPTION =
  "Convert, compress, and edit your images, video, and audio right on your Mac, instead of trusting sketchy websites. Everything works offline, no subscription.";
---

<html lang="en">
  <head>
    <BaseHead
      title="Picmal is your Mac's media toolkit to convert, compress & edit"
      description={SITE_DESCRIPTION}
    />
    <OrganizationSchema url={Astro.site!.href} />
    <WebSiteSchema url={Astro.site!.href} />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <!-- Hero Section -->
    <main id="main-content" class="relative z-10 pt-32 pb-20">
      <div class="max-w-7xl mx-auto px-6 xl:px-0">
        <div class="max-w-3xl">
          <div class="hero-reveal" style="--d: 0ms">
            <ReleaseBadge class="mb-6" />
          </div>
          <div class="hero-reveal" style="--d: 80ms">
            <SectionHeading
              level={1}
              align="left"
              class="mb-8"
              headingClass="mb-6"
              subleadClass="max-w-xl"
            >
              Your Mac's media toolkit
              <Fragment slot="sublead">
                Convert, compress, and edit images, video, audio, and PDFs on
                your Mac, instead of trusting sketchy websites with them.
              </Fragment>
            </SectionHeading>
          </div>
          <div class="hero-reveal flex flex-col sm:flex-row gap-3" style="--d: 160ms">
            <Button
              text="Buy for Mac"
              href="/#pricing"
              target="_self"
              id="buy-cta-button"
              class="w-full sm:w-auto"
            />
            <Button
              text="Download"
              href="/download"
              variant="secondary"
              target="_self"
              icon="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 14.25 3.51 5.71 9.05 5.43c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 3.97l.01-.01zM12.03 5.38c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"
              iconType="fill"
              id="download-cta-button"
              class="w-full sm:w-auto"
            />
          </div>
        </div>

        <!-- Demo Video -->
        <div class="hero-reveal mt-12" style="--d: 240ms">
          <div
            class="rounded-xl overflow-hidden ring-1 ring-black/[0.08] dark:ring-white/10 shadow-[0_2px_4px_-1px_rgba(0,0,0,0.06),0_16px_32px_-8px_rgba(0,0,0,0.12)]"
          >
            <div class="aspect-video bg-background-subtle">
              <video
                id="hero-demo-video"
                class="w-full h-full object-cover"
                width="1280"
                height="720"
                src="/convert.mp4"
                poster="/convert-poster.webp"
                loop
                muted
                playsinline
                preload="metadata"
                aria-label="Picmal convert demo"
              >
              </video>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Testimonials -->
    <MasonryTestimonials
      heading="Tired of having to go online, upload your files, wait for the process to finish, then download them again?"
      showTrustBar={true}
      trustSuffix=" people (including me) too"
    />

    <!-- Features -->
    <FeatureGrid />

    <!-- Pricing -->
    <PricingSection />

    <!-- Founder letter -->
    <FounderLetter />

    <!-- FAQ Section -->
    <Section id="faq" width="narrow">
      <SectionHeading
        sublead="Something not covered here? Write to support@picmal.app"
      >
        Frequently Asked Questions
      </SectionHeading>
      <Card>
        <FAQ faqs={faqs} />
      </Card>
    </Section>

    <Footer />

    <!-- Modal rendered at page level to avoid z-index issues -->
    <SupportedFormatsModal />
    <CompressFormatsModal />

    <!-- One-time hero entrance: split into chunks, staggered ~80ms apart.
         Only opacity + transform (GPU-composited); disabled under reduced motion. -->
    <style>
      @media (prefers-reduced-motion: no-preference) {
        .hero-reveal {
          opacity: 0;
          animation: hero-reveal 0.6s cubic-bezier(0.2, 0, 0, 1) both;
          animation-delay: var(--d, 0ms);
        }
        @keyframes hero-reveal {
          from {
            opacity: 0;
            transform: translateY(12px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
      }
    </style>

    <!-- Hero demo: autoplay the loop unless the user prefers reduced motion
         (then the poster stays put). -->
    <script>
      const heroVideo = document.getElementById(
        "hero-demo-video",
      ) as HTMLVideoElement | null;
      if (
        heroVideo &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        heroVideo.play().catch(() => {});
      }
    </script>

    <!-- PostHog Analytics with keyboard accessibility -->
    <script>
      // Track buy button clicks (both mouse and keyboard)
      document
        .getElementById("buy-cta-button")
        ?.addEventListener("click", () => {
          if (typeof posthog !== "undefined") posthog.capture("buy_clicked");
        });

      // Track download button clicks
      document
        .getElementById("download-cta-button")
        ?.addEventListener("click", () => {
          if (typeof posthog !== "undefined")
            posthog.capture("download_clicked");
        });
    </script>
  </body>
</html>
