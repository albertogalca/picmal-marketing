---
import { getEntry, render } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import "../../styles/global.css";
import H1 from "../../components/H1.astro";
import Paragraph from "../../components/Paragraph.astro";

const changelog = await getEntry("blog", "changelog");
if (!changelog) {
  throw new Error("Changelog not found");
}
const { Content } = await render(changelog);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Changelog - ${SITE_TITLE} | Latest Updates & New Features`}
      description="Stay updated with the latest Picmal updates, new features, and improvements in our changelog."
    />
  </head>
  <body class="bg-white">
    <Header />
    <main class="relative z-10 px-6 pt-32 pb-16">
      <div class="max-w-3xl mx-auto">
        <!-- Blog Header -->
        <div class="mb-12">
          <H1 class="mb-4"> Changelog </H1>
          <Paragraph>
            Latest updates, new features, and improvements to Picmal.
          </Paragraph>
        </div>

        <!-- Changelog Content -->
        <div
          class="prose prose-lg max-w-none prose-headings:text-black prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl prose-h4:text-lg prose-a:text-[#1B5BFF] prose-a:no-underline hover:prose-a:underline prose-img:rounded-lg"
        >
          <Content />
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
