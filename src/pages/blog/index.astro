---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { getPublishedPosts, postCover } from "../../utils/posts";
import PostCard from "../../components/PostCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SegmentedControl from "../../components/SegmentedControl.astro";
import Paragraph from "../../components/Paragraph.astro";

const posts = (await getPublishedPosts()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Categories come from the posts themselves, so a new category needs no code
// change here. "All" is always first.
const categories = [
  "All",
  ...new Set(posts.map((p) => p.data.category).filter(Boolean)),
];
const segments = categories.map((c) => ({ id: c, label: c }));

const blogListSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Picmal Blog",
  description:
    "Guides on image conversion, batch processing, format optimization, and Mac productivity tips.",
  url: new URL("/blog", Astro.site).href,
  isPartOf: {
    "@type": "WebSite",
    name: "Picmal",
    url: Astro.site?.href,
  },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: posts.length,
    itemListElement: posts.map((post, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: new URL(`/blog/${post.id}`, Astro.site).href,
      name: post.data.title,
    })),
  },
};
---

<MarketingLayout
  title="Picmal: Blog"
  description="Guides on converting and compressing images, video, audio, and PDFs on your Mac, plus format tips, batch-processing workflows, and product updates."
  mainClass="relative z-10 pt-32 pb-20"
>
  <Fragment slot="head">
    <script
          type="application/ld+json"
          set:html={JSON.stringify(blogListSchema)}
        />
  </Fragment>

  <div class="max-w-7xl mx-auto px-6">
    <SectionHeading
      level={1}
      sublead="Updates, guides, and thoughts about building a media conversion app for Mac"
    >
      Picmal Blog
    </SectionHeading>

    <!-- Category filter (client-side, no page reloads) -->
    {
      segments.length > 1 && (
        <div class="mb-12">
          <SegmentedControl
            segments={segments}
            activeId="All"
            ariaLabel="Blog categories"
            mode="radio"
            segmentClass="blog-cat-tab"
          />
        </div>
      )
    }

    <!-- Blog Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        posts.map((post) => (
          <article class="h-full" data-category={post.data.category ?? ""}>
            <PostCard
              href={`/blog/${post.id}`}
              label={post.data.title}
              description={post.data.description}
              image={postCover(post)}
              category={post.data.category}
              date={post.data.pubDate}
              headingLevel={2}
            />
          </article>
        ))
      }
    </div>

    <div
      id="blog-empty"
      class="text-center py-16"
      hidden={posts.length !== 0}
    >
      <Paragraph>No posts here yet.</Paragraph>
    </div>
  </div>

  <Fragment slot="after">
    <!-- Filter the grid by category without leaving the page. -->
        <script>
          const tabs =
            document.querySelectorAll<HTMLElement>(".blog-cat-tab");
          const articles =
            document.querySelectorAll<HTMLElement>("article[data-category]");
          const empty = document.getElementById("blog-empty");

          // SegmentedControl owns selection and keyboard; this owns the filtering.
          tabs[0]?.closest('[role="radiogroup"]')?.addEventListener(
            "segment-change",
            (event) => {
              const cat = (event as CustomEvent<{ id?: string }>).detail?.id;
              let visible = 0;
              articles.forEach((a) => {
                const show = cat === "All" || a.dataset.category === cat;
                a.hidden = !show;
                if (show) visible++;
              });
              if (empty) empty.hidden = visible !== 0;
            },
          );
        </script>
  </Fragment>
</MarketingLayout>
