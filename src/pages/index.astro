---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WebSiteSchema from "../components/schema/WebSiteSchema.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import FAQSchema, { faqs } from "../components/schema/FAQSchema.astro";
import HeroCTA from "../components/HeroCTA.astro";
import FAQ from "../components/FAQ.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import ReleaseBadge from "../components/ReleaseBadge.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import CompressFormatsModal from "../components/CompressFormatsModal.astro";
import PricingSection from "../components/PricingSection.astro";
import FounderLetter from "../components/FounderLetter.astro";
import FeaturedReview from "../components/FeaturedReview.astro";
import CTASection from "../components/CTASection.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import SectionHeading from "../components/SectionHeading.astro";
import H3 from "../components/H3.astro";
import Paragraph from "../components/Paragraph.astro";
import { getCollection } from "astro:content";

// Hero demo reel: stacked clips, swapped by the thumbnail dock.
// `poster` is the clean opening frame, used only by the clip that loads first.
// `thumb` is a mid-clip frame chosen so the three dock tiles are told apart at
// 144px: a full file list, a before/after photo, a white PDF page. Frame 0 of
// every clip is the same idle drop zone, which made the tiles identical.
//
// `still` is that same idea applied to the poster, but only for people who
// never see the clip run. Frame 0 is an empty drop zone: correct for the
// autoplay path, since the video takes over in a few hundred ms and any other
// frame would pop, and useless for someone on prefers-reduced-motion, who sits
// on that empty window forever. The script swaps in `still` for exactly that
// case, so reduced motion gets the finished batch (files, sizes, Done) instead
// of an app doing nothing. Motion users never fetch these.
const demos = [
  {
    label: "Convert",
    src: "/convert.mp4",
    poster: "/convert-poster.webp",
    still: "/convert-still.webp",
    thumb: "/demo-thumb-convert.webp",
  },
  {
    label: "Compress",
    src: "/compress.mp4",
    poster: "/compress-poster.webp",
    still: "/compress-still.webp",
    thumb: "/demo-thumb-compress.webp",
  },
  {
    label: "PDF tools",
    src: "/pdf.mp4",
    poster: "/pdf-poster.webp",
    still: "/pdf-still.webp",
    thumb: "/demo-thumb-pdf.webp",
  },
];

// The guides that earn their own traffic, linked from the highest-authority
// page on the site. Before this block the home page passed 11 links to
// /alternative/* and 3 to /blog, which is backwards: the "N free methods"
// guides rank on page one while the programmatic pages sit in the 40s.
//
// An explicit slug list, not "the 6 newest": newest would surface the monthly
// newsletter posts, which are the wrong thing to hand a first-time visitor.
// Titles and descriptions still come from the collection, so editing a post
// never leaves a stale card behind. Swap the slugs as Search Console moves.
const FEATURED_GUIDES = [
  "reduce-image-file-size-mac",
  "how-to-convert-heic-to-jpg-mac",
  "how-to-compress-video-mac",
  "how-to-extract-audio-from-video-mac",
  "batch-convert-images-mac",
  "best-media-converter-mac-2026",
];

const allPosts = await getCollection("blog");
const guides = allPosts
  .filter((post) => FEATURED_GUIDES.includes(post.id))
  .sort(
    (a, b) => FEATURED_GUIDES.indexOf(a.id) - FEATURED_GUIDES.indexOf(b.id),
  );

const SITE_DESCRIPTION =
  "Convert, compress, and edit images, video, audio, and PDFs right on your Mac, instead of trusting sketchy websites. Works offline, no account, no subscription.";
---

<html lang="en">
  <head>
    <BaseHead
      title="Picmal: convert and compress media on your Mac, offline"
      description={SITE_DESCRIPTION}
    />
    <WebSiteSchema url={Astro.site!.href} />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <main id="main-content">
      {/* The hero used to be `<main class="relative z-10 pt-32 pb-20">` with a
          hand-rolled `max-w-7xl mx-auto px-6 xl:px-0` inside, which is exactly
          what `Section width="wide"` renders. Section calls itself the single
          source of truth for section rhythm, and the hero was the one block
          opting out, which is why its padding never matched the rest.
          `pt-32` for header clearance is the same override every other page
          uses. */}
      <Section width="wide" class="pt-32 sm:pt-32">
        <div class="max-w-3xl">
          <div class="hero-reveal" style="--d: 0ms">
            <ReleaseBadge class="mb-6" />
          </div>
          <div class="hero-reveal" style="--d: 80ms">
            <SectionHeading
              level={1}
              align="left"
              class="mb-8"
              headingClass="mb-6"
              subleadClass="max-w-xl"
            >
              {/* H1 under test. Live line is A3.

                  A3 moves the category INTO the H1. A2c had better rhythm, but
                  it named an interaction and an absence and never said what
                  the software is, which left the whole category load on the
                  sublead: the largest element on the page carried none of it.
                  Most arrivals here are cold, off a format query, and they
                  read one line before deciding.

                  With the category in the H1, the sublead is free to stop
                  repeating it. Its job now is proof, not definition: the media
                  types, and the batch/speed claim that beats a web uploader.
                  Do not let both lines name the category again.

                  A2a  Upload, wait, download, wait. Or drag, click, done.
                  A2b  Online: upload, wait, download, wait. Picmal: drag, click, done.
                  A2c  Drag, click, done. Nothing gets uploaded.
                  A2d  Done before a website finishes uploading.
                  A3   Convert and compress anything on your Mac. Nothing gets uploaded.

                  A2c is the one to revert to if A3 tests worse: it was picked
                  deliberately, not by default.

                  Earlier bets, if the upload angle is not the one: privacy,
                  breadth, pay-once, batch size, native-app craft.
              */}
              Convert and compress anything on your Mac. Nothing gets uploaded.
              <Fragment slot="sublead">
                Images, video, audio and PDFs. Batch hundreds at once, in the
                time a website would still be uploading.
              </Fragment>
            </SectionHeading>
          </div>
          <HeroCTA buyEvent="buy_clicked" pricingHref="#pricing" />
        </div>

        <!-- Demo reel: the video plus a dock of the other demos. The dock
             floats over the video from sm up, stacks under it on phones. -->
        <div class="hero-reveal mt-12 relative" style="--d: 240ms">
          <div
            class="rounded-xl overflow-hidden ring-1 ring-black/[0.08] dark:ring-white/10 shadow-[0_2px_4px_-1px_rgba(0,0,0,0.06),0_16px_32px_-8px_rgba(0,0,0,0.12)]"
          >
            <div class="relative aspect-video bg-background-subtle">
              {
                demos.map((demo, i) => (
                  <video
                    data-demo-video
                    data-demo-src={demo.src}
                    data-demo-still={demo.still}
                    data-active={i === 0 ? "" : undefined}
                    aria-hidden={i === 0 ? undefined : "true"}
                    class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 ease-out motion-reduce:transition-none data-[active]:opacity-100"
                    width="1280"
                    height="720"
                    src={i === 0 ? demo.src : undefined}
                    poster={demo.poster}
                    muted
                    playsinline
                    preload={i === 0 ? "auto" : "none"}
                    aria-label={`Picmal demo: ${demo.label}`}
                  />
                ))
              }
            </div>
          </div>

          <div
            class="mt-3 flex sm:absolute sm:inset-x-0 sm:bottom-4 sm:mt-0 sm:justify-center"
          >
            <!-- Concentric: 8px thumbnails + 8px padding = 16px on the dock. -->
            <div
              id="hero-demo-dock"
              role="group"
              aria-label="Picmal demos"
              class="flex gap-2 overflow-x-auto p-2 sm:overflow-visible sm:rounded-[16px] sm:bg-black/40 sm:shadow-[0_1px_2px_rgba(0,0,0,0.2),0_8px_24px_-6px_rgba(0,0,0,0.35)] sm:ring-1 sm:ring-white/15 sm:backdrop-blur-xl"
            >
              {
                demos.map((demo, i) => (
                  <button
                    type="button"
                    aria-pressed={i === 0}
                    data-demo-tab
                    class="relative shrink-0 overflow-hidden rounded-lg opacity-70 ring-1 ring-black/10 transition-[opacity,scale,box-shadow] duration-200 ease-out hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:scale-[0.97] motion-reduce:transition-none motion-reduce:active:scale-100 dark:ring-white/10 aria-pressed:opacity-100 aria-pressed:ring-2 aria-pressed:ring-accent"
                  >
                    <img
                      src={demo.thumb}
                      alt=""
                      width="288"
                      height="162"
                      class="aspect-video w-32 object-cover sm:w-36"
                    />
                    <span class="absolute inset-x-0 bottom-0 whitespace-nowrap bg-gradient-to-t from-black/75 to-transparent px-2 pb-1 pt-4 text-center text-caption font-[590] text-white">
                      {demo.label}
                    </span>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Featured review: the video shows what it does, this vouches that
             it's a real, reviewed app. Highest-authority outlet goes here. -->
        <div class="hero-reveal mt-16" style="--d: 320ms">
          <FeaturedReview publication="MacStories" />
        </div>
      </Section>

      <!-- Testimonials -->
      <MasonryTestimonials
        heading="Tired of uploading your files to a website, waiting, then downloading them again?"
        showTrustBar={true}
        trustSuffix=" Mac users too"
      />

      <!-- Features -->
      <FeatureGrid />

      <!-- Pricing -->
      <PricingSection />

      <!-- Second featured review, placed right after the price: this is where
           "is this a legit app?" gets asked, so an outside voice answers it.

           Padding is deliberately tighter than Section's py-16 sm:py-20. This
           is one centered quote between PricingSection and FounderLetter, both
           of which bring their own full rhythm, so the default left ~250px of
           empty page on each side and the section read as "the page ended".
           An interstitial gets interstitial spacing. -->
      <Section id="press" width="default" class="py-8 sm:py-10">
        <FeaturedReview publication="TheSweetBits" />
      </Section>

      <!-- Founder letter -->
      <FounderLetter />

      <Section id="guides" width="default">
        <SectionHeading class="mb-10">
          Free ways to convert and compress without Picmal
          <Fragment slot="sublead">
            The guides walk you through the free path on your Mac, and say where
            it stops being worth the effort. <a class="link" href="/blog"
              >See all of them</a
            >.
          </Fragment>
        </SectionHeading>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            guides.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="block h-full rounded-2xl border border-border bg-background-subtle/50 p-6 transition-[border-color,background-color,scale] duration-200 ease-out hover:border-accent/30 hover:bg-accent/[0.03] active:scale-[0.98] motion-reduce:transition-none motion-reduce:active:scale-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              >
                <H3 class="text-h4 mb-2">
                  {post.data.title}
                </H3>
                <Paragraph size="small" class="text-text-secondary">
                  {post.data.description}
                </Paragraph>
              </a>
            ))
          }
        </div>
      </Section>

      <Section id="faq" width="narrow">
        <SectionHeading>
          Questions
          <Fragment slot="sublead">
            Something not covered here? Write to <a
              class="link"
              href="mailto:support@picmal.app">support@picmal.app</a
            >
          </Fragment>
        </SectionHeading>
        <Card>
          <FAQ faqs={faqs} />
        </Card>
      </Section>

      <!-- The homepage was the one page with no closing ask: it went from the
           FAQ straight into the footer. A reader who opened every answer has
           already decided; give them the button instead of a sitemap. -->
      <CTASection
        heading="Stop uploading your files"
        analyticsEvent="buy_clicked_home_bottom"
      />
    </main>

    <Footer />

    <!-- Modals sit outside main on purpose: page-level overlays, not content. -->
    <SupportedFormatsModal />
    <CompressFormatsModal />

    <!-- Hero demo reel: the clips are stacked and crossfaded, so switching
         never flashes a poster. Only the first clip loads up front; the next is
         warmed once the current one is nearly over. Picking a tile hands control
         over: the reel stops advancing and loops that clip instead. Reduced
         motion: nothing autoplays and the dock stays a manual picker. -->
    <script>
      const heroClips = Array.from(
        document.querySelectorAll<HTMLVideoElement>("[data-demo-video]"),
      );
      const heroTabs = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-demo-tab]"),
      );
      const heroMotion = !window.matchMedia("(prefers-reduced-motion: reduce)")
        .matches;

      if (heroClips.length && heroClips.length === heroTabs.length) {
        let heroCurrent = 0;
        // The reel cycles on its own until someone picks a clip. After that it
        // stays on their choice and loops it, instead of moving on mid-watch.
        let heroAuto = true;

        const heroLoad = (clip: HTMLVideoElement) => {
          if (!clip.getAttribute("src")) {
            clip.src = clip.dataset.demoSrc!;
            clip.preload = "auto";
            clip.load();
          }
          return clip;
        };

        // readyState >= 2 means a frame is decoded, so the fade lands on video
        // rather than on the poster. Capped: a clip that stalls (slow link, a
        // codec the browser refuses) must not strand the dock showing a tile as
        // selected while the video never changes. On timeout the swap happens
        // anyway and lands on that clip's poster, which is why every clip keeps
        // one. The video appears underneath as soon as it can.
        const heroReady = (clip: HTMLVideoElement) =>
          clip.readyState >= 2
            ? Promise.resolve()
            : new Promise<void>((resolve) => {
                const done = () => {
                  window.clearTimeout(timer);
                  clip.removeEventListener("loadeddata", done);
                  resolve();
                };
                const timer = window.setTimeout(done, 1500);
                clip.addEventListener("loadeddata", done, { once: true });
              });

        const showDemo = async (index: number) => {
          if (index === heroCurrent) return;
          const previous = heroClips[heroCurrent];
          const next = heroLoad(heroClips[index]);
          heroCurrent = index;
          heroTabs.forEach((tab, i) =>
            tab.setAttribute("aria-pressed", String(i === index)),
          );

          await heroReady(next);
          if (heroCurrent !== index) return; // a later click won the race

          next.currentTime = 0;
          next.loop = !heroAuto;
          if (heroMotion) next.play().catch(() => {});
          next.setAttribute("data-active", "");
          next.removeAttribute("aria-hidden");
          previous.removeAttribute("data-active");
          previous.setAttribute("aria-hidden", "true");
          window.setTimeout(() => {
            if (heroClips[heroCurrent] !== previous) {
              previous.pause();
              previous.currentTime = 0;
            }
          }, 500);
        };

        heroTabs.forEach((tab, i) =>
          tab.addEventListener("click", () => {
            heroAuto = false;
            heroClips[heroCurrent].loop = false;
            if (i === heroCurrent) {
              heroClips[i].loop = true;
              return;
            }
            showDemo(i);
          }),
        );

        heroClips.forEach((clip, i) => {
          clip.addEventListener("ended", () => {
            if (heroAuto) showDemo((i + 1) % heroClips.length);
          });
          // Warm the next clip only once this one is nearly over. Warming at
          // page load pulled a second video (609KB) that most visitors, who
          // arrive from search for one specific job, never watch.
          clip.addEventListener("timeupdate", () => {
            if (!heroAuto || !clip.duration) return;
            if (clip.duration - clip.currentTime < 3) {
              heroLoad(heroClips[(i + 1) % heroClips.length]);
            }
          });
        });

        if (heroMotion) {
          heroClips[0].play().catch(() => {});
        } else {
          // Nothing autoplays under reduced motion and the dock becomes a
          // manual picker, so every clip stays on its poster. Show the frame
          // that has something in it.
          heroClips.forEach((clip) => {
            const still = clip.dataset.demoStill;
            if (still) clip.poster = still;
          });
        }
      }
    </script>
  </body>
</html>
