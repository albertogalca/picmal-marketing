---
import testimonials from "../data/testimonials.json";
import H2 from "./H2.astro";
import TestimonialCard from "./TestimonialCard.astro";

const userTestimonials = testimonials.filter((t) => t.type !== "press");

const reviewSchemas = userTestimonials.map((t) => ({
  "@type": "Review",
  author: { "@type": "Person", name: t.name },
  reviewBody: t.content,
  reviewRating: {
    "@type": "Rating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "1",
  },
}));

const aggregateRatingSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Picmal",
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.8",
    reviewCount: String(userTestimonials.length),
    bestRating: "5",
    worstRating: "1",
  },
  review: reviewSchemas,
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(aggregateRatingSchema)}
/>

<section id="testimonials" class="relative z-10 px-6 xl:px-0 py-20">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <div
        class="flex justify-center gap-1 mb-6"
        role="img"
        aria-label="Rated 5 out of 5 stars"
      >
        {
          [...Array(5)].map(() => (
            <svg
              class="w-6 h-6 text-amber-400"
              fill="currentColor"
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))
        }
      </div>
      <H2 class="mb-4">What people are <br /> saying about Picmal</H2>
    </div>

    <div class="masonry-grid">
      {
        testimonials.map((testimonial) => {
          const isPress = testimonial.type === "press";
          const hasLink = !!testimonial.link;
          // Person cards link the whole card; press cards link via their logo
          // inside TestimonialCard, so don't wrap them (avoids nested anchors).
          const wrapAsLink = hasLink && !isPress;
          const CardWrapper = wrapAsLink ? "a" : "div";

          return (
            <div class="masonry-item">
              <CardWrapper
                href={wrapAsLink ? testimonial.link : undefined}
                target={wrapAsLink ? "_blank" : undefined}
                rel={wrapAsLink ? "nofollow noreferrer" : undefined}
                class:list={[
                  "block",
                  wrapAsLink &&
                    "rounded-xl cursor-pointer hover:opacity-70 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50",
                ]}
              >
                <TestimonialCard testimonial={testimonial} align="left" />
              </CardWrapper>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .masonry-grid {
    columns: 1;
    column-gap: 3rem;
  }

  @media (min-width: 640px) {
    .masonry-grid {
      columns: 2;
    }
  }

  @media (min-width: 1024px) {
    .masonry-grid {
      columns: 3;
    }
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 3rem;
  }
</style>
