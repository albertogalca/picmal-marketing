---
import testimonials from "../data/testimonials.json";
import TestimonialCard from "./TestimonialCard.astro";

interface Props {
  /** Which press entry to feature, matched on `publication`. */
  publication: string;
  class?: string;
}
const { publication, class: className = "" } = Astro.props;

// Single source of truth: the press entries in testimonials.json. They are
// filtered out of the scrolling wall, so this is the only place they render.
// Cast: the JSON import infers a union where the press-only keys are absent
// from most members, so plain property access would not typecheck.
const review = (testimonials as Record<string, any>[]).find(
  (t) => t.type === "press" && t.publication === publication,
);
if (!review) throw new Error(`No press review for "${publication}"`);
---

<div class:list={["max-w-2xl mx-auto", className]}>
  <TestimonialCard testimonial={review} align="center" />
</div>
