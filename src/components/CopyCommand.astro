---
import { cn } from "../utils/cn";

export interface Props {
  /** The shell command. The `$` prompt is decorative and never copied. */
  command: string;
  /** Accessible name for the copy button, e.g. "Copy the Homebrew command". */
  label?: string;
  class?: string;
}

const {
  command,
  label = "Copy command to clipboard",
  class: className = "",
} = Astro.props;

const COPY_ICON =
  "M8 16H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2M10 8h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2Z";
const CHECK_ICON = "M5 13l4 4L19 7";

const ICON_CLASS =
  "col-start-1 row-start-1 h-4 w-4 transition-[opacity,scale] duration-200 ease-out motion-reduce:transition-none";
---

{/*
  Full width on a phone, shrink-to-fit from `sm` up. A command is one
  unbreakable token, so on a 320px screen the row has to be allowed to be as
  wide as the screen and scroll inside itself; sized to content it pushed 32px
  past the gutter and the whole page scrolled sideways.
*/}
<div
  class={cn(
    // `min-w-0` matters when this sits inside a flex row: a flex item's default
    // `min-width: auto` floors it at min-content, and the command is one
    // unbreakable token, so `w-full` alone still overflowed.
    "flex w-full min-w-0 items-center gap-3 rounded-lg border border-border bg-background-subtle py-1.5 pl-3 pr-1.5 text-left sm:w-auto",
    className,
  )}
  data-copy-command
>
  {/*
    global.css tints every inline <code> with its own pill and sizes it at
    0.875em. Here the row is already the surface, so the tint is a box inside a
    box, and the size is pinned to the site's 14px inline-code convention rather
    than inherited from whatever this sits in. Ligatures off: with them on,
    `--cask` reads as an em dash.
  */}
  <code
    data-copy-source-wrap
    class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap font-mono text-text
           !bg-transparent !p-0 !text-[0.875rem] [font-variant-ligatures:none]
           [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    <span class="select-none text-text-secondary" aria-hidden="true">$</span>
    <span data-copy-source>{command}</span>
  </code>

  {/* 32px box carried to a 44px hit area by the transparent `before:` bleed. */}
  <button
    type="button"
    aria-label={label}
    class="relative flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-lg text-text-secondary
           transition-[color,background-color,scale] duration-200 ease-out motion-reduce:transition-none
           hover:bg-black/[0.05] hover:text-text dark:hover:bg-white/[0.08]
           active:scale-[0.92] motion-reduce:active:scale-100
           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent
           before:absolute before:content-[''] before:-inset-[6px]"
  >
    {/* Both icons share one grid cell so the swap cross-fades in place. */}
    <span class="grid h-4 w-4 place-items-center">
      <svg
        class={ICON_CLASS}
        data-icon-copy
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d={COPY_ICON} />
      </svg>
      <svg
        class={cn(ICON_CLASS, "text-accent")}
        data-icon-done
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d={CHECK_ICON} />
      </svg>
    </span>
  </button>

  <span class="sr-only" role="status" data-copy-status></span>
</div>

<style>
  /* The confirmation is the one authored moment here: the clipboard glyph
     falls away as the check lands. Driven by an attribute rather than
     `hidden`, so both states are animatable. */
  [data-icon-done] {
    opacity: 0;
    scale: 0.7;
  }

  [data-copy-command][data-copied] [data-icon-copy] {
    opacity: 0;
    scale: 0.7;
  }

  [data-copy-command][data-copied] [data-icon-done] {
    opacity: 1;
    scale: 1;
  }

  /* Only when the command is actually wider than its box, which on the shipped
     breakpoints means phones under ~352px. A hard clip reads as a bug; the
     fade reads as "there is more, and the button already has it". */
  [data-copy-source-wrap][data-overflow] {
    -webkit-mask-image: linear-gradient(
      to right,
      #000 calc(100% - 28px),
      transparent
    );
    mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent);
  }
</style>

<script>
  // Astro hoists this once per page, so it wires every instance.
  document
    .querySelectorAll<HTMLElement>("[data-copy-command]")
    .forEach((root) => {
      const button = root.querySelector("button");
      const source = root.querySelector<HTMLElement>("[data-copy-source]");
      const status = root.querySelector<HTMLElement>("[data-copy-status]");
      const wrap = root.querySelector<HTMLElement>("[data-copy-source-wrap]");
      if (!button || !source || !status || !wrap) return;

      // The edge fade is only honest when the command really is cut off.
      const syncOverflow = () =>
        wrap.toggleAttribute("data-overflow", wrap.scrollWidth > wrap.clientWidth + 1);
      new ResizeObserver(syncOverflow).observe(wrap);
      syncOverflow();

      let timer: ReturnType<typeof setTimeout>;

      button.addEventListener("click", async () => {
        const text = source.textContent?.trim() ?? "";
        try {
          await navigator.clipboard.writeText(text);
          status.textContent = "Copied";
        } catch {
          // No clipboard permission or an insecure context: select the command
          // so the reader can still press Cmd+C.
          const range = document.createRange();
          range.selectNodeContents(source);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
          status.textContent = "Selected, press Command C to copy";
        }

        root.setAttribute("data-copied", "");
        clearTimeout(timer);
        timer = setTimeout(() => {
          root.removeAttribute("data-copied");
          status.textContent = "";
        }, 2000);
      });
    });
</script>
