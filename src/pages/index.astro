---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import VideoPlayer from "../components/VideoPlayer.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import FAQSchema from "../components/schema/FAQSchema.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import FeatureCard from "../components/FeatureCard.astro";
import { Image } from "astro:assets";
import Button from "../components/Button.astro";
import Testimonials from "../components/Testimonials.astro";
import Paragraph from "../components/Paragraph.astro";

const SITE_TITLE = "Picmal - Image converter & compressor for Mac";
const SITE_DESCRIPTION =
  "Picmal makes converting and compressing images a breeze. Convert or compress batches of images, entirely offline on your Mac—fast and private.";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <FAQSchema />
  </head>
  <body>
    <Header />

    <!-- Hero Section -->
    <main id="main-content" class="relative z-10 px-6 pt-32 pb-16">
      <div class="max-w-3xl mx-auto text-center">
        <H1 class="mb-6"> Image converter & compressor for Mac </H1>
        <Paragraph class="mb-6 max-w-xl mx-auto">
          Picmal makes converting and compressing images a breeze. Convert or
          compress batches of images, entirely offline on your Mac—fast and
          private.
        </Paragraph>

        <div class="flex flex-col items-center gap-4 mb-12">
          <Button text="Buy for Mac" />
          <Paragraph size="small">
            One-time purchase • 14-day money back guarantee
          </Paragraph>
        </div>

        <!-- Demo Video -->
        <div class="max-w-4xl mx-auto">
          <VideoPlayer src="/picmal-demo.mp4" />
        </div>
      </div>
    </main>

    <!-- Features Section -->
    <section
      id="features"
      class="relative z-10 px-6 py-20 bg-accent-background"
    >
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-24 text-center">Why choose Picmal?</H2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 text-left">
          <FeatureCard
            icon="M13 10V3L4 14h7v7l9-11h-7z"
            title="It's fast & local"
            description="Picmal works offline. You don't need an internet connection for anything. Everything happens on your laptop."
          />

          <FeatureCard
            icon="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
            title="It's all kept private"
            description=" Everything's handled from the analytics tool I use to how your pictures are stored — I don't upload any of your private data anywhere."
          />

          <FeatureCard
            icon="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 16c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6zm0-10c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4z"
            title="It's meant to be straightforward"
            description="If I add anything else, it'll be for a good reason. There's no need for unnecessary AI or random features. It's just a basic UI that works well and looks like an app designed by Apple."
          />

          <FeatureCard
            icon="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h2v-6h-2v6zm0-8h2V7h-2v2z"
            title="It's designed to save you time"
            description="There are a lot of options out there for converting and compressing images, but Picmal looks for the best approach to make your work easier and save you time."
          />
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section id="testimonials" class="relative z-10 px-6 py-20 bg-white">
      <div class="max-w-5xl mx-auto">
        <H2 class="mb-10 text-center">What users are saying</H2>

        <Testimonials />

        <div class="mt-12 text-center space-y-4">
          <Paragraph class="font-bold text-black">
            Are you happy with Picmal?
          </Paragraph>
          <Button
            href="https://albertogalca.gumroad.com/l/picmal"
            text="Leave a review"
            variant="secondary"
            size="small"
            class="block max-w-[200px] mx-auto"
          />
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="relative z-10 px-6 py-20 bg-accent-background">
      <div class="max-w-xl mx-auto">
        <div class="relative">
          <!-- Background layer -->
          <div
            class="absolute inset-0 transform rotate-1 trangray-x-2 trangray-y-2 rounded-2xl bg-gray-100 border-gray-300/30 border"
          >
          </div>

          <!-- Main letter -->
          <div
            class="relative transform -rotate-1 bg-white border-gray-200 border rounded-2xl p-8 shadow-lg"
          >
            <div class="text-lg leading-relaxed text-black">
              <Paragraph class="mb-6 text-lg">Hey there!</Paragraph>

              <Paragraph class="mb-6 text-lg">
                I'm{" "}
                <a
                  href="https://albertogalca.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline underline-offset-4 hover:text-black transition-colors duration-200"
                >
                  Alberto</a
                >
                , the developer behind Picmal.
              </Paragraph>

              <Paragraph class="mb-6 text-lg">
                I built this app because I was frustrated with the options that
                were already out there. Online converters were a pain because
                you had to upload private images, and the local tools I tried
                were either too complicated or required using the terminal.
              </Paragraph>

              <Paragraph class="mb-6 text-lg">
                Picmal is my go-to: a native Mac app that's fast, fully private,
                and can handle multiple images at once. Simple, reliable, and
                designed with care.
              </Paragraph>

              <Paragraph class="mb-8 text-lg">
                If you have any questions or suggestions for improvement, I'd be
                happy to hear them.
              </Paragraph>

              <div class="flex items-center gap-2">
                <Image
                  src="/alberto.webp"
                  alt="Alberto, creator of Picmal"
                  width={64}
                  height={64}
                  class="w-14 h-14 object-cover rounded-full"
                />
                <div>
                  <Paragraph class="font-semibold text-black">Alberto</Paragraph
                  >
                  <Paragraph> Creator of Picmal </Paragraph>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-20 bg-white">
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-10"> Frequently asked questions </H2>
        <FAQ />
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="relative z-10 px-6 py-16 bg-accent-background">
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-10">A few words about pricing…</H2>
        <div class="space-y-6">
          <div class="space-y-4 mb-8">
            <Paragraph>
              Picmal is a one-time purchase. There are no monthly or yearly
              fees. You only pay for it once, and you own it forever, including
              all future updates.
            </Paragraph>

            <Paragraph>
              As more people buy the app and provide feedback, I will implement
              these changes to improve the app. I will keep increasing <strong
                >the price until it reaches $16</strong
              >, which I think is a fair price for this kind of app.
            </Paragraph>

            <Paragraph>
              I think this pricing model is fair because it lets me keep
              improving the app based on what users tell me, while also making
              sure that people who use the app early get the best deal.
            </Paragraph>
          </div>

          <!-- Pricing Table -->
          <div class="bg-white rounded-lg p-6 border border-gray-200 relative">
            <div
              class="flex justify-between items-center pb-4 border-b border-gray-200 mb-4"
            >
              <h3 class="text-base font-semibold text-black">Customers</h3>
              <h3 class="text-base font-semibold text-black">Price</h3>
            </div>

            <div class="space-y-3">
              <div
                class="flex justify-between items-center py-3 px-4 bg-white border border-gray-100 rounded-lg"
              >
                <span class="text-base text-black font-medium">1–10</span>
                <span class="text-base text-black font-medium">$5.99</span>
              </div>

              <div
                class="flex justify-between items-center py-3 px-4 bg-white border border-gray-100 rounded-lg"
              >
                <span class="text-base text-black font-medium">11–20</span>
                <span class="text-base text-black font-medium">$7.99</span>
              </div>

              <div
                class="flex justify-between items-center py-3 px-4 bg-[#edf5ff] border border-[#b9d8ff] rounded-lg"
              >
                <span class="text-base text-black font-medium">21–30</span>
                <span class="text-base text-black font-medium"
                  >$9.99 (current)</span
                >
              </div>

              <div
                class="flex justify-between items-center py-3 px-4 bg-white border border-gray-100 rounded-lg"
              >
                <span class="text-base text-black font-medium">31–40</span>
                <span class="text-base text-black font-medium">$11.99</span>
              </div>

              <div
                class="flex justify-between items-center py-3 px-4 bg-white border border-gray-100 rounded-lg"
              >
                <span class="text-base text-black font-medium">41–50</span>
                <span class="text-base text-black font-medium">$13.99</span>
              </div>

              <div
                class="flex justify-between items-center py-3 px-4 bg-white border border-gray-100 rounded-lg"
              >
                <span class="text-base text-black font-medium">51+</span>
                <span class="text-base text-black font-medium"
                  >$15.99 (final price)</span
                >
              </div>
            </div>

            <div class="flex justify-end mt-8">
              <Button text="Buy for Mac" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>
