---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import ArticleSchema from "../components/schema/ArticleSchema.astro";
import PicmalCTA from "../components/PicmalCTA.astro";
import H1 from "../components/H1.astro";

type Props = CollectionEntry<"blog">["data"] & {
  category?: string;
  slug?: string;
};

const { title, description, pubDate, updatedDate, heroImage, category, slug } =
  Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
    {
      slug && (
        <ArticleSchema
          post={{
            title,
            description,
            pubDate,
            updatedDate,
            heroImage,
            category,
          }}
          url={Astro.site!.href}
          slug={slug}
        />
      )
    }
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text"
  >
    <Header />

    <!-- Back to Blog Link -->
    <div class="relative z-10 px-6 pt-32 pb-12">
      <div class="max-w-4xl mx-auto">
        <a
          href="/blog"
          class="inline-flex items-center transition-colors cursor-pointer text-text hover:text-text"
        >
          ← Back to blog
        </a>
      </div>
    </div>

    <!-- Article -->
    <article class="relative z-10 px-6 pb-20">
      <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <header class="mb-8">
          {
            heroImage && (
              <div class="mb-6">
                <Image
                  src={heroImage}
                  alt={`Hero image for the article ${title}`}
                  width={800}
                  height={400}
                  class="w-full h-auto rounded-lg"
                />
              </div>
            )
          }
          <div class="flex items-center gap-3 mb-8 text-base font-semibold">
            {
              category && (
                <>
                  <span class="text-text-secondary">{category}</span>
                  <span class="text-text font-semibold">•</span>
                </>
              )
            }
            <time
              datetime={pubDate.toISOString()}
              class="text-text font-semibold"
            >
              <FormattedDate date={pubDate} />
            </time>
            {
              updatedDate && (
                <>
                  <span class="text-text-secondary">•</span>
                  <span class="text-text-secondary italic">
                    Updated <FormattedDate date={updatedDate} />
                  </span>
                </>
              )
            }
          </div>

          <H1 id="article-title" class="mb-4">
            {title}
          </H1>
        </header>

        <!-- Content -->
        <div
          class="prose md:prose-lg max-w-none
              prose-headings:text-text prose-headings:font-semibold
              prose-p:text-text/65 prose-p:leading-relaxed
              prose-a:text-text/65 hover:prose-a:text-text prose-a:underline prose-a:underline-offset-4 prose-a:transition-colors prose-a:duration-200
              prose-strong:text-text
              prose-code:text-accent prose-code:bg-gray-100
              prose-pre:bg-black
              prose-blockquote:border-l-accent prose-blockquote:text-text-secondary prose-blockquote:bg-background-subtle
              prose-th:text-text
              prose-td:text-text/65
              prose-ul:text-text/65
              prose-ol:text-text/65
              prose-li:text-text/65
              prose-img:rounded-lg"
          role="main"
          aria-labelledby="article-title"
        >
          <slot />
        </div>

        <!-- Download CTA -->
        <div class="mt-12 pt-8">
          <PicmalCTA />
        </div>
      </div>
    </article>

    <Footer />
  </body>
</html>
