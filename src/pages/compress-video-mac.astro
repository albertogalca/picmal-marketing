---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import PricingSection from "../components/PricingSection.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import ComparisonHero from "../components/ComparisonHero.astro";
import CardGrid from "../components/CardGrid.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import SectionHeading from "../components/SectionHeading.astro";

const title =
  "Picmal: Compress video on Mac, reduce file size without losing quality";
const description =
  "Compress MP4, MOV, MKV and more on your Mac. H.264/H.265 with a quality slider, target a size for email, batch process. Offline, no watermark, no upload limit. $15.99 one-time.";

const faqs = [
  {
    question: "How do I compress a video on my Mac?",
    answer:
      "Open Picmal, drag your video in (or a whole folder), pick a quality level and codec, and click Compress. A live size estimate shows how small it will be before you export, and everything runs on your Mac with no upload.",
  },
  {
    question: "How much can Picmal shrink a video?",
    answer:
      "It depends on the source and your settings, but 50–80% is common. Switching to H.265 (HEVC) alone cuts size roughly in half versus H.264 at the same quality, and lowering the CRF, resolution, or frame rate shrinks it further.",
  },
  {
    question: "Does compressing a video lose quality?",
    answer:
      "Only as much as you choose. Picmal uses a CRF quality slider. At CRF 18–20 the result is visually lossless. Picmal also shows an estimated output size before you encode, so you can dial in the size/quality trade-off without guessing.",
  },
  {
    question: "Can I compress a video to send by email?",
    answer:
      "Yes. Most email providers cap attachments around 25 MB. Lower the CRF, drop the resolution, or reduce the frame rate and watch the live size estimate until your clip fits, then export.",
  },
  {
    question: "Which video formats can Picmal compress?",
    answer:
      "MP4, MOV, MKV, AVI, WebM, M4V, MPG, HEVC, FLV, WMV, 3GP, M2TS/MTS, VOB, TS and more. You can keep the same container or switch it while compressing.",
  },
  {
    question: "Can I batch compress multiple videos?",
    answer:
      "Yes. Drop multiple videos or a whole folder into Picmal and compress them all with the same settings in one pass.",
  },
  {
    question: "Is there an upload, watermark, or size limit?",
    answer:
      "No. Picmal compresses entirely on your Mac. No uploads, no queues, no watermark, and no file-size cap. It's a one-time $15.99, not a subscription.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <ComparisonHero
      title="Compress video on your Mac without losing quality"
      subhead="Shrink MP4, MOV, MKV and more with a quality slider and a live size estimate. Make a clip small enough to email, or batch-compress a whole folder. Offline, no watermark, no upload limit."
      buyEvent="buy_clicked_compress_video_mac"
      defaultTab="compress"
    />

    <!-- How It Works -->
    <CardGrid
      heading="How to compress a video on your Mac"
      numbered
      items={[
        {
          title: "Drop your video",
          description: "Drag in one clip or a whole folder of videos.",
        },
        {
          title: "Set quality & codec",
          description:
            "Pick a CRF level and codec (H.264/H.265). Watch the size estimate update live.",
        },
        {
          title: "Compress",
          description: "Click Compress. Everything runs on your Mac.",
        },
      ]}
    />

    <!-- Controls -->
    <CardGrid
      heading="Real control over the trade-off"
      items={[
        {
          title: "CRF quality slider",
          description:
            "0–51 scale. CRF 18–20 is visually lossless; push higher for smaller files when you need them.",
        },
        {
          title: "Modern codecs",
          description:
            "H.264 for compatibility, H.265/HEVC for ~50% smaller files, VP9 and AV1 for the web.",
        },
        {
          title: "Frame-rate reduction",
          description:
            "Drop 60 fps to 30 fps to shrink screen recordings and tutorials that don't need cinematic motion.",
        },
        {
          title: "Size estimate first",
          description:
            "See the projected output size before you encode, perfect for hitting an email or upload limit.",
        },
      ]}
      linkText="Need to convert video formats too? See the video converter"
      linkHref="/video-converter-mac"
    />

    <!-- Why compress -->
    <CardGrid
      heading="When you actually need this"
      intro={"Modern phones and cameras produce enormous files. A two-minute 4K clip can be over 1 GB. Most of the time you just need it small enough to send or store."}
      items={[
        {
          title: "It won't fit in an email",
          description:
            "Gmail and most providers cap attachments around 25 MB. Drop the CRF and resolution until the live size estimate fits, then send.",
        },
        {
          title: "Upload limits and slow uploads",
          description:
            "Discord, Slack, and form uploads reject big files or crawl. A smaller H.265 file uploads in a fraction of the time.",
        },
        {
          title: "Screen recordings",
          description:
            "Tutorials and demos don't need 60 fps or full resolution. Halving both can shrink a recording by 80% with no real loss.",
        },
        {
          title: "Reclaiming disk space",
          description:
            "Old vacation clips eating your SSD? Re-encode to H.265 and cut the file size roughly in half.",
        },
      ]}
    />

    <!-- Related -->
    <Section width="narrow" class="text-center">
      <SectionHeading class="mb-6">Related tools</SectionHeading>
      <div class="flex flex-col gap-3">
        <a href="/video-converter-mac" class="text-accent hover:underline"
          >Convert video formats (MOV to MP4, and more) &rarr;</a
        >
        <a href="/compress" class="text-accent hover:underline"
          >Compress images on Mac &rarr;</a
        >
        <a href="/compress-audio-mac" class="text-accent hover:underline"
          >Compress audio on Mac &rarr;</a
        >
        <a href="/compress" class="text-accent hover:underline"
          >All compression options &rarr;</a
        >
      </div>
    </Section>

    <MasonryTestimonials />

    <PricingSection />

    <Section id="faq" width="narrow">
      <SectionHeading
        sublead="Something not covered here? Write to support@picmal.app"
      >
        Frequently Asked Questions
      </SectionHeading>
      <Card>
        <FAQ faqs={faqs} />
      </Card>
    </Section>

    <Footer />
    <SupportedFormatsModal />
  </body>
</html>
