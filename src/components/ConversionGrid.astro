---
import { cn } from "../utils/cn";
import SectionLink from "./SectionLink.astro";

/**
 * ConversionGrid, the one canonical grid of "simple pill" link cards used for
 * every related-conversions / format-link block across the SEO pages. Callers
 * map their own data (image/audio/video/compression) to `{ href, label }` and
 * optionally a `sublabel` (e.g. the camera brand on RAW pages).
 */
interface LinkItem {
  href: string;
  label: string;
  sublabel?: string;
}

interface Props {
  links: LinkItem[];
  columns?: 3 | 4;
  /** Optional trailing accent link (arrow appended automatically). */
  linkText?: string;
  linkHref?: string;
  /** Alignment of that trailing link. */
  linkAlign?: "center" | "left";
  class?: string;
}

const {
  links,
  columns = 3,
  linkText,
  linkHref,
  linkAlign = "center",
  class: className,
} = Astro.props;

const cols =
  columns === 4
    ? "grid-cols-2 sm:grid-cols-3 md:grid-cols-4"
    : "grid-cols-2 sm:grid-cols-3";
---

{/* Redesign: a list of plain links reads as chips; links with a second line
    keep the card grid. */}
{links.every((l) => !l.sublabel) ? (
  <div class={cn("flex flex-wrap gap-2", className)}>
    {links.map((l) => (
      <a
        href={l.href}
        class="inline-flex h-8 items-center rounded-full bg-control px-3.5 text-[13px] font-medium text-text transition-[background-color,scale] duration-150 hover:bg-control-hover active:scale-[0.97] motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {l.label}
      </a>
    ))}
  </div>
) : (
  <div class={cn("grid gap-3", cols, className)}>
    {links.map((l) => (
      <a
        href={l.href}
        class="bg-surface border border-border rounded-xl p-4 transition-[border-color,scale] duration-200 ease-out hover:border-text-quiet active:scale-[0.97] motion-reduce:transition-none motion-reduce:active:scale-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <span class="block text-small font-medium text-text">{l.label}</span>
        {l.sublabel && (
          <span class="block text-small text-text-secondary mt-1">{l.sublabel}</span>
        )}
      </a>
    ))}
  </div>
)}
{linkText && linkHref && <SectionLink text={linkText} href={linkHref} align={linkAlign} />}
