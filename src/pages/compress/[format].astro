---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import Paragraph from "../../components/Paragraph.astro";
import Button from "../../components/Button.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import CTASection from "../../components/CTASection.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import TrustBar from "../../components/TrustBar.astro";
import { compressions } from "../../data/compressions";
import { conversions, formats } from "../../data/conversions";

export function getStaticPaths() {
  return compressions.map((c) => ({
    params: { format: c.slug },
    props: { compression: c },
  }));
}

const { compression } = Astro.props;

const title = `Compress ${compression.name} Files on Mac — Free with Picmal`;
const description = `Reduce ${compression.name.toLowerCase()} file size on your Mac without losing quality. Batch compression for multiple files. Free download.`;

const relatedConversions = conversions
  .filter((c) => c.from === compression.format)
  .slice(0, 4);

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: `How to Compress ${compression.name} Files on Mac`,
  description: description,
  step: [
    { "@type": "HowToStep", name: "Open Picmal", text: "Download and open Picmal on your Mac." },
    { "@type": "HowToStep", name: "Add your files", text: `Drag and drop your ${compression.name} files into Picmal.` },
    { "@type": "HowToStep", name: "Compress", text: "Adjust the quality slider and click Compress to reduce file sizes." },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: compression.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden">
    <div class="fixed inset-0 -z-20 apple-gradient"></div>

    <Header />

    <main id="main-content" class="relative z-10 pt-32 pb-16 sm:pb-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <Breadcrumb
          items={[
            { label: "Home", href: "/" },
            { label: "Compress", href: "/compress" },
            { label: compression.name },
          ]}
        />

        <!-- Hero -->
        <div class="text-center mb-16 sm:mb-20">
          <div class="flex items-center justify-center gap-3 mb-8">
            <span class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-background-subtle border border-border text-sm font-mono font-medium text-text tracking-wide">
              .{compression.format}
            </span>
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
            <span class="inline-flex items-center justify-center px-3 py-2 rounded-lg bg-accent/10 border border-accent/20 text-xs font-medium text-accent tracking-wide">
              Smaller
            </span>
          </div>

          <H1 class="mb-6">Compress {compression.name} Files on Mac</H1>
          <Paragraph class="max-w-2xl mx-auto mb-8">
            {compression.whyCompress}
          </Paragraph>
          <div class="flex flex-col sm:flex-row gap-3 items-center justify-center mb-6">
            <Button
              text="Get Picmal for $15.99"
              onclick={`posthog.capture('buy_clicked_compress_${compression.slug}')`}
              class="apple-button-primary"
            />
            <a
              href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg"
              class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-base py-3 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto"
            >
              Download for Mac
            </a>
          </div>
          <TrustBar />
        </div>

        <!-- Benefits -->
        <section class="mb-16 sm:mb-20">
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8">
            <H2 class="mb-6">Why compress {compression.name} files?</H2>
            <ul class="space-y-4">
              {compression.benefits.map((benefit) => (
                <li class="flex gap-3 items-start">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-text">{benefit}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <!-- How To Steps -->
        <section class="mb-16 sm:mb-20">
          <H2 class="mb-8 text-center">How to compress {compression.name} files on Mac</H2>
          <div class="grid md:grid-cols-3 gap-4 relative">
            <div class="hidden md:block absolute top-[2.25rem] left-[calc(33.33%-0.5rem)] right-[calc(33.33%-0.5rem)] h-px bg-border z-0"></div>

            <div class="bg-background-subtle/50 border border-border rounded-xl p-6 text-center relative z-10">
              <div class="w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center mx-auto mb-4 font-semibold text-sm">1</div>
              <h3 class="font-semibold text-text mb-2">Open Picmal</h3>
              <Paragraph>Download and open Picmal on your Mac.</Paragraph>
            </div>
            <div class="bg-background-subtle/50 border border-border rounded-xl p-6 text-center relative z-10">
              <div class="w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center mx-auto mb-4 font-semibold text-sm">2</div>
              <h3 class="font-semibold text-text mb-2">Add your {compression.name} files</h3>
              <Paragraph>Drag and drop your {compression.name} files or entire folders into Picmal.</Paragraph>
            </div>
            <div class="bg-background-subtle/50 border border-border rounded-xl p-6 text-center relative z-10">
              <div class="w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center mx-auto mb-4 font-semibold text-sm">3</div>
              <h3 class="font-semibold text-text mb-2">Adjust quality and compress</h3>
              <Paragraph>Set your preferred quality level and click Compress to reduce file sizes.</Paragraph>
            </div>
          </div>
        </section>

        <!-- FAQ -->
        <section class="mb-16 sm:mb-20">
          <H2 class="mb-8 text-center">Frequently Asked Questions</H2>
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8">
            <FAQ faqs={compression.faqs} />
          </div>
        </section>

        <!-- Related Conversions -->
        {relatedConversions.length > 0 && (
          <section class="mb-16 sm:mb-20">
            <H2 class="mb-8 text-center">Convert {compression.name} to Other Formats</H2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
              {relatedConversions.map((c) => (
                <a
                  href={`/convert/${c.slug}`}
                  class="group bg-background-subtle/50 border border-border rounded-lg p-4 text-center transition-all duration-200 hover:border-accent/30 hover:bg-accent/[0.03]"
                >
                  <div class="flex items-center justify-center gap-2 mb-1">
                    <span class="text-xs font-mono text-text-secondary">.{formats[c.from].extension}</span>
                    <svg class="w-3 h-3 text-text-secondary/50 group-hover:text-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                    <span class="text-xs font-mono text-text-secondary">.{formats[c.to].extension}</span>
                  </div>
                  <span class="text-sm font-medium text-text">
                    {formats[c.from].name} to {formats[c.to].name}
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}

        <CTASection
          heading={`Compress ${compression.name} files with Picmal`}
          analyticsEvent={`buy_clicked_compress_${compression.slug}_bottom`}
        />
      </div>
    </main>

    <Footer />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "picmal" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
