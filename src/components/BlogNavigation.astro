---
import SegmentedControl from "./SegmentedControl.astro";

interface Props {
  currentCategory?: "All" | "Guide" | "Tutorial";
}

const { currentCategory = "All" } = Astro.props;

const segments = [
  { id: "All", label: "All", href: "/blog" },
  { id: "Guide", label: "Guide", href: "/blog/guide" },
  { id: "Tutorial", label: "Tutorial", href: "/blog/tutorial" },
];
---

<SegmentedControl
  segments={segments}
  activeId={currentCategory}
  ariaLabel="Blog categories"
  mode="links"
/>
