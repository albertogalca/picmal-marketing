---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import PricingSection from "../../components/PricingSection.astro";
import FounderLetter from "../../components/FounderLetter.astro";
import Section from "../../components/Section.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import AlternativeVerdict from "../../components/AlternativeVerdict.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";
import FAQSection from "../../components/FAQSection.astro";

const SITE_DESCRIPTION =
  "Looking for a TinyPNG alternative? Picmal compresses images on your Mac with no 5MB limit, no 20 image batches, and no uploads. Video, audio, and PDFs too. $29 once.";

const faqs = [
  {
    question: "Is Picmal a good TinyPNG alternative?",
    answer:
      "If you compress images regularly, yes. Picmal does the same job on your Mac with no per-file size cap, no 20 image batch limit, and nothing uploaded. TinyPNG is excellent and free for occasional use, so if you compress a few images a month there's no reason to switch.",
  },
  {
    question: "What are TinyPNG's free limits?",
    answer:
      "20 images at a time, 5MB each. Format conversion is limited to 3 free images, while compression itself is unlimited in batches of 20. Files are uploaded to their servers and deleted within 48 hours. Picmal has no caps because nothing leaves your Mac.",
  },
  {
    question: "Does Picmal compress as well as TinyPNG?",
    answer:
      "For normal web use the results are close enough that you won't see a difference at the same file size. TinyPNG has spent years tuning its lossy PNG quantisation and is genuinely very good at that one job. Picmal compresses JPG, PNG, WebP, HEIC, AVIF and more, plus video, audio, and PDFs.",
  },
  {
    question: "Can I compress images larger than 5MB?",
    answer:
      "In Picmal, yes, there's no size limit. That's usually the reason people look for a TinyPNG alternative, since camera photos and screenshots on a retina display go past 5MB easily.",
  },
  {
    question: "Does TinyPNG upload my images?",
    answer:
      "Yes. It's a web service, so images are uploaded, compressed on their servers, and downloaded back. They state files are deleted within 48 hours. Picmal never sends an image anywhere and works with no internet connection at all.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Email support@picmal.app.",
  },
];
---

<MarketingLayout
  title="Picmal: The TinyPNG alternative with no upload and no 5MB limit"
  description={SITE_DESCRIPTION}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
        <FAQSchema />
  </Fragment>

  <ComparisonHero
    title="The TinyPNG alternative with no upload and no 5MB limit"
    subhead="TinyPNG is great until you hit 20 images at a time, 5MB each, all going to someone else's server. Picmal compresses images, video, audio, and PDFs on your Mac, in batches of hundreds, for $29 once."
    buyEvent="buy_clicked_tinypng_comparison"
  />

  <ComparisonVerdict
    competitor="TinyPNG"
    summary="TinyPNG is very good at one thing: squeezing PNG and JPEG for the web, free, in your browser. The limits are 20 images at a time, 5MB each, and every file gets uploaded. Picmal ($29, pay once) compresses the same formats on your Mac with no caps, and also converts formats and handles video, audio, and PDFs."
    picmalFor="You compress images often, your files go past 5MB, or you'd rather not upload client photos to a web service to make them smaller."
    competitorFor="You compress a handful of small web images now and then. It's free and it works, so keep using it."
  />

  <!-- Comparison Table -->
  <Section width="default">
    <SectionHeading>
      Picmal vs TinyPNG at a glance
      <Fragment slot="sublead">
        TinyPNG is a free web compressor for images. Picmal is a Mac app that
        converts and compresses images, video, audio, and PDFs without
        uploading anything.
      </Fragment>
    </SectionHeading>
    <ComparisonTable
      competitor="TinyPNG"
      rows={[
      {
        feature: "Price",
        picmal: "$29 one-time",
        competitor: "Free tier, then subscription",
      },
      {
        feature: "Where files are processed",
        picmal: "On your Mac",
        competitor: "Uploaded to their servers",
      },
      {
        feature: "Works offline",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "File size limit",
        picmal: "None",
        competitor: "5MB per image (free)",
      },
      {
        feature: "Batch size",
        picmal: "Hundreds at once",
        competitor: "20 at a time (free)",
      },
      {
        feature: "Image compression",
        picmal: "Yes",
        competitor: "Yes, its speciality",
      },
      {
        feature: "Image conversion",
        picmal: "Yes, unlimited",
        competitor: "3 free images",
      },
      {
        feature: "Video",
        picmal: "Convert &amp; compress",
        competitor: "No",
      },
      {
        feature: "Audio",
        picmal: "Convert &amp; compress",
        competitor: "No",
      },
      {
        feature: "PDF",
        picmal: "Compress, merge, split, images to PDF",
        competitor: "No",
      },
      {
        feature: "Resize",
        picmal: "Yes",
        competitor: "Yes, on paid plans",
      },
      {
        feature: "Folder monitoring",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "Shortcuts integration",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "Finder right-click",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "Platform",
        picmal: "macOS 15+",
        competitor: "Any browser",
      },
    ]}
    />
  </Section>

  <!-- Who each is for -->
  <AlternativeVerdict
    sublead="Here's where each one makes more sense."
    picmal={{
      heading: "Choose Picmal",
      lead: "You're compressing constantly, or your files are big",
      items: [
        "Your images are over 5MB, which most camera photos are",
        "You're tired of uploading 20 at a time and repeating",
        "The images are client work, and uploading them isn't your call",
        "You also need to convert formats, or shrink video and PDFs",
      ],
    }}
    rival={{
      heading: "Stay with TinyPNG",
      lead: "Occasional web images, and free is hard to beat",
      items: [
        "You compress a few small web images a month",
        "You want the absolute smallest PNG and nothing else matters",
        "You're not on a Mac, or you need it from any browser",
        "You're using their API inside a build pipeline",
      ],
    }}
  />

  <FeatureGrid
    heading="Everything else Picmal does"
    subleadIntro="One app for images, video, audio, and PDFs. Convert, compress, and edit, all on your Mac."
  />

  <MasonryTestimonials />

  <PricingSection />

  <FounderLetter />

  <FAQSection
    faqs={faqs}
    heading="Frequently asked questions"
    sublead="Can't find what you're looking for? Email support@picmal.app"
  />

  <Fragment slot="after">
    <SupportedFormatsModal />
  </Fragment>
</MarketingLayout>
