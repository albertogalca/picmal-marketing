---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import OrganizationSchema from "../../components/schema/OrganizationSchema.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import PricingSection from "../../components/PricingSection.astro";
import FounderLetter from "../../components/FounderLetter.astro";
import Section from "../../components/Section.astro";
import Card from "../../components/Card.astro";
import H3 from "../../components/H3.astro";
import Paragraph from "../../components/Paragraph.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";

const SITE_DESCRIPTION =
  "Want an XnConvert alternative on your Mac? Picmal is a native app that converts, compresses, and edits images, video, audio, and PDFs. Works with Shortcuts. Everything runs offline. Pay $39 once.";

const faqs = [
  {
    question: "Is Picmal a good XnConvert alternative?",
    answer:
      "If you work with video and audio alongside images on a Mac, yes. XnConvert doesn't touch those. If you need 500+ image formats, 80+ editing actions, or the same app on Windows and Linux, XnConvert goes deeper on the image side.",
  },
  {
    question: "Why pay for Picmal when XnConvert is free?",
    answer:
      "XnConvert is free and great at bulk image editing with 80+ actions. Picmal is $39 and adds video, audio, PDF tools, compression, Shortcuts, and a Finder right-click. XnConvert has none of those. If images are all you need and you want deep editing, stick with XnConvert.",
  },
  {
    question: "Does XnConvert support more formats than Picmal?",
    answer:
      "For images, yes, by a lot. 500+ input formats against Picmal's 20+. But Picmal also handles video, audio, RAW decode, and PDFs, and XnConvert doesn't do any of those.",
  },
  {
    question: "Can Picmal add watermarks like XnConvert?",
    answer:
      "Picmal watermarks video. XnConvert watermarks images. Neither does both. XnConvert goes further on image editing overall, with 80+ actions, filters, and full metadata editing, so for bulk image work it's the stronger tool.",
  },
  {
    question: "Does Picmal work on Windows or Linux like XnConvert?",
    answer:
      "No. Picmal is Mac only. XnConvert runs on Windows and Linux too.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Just email support@picmal.app.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead
      title="Picmal: The native Mac XnConvert alternative"
      description={SITE_DESCRIPTION}
    />
    <OrganizationSchema url={Astro.site!.href} />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <ComparisonHero
      title="The native Mac XnConvert alternative"
      subhead="XnConvert goes deep on bulk image editing. 500+ formats, 80+ actions, free. Picmal covers more media types. Video, audio, and PDFs alongside images, in a native Mac app that works with Shortcuts."
      buyEvent="buy_clicked_xnconvert_comparison"
    />

    <ComparisonVerdict
      competitor="XnConvert"
      summary="XnConvert is free, runs on every platform, and handles 500+ formats with 80+ editing actions for bulk image work. Picmal ($39, paid once) is Mac only and covers more media types. Video, audio, and PDFs alongside images, with a native interface and Shortcuts support."
      picmalFor="You work with video and audio alongside images, you want a native Mac feel with Shortcuts and a Finder right-click, and you're fine with fewer image editing options."
      competitorFor="You need 500+ image formats, 80+ editing actions, full metadata editing, scripting, or the same app on Windows and Linux, and free matters to you."
    />

    <!-- Comparison Table -->
    <Section width="default">
      <SectionHeading>
        Picmal vs XnConvert at a glance
        <Fragment slot="sublead">
          XnConvert is a bulk image processor with hundreds of editing actions.
          Picmal covers more media types, video, audio, and PDFs, with fewer
          image editing options. Pick based on what you actually need.
        </Fragment>
      </SectionHeading>
      <Card padding="p-4 md:p-8">
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left p-4 font-semibold text-text">Feature</th>
                  <th class="text-left p-4 font-semibold text-text">Picmal</th>
                  <th class="text-left p-4 font-semibold text-text"
                    >XnConvert</th
                  >
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr>
                  <td class="p-4 text-text-secondary">Price</td>
                  <td class="p-4 text-text">$39 one-time</td>
                  <td class="p-4 text-text"
                    >Free (personal), €15 (commercial)</td
                  >
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Platforms</td>
                  <td class="p-4 text-text">macOS only</td>
                  <td class="p-4 text-text">Windows, Mac, Linux</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Privacy</td>
                  <td class="p-4 text-text">100% offline</td>
                  <td class="p-4 text-text">100% offline</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Interface</td>
                  <td class="p-4 text-text">Native macOS, minimal</td>
                  <td class="p-4 text-text">Cross-platform, feature-rich</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Image formats</td>
                  <td class="p-4 text-text">20+</td>
                  <td class="p-4 text-text">500+ input, 70+ output</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video conversion</td>
                  <td class="p-4 text-text">Yes. MP4, MOV, MKV, and more</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Audio conversion</td>
                  <td class="p-4 text-text">Yes. MP3, WAV, FLAC, and more</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Editing actions</td>
                  <td class="p-4 text-text"
                    >Light (watermark, resize, rotate, metadata removal)</td
                  >
                  <td class="p-4 text-text"
                    >80+ (watermarks, filters, transforms)</td
                  >
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Watermarks</td>
                  <td class="p-4 text-text">Video only</td>
                  <td class="p-4 text-text">Yes</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Metadata editing</td>
                  <td class="p-4 text-text">Removal only</td>
                  <td class="p-4 text-text">Full editing</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Folder monitoring</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">Yes (watch folder)</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Shortcuts integration</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Finder right-click</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Custom presets</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text">Yes</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">macOS</td>
                  <td class="p-4 text-text">15+</td>
                  <td class="p-4 text-text">10.13+</td>
                </tr>
              </tbody>
            </table>
          </div>
      </Card>
    </Section>

    <!-- Who Picmal Is For / Who Should Stick with XnConvert -->
    <Section width="default">
      <SectionHeading>
        Which one is right for you?
        <Fragment slot="sublead">
            Here's where each one makes more sense.
        </Fragment>
      </SectionHeading>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Picmal Column -->
          <Card>
            <div class="mb-6">
              <H3 class="mb-2">
                Choose Picmal
              </H3>
              <Paragraph color="secondary">
                Video, audio, and PDFs alongside images. Mac native.
              </Paragraph>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want one native app to convert, compress, and edit
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You use Apple Shortcuts for automation
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want a UI that actually feels like a Mac app
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need video, audio, and PDF tools plus real compression
                </span>
              </li>
            </ul>
          </Card>

          <!-- XnConvert Column -->
          <Card>
            <div class="mb-6">
              <H3 class="mb-2">
                Choose XnConvert
              </H3>
              <Paragraph color="secondary">
                Best for deep image processing and running on any platform
              </Paragraph>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text"> You use Windows or Linux </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need deep bulk image editing, with transforms, filters,
                  and full metadata editing
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want 500+ format support with 80+ editing actions
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You prefer free software for personal use
                </span>
              </li>
            </ul>
          </Card>
        </div>
    </Section>

    <!-- Features -->
    <FeatureGrid
      heading="Everything else Picmal does"
      subleadIntro="One app for images, video, audio, and PDFs. Convert, compress, and edit, all on your Mac."
    />

    <!-- Testimonials Section -->
    <MasonryTestimonials />

    <!-- Pricing -->
    <PricingSection />

    <!-- Founder letter -->
    <FounderLetter />

    <!-- FAQ Section -->
    <Section id="faq" width="narrow">
      <SectionHeading
        sublead="Can't find what you're looking for? Email support@picmal.app"
      >
        Frequently asked questions
      </SectionHeading>
      <Card>
        <FAQ faqs={faqs} />
      </Card>
    </Section>

    <Footer />

    <SupportedFormatsModal />

  </body>
</html>
