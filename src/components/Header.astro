---
import { Image } from "astro:assets";
import Button from "./Button.astro";

const currentPage = Astro.url.pathname;
---

<nav
  class="fixed top-0 left-0 right-0 z-50 px-6 py-6 backdrop-blur-md text-sm transition-colors duration-300 bg-white/90 border-b border-gray-100"
>
  <div class="max-w-6xl mx-auto flex items-center justify-between">
    <div class="flex items-center">
      <a href="/" class="flex items-center gap-3 cursor-pointer">
        <Image
          src="/logo.webp"
          alt="Picmal Logo"
          width={40}
          height={40}
          class="rounded-lg w-10 h-10 object-cover"
          loading="eager"
        />
        <div class="text-xl font-semibold text-black">Picmal</div>
      </a>
    </div>

    <div class="hidden xl:flex items-center space-x-6 2xl:space-x-8">
      <a
        href="/#features"
        class="text-sm transition-colors cursor-pointer text-black/65 hover:text-black font-medium"
      >
        Features
      </a>
      <a
        href="/#testimonials"
        class="text-sm transition-colors cursor-pointer text-black/65 hover:text-black font-medium"
      >
        Testimonials
      </a>
      <a
        href="/#about"
        class="text-sm transition-colors cursor-pointer text-black/65 hover:text-black font-medium"
      >
        About
      </a>
      <a
        href="/#faq"
        class="text-sm transition-colors cursor-pointer text-black/65 hover:text-black font-medium"
      >
        FAQ
      </a>

      <a
        href="/#pricing"
        class="text-sm transition-colors cursor-pointer text-black/65 hover:text-black font-medium"
      >
        Pricing
      </a>
      <a
        href="/blog/changelog"
        class={`text-sm transition-colors cursor-pointer font-medium ${
          currentPage.startsWith("/blog/changelog")
            ? "text-accent"
            : "text-black/65 hover:text-black "
        }`}
      >
        Changelog
      </a>
      <a
        href="/blog"
        class={`text-sm transition-colors cursor-pointer font-medium ${
          currentPage.startsWith("/blog") &&
          !currentPage.startsWith("/blog/changelog")
            ? "text-accent"
            : "text-black/65 hover:text-black "
        }`}
      >
        Blog
      </a>
    </div>

    <div class="flex items-center space-x-3">
      <!-- Buy button - hidden on mobile, shown on xl+ -->
      <Button size="small" text="Buy for Mac" class="hidden xl:inline-block" useGumroad={true} />

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        class="xl:hidden inline-flex items-center justify-center p-2 rounded-md text-black/65 hover:text-black hover:bg-gray-100 text-sm transition-colors"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <svg
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden xl:hidden">
    <div class="py-3 space-y-1">
      <a
        href="/#features"
        class="text-sm block py-2 rounded-md font-medium text-black/65 hover:text-black"
      >
        Features
      </a>
      <a
        href="/#testimonials"
        class="text-sm block py-2 rounded-md font-medium text-black/65 hover:text-black"
      >
        Testimonials
      </a>
      <a
        href="/#about"
        class="text-sm block py-2 rounded-md font-medium text-black/65 hover:text-black"
      >
        About
      </a>

      <a
        href="/#faq"
        class="text-sm block py-2 rounded-md font-medium text-black/65 hover:text-black"
      >
        FAQ
      </a>

      <a
        href="/blog/changelog"
        class="text-sm block py-2 rounded-md font-medium text-black/65 hover:text-black"
      >
        Changelog
      </a>
      <a
        href="/#pricing"
        class="text-sm block py-2 rounded-md font-medium text-black/65 hover:text-black"
      >
        Pricing
      </a>
      <a
        href="/blog"
        class="text-sm block py-2 rounded-md font-medium text-black/65 hover:text-black"
      >
        Blog
      </a>
      <a
        href="/tools"
        class="text-sm block py-2 rounded-md font-medium text-black/65 hover:text-black"
      >
        Free Tools
      </a>
      <Button
        size="small"
        text="Buy for Mac"
        class="block my-4 py-2 text-center"
        useGumroad={true}
      />
    </div>
  </div>
</nav>

<script>
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");

  // Mobile menu functionality
  mobileMenuButton?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });
</script>
