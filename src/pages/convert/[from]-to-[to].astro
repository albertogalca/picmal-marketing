---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import H2 from "../../components/H2.astro";
import Paragraph from "../../components/Paragraph.astro";
import CardGrid from "../../components/CardGrid.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";
import CTASection from "../../components/CTASection.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import Section from "../../components/Section.astro";
import Card from "../../components/Card.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import BenefitsCard from "../../components/BenefitsCard.astro";
import ConversionGrid from "../../components/ConversionGrid.astro";
import {
  conversions,
  formats,
  getRelatedConversions,
  isConversionIndexed,
  type FileSizeExample,
  type UseCase,
} from "../../data/conversions";

import { compressions } from "../../data/compressions";

export function getStaticPaths() {
  return conversions.map((c) => ({
    params: { from: c.from, to: c.to },
    props: { conversion: c },
  }));
}

const { conversion } = Astro.props;

// Blog post cross-links for conversion pages
const blogGuides: Record<string, { title: string; slug: string }> = {
  "webp-to-jpg": {
    title: "How to Convert WebP to JPG on Mac (4 Methods)",
    slug: "convert-webp-to-jpg-mac",
  },
  "webp-to-png": {
    title: "How to Convert WebP to PNG on Mac (4 Methods)",
    slug: "convert-webp-to-png-mac",
  },
  "tiff-to-jpg": {
    title: "How to Convert TIFF to JPG on Mac (4 Methods)",
    slug: "convert-tiff-to-jpg-mac",
  },
  "svg-to-png": {
    title: "How to Convert SVG to PNG on Mac (4 Methods)",
    slug: "convert-svg-to-png-mac",
  },
  "heic-to-jpg": {
    title: "How to Convert HEIC to JPG on Mac (2026 Guide)",
    slug: "how-to-convert-heic-to-jpg-mac",
  },
  "heic-to-png": {
    title: "How to Convert HEIC to PNG on Mac (4 Methods)",
    slug: "convert-heic-to-png-mac",
  },
  "avif-to-jpg": {
    title: "How to Convert AVIF to JPG on Mac (3 Methods)",
    slug: "convert-avif-to-jpg-mac",
  },
  "png-to-jpg": {
    title: "How to Convert PNG to JPEG on Mac",
    slug: "convert-png-to-jpeg-mac",
  },
  "arw-to-jpg": {
    title: "How to Convert ARW to JPG on Mac (4 Free Methods)",
    slug: "convert-arw-to-jpg-mac",
  },
};
const blogGuide = blogGuides[conversion.slug];
const from = formats[conversion.from];
const to = formats[conversion.to];
const related = getRelatedConversions(conversion.from, conversion.to, 6);

const fromCompress = compressions.find((c) => c.format === conversion.from);
const toCompress = compressions.find((c) => c.format === conversion.to);

const title =
  conversion.metaTitle || `Convert ${from.name} to ${to.name} on Mac, offline and in batches`;
const description = conversion.metaDescription;

// Low-demand templated pairs are de-indexed to concentrate site quality on winners.
const noindex = !isConversionIndexed(conversion.slug);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: conversion.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <ComparisonHero
      pricingHref="/#pricing"
      title={`Convert ${from.name} to ${to.name} on Mac`}
      subhead={conversion.whyConvert}
      buyEvent={`buy_clicked_convert_${conversion.slug}`}
      defaultTab="convert"
    />

    <!-- Benefits -->
    <Section width="narrow">
      <BenefitsCard
        heading={`Why convert ${from.name} to ${to.name}?`}
        benefits={conversion.benefits}
      />
    </Section>

    <!-- File Size Comparison -->
    {
      conversion.fileSizeExamples && conversion.fileSizeExamples.length > 0 && (
        <Section width="narrow">
          <SectionHeading>
            {from.name} vs {to.name} file sizes
          </SectionHeading>
          <div class="bg-background-subtle/50 border border-border rounded-xl overflow-hidden">
            <table class="w-full">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left text-small font-medium text-text-secondary px-6 py-4">
                    File type
                  </th>
                  <th class="text-right text-small font-medium text-text-secondary px-6 py-4">
                    {from.name}
                  </th>
                  <th class="text-right text-small font-medium text-text-secondary px-6 py-4">
                    {to.name}
                  </th>
                  <th class="text-right text-small font-medium text-text-secondary px-6 py-4">
                    Note
                  </th>
                </tr>
              </thead>
              <tbody>
                {conversion.fileSizeExamples.map(
                  (example: FileSizeExample, i: number) => (
                    <tr
                      class={
                        i < conversion.fileSizeExamples!.length - 1
                          ? "border-b border-border/50"
                          : ""
                      }
                    >
                      <td class="px-6 py-4 text-small text-text">
                        {example.label}
                      </td>
                      <td class="px-6 py-4 text-small text-text-secondary text-right font-mono">
                        {example.fromSize}
                      </td>
                      <td class="px-6 py-4 text-small text-text text-right font-mono font-medium">
                        {example.toSize}
                      </td>
                      <td class="px-6 py-4 text-small text-accent text-right">
                        {example.savings}
                      </td>
                    </tr>
                  ),
                )}
              </tbody>
            </table>
            {conversion.conversionSpeed && (
              <div class="px-6 py-4 border-t border-border bg-background/50">
                <div class="flex items-center gap-2 text-small text-text-secondary">
                  <svg
                    class="w-4 h-4 text-accent flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 10V3L4 14h7v7l9-11h-7z"
                    />
                  </svg>
                  <span>
                    Conversion speed:{" "}
                    <strong class="text-text">
                      {conversion.conversionSpeed}
                    </strong>
                  </span>
                </div>
              </div>
            )}
          </div>
        </Section>
      )
    }

    <!-- Real-World Use Cases -->
    {
      conversion.useCases && conversion.useCases.length > 0 && (
        <Section>
          <SectionHeading>
            When to convert {from.name} to {to.name}
          </SectionHeading>
          <div class="grid md:grid-cols-2 gap-4">
            {conversion.useCases.map((useCase: UseCase) => (
              <Card>
                <h3 class="font-semibold text-text mb-2">{useCase.title}</h3>
                <Paragraph class="text-small">{useCase.description}</Paragraph>
              </Card>
            ))}
          </div>
        </Section>
      )
    }

    <!-- How To Steps -->
    <CardGrid
      numbered
      heading={`How to convert ${from.name} to ${to.name} on Mac`}
      items={[
        {
          title: "Open Picmal",
          description: "Download and open Picmal on your Mac.",
        },
        {
          title: `Add your ${from.name} files`,
          description: `Drag and drop your ${from.name} files or entire folders into Picmal.`,
        },
        {
          title: `Select ${to.name} and convert`,
          description: `Choose ${to.name} as the output format and click Convert.`,
        },
      ]}
    />

    <!-- Format Comparison -->
    <Section>
      <SectionHeading>{from.name} vs {to.name}</SectionHeading>
      <div
        class="grid md:grid-cols-2 gap-px bg-border rounded-xl overflow-hidden border border-border"
      >
        <div class="bg-background p-6 md:p-8">
          <div class="flex items-center gap-3 mb-4">
            <span
              class="inline-flex items-center justify-center px-3 py-1 rounded-xl bg-background-subtle border border-border text-small font-mono font-medium text-text tracking-wide"
              >.{from.extension}</span
            >
            <h3 class="font-semibold text-text">{from.name}</h3>
          </div>
          <p class="text-small text-text-secondary mb-3">{from.fullName}</p>
          <Paragraph class="mb-4">{from.description}</Paragraph>
          <div class="pt-4 border-t border-border">
            <p class="text-small font-medium text-text-secondary mb-2">
              Best for
            </p>
            <p class="text-small text-text">{from.bestFor}</p>
          </div>
        </div>
        <div class="bg-background p-6 md:p-8">
          <div class="flex items-center gap-3 mb-4">
            <span
              class="inline-flex items-center justify-center px-3 py-1 rounded-xl bg-accent/10 border border-accent/20 text-small font-mono font-medium text-accent tracking-wide"
              >.{to.extension}</span
            >
            <h3 class="font-semibold text-text">{to.name}</h3>
          </div>
          <p class="text-small text-text-secondary mb-3">{to.fullName}</p>
          <Paragraph class="mb-4">{to.description}</Paragraph>
          <div class="pt-4 border-t border-border">
            <p class="text-small font-medium text-text-secondary mb-2">
              Best for
            </p>
            <p class="text-small text-text">{to.bestFor}</p>
          </div>
        </div>
      </div>
    </Section>

    <!-- FAQ -->
    <Section id="faq" width="narrow">
      <SectionHeading
        sublead="Something not covered here? Write to support@picmal.app"
      >
        Frequently Asked Questions
      </SectionHeading>
      <Card>
        <FAQ faqs={conversion.faqs} />
      </Card>
    </Section>

    <!-- Sources & Standards -->
    {
      (from.standardBody || to.standardBody) && (
        <Section width="narrow">
          <Card>
            <H2 class="mb-6">Format standards & sources</H2>
            <ul class="space-y-3 text-small text-text-secondary">
              {from.standardBody && (
                <li class="flex gap-2 items-start">
                  <span class="text-accent font-medium flex-shrink-0">
                    {from.name}:
                  </span>
                  <span>
                    Defined by {from.standardBody}.
                    {from.sourceUrl && (
                      <a
                        href={from.sourceUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-accent hover:underline ml-1"
                      >
                        View specification &rarr;
                      </a>
                    )}
                  </span>
                </li>
              )}
              {to.standardBody && (
                <li class="flex gap-2 items-start">
                  <span class="text-accent font-medium flex-shrink-0">
                    {to.name}:
                  </span>
                  <span>
                    Defined by {to.standardBody}.
                    {to.sourceUrl && (
                      <a
                        href={to.sourceUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-accent hover:underline ml-1"
                      >
                        View specification &rarr;
                      </a>
                    )}
                  </span>
                </li>
              )}
            </ul>
          </Card>
        </Section>
      )
    }

    <!-- Compress Cross-Links -->
    {
      (fromCompress || toCompress) && (
        <Section width="narrow">
          <Card>
            <H2 class="mb-4">Need to compress instead?</H2>
            <Paragraph class="mb-4">
              If you don't need to change formats, Picmal can also compress your
              files to reduce size:
            </Paragraph>
            <div class="flex flex-wrap gap-3">
              {fromCompress && (
                <a
                  href={`/compress/${fromCompress.slug}`}
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-background border border-border text-small font-medium text-text hover:border-accent/30 hover:bg-accent/[0.03] transition-colors duration-200 motion-reduce:transition-none"
                >
                  <span class="font-mono text-small text-text-secondary">
                    .{fromCompress.format}
                  </span>
                  Compress {fromCompress.name}
                </a>
              )}
              {toCompress && (
                <a
                  href={`/compress/${toCompress.slug}`}
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-background border border-border text-small font-medium text-text hover:border-accent/30 hover:bg-accent/[0.03] transition-colors duration-200 motion-reduce:transition-none"
                >
                  <span class="font-mono text-small text-text-secondary">
                    .{toCompress.format}
                  </span>
                  Compress {toCompress.name}
                </a>
              )}
            </div>
          </Card>
        </Section>
      )
    }

    <!-- Related Conversions -->
    <Section>
      <SectionHeading>Related conversions</SectionHeading>
      <ConversionGrid
        columns={3}
        links={related.map((r) => ({
          href: `/convert/${r.slug}`,
          label: `${formats[r.from].name} to ${formats[r.to].name}`,
        }))}
        linkText="View all conversions"
        linkHref="/convert"
      />
    </Section>

    <!-- Blog Guide Cross-Link -->
    {
      blogGuide && (
        <Section width="narrow">
          <Card>
            <H2 class="mb-4">In-depth guide</H2>
            <Paragraph class="mb-4">
              Want step-by-step instructions with multiple methods including
              Preview, Terminal, and online tools?
            </Paragraph>
            <a
              href={`/blog/${blogGuide.slug}`}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-background border border-border text-small font-medium text-text hover:border-accent/30 hover:bg-accent/[0.03] transition-colors duration-200 motion-reduce:transition-none"
            >
              Read: {blogGuide.title} &rarr;
            </a>
          </Card>
        </Section>
      )
    }

    <!-- CTA -->
    <CTASection
      heading={`Convert ${from.name} to ${to.name} with Picmal`}
      analyticsEvent={`buy_clicked_convert_${conversion.slug}_bottom`}
    />

    <Footer />
  </body>
</html>
