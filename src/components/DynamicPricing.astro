---
import H3 from "./H3.astro";
import Paragraph from "./Paragraph.astro";
import Button from "./Button.astro";
import { TIERS, DEFAULT_TIER_INDEX } from "../config/pricing";

const initial = TIERS[DEFAULT_TIER_INDEX];
---

<div class="bg-background-subtle rounded-2xl p-4 md:p-8 border border-border">
  <div class="mb-8">
    <!-- Title -->
    <H3 class="mb-6">Select number of devices</H3>

    <!-- Price Display -->
    <div class="flex items-baseline gap-1 mb-8">
      <span id="current-price" class="text-4xl font-semibold text-text tabular-nums">
        ${initial.price.toFixed(2)}
      </span>
      <span class="text-text-secondary text-body">/ once</span>
    </div>

    <!-- Features List -->
    <ul class="space-y-2 mb-8">
      <li class="flex items-start gap-3">
        <div class="flex items-center gap-2 mb-4">
          <!-- Device Selector -->
          <div class="flex items-center gap-2">
            <button
              id="decrease-devices"
              class="w-7 h-7 rounded-xl bg-background hover:bg-background-subtle border border-border hover:border-border/20 flex items-center justify-center transition-[background-color,border-color,opacity,scale] duration-200 ease-out active:scale-[0.96] motion-reduce:transition-none disabled:opacity-50 disabled:cursor-not-allowed"
              aria-label="Decrease number of devices"
            >
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20 12H4"></path>
              </svg>
            </button>

            <div
              class="flex items-center justify-center min-w-[85px] h-7 rounded-xl border border-border bg-background px-2.5"
            >
              <span id="device-count" class="text-body font-semibold tabular-nums"
                >{initial.devices}</span
              >
              <span
                class="ml-1.5 text-small text-text-secondary"
                id="device-label">{initial.devices === 1 ? "device" : "devices"}</span
              >
            </div>

            <button
              id="increase-devices"
              class="w-7 h-7 rounded-xl bg-background hover:bg-background-subtle border border-border hover:border-border/20 flex items-center justify-center transition-[background-color,border-color,opacity,scale] duration-200 ease-out active:scale-[0.96] motion-reduce:transition-none disabled:opacity-50 disabled:cursor-not-allowed"
              aria-label="Increase number of devices"
            >
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 4v16m8-8H4"></path>
              </svg>
            </button>
          </div>

          <Paragraph>
            (<span id="seat-count-text"
              >{initial.devices} {initial.devices === 1 ? "seat" : "seats"}</span
            >)
          </Paragraph>
        </div>
      </li>

      <li class="flex items-start gap-3">
        <svg
          class="w-5 h-5 text-text-secondary flex-shrink-0 mt-0.5"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        <div>
          <Paragraph>
            Convert & compress images, videos, audio <button
              id="open-formats-modal"
              class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-text/5 hover:bg-text/10 cursor-pointer transition-[background-color,scale] duration-200 ease-out active:scale-[0.96] motion-reduce:transition-none align-middle ml-0.5"
              type="button"
              aria-label="View supported formats"
              ><svg
                class="w-2.5 h-2.5 text-text-secondary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg></button
            >
          </Paragraph>
        </div>
      </li>
      <li class="flex items-start gap-3">
        <svg
          class="w-5 h-5 text-text-secondary flex-shrink-0 mt-0.5"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        <div>
          <Paragraph>Batch processing for multiple files</Paragraph>
        </div>
      </li>

      <li class="flex items-start gap-3">
        <svg
          class="w-5 h-5 text-text-secondary flex-shrink-0 mt-0.5"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        <div>
          <Paragraph>
            Tools like merging audios/PDFs, and organising pages.</Paragraph
          >
        </div>
      </li>
      <li class="flex items-start gap-3">
        <svg
          class="w-5 h-5 text-text-secondary flex-shrink-0 mt-0.5"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        <div>
          <Paragraph>Works offline, no data leaves your Mac</Paragraph>
        </div>
      </li>
      <li class="flex items-start gap-3">
        <svg
          class="w-5 h-5 text-text-secondary flex-shrink-0 mt-0.5"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        <div>
          <Paragraph>Free updates included</Paragraph>
        </div>
      </li>
    </ul>

    <!-- CTA Button -->
    <Button
      id="buy-button"
      text="Buy for Mac"
      class="w-full mt-6"
      onclick={import.meta.env.PROD ? "window.seline?.track('buy_clicked')" : undefined}
    />

    <script define:vars={{ pricingTiers: TIERS, defaultIndex: DEFAULT_TIER_INDEX }}>
      // Initialize state — opens on the default (2-Mac) tier, not the cheapest.
      let currentTierIndex = defaultIndex;

      // Get DOM elements
      const decreaseBtn = document.getElementById("decrease-devices");
      const increaseBtn = document.getElementById("increase-devices");
      const deviceCountEl = document.getElementById("device-count");
      const deviceLabelEl = document.getElementById("device-label");
      const currentPriceEl = document.getElementById("current-price");
      const seatCountTextEl = document.getElementById("seat-count-text");
      const buyButton = document.getElementById("buy-button");

      // Update UI function
      function updateUI() {
        const tier = pricingTiers[currentTierIndex];

        // Update device count
        deviceCountEl.textContent = tier.devices;
        deviceLabelEl.textContent = tier.devices === 1 ? "device" : "devices";

        // Update price
        currentPriceEl.textContent = `$${tier.price.toFixed(2)}`;

        // Update feature list
        seatCountTextEl.textContent = `${tier.devices} ${tier.devices === 1 ? "seat" : "seats"}`;

        // Update buy button -> this tier's licencio checkout link (302s to Stripe)
        buyButton.href = tier.checkoutUrl;

        // Update button states
        decreaseBtn.disabled = currentTierIndex === 0;
        increaseBtn.disabled = currentTierIndex === pricingTiers.length - 1;
      }

      // Event listeners
      decreaseBtn.addEventListener("click", () => {
        if (currentTierIndex > 0) {
          currentTierIndex--;
          updateUI();
        }
      });

      increaseBtn.addEventListener("click", () => {
        if (currentTierIndex < pricingTiers.length - 1) {
          currentTierIndex++;
          updateUI();
        }
      });

      // Initial UI update
      updateUI();
    </script>
  </div>
</div>

<Paragraph size="small" class="text-center text-text-secondary mt-4">
  Prices in USD. VAT may apply. Secure payment via Stripe.
</Paragraph>
