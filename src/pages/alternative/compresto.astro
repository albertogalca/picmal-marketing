---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import PricingSection from "../../components/PricingSection.astro";
import FounderLetter from "../../components/FounderLetter.astro";
import Section from "../../components/Section.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import AlternativeVerdict from "../../components/AlternativeVerdict.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";
import FAQSection from "../../components/FAQSection.astro";

const SITE_DESCRIPTION =
  "Looking for a Compresto alternative? Picmal is one Mac app for convert, compress, and edit across images, video, audio, and PDFs. Pay once, $29, not $49. Works with Shortcuts and folder monitoring. 14-day refund.";

const faqs = [
  {
    question: "Is Picmal a good Compresto alternative?",
    answer:
      "Depends what you need. Picmal converts formats, compresses files, and handles images, video, audio, and PDFs, all for $29. Compresto is built to compress as hard as it can. Different tools for different jobs.",
  },
  {
    question: "Does Picmal compress files as much as Compresto?",
    answer:
      "Compresto advertises up to 90% reduction and is tuned for exactly that. Picmal compresses well across images, video, audio, and PDFs. Not as far, but enough for most jobs. And you get format conversion and PDF tools in the same app.",
  },
  {
    question: "Why is Picmal cheaper than Compresto?",
    answer:
      "Compresto costs $49 and does one thing, compression, very well. Picmal is $29 and covers more: converting, compressing, light editing, and PDF tools. A tool built to do one thing extremely well often costs more than one that does a lot.",
  },
  {
    question: "Does Picmal have Raycast integration like Compresto?",
    answer:
      "Yes. The Picmal Raycast extension adds Convert Files, Compress Files, Combine PDFs, and Images to PDF, plus Raycast AI tools, so you can ask it to convert or compress in plain English. Picmal also works with Apple Shortcuts, Finder right-click, and the command line.",
  },
  {
    question: "Can Picmal compress PDFs like Compresto?",
    answer:
      "Yes. Picmal compresses PDFs, and the output is never larger than the input. It also combines PDFs, turns images into a PDF, and exports PDF pages to PNG at the DPI you pick. On top of that, real compression for images, video, and audio.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Email support@picmal.app.",
  },
];
---

<MarketingLayout
  title="Picmal: The affordable Compresto alternative for Mac"
  description={SITE_DESCRIPTION}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
        <FAQSchema />
  </Fragment>

  <ComparisonHero
    title="The affordable Compresto alternative for Mac"
    subhead="Compresto compresses well. If you also need to convert formats, work with video and audio, or handle PDFs, Picmal does all of it for $29, not $49. Files never leave your Mac."
    buyEvent="buy_clicked_compresto_comparison"
  />

  <ComparisonVerdict
    competitor="Compresto"
    summary="Compresto squeezes files as small as they'll go, up to 90% reduction. Picmal ($29, pay once) does real compression too. It also converts formats, covers video and audio, handles PDFs, has its own Raycast extension, and costs $20 less."
    picmalFor="You need more than compression. Formats to convert, video and audio to process, PDFs to shrink or combine, and you'd rather not pay $49 for it."
    competitorFor="You compress files all day and want the smallest possible output, whatever it costs."
  />

  <!-- Comparison Table -->
  <Section width="default">
    <SectionHeading>
      Picmal vs Compresto at a glance
      <Fragment slot="sublead">
        Compresto is built for one thing: squeezing files as small as possible.
        Picmal does more. Convert, compress, and edit across images, video,
        audio, and PDFs. Both run offline, both handle batches.
      </Fragment>
    </SectionHeading>
    <ComparisonTable
      competitor="Compresto"
      rows={[
      {
        feature: "Price",
        picmal: "$29 one-time",
        competitor: "$49 one-time (or $7/mo)",
      },
      {
        feature: "What it's for",
        picmal: "Convert, compress &amp; edit",
        competitor: "File compression",
      },
      {
        feature: "Privacy",
        picmal: "100% offline",
        competitor: "100% offline",
      },
      {
        feature: "Image conversion",
        picmal: "Yes. HEIC, JPG, PNG, WebP, and more",
        competitor: "Compression only",
      },
      {
        feature: "Video conversion",
        picmal: "Yes. MP4, MOV, MKV, and more",
        competitor: "Compression only",
      },
      {
        feature: "Audio conversion",
        picmal: "Yes. MP3, WAV, FLAC, and more",
        competitor: "No",
      },
      {
        feature: "PDF support",
        picmal: "Yes. Compress, combine, images to PDF",
        competitor: "Yes. Compression",
      },
      {
        feature: "Compression",
        picmal: "Yes. Images, video, audio, PDF",
        competitor: "Up to 90% reduction",
      },
      {
        feature: "Metadata removal",
        picmal: "Yes",
        competitor: "Yes",
      },
      {
        feature: "Folder monitoring",
        picmal: "Yes",
        competitor: "Yes",
      },
      {
        feature: "Shortcuts integration",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "Raycast extension",
        picmal: "Yes",
        competitor: "Yes",
      },
      {
        feature: "Finder right-click",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "macOS",
        picmal: "15+",
        competitor: "13+",
      },
    ]}
    />
  </Section>

  <!-- Who Picmal Is For / Who Should Stick with Compresto -->
  <AlternativeVerdict
    sublead="Here's where each one makes more sense."
    picmal={{
      heading: "Choose Picmal",
      lead: "You need more than just compression",
      items: [
        "You want one app to convert, compress, and edit your media",
        "You use Apple Shortcuts for automation",
        "You need to convert or compress video, audio, and PDFs too",
        "You don't want to pay $49 for a single-purpose app",
      ],
    }}
    rival={{
      heading: "Choose Compresto",
      lead: "Compression is your only job",
      items: [
        "Your focus is compression, not format conversion",
        "You need up to 90% file size reduction",
        "You want one app that only compresses, and does it hard",
      ],
    }}
  />

  <!-- Features -->
  <FeatureGrid
    heading="Everything else Picmal does"
    subleadIntro="One app for images, video, audio, and PDFs. Convert, compress, and edit, all on your Mac."
  />

  <!-- Testimonials Section -->
  <MasonryTestimonials />

  <!-- Pricing -->
  <PricingSection />

  <!-- Founder letter -->
  <FounderLetter />

  <!-- FAQ Section -->
  <FAQSection
    faqs={faqs}
    heading="Frequently asked questions"
    sublead="Can't find what you're looking for? Email support@picmal.app"
  />

  <Fragment slot="after">
    <SupportedFormatsModal />
  </Fragment>
</MarketingLayout>
