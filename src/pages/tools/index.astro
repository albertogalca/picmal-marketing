---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CTASection from "../../components/CTASection.astro";
import SectionDivider from "../../components/SectionDivider.astro";
import "../../styles/global.css";
import H1 from "../../components/H1.astro";
import Paragraph from "../../components/Paragraph.astro";

const SITE_TITLE =
  "Free Image Tools - Format Selection, Conversion Tips & More";
const SITE_DESCRIPTION =
  "Collection of free tools to help you work with images: format selector, conversion guides, and optimization tips.";

const tools = [
  {
    id: "format-selector",
    title: "Image format selector",
    description:
      "Answer a few questions about your use case and get instant recommendations for the best image format.",
    href: "/tools/image-format-selector",
    available: true,
  },
  {
    id: "file-size-calculator",
    title: "Image file size calculator",
    description:
      "Calculate estimated file sizes for different image formats and see potential compression savings.",
    href: "/tools/image-file-size-calculator",
    available: true,
  },
  {
    id: "format-support-matrix",
    title: "Format support matrix",
    description:
      "Check browser and OS compatibility for HEIC, WebP, AVIF, and all major image formats.",
    href: "/tools/image-format-support-matrix",
    available: true,
  },
  {
    id: "compression-analyzer",
    title: "Compression analyzer",
    description:
      "Visualize how different compression levels affect your image quality and file size.",
    href: "#",
    available: false,
  },
  {
    id: "batch-guide",
    title: "Batch processing guide",
    description:
      "Learn best practices for processing multiple images efficiently.",
    href: "#",
    available: false,
  },
  {
    id: "metadata-viewer",
    title: "Metadata viewer",
    description:
      "Check what metadata your images contain and learn how to optimize it.",
    href: "#",
    available: false,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
      mainEntity: tools.filter((t) => t.available).map((t) => ({
        "@type": "WebApplication",
        name: t.title,
        description: t.description,
        url: `https://picmal.app${t.href}`,
        applicationCategory: "UtilityApplication",
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      })),
    })} />
  </head>
  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <main class="relative z-10 pt-32 pb-12 sm:pb-16 md:pb-20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <!-- Hero Section -->
        <div class="text-center mb-12 sm:mb-16">
          <H1 class="mb-4 sm:mb-6">Free image tools</H1>
          <Paragraph
            class="max-w-2xl mx-auto text-base sm:text-lg md:text-xl"
          >
            Simple, free utilities to help you make better decisions about image
            formats and optimization.
          </Paragraph>
        </div>

        <!-- Tools Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 tool-grid">
          {
            tools.map((tool, index) => (
              <div class="tool-card" style={`--card-index: ${index}`}>
                {tool.available ? (
                  <a
                    href={tool.href}
                    class="tool-card-link bg-background-subtle border border-border rounded-lg p-6 transition-all duration-200 flex flex-col h-full"
                  >
                    <div class="mb-4">
                      <h3 class="text-lg font-semibold mb-2">{tool.title}</h3>
                      <p class="text-text-secondary text-sm leading-relaxed">
                        {tool.description}
                      </p>
                    </div>
                    <div class="mt-auto pt-4">
                      <span class="text-accent font-semibold text-sm inline-flex items-center gap-2">
                        Use tool
                        <svg
                          class="w-4 h-4 transition-transform duration-200"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M13 7l5 5m0 0l-5 5m5-5H6"
                          />
                        </svg>
                      </span>
                    </div>
                  </a>
                ) : (
                  <div class="bg-background-subtle border border-border rounded-lg p-6 flex flex-col h-full opacity-60">
                    <div class="mb-4">
                      <div class="flex items-center gap-2 mb-2">
                        <h3 class="text-lg font-semibold">{tool.title}</h3>
                        <span class="text-xs px-2 py-1 bg-background border border-border rounded text-text-secondary">
                          Coming soon
                        </span>
                      </div>
                      <p class="text-text-secondary text-sm leading-relaxed">
                        {tool.description}
                      </p>
                    </div>
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </main>

    <SectionDivider />

    <!-- CTA Section -->
    <section class="relative z-10 px-6 py-16 sm:py-20 cta-section">
      <CTASection
        heading="Use Picmal to easily convert your media on your Mac"
        analyticsEvent="buy_clicked_tools_index"
      />
    </section>

    <Footer />

  </body>
</html>
