---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import ArticleSchema from "../components/schema/ArticleSchema.astro";
import PicmalCTA from "../components/PicmalCTA.astro";
import H1 from "../components/H1.astro";

type Props = CollectionEntry<"blog">["data"] & {
  category?: string;
  slug?: string;
};

const { title, description, pubDate, updatedDate, heroImage, category, slug } =
  Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
    {
      slug && (
        <ArticleSchema
          post={{
            title,
            description,
            pubDate,
            updatedDate,
            heroImage,
            category,
          }}
          url={Astro.site!.href}
          slug={slug}
        />
      )
    }
  </head>

  <body class="min-h-screen transition-colors duration-300 bg-white text-black">
    <Header />

    <!-- Back to Blog Link -->
    <div class="relative z-10 px-6 pt-32 pb-12">
      <div class="max-w-3xl mx-auto">
        <a
          href="/blog"
          class="inline-flex items-center transition-colors cursor-pointer text-black hover:text-black"
        >
          ← Back to blog
        </a>
      </div>
    </div>

    <!-- Article -->
    <article class="relative z-10 px-6 pb-20">
      <div class="max-w-3xl mx-auto">
        <!-- Header -->
        <header class="mb-8">
          {
            heroImage && (
              <div class="mb-6">
                <Image
                  src={heroImage}
                  alt={`Hero image for the article ${title}`}
                  width={800}
                  height={400}
                  class="w-full h-auto rounded-lg"
                />
              </div>
            )
          }
          <div class="flex items-center gap-3 mb-8 text-base font-medium">
            {
              category && (
                <>
                  <span
                    class={
                      category === "Changelog"
                        ? "text-accent"
                        : category === "Guide"
                          ? "text-emerald-600"
                          : category === "Tutorial"
                            ? "text-purple-600"
                            : "text-gray-600"
                    }
                  >
                    {category}
                  </span>
                  <span class="text-black font-medium">•</span>
                </>
              )
            }
            <time
              datetime={pubDate.toISOString()}
              class="text-black font-medium"
            >
              <FormattedDate date={pubDate} />
            </time>
            {
              updatedDate && (
                <>
                  <span class="text-gray-500">•</span>
                  <span class="text-gray-500 italic">
                    Updated <FormattedDate date={updatedDate} />
                  </span>
                </>
              )
            }
          </div>

          <H1 id="article-title" class="mb-4">
            {title}
          </H1>
        </header>

        <!-- Content -->
        <div
          class="prose md:prose-lg max-w-none
              prose-headings:text-black prose-headings:font-semibold
              prose-p:text-black/65 prose-p:leading-relaxed
              prose-a:text-black/65 hover:prose-a:text-black prose-a:underline prose-a:underline-offset-4 prose-a:transition-colors prose-a:duration-200
              prose-strong:text-black
              prose-code:text-accent prose-code:bg-gray-100
              prose-pre:bg-black
              prose-blockquote:border-l-accent prose-blockquote:text-gray-600 prose-blockquote:bg-accent-background
              prose-th:text-black
              prose-td:text-black/65
              prose-ul:text-black/65
              prose-ol:text-black/65
              prose-li:text-black/65
              prose-img:rounded-lg"
          role="main"
          aria-labelledby="article-title"
        >
          <slot />
        </div>

        <!-- Download CTA -->
        <div class="mt-12 pt-8">
          <PicmalCTA />
        </div>
      </div>
    </article>

    <Footer />
  </body>
</html>
