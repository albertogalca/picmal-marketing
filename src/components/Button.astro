---
import { cn } from "../utils/cn";
import { DEFAULT_TIER } from "../config/pricing";

export interface Props {
  class?: string;
  href?: string;
  text?: string;
  size?: "small" | "normal";
  variant?: "primary" | "secondary" | "overlay";
  type?: "link" | "submit" | "button";
  disabled?: boolean;
  icon?: string;
  iconType?: "stroke" | "fill";
  id?: string;
  title?: string;
  ariaLabel?: string;
  target?: string;
  rel?: string;
  onclick?: string;
  download?: boolean | string;
}

const {
  class: className = "",
  href = DEFAULT_TIER.checkoutUrl,
  text = "",
  size = "normal",
  variant = "primary",
  type = "link",
  disabled = false,
  icon,
  iconType = "stroke",
  id,
  title,
  ariaLabel,
  target = "_blank",
  rel = "noopener noreferrer",
  onclick,
  download,
} = Astro.props;

const isIconOnly = !!icon && !text;

// `small` renders ~38px tall and `normal` ~49px. The pseudo-element carries the
// small variants up to a 44px hit area without changing what anyone sees; the
// bleed is vertical only, so it never eats a neighbour's click.
const HIT_AREA = "relative before:absolute before:content-['']";

const sizeClasses = {
  small: `text-small py-1.5 px-3.5 gap-1.5 ${HIT_AREA} before:inset-x-0 before:-inset-y-[3px]`,
  normal: "text-body py-2.5 px-5 gap-2",
};

// Icon-only buttons: square, sized to meet/approach a 44px touch target.
const iconOnlySizeClasses = {
  small: `p-0 w-10 h-10 ${HIT_AREA} before:-inset-[2px]`,
  normal: "p-0 w-12 h-12",
};

const iconSizeClasses = {
  small: "w-4 h-4",
  normal: "w-5 h-5",
};

const variantClasses = {
  // Redesign: flat. The one primary per view is near-black on light and
  // near-white on dark (--color-action), 15.7:1 or better against its label.
  // Blue stays for links and the pixel art, not for buttons.
  primary: cn(
    "font-medium rounded-lg bg-action text-on-action",
    "hover:brightness-[0.92]",
  ),
  secondary: cn("font-medium rounded-lg bg-control text-text", "hover:bg-control-hover"),
  overlay: cn(
    "font-semibold bg-white/85 text-black backdrop-blur-md ring-1 ring-black/[0.06]",
    "shadow-[0_2px_8px_rgba(0,0,0,0.25),inset_0_1px_0_rgba(255,255,255,0.5)]",
    "hover:bg-white hover:shadow-[0_4px_14px_rgba(0,0,0,0.3),inset_0_1px_0_rgba(255,255,255,0.6)]",
  ),
};

const layoutClasses = isIconOnly
  ? iconOnlySizeClasses[size]
  : sizeClasses[size];

const baseClasses = cn(
  "inline-flex items-center justify-center rounded-lg cursor-pointer",
  "transition-[scale,box-shadow,background-color,border-color,filter] duration-150 ease-out motion-reduce:transition-none",
  "active:scale-[0.96] active:shadow-sm motion-reduce:active:scale-100",
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
  "disabled:opacity-60 disabled:cursor-not-allowed disabled:shadow-none disabled:active:scale-100",
  layoutClasses,
  variantClasses[variant],
  className,
);

// Icon-only buttons need an accessible name; fall back to title if no aria-label.
const accessibleLabel = ariaLabel ?? (isIconOnly ? title : undefined);

const isStroke = iconType === "stroke";
---

{
  type === "link" ? (
    <a
      href={disabled ? undefined : href}
      target={target}
      rel={rel}
      class={baseClasses}
      id={id}
      title={title}
      aria-label={accessibleLabel}
      aria-disabled={disabled || undefined}
      tabindex={disabled ? -1 : undefined}
      onclick={onclick}
      download={download}
    >
      {icon && (
        <svg
          class={iconSizeClasses[size]}
          fill={isStroke ? "none" : "currentColor"}
          stroke={isStroke ? "currentColor" : "none"}
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap={isStroke ? "round" : undefined}
            stroke-linejoin={isStroke ? "round" : undefined}
            stroke-width={isStroke ? 2 : undefined}
            d={icon}
          />
        </svg>
      )}
      {text}
    </a>
  ) : (
    <button
      disabled={disabled}
      type={type === "submit" ? "submit" : "button"}
      class={baseClasses}
      id={id}
      title={title}
      aria-label={accessibleLabel}
    >
      {icon && (
        <svg
          class={iconSizeClasses[size]}
          fill={isStroke ? "none" : "currentColor"}
          stroke={isStroke ? "currentColor" : "none"}
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap={isStroke ? "round" : undefined}
            stroke-linejoin={isStroke ? "round" : undefined}
            stroke-width={isStroke ? 2 : undefined}
            d={icon}
          />
        </svg>
      )}
      {text}
    </button>
  )
}
