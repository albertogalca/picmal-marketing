---
import { twMerge } from "tailwind-merge";

interface Props {
  class?: string;
  size?: "base" | "small";
}

const { class: className, size = "base" } = Astro.props;

const sizeClasses = {
  base: "text-base md:text-lg",
  small: "text-sm",
};

const defaultClasses = `${sizeClasses[size]} leading-relaxed text-black/65`;
const mergedClasses = twMerge(defaultClasses, className);
---

<p class={mergedClasses}>
  <slot />
</p>
