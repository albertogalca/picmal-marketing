---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import H3 from "../components/H3.astro";
import Button from "../components/Button.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import Paragraph from "../components/Paragraph.astro";
import TrustBar from "../components/TrustBar.astro";
import SectionDivider from "../components/SectionDivider.astro";

const SITE_TITLE =
  "All-in-One Media Converter for Mac - Images, Videos & Audio";
const SITE_DESCRIPTION =
  "Convert images, videos, and audio in one powerful Mac app. Batch process all your media files offline with 50+ format support. Native macOS design.";

const faqs = [
  {
    question: "What types of media files can Picmal convert?",
    answer:
      "Picmal converts images (HEIC, JPG, PNG, WebP, AVIF, TIFF, etc.), videos (MOV, MP4, MKV, AVI, WebM, etc.), and audio files (MP3, AAC, FLAC, WAV, etc.). Over 50 formats supported across all media types.",
  },
  {
    question: "Can I convert different media types in the same batch?",
    answer:
      "Yes! Drop a mix of images, videos, and audio files into Picmal and convert them all at once. Each file type is processed with optimized settings.",
  },
  {
    question: "Why use Picmal instead of separate converters?",
    answer:
      "One app for all your media conversion needs means a consistent interface, shared presets, and no switching between tools. Plus, you only pay once for unlimited conversions across all media types.",
  },
  {
    question: "Does Picmal work offline?",
    answer:
      "Yes, completely offline. All media processing happens locally on your Mac. No uploads, no internet required, and complete privacy for your files.",
  },
  {
    question: "Can I compress media while converting?",
    answer:
      "Absolutely. Picmal lets you convert and compress in one step. Adjust quality settings for images, videos, and audio to get the perfect balance of size and quality.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <link
      rel="preload"
      href="/picmal-1.2.0-demo.mp4"
      as="video"
      type="video/mp4"
    />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text"
  >
    <Header />

    <!-- Hero Section -->
    <main
      id="main-content"
      class="relative z-10 pt-24 sm:pt-28 md:pt-32 pb-12 sm:pb-16 md:pb-20"
    >
      <div class="absolute inset-0 -z-10 overflow-hidden hero-gradient"></div>

      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-8 sm:mb-12">
          <div
            class="max-w-4xl mx-auto flex justify-center items-center flex-col"
          >
            <H1 class="mb-4 sm:mb-6 max-w-2xl mx-auto">
              One app to convert all your media files
            </H1>
            <p
              class="mb-8 sm:mb-10 max-w-2xl mx-auto text-base sm:text-lg md:text-xl leading-relaxed text-text-secondary px-4 sm:px-0"
            >
              Convert images, videos, and audio in one powerful Mac app. Batch
              process everything offline with 50+ format support.
            </p>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col items-center gap-3 sm:gap-4">
            <div
              class="flex flex-col sm:flex-row gap-2 items-center justify-center"
            >
              <Button
                text="Get Picmal for $15.99"
                onclick="posthog.capture('buy_clicked_media_converter_mac')"
              />
              <a
                href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg"
                class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-base py-3 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto"
              >
                <svg
                  class="w-4 h-4 inline-block mr-2"
                  fill="currentColor"
                  stroke="none"
                  viewBox="0 0 24 24"
                  ><path
                    d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8a4.35 4.35 0 0 1-2.59-4.03z"
                  ></path></svg
                >
                Download for Mac
              </a>
            </div>
            <p class="text-xs sm:text-sm text-text-secondary">
              One-time purchase • 14-day money back • macOS 12+
            </p>
          </div>

          <!-- Social Proof -->
          <div class="mt-6 sm:mt-8">
            <TrustBar />
          </div>
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-5xl mx-auto mb-6 sm:mb-8 rounded-lg sm:rounded-xl overflow-hidden border border-border"
        >
          <div style="aspect-ratio: 16/10;">
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover block dark:hidden"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal media converter interface"
            >
            </video>
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover hidden dark:block"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal media converter interface"
            >
            </video>
          </div>
        </div>
      </div>
    </main>

    <SectionDivider />

    <!-- Features Section -->
    <section class="relative z-10 px-6 py-20">
      <div class="max-w-6xl mx-auto">
        <H2 class="mb-4 text-center"
          >All your media conversion needs in one app</H2
        >
        <Paragraph class="text-center mb-16 max-w-2xl mx-auto">
          Stop juggling multiple converters. Picmal handles images, videos, and
          audio with the same powerful, offline processing.
        </Paragraph>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Feature 1 -->
          <div class="bg-background-subtle rounded-xl p-8 border border-border">
            <H3 class="mb-4">Images: 20+ formats supported</H3>
            <Paragraph class="mb-4">
              Convert HEIC, JPG, PNG, WebP, AVIF, TIFF, BMP, GIF, PSD, and more.
              Perfect for photographers, designers, and anyone managing photo
              libraries.
            </Paragraph>
            <ul class="space-y-2 text-text-secondary">
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>iPhone HEIC to JPG conversion</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Modern web formats: WebP, AVIF</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Batch process thousands at once</span>
              </li>
            </ul>
          </div>

          <!-- Feature 2 -->
          <div class="bg-background-subtle rounded-xl p-8 border border-border">
            <H3 class="mb-4">Videos: Professional codec control</H3>
            <Paragraph class="mb-4">
              Convert MOV, MP4, MKV, AVI, WebM with full control over codecs,
              resolution, and bitrate. Hardware-accelerated for speed.
            </Paragraph>
            <ul class="space-y-2 text-text-secondary">
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>H.264, H.265, VP9, AV1 codecs</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>4K video support with hardware acceleration</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Resize, compress, and optimize</span>
              </li>
            </ul>
          </div>

          <!-- Feature 3 -->
          <div class="bg-background-subtle rounded-xl p-8 border border-border">
            <H3 class="mb-4">Audio: Lossless & compressed formats</H3>
            <Paragraph class="mb-4">
              Convert MP3, AAC, FLAC, WAV, OGG, and more. Perfect for music
              libraries, podcasts, and audio production workflows.
            </Paragraph>
            <ul class="space-y-2 text-text-secondary">
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Lossless formats: FLAC, ALAC, WAV</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Compressed: MP3, AAC, OGG, Opus</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Adjust bitrate and quality settings</span>
              </li>
            </ul>
          </div>

          <!-- Feature 4 -->
          <div class="bg-background-subtle rounded-xl p-8 border border-border">
            <H3 class="mb-4">Unified batch processing</H3>
            <Paragraph class="mb-4">
              Mix images, videos, and audio in the same batch. Picmal
              intelligently processes each file type with optimized settings.
            </Paragraph>
            <ul class="space-y-2 text-text-secondary">
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Convert mixed media types together</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Save custom presets for any workflow</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Parallel processing for maximum speed</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- Why Picmal Section -->
    <section class="relative z-10 px-6 py-20 bg-background-subtle/50">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-4 text-center">Why choose Picmal for media conversion</H2>
        <Paragraph class="text-center mb-12 max-w-2xl mx-auto">
          The best all-in-one media converter for Mac with native performance
          and offline privacy.
        </Paragraph>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-background rounded-lg p-6 border border-border">
            <div
              class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4"
            >
              <svg
                class="w-6 h-6 text-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <H3 class="mb-2">One-time purchase</H3>
            <Paragraph class="text-sm">
              Buy once, use forever. No subscriptions, no recurring fees.
              Unlimited conversions for all media types.
            </Paragraph>
          </div>

          <div class="bg-background rounded-lg p-6 border border-border">
            <div
              class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4"
            >
              <svg
                class="w-6 h-6 text-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                ></path>
              </svg>
            </div>
            <H3 class="mb-2">100% offline</H3>
            <Paragraph class="text-sm">
              No uploads, no servers. All processing happens locally on your Mac
              for complete privacy and speed.
            </Paragraph>
          </div>

          <div class="bg-background rounded-lg p-6 border border-border">
            <div
              class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4"
            >
              <svg
                class="w-6 h-6 text-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <H3 class="mb-2">Native macOS</H3>
            <Paragraph class="text-sm">
              Built specifically for Mac with beautiful design, Finder
              integration, and optimized performance.
            </Paragraph>
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- Testimonials -->
    <MasonryTestimonials />

    <SectionDivider />

    <!-- CTA Section -->
    <section class="relative z-10 px-6 py-20">
      <div class="max-w-3xl mx-auto text-center">
        <H2 class="mb-6">Get the all-in-one media converter for Mac</H2>
        <Paragraph class="mb-10 max-w-2xl mx-auto">
          One app, one price. Convert images, videos, and audio forever.
        </Paragraph>
        <div
          class="flex flex-col sm:flex-row gap-3 items-center justify-center"
        >
          <Button
            text="Get Picmal for $15.99"
            onclick="posthog.capture('buy_clicked_media_converter_mac_bottom')"
          />
          <a
            href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg"
            class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-base py-3 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto"
          >
            <svg
              class="w-4 h-4 inline-block mr-2"
              fill="currentColor"
              stroke="none"
              viewBox="0 0 24 24"
              ><path
                d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8a4.35 4.35 0 0 1-2.59-4.03z"
              ></path></svg
            >
            Download for Mac
          </a>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-6">Media conversion questions</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Everything you need to know about converting media files on Mac.
          </Paragraph>
        </div>
        <div
          class="bg-background-subtle/50 border border-border rounded-lg p-4 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "picmal" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
