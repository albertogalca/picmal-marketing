---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import H3 from "../components/H3.astro";
import H4 from "../components/H4.astro";
import Paragraph from "../components/Paragraph.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";

const SITE_DESCRIPTION =
  "Picmal press kit: download logos, app screenshots, demo videos, brand assets, and ready-to-use copy for articles, reviews, and stories about Picmal for Mac.";

const shortDescription =
  "Convert, compress, and edit images, video, audio, and PDFs right on your Mac, instead of trusting sketchy websites with them. Batch up to 10,000 files at once, and do far more than convert: merge audio, combine video, edit PDFs, and generate app icons. Works offline, no account, nothing to subscribe to.";

const mediumDescription =
  "Picmal converts, compresses, and edits images, video, audio, and PDFs on your Mac. Drop files in, and that's it. No setup, no uploads, no need to know what a codec is. It handles batches of up to 10,000 files at a time, reads RAW from most cameras, and watermarks photos and video. It does far more than convert, too: merge audio into chaptered audiobooks, combine videos, burn in subtitles, split and organize PDFs, and generate app icons for macOS, Windows, and iOS. It plugs into Finder, Shortcuts, Raycast, and the command line, and can watch folders to process files automatically. There's an advanced mode if you want control, but the defaults are already sensible, so most people won't need it. It feels native because it is. Everything runs locally, so your files never leave your machine.";

const longDescription = `Picmal is a Mac app for converting, compressing, and editing images, video, audio, and PDFs. Simple by default. Drop your files in and go. No setup, no need to know what a bitrate is.

It does a lot: batch up to 10,000 files at once, read RAW photos from most cameras, watermark photos and video, resize and recolor images, and compress to a target file size without ever making a file bigger. Beyond converting, it can merge audio into chaptered audiobooks, combine videos, burn in subtitles, split and organize PDFs, build PDFs from images, and generate app icons for macOS, Windows, and iOS. It plugs into Finder Quick Actions, Shortcuts, Raycast, and a full command-line tool, and can watch folders to process new files on its own. If you want more control, there's an advanced mode. The defaults are already sensible, so most people won't touch it.

It feels native because it is. Picmal lives wherever your other Mac apps live. Everything runs locally, so your files never leave your machine.`;

const principles = [
  {
    title: "Simple by default",
    description:
      "No setup, no technical knowledge required. You open it and start converting. That's it.",
  },
  {
    title: "Opinionated advanced mode",
    description:
      "The options that matter are already configured. The goal was never to expose every knob. It was to make the right choice for you by default.",
  },
  {
    title: "Native to macOS",
    description:
      "It looks and feels like an Apple app because it was built to. It lives where your other apps live and works the same way.",
  },
  {
    title: "Local and private",
    description: "Your files stay on your machine. Always.",
  },
];

const screenshots = [
  {
    src: "/press/picmal_empty.png",
    title: "Empty state",
    caption: "Drop files anywhere to get started.",
  },
  {
    src: "/press/picmal_with_files.png",
    title: "With files",
    caption: "Files loaded and ready to convert.",
  },
  {
    src: "/press/picmal_working.png",
    title: "Working",
    caption: "Mid-conversion.",
  },
  {
    src: "/press/picmal_settings.png",
    title: "Settings",
    caption: "Advanced options for people who want them.",
  },
  {
    src: "/press/picmal_settings_2.png",
    title: "More settings",
    caption: "Format-specific configuration.",
  },
];

const storeAssets = [
  {
    src: "/press/mac_store_a.png",
    title: "Hero, convert",
    caption: "Brand hero, conversion side.",
  },
  {
    src: "/press/mac_store_b.png",
    title: "Hero, compress",
    caption: "Brand hero, compression side.",
  },
  {
    src: "/press/mac_store_c.png",
    title: "Feature highlight",
    caption: "Marketing visual, third panel.",
  },
  {
    src: "/press/mac_store_d.png",
    title: "Feature highlight",
    caption: "Marketing visual, fourth panel.",
  },
  {
    src: "/press/lemon_squeezy_version.png",
    title: "Storefront listing",
    caption: "Storefront preview.",
  },
];

const videos = [
  {
    title: "Full demo",
    description: "About a minute, covers conversion process.",
    src: "/picmal-1.2.0-demo.mp4",
  },
  {
    title: "Clipboard support",
    description: "Copy and paste files directly into Picmal.",
    src: "/images/changelog/1.3.8/clipboard_demo.mp4",
  },
  {
    title: "Drop a folder",
    description: "Drop entire folders to convert everything inside.",
    src: "/images/changelog/1.2.7/drop_folder.mp4",
  },
  {
    title: "Notch progress overlay",
    description: "Live progress shown in the MacBook notch.",
    src: "/images/changelog/1.4.2/notch.mp4",
  },
  {
    title: "Watched folders",
    description:
      "Drop files in a folder and Picmal processes them automatically.",
    src: "/watched_folders.mp4",
  },
];

const facts = [
  {
    label: "What it handles",
    value:
      "Images (including RAW from Sony, Canon, Nikon, Fujifilm, and Adobe), video, audio, and PDFs. Over 100 formats.",
  },
  {
    label: "What it does",
    value:
      "Convert, compress, resize, and watermark. Combine videos, merge audio into chaptered audiobooks, burn in subtitles, split and organize PDFs, and generate app icons for macOS, Windows, and iOS.",
  },
  {
    label: "Fits your workflow",
    value:
      "Batch up to 10,000 files at once. Runs from Finder Quick Actions, Shortcuts, Raycast, watched folders, and a full command-line tool that shares the app's engine.",
  },
  {
    label: "Pricing",
    value:
      "Pay once, every update included. $39 for 2 Macs, $69 for 5. Sold direct on picmal.app and on the Mac App Store.",
  },
  {
    label: "Who uses it",
    value:
      "Mostly photographers, designers, developers, and teachers. Also a lot of people who just want HEIC files to be JPGs.",
  },
  {
    label: "Requirements",
    value:
      "macOS 15 (Sequoia) or later. Runs natively on Apple Silicon and Intel.",
  },
];

const descriptionBlocks = [
  { label: "Short", text: shortDescription },
  { label: "Medium", text: mediumDescription },
  { label: "Long", text: longDescription },
];

const ICON_EYE =
  "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z";
const ICON_DOWNLOAD =
  "M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4";

const CARD_LINK =
  "bg-background-subtle/50 rounded-2xl border border-border p-6 hover:border-accent/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50 active:scale-[0.99] motion-reduce:active:scale-100 transition-[border-color,scale] duration-200";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Picmal: Press kit" description={SITE_DESCRIPTION} />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <!-- Hero -->
    <main id="main-content" class="relative z-10 pt-32 pb-8">
      <div class="max-w-7xl mx-auto px-6 xl:px-0">
        <div class="max-w-3xl">
          <SectionHeading
            level={1}
            align="left"
            headingClass="mb-6"
            subleadClass="max-w-2xl"
          >
            Picmal Press Kit
            <Fragment slot="sublead">
              Everything you need to write about Picmal: logos, screenshots,
              demo videos, and ready-to-use copy. Use any of it freely, and if
              you need a different format or higher resolution, just ask.
            </Fragment>
          </SectionHeading>
        </div>
      </div>
    </main>

    <!-- About / descriptions -->
    <Section width="wide">
      <SectionHeading
        align="left"
        class="mb-8"
        sublead="Ready-to-paste descriptions, in three lengths. Take whichever fits."
      >
        Descriptions
      </SectionHeading>
      <div class="space-y-3 max-w-3xl">
        {
          descriptionBlocks.map((d) => (
            <Card>
              <div class="flex items-center justify-between mb-3">
                <p class="text-small text-text-secondary">{d.label}</p>
                <button
                  class="copy-btn text-small text-text-secondary hover:text-accent focus-visible:text-accent transition-colors cursor-pointer"
                  data-copy={d.text}
                >
                  Copy
                </button>
              </div>
              <Paragraph class="whitespace-pre-line">{d.text}</Paragraph>
            </Card>
          ))
        }
      </div>
    </Section>

    <!-- About me -->
    <Section id="about" bg="subtle" width="wide">
      <SectionHeading align="left" class="mb-8" headingClass="mb-0">
        About me
      </SectionHeading>

      <div class="flex flex-col sm:flex-row gap-8 sm:gap-12">
        <div class="shrink-0">
          <img
            src="/alberto.webp"
            alt="Alberto Gallego, creator of Picmal"
            width="112"
            height="112"
            class="w-28 h-28 object-cover rounded-2xl ring-1 ring-black/10 dark:ring-white/10 shadow-sm"
            loading="lazy"
          />
          <p class="mt-4 text-h4 text-text">Alberto Gallego</p>
          <p class="text-small text-text-secondary">Independent developer</p>
          <div class="mt-3 flex items-center gap-4 text-small">
            <a
              href="https://albertogalca.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="link">Website ↗</a
            >
            <a
              href="https://github.com/albertogalca"
              target="_blank"
              rel="noopener noreferrer"
              class="link">GitHub ↗</a
            >
          </div>
        </div>
        <div class="space-y-4 max-w-xl">
          <Paragraph>
            I build tools that try to respect the people using them: small,
            private, and deliberate. Nothing overdesigned or cluttered. Just
            software that works and doesn't feel like it was made by a
            committee.
          </Paragraph>
          <Paragraph>
            I built Picmal because I couldn't find a file converter I actually
            liked. Every option I tried had the same problems: outdated, clunky
            interfaces. Terminal-only tools when I just wanted something I could
            see and click. Online services that expected me to upload private
            media files to some external server. And no batch conversion
            anywhere.
          </Paragraph>
          <Paragraph color="primary" class="font-bold text-balance pt-1">
            So I built the thing I wanted to use.
          </Paragraph>
          <Paragraph>
            Outside of building, I take photos, travel, read, and walk a lot.
            That stuff probably matters more than it sounds like it should. It's
            where most of my ideas about what good software feels like come
            from.
          </Paragraph>
        </div>
      </div>

      <div class="mt-14">
        <H3 class="mb-6">The principles behind it</H3>
        <ol class="border-t border-border">
          {
            principles.map((p, i) => (
              <li class="grid grid-cols-[2.25rem_1fr] sm:grid-cols-[3rem_1fr] gap-x-4 sm:gap-x-6 border-b border-border py-5">
                <span
                  class="text-h2 leading-none font-semibold text-accent/30 tabular-nums select-none"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="max-w-xl">
                  <H4 class="mb-1.5">{p.title}</H4>
                  <Paragraph>{p.description}</Paragraph>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </Section>

    <!-- Quick facts -->
    <Section width="wide">
      <SectionHeading align="left" class="mb-8" headingClass="mb-0">
        Quick facts
      </SectionHeading>
      <dl class="grid sm:grid-cols-2 gap-x-8 gap-y-6">
        {
          facts.map((f) => (
            <div>
              <dt class="text-small text-text-secondary mb-1.5">{f.label}</dt>
              <dd class="text-body text-text">{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </Section>

    <!-- Media -->
    <Section bg="subtle" width="wide">
      <SectionHeading
        align="left"
        class="mb-8"
        sublead="App icon, screenshots, store visuals, and demo videos."
      >
        Media
      </SectionHeading>

      <div class="space-y-12">
        <!-- App icon -->
        <div>
          <H3 class="mb-4">App icon</H3>
          <Card padding="p-4" class="flex items-center gap-4">
            <img
              src="/Icon-macOS-Default-1024x1024@1x.png"
              alt="Picmal icon"
              class="w-16 h-16 rounded-2xl"
            />
            <div class="flex-1">
              <p class="text-h4 text-text">PNG</p>
              <Paragraph size="small">1024 × 1024</Paragraph>
            </div>
            <Button
              href="/Icon-macOS-Default-1024x1024@1x.png"
              text="Download"
              size="small"
              variant="secondary"
              target="_self"
              download="picmal-icon.png"
            />
          </Card>
        </div>

        <!-- Screenshots -->
        <div>
          <H3 class="mb-4">macOS screenshots</H3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {
              screenshots.map((s) => (
                <div
                  class="image-card group relative aspect-video overflow-hidden bg-background-subtle rounded-2xl ring-1 ring-black/[0.08] dark:ring-white/10 shadow-[0_1px_2px_-1px_rgba(0,0,0,0.06),0_8px_24px_-12px_rgba(0,0,0,0.18)]"
                  data-image-src={s.src}
                  data-image-title={s.title}
                >
                  <img
                    src={s.src}
                    alt={s.title}
                    class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                  <div class="image-card-overlay">
                    <Button
                      type="button"
                      variant="overlay"
                      size="small"
                      text="View"
                      icon={ICON_EYE}
                      class="view-btn"
                    />
                    <Button
                      href={s.src}
                      variant="overlay"
                      size="small"
                      text="Download"
                      icon={ICON_DOWNLOAD}
                      target="_self"
                      download={true}
                    />
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Store assets -->
        <div>
          <H3 class="mb-4">Store assets</H3>
          <Paragraph class="mb-4">
            Marketing visuals and storefront previews.
          </Paragraph>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {
              storeAssets.map((s) => (
                <div
                  class="image-card group relative aspect-video overflow-hidden bg-background-subtle rounded-2xl ring-1 ring-black/[0.08] dark:ring-white/10 shadow-[0_1px_2px_-1px_rgba(0,0,0,0.06),0_8px_24px_-12px_rgba(0,0,0,0.18)]"
                  data-image-src={s.src}
                  data-image-title={s.title}
                >
                  <img
                    src={s.src}
                    alt={s.title}
                    class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                  <div class="image-card-overlay">
                    <Button
                      type="button"
                      variant="overlay"
                      size="small"
                      text="View"
                      icon={ICON_EYE}
                      class="view-btn"
                    />
                    <Button
                      href={s.src}
                      variant="overlay"
                      size="small"
                      text="Download"
                      icon={ICON_DOWNLOAD}
                      target="_self"
                      download={true}
                    />
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Videos -->
        <div>
          <H3 class="mb-4">Videos</H3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {
              videos.map((v) => (
                <Card padding="p-0" class="overflow-hidden">
                  <div class="p-4 flex items-center justify-between gap-4">
                    <div class="flex-1 min-w-0">
                      <p class="text-h4 text-text">{v.title}</p>
                      <Paragraph>{v.description}</Paragraph>
                    </div>
                    <Button
                      href={v.src}
                      text="Download"
                      size="small"
                      variant="secondary"
                      target="_self"
                      download={true}
                    />
                  </div>
                  <video
                    src={v.src}
                    class="w-full h-auto border-t border-border"
                    controls
                    muted
                    playsinline
                    preload="metadata"
                  />
                </Card>
              ))
            }
          </div>
        </div>
      </div>
    </Section>

    <!-- Contact -->
    <Section width="wide">
      <SectionHeading
        align="left"
        class="mb-8"
        sublead="Writing about Picmal, want to partner, or just have a question? Email me."
      >
        Get in touch
      </SectionHeading>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="mailto:support@picmal.app" class={CARD_LINK}>
          <p class="text-small text-text-secondary mb-2">Email</p>
          <p class="text-h4 text-text truncate">support@picmal.app</p>
        </a>

        <a href="https://picmal.app/docs" class={CARD_LINK}>
          <p class="text-small text-text-secondary mb-2">Documentation</p>
          <p class="text-h4 text-text truncate">picmal.app/docs</p>
        </a>

        <a
          href="https://licenses.albertogalca.com/affiliate/signup/new"
          target="_blank"
          rel="noopener noreferrer"
          class={`sm:col-span-2 ${CARD_LINK}`}
        >
          <p class="text-small text-text-secondary mb-2">Become an affiliate</p>
          <p class="text-h4 text-text">Earn 25% on every sale you refer</p>
        </a>
      </div>
    </Section>

    <Footer />

    <!-- LIGHTBOX -->
    <div
      id="lightbox"
      class="lightbox"
      role="dialog"
      aria-modal="true"
      aria-labelledby="lightbox-title"
      hidden
    >
      <div class="lightbox-controls">
        <Button
          id="lightbox-download"
          href="#"
          variant="primary"
          size="small"
          text="Download"
          icon={ICON_DOWNLOAD}
          target="_self"
          download={true}
        />
        <Button
          type="button"
          id="lightbox-close"
          variant="overlay"
          size="small"
          icon="M6 18L18 6M6 6l12 12"
          ariaLabel="Close"
        />
      </div>
      <img id="lightbox-image" src="" alt="" />
      <p id="lightbox-title" class="lightbox-caption"></p>
    </div>

    <style>
      /* Copy button — fixed width avoids layout shift on "Copied ✓",
         min-height + relative pseudo extends hit area to ≥40px without
         visually growing the control. */
      .copy-btn {
        position: relative;
        min-width: 4rem;
        min-height: 1.5rem;
        text-align: right;
      }
      .copy-btn::before {
        content: "";
        position: absolute;
        inset: -10px -8px;
      }

      /* Image card overlay — View / Download Buttons revealed on hover */
      .image-card-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        background: rgba(0, 0, 0, 0.55);
        opacity: 0;
        transition: opacity 0.2s ease-out;
        pointer-events: none;
      }
      .image-card:hover .image-card-overlay,
      .image-card:focus-within .image-card-overlay {
        opacity: 1;
        pointer-events: auto;
      }

      /* LIGHTBOX */
      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: 4rem 1.5rem 2rem;
        background: rgba(0, 0, 0, 0.92);
        backdrop-filter: blur(8px);
        animation: lightbox-fade 0.18s ease-out;
      }
      .lightbox[hidden] {
        display: none;
      }
      .lightbox-controls {
        position: absolute;
        top: 1rem;
        right: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .lightbox img {
        max-width: 100%;
        max-height: calc(100vh - 8rem);
        width: auto;
        height: auto;
        border-radius: 0.5rem;
        object-fit: contain;
      }
      .lightbox-caption {
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.875rem;
        text-align: center;
      }
      @keyframes lightbox-fade {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .image-card-overlay {
          transition: none;
        }
        .image-card img {
          transition: none !important;
        }
        .image-card:hover img {
          transform: none !important;
        }
        .lightbox {
          animation: none;
        }
      }
    </style>

    <script>
      document
        .querySelectorAll<HTMLButtonElement>(".copy-btn")
        .forEach((btn) => {
          btn.addEventListener("click", async () => {
            const text = btn.dataset.copy ?? "";
            try {
              await navigator.clipboard.writeText(text);
              const original = btn.textContent;
              btn.textContent = "Copied ✓";
              setTimeout(() => {
                btn.textContent = original;
              }, 1500);
            } catch (err) {
              console.error("Copy failed", err);
            }
          });
        });

      // Lightbox
      const lightbox = document.getElementById("lightbox");
      const lightboxImage = document.getElementById(
        "lightbox-image",
      ) as HTMLImageElement | null;
      const lightboxTitle = document.getElementById("lightbox-title");
      const lightboxDownload = document.getElementById(
        "lightbox-download",
      ) as HTMLAnchorElement | null;
      const lightboxClose = document.getElementById(
        "lightbox-close",
      ) as HTMLButtonElement | null;

      let lastTrigger: HTMLElement | null = null;

      function openLightbox(src: string, title: string, trigger: HTMLElement) {
        if (!lightbox || !lightboxImage || !lightboxTitle || !lightboxDownload)
          return;
        lastTrigger = trigger;
        lightboxImage.src = src;
        lightboxImage.alt = title;
        lightboxTitle.textContent = title;
        lightboxDownload.href = src;
        lightbox.hidden = false;
        document.body.style.overflow = "hidden";
        // Move focus into the dialog for keyboard users.
        lightboxClose?.focus();
      }

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.hidden = true;
        document.body.style.overflow = "";
        if (lightboxImage) lightboxImage.src = "";
        // Restore focus to the element that opened the dialog.
        lastTrigger?.focus();
        lastTrigger = null;
      }

      document
        .querySelectorAll<HTMLAnchorElement | HTMLButtonElement>(".view-btn")
        .forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.preventDefault();
            const card = btn.closest<HTMLElement>(".image-card");
            if (!card) return;
            const src = card.dataset.imageSrc;
            const title = card.dataset.imageTitle ?? "";
            if (src) openLightbox(src, title, btn);
          });
        });

      lightboxClose?.addEventListener("click", closeLightbox);
      lightbox?.addEventListener("click", (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener("keydown", (e) => {
        if (!lightbox || lightbox.hidden) return;
        if (e.key === "Escape") {
          closeLightbox();
          return;
        }
        // Minimal focus trap — wrap Tab navigation inside the dialog.
        if (e.key === "Tab") {
          const focusables = lightbox.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
          );
          if (focusables.length === 0) return;
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          const active = document.activeElement;
          if (e.shiftKey && active === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && active === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    </script>
  </body>
</html>
