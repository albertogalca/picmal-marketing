---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import H2 from "../../components/H2.astro";
import Paragraph from "../../components/Paragraph.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";
import CTASection from "../../components/CTASection.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import Section from "../../components/Section.astro";
import ConversionGrid from "../../components/ConversionGrid.astro";
import { formats, conversions } from "../../data/conversions";
import FormatPill from "../../components/FormatPill.astro";
import SectionHeading from "../../components/SectionHeading.astro";

const title = "Picmal: Convert images on Mac, all formats supported";
const description =
  "Convert between HEIC, JPG, PNG, WebP, AVIF, TIFF, GIF, and DNG on your Mac. Batch conversion, offline processing.";

const formatKeys = Object.keys(formats);
const groupedBySource = formatKeys.map((key) => ({
  format: formats[key],
  key,
  conversions: conversions.filter((c) => c.from === key),
}));
---

<MarketingLayout
  title={title}
  description={description}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
  </Fragment>

  <ComparisonHero
    pricingHref="/#pricing"
    title="Convert any image format on Mac"
    subhead="Picmal converts between all major image formats, HEIC, JPG, PNG, WebP, AVIF, TIFF, GIF, and DNG. Batch processing, offline, no quality loss."
    buyEvent="buy_clicked_convert_hub"
    defaultTab="convert"
    demo={false}
    art={{ texture: "dissolve", ground: "brand", seed: "convert-hub" }}
  />

  <!-- All Conversions Grid -->
  <Section>
    <div class="grid gap-x-10 gap-y-12 md:grid-cols-2">
      {
        groupedBySource.map((group) => (
          <section>
            <div class="flex items-center gap-3 mb-2">
              <FormatPill ext={group.format.extension} />
              <H2 class="text-h3">Convert from {group.format.name}</H2>
            </div>
            <Paragraph class="mb-5">
              {group.format.description}
            </Paragraph>
            <ConversionGrid
              links={group.conversions.map((c) => ({
                href: `/convert/${c.slug}`,
                label: `${formats[c.from].name} to ${formats[c.to].name}`,
              }))}
            />
          </section>
        ))
      }
    </div>
  </Section>

  <!-- The footer calls this page "All conversions", and video and audio
       live on their own pages. Without this block the hub was a dead end
       for anyone holding a MOV or a FLAC. -->
  <Section>
    <SectionHeading sublead="Video and audio have their own pages, with every pair Picmal converts.">
      Video and audio
    </SectionHeading>
    <ConversionGrid
      links={[
        { href: "/video-converter-mac", label: "Video converter for Mac", sublabel: "MOV, MKV, AVI to MP4" },
        { href: "/audio-converter-mac", label: "Audio converter for Mac", sublabel: "FLAC, WAV, M4A to MP3" },
        { href: "/extract-audio-from-video-mac", label: "Extract audio from video", sublabel: "MP4 or MOV to MP3" },
      ]}
    />
  </Section>

  <CTASection
    heading="Convert any image format with Picmal"
    analyticsEvent="buy_clicked_convert_hub_bottom"
  />
</MarketingLayout>
