---
import ArtCard from "../components/pm/ArtCard.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import H1 from "../components/H1.astro";
import Paragraph from "../components/Paragraph.astro";
import Button from "../components/Button.astro";


---

<MarketingLayout
  title="Picmal: Page not found"
  description="The page you're looking for doesn't exist. Browse Picmal's tools, blog, or head back to the homepage."
  mainClass="relative z-10 pt-32 pb-20"
>
  <div class="max-w-5xl mx-auto px-6 md:grid md:grid-cols-[minmax(0,1fr)_minmax(0,400px)] md:gap-16 md:items-start"><div class="max-w-[640px]">
    <p class="text-small font-medium text-accent mb-4 tabular-nums md:hidden">404</p>
    <H1 class="mb-4">Page not found</H1>
    <Paragraph size="lead" class="mb-8">
      The page you're looking for doesn't exist or has been moved.
    </Paragraph>

    <div class="flex flex-col sm:flex-row gap-2">
      <Button href="/" text="Back to home" target="_self" />
      <Button href="/blog" text="Read the blog" variant="secondary" target="_self" />
    </div>

    <Paragraph size="small" class="mt-10">
      Looking for something specific? Try the <a class="link" href="/docs"
        >docs</a
      > or the <a class="link" href="/blog">blog</a>.
    </Paragraph>

    <!-- Agents: this path also answers `Accept: text/markdown` and
         `Accept: application/json` with a machine-readable body, and
         /llms.txt + /sitemap-index.xml are both live. Kept out of the
         visible copy: a person who mistyped a URL was being handed
         content-negotiation headers as their closing line. -->
  </div>
    <div class="hidden md:block md:pt-2"><ArtCard class="rounded-xl" title="404" texture="dissolve" seed="not-found" /></div>
  </div>
</MarketingLayout>
