---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import Paragraph from "../../components/Paragraph.astro";
import Button from "../../components/Button.astro";
import CTASection from "../../components/CTASection.astro";
import SectionDivider from "../../components/SectionDivider.astro";
import TrustBar from "../../components/TrustBar.astro";
import BentoFeatures from "../../components/BentoFeatures.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeaturedOn from "../../components/FeaturedOn.astro";
import { compressionFormats } from "../../data/compression";
import type { CompressionFormatInfo } from "../../data/compression";

const SITE_TITLE =
  "Image Compression for Mac | Reduce File Size Without Quality Loss";
const SITE_DESCRIPTION =
  "Compress JPEG, WebP, PNG, GIF, TIFF, AVIF, and PDF images on Mac. Reduce file sizes by up to 90% while maintaining quality. 100% offline, batch processing, privacy-focused.";

// Popular compression formats to highlight
const popularFormats = [
  { format: "jpg", label: "Compress JPG" },
  { format: "png", label: "Compress PNG" },
  { format: "webp", label: "Compress WebP" },
  { format: "avif", label: "Compress AVIF" },
  { format: "pdf", label: "Compress PDF" },
  { format: "gif", label: "Compress GIF" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body class="min-h-screen transition-colors duration-300 bg-background text-text">
    <Header />

    <!-- Hero Section -->
    <main class="relative z-10 pt-32 pb-12 sm:pb-16 md:pb-20">
      <!-- Gradient background -->
      <div class="absolute inset-0 -z-10 overflow-hidden hero-gradient"></div>

      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-8 sm:mb-12">
          <div class="max-w-4xl mx-auto flex justify-center items-center flex-col">
            <H1 class="mb-4 sm:mb-6 max-w-3xl mx-auto">Compress images without quality loss</H1>
            <p class="mb-8 sm:mb-10 max-w-2xl mx-auto text-base sm:text-lg md:text-xl leading-relaxed text-text-secondary px-4 sm:px-0">
              Reduce file sizes by up to 90% while maintaining visual quality.
              Support for JPG, PNG, WebP, AVIF, GIF, TIFF, and PDF. 100% offline
              processing.
            </p>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col items-center gap-3 sm:gap-4">
            <Button text="Get Picmal for $15.99" onclick="posthog.capture('buy_clicked')" />
            <p class="text-xs sm:text-sm text-text-secondary">
              One-time purchase • 14-day money back guarantee
            </p>
          </div>
        </div>

        <!-- Trust Bar -->
        <div class="mb-8 sm:mb-12">
          <TrustBar />
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-5xl mx-auto mb-6 sm:mb-8 rounded-lg sm:rounded-xl overflow-hidden border border-border"
        >
          <div style="aspect-ratio: 16/10;">
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover block dark:hidden"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal app interface"
            >
            </video>
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover hidden dark:block"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal app interface"
            >
            </video>
          </div>
        </div>
      </div>
    </main>

    <SectionDivider />

    <!-- Features Section -->
    <BentoFeatures />

    <SectionDivider />

    <!-- Popular Formats Section -->
    <section class="relative z-10 px-4 sm:px-6 py-16 sm:py-20 bg-background-subtle">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10 sm:mb-12">
          <H2 class="mb-4">Popular Compression Formats</H2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            popularFormats.map(({ format, label }) => (
              <a
                href={`/compress/${format}`}
                class="block p-6 bg-background rounded-lg border border-border hover:border-accent/30 transition-all duration-300 group"
              >
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="font-semibold text-text text-base group-hover:text-accent transition-colors">
                      {label}
                    </h3>
                    <p class="text-text-secondary text-sm mt-1">
                      {compressionFormats[format].useCase}
                    </p>
                  </div>
                  <svg
                    class="w-5 h-5 text-accent"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- All Compression Formats Section -->
    <section class="relative z-10 px-4 sm:px-6 py-16 sm:py-20 bg-background">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10 sm:mb-12">
          <H2 class="mb-4">All Supported Formats</H2>
        </div>

        <div class="space-y-12">
          {
            Object.entries(compressionFormats).map(
              ([format, info]: [string, CompressionFormatInfo]) => (
                <div class="border-b border-gray-100 pb-12 last:border-0 last:pb-0">
                  <h3 class="font-semibold text-text text-2xl mb-3">
                    Compress {info.name.toUpperCase()}
                  </h3>
                  <p class="text-text-secondary mb-4">{info.description}</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                      <p class="text-sm font-semibold text-text mb-1">
                        Typical Compression
                      </p>
                      <p class="text-sm text-text-secondary">
                        {info.typical_compression}
                      </p>
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-text mb-1">
                        Quality Retention
                      </p>
                      <p class="text-sm text-text-secondary">
                        {info.quality_retention}
                      </p>
                    </div>
                  </div>

                  <div class="mb-4">
                    <p class="text-sm font-semibold text-text mb-2">
                      Best for:
                    </p>
                    <div class="flex flex-wrap gap-2">
                      {info.best_for.map((use) => (
                        <span class="text-xs px-3 py-1 bg-accent/10 text-accent rounded-full">
                          {use}
                        </span>
                      ))}
                    </div>
                  </div>

                  <a
                    href={`/compress/${format}`}
                    class="inline-flex items-center gap-2 text-accent hover:underline font-semibold"
                  >
                    Learn more about {info.name} compression
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      />
                    </svg>
                  </a>
                </div>
              )
            )
          }
        </div>
      </div>
    </section>

    <!-- Benefits Section -->
    <section class="relative z-10 px-4 sm:px-6 py-16 sm:py-20 bg-background-subtle">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10 sm:mb-12">
          <H2 class="mb-4">Why Compress Images?</H2>
        </div>

        <div class="space-y-6">
          <div class="bg-background p-6 rounded-lg border border-border">
            <h3 class="font-semibold text-text text-base mb-2">
              Faster Website Loading
            </h3>
            <Paragraph>
              Smaller image files load faster, improving user experience and SEO
              rankings. Compressed images can reduce page load times by 50-80%.
            </Paragraph>
          </div>

          <div class="bg-background p-6 rounded-lg border border-border">
            <h3 class="font-semibold text-text text-base mb-2">
              Save Storage Space
            </h3>
            <Paragraph>
              Reduce file sizes by 60-90% to free up storage on your Mac,
              iPhone, and cloud services. Perfect for photographers and content
              creators.
            </Paragraph>
          </div>

          <div class="bg-background p-6 rounded-lg border border-border">
            <h3 class="font-semibold text-text text-base mb-2">
              Email & Upload Limits
            </h3>
            <Paragraph>
              Stay within email attachment limits and upload restrictions.
              Compressed images share faster while maintaining visual quality.
            </Paragraph>
          </div>

          <div class="bg-background p-6 rounded-lg border border-border">
            <h3 class="font-semibold text-text text-base mb-2">
              Faster Backups
            </h3>
            <Paragraph>
              Smaller files mean faster cloud backups and transfers. Save time
              and bandwidth while keeping your images safe.
            </Paragraph>
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- Testimonials Section -->
    <MasonryTestimonials />

    <SectionDivider />

    <!-- Featured On Section -->
    <FeaturedOn />

    <SectionDivider />

    <!-- CTA Section -->
    <CTASection
      heading="Compress images effortlessly on your Mac"
      analyticsEvent="buy_clicked_compress_index_bottom"
    />

    <Footer />
  </body>
</html>
