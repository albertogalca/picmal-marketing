---
import { cn } from "../utils/cn";

export interface Props {
  class?: string;
  id?: string;
}

const { class: className = "", id } = Astro.props;
const defaultClasses = "text-h1 text-text text-balance";
const mergedClasses = cn(defaultClasses, className);
---

<h1 id={id} class={mergedClasses}>
  <slot />
</h1>
