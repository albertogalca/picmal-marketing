---
import Hero from "../components/Hero.astro";
import Button from "../components/Button.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Feature from "../components/Feature.astro";
import VideoShowcase from "../components/VideoShowcase.astro";
import Reviews from "../components/Reviews.astro";
import PricingCard from "../components/PricingCard.astro";
import FAQ from "../components/FAQ.astro";
import CtaBand from "../components/CtaBand.astro";
import PostCard from "../components/PostCard.astro";
import FounderNote from "../components/FounderNote.astro";
import { faqs } from "../../components/schema/FAQSchema.astro";
import { DEFAULT_TIER, SUPPORT_EMAIL, UPGRADE } from "../../config/pricing";
import { getPublishedPosts } from "../../utils/posts";

// Copy is the live homepage's, word for word (index.astro, FeatureGrid,
// FAQSchema). Only the presentation is new.
const features = [
  { icon: "convert", title: "Convert between formats", text: "Over 100 formats across images, video, audio, RAW, and PDF. HEIC to JPG, MOV to MP4, FLAC to ALAC. Drop it in, pick the output, done." },
  { icon: "trend", title: "Compress and save space", text: "Get under an email limit or a slow upload, without the quality drop you'd actually notice. No browser, no waiting." },
  { icon: "pdf", title: "Split, combine and organize PDFs", text: "Break a PDF apart, merge a stack into one, drag pages to reorder, or turn a folder of photos into a PDF. Your documents never leave your Mac." },
  { icon: "film", title: "Combine, download and watermark videos", text: "Stitch clips into one video, paste a link to fetch a clip, or stamp a logo over a preview while it converts." },
  { icon: "audio", title: "Merge and split audio", text: "Join tracks into one file, or split a long recording by its chapters. Podcasts and audiobooks, sorted." },
  { icon: "crop", title: "Crop, cut out and trace images", text: "Trim margins, lift a subject onto a transparent PNG with on-device Vision, trace a logo to real SVG paths, or build a full icon set from one image." },
  { icon: "folder", title: "Watch a folder", text: "Point Picmal at a folder and whatever lands in it gets converted, compressed, or built into a PDF on its own. Set it once." },
  { icon: "pin", title: "Strip metadata", text: "Take GPS coordinates, camera model and timestamps out of a photo before you send it. Or keep them, and add your own copyright." },
  { title: "Fits your workflow", apps: [{ name: "Finder", src: "/finder.png" }, { name: "Shortcuts", src: "/shortcuts.png" }, { name: "Raycast", src: "/raycast.png" }], text: "Finder, Shortcuts, Raycast, a command line tool, and a clipboard that compresses screenshots as you copy them. A conversion is never more than a right-click away." },
];
const posts = (await getPublishedPosts()).sort((a, b) => +b.data.pubDate - +a.data.pubDate).slice(0, 3);
---

<div class="pm-wrap">
  <div style="padding-top: 96px">
    <Hero>
      <Fragment slot="title">Convert and compress anything on your Mac.</Fragment>
      <Fragment slot="quiet">Nothing gets uploaded.</Fragment>
      <Fragment slot="actions">
        <Button href={DEFAULT_TIER.checkoutUrl}>Get Picmal for ${DEFAULT_TIER.price}</Button>
        <Button href="/download" variant="secondary">Try free for 7 days</Button>
      </Fragment>
      <Fragment slot="note">Images, video, audio and PDFs. Batch hundreds at once, in the time a website would still be uploading.</Fragment>
    </Hero>
  </div>

  <div class="pm-mt-16"><VideoShowcase /></div>

  <section class="pm-section" id="features">
    <SectionHeader title="Nice, but what can you do with Picmal?">Quite a lot, actually. These are the essentials, and there's plenty more in the <a href="/docs">docs</a>.</SectionHeader>
    <div class="pm-grid3 pm-mt-16">
      {features.map((f) => <Feature icon={f.icon} title={f.title} apps={f.apps}>{f.text}</Feature>)}
    </div>
  </section>

  <section class="pm-section" id="testimonials">
    <SectionHeader title="Tired of uploading your files to a website?" subtitle="Here's what people say after switching." />
    <div class="pm-mt-16"><Reviews /></div>
  </section>

  <section class="pm-section" id="pricing">
    <SectionHeader title="Pay once and you're all set.">Already own Picmal? <a href={UPGRADE.url}>Add more Macs &rarr;</a></SectionHeader>
    <div class="pm-mt-16"><PricingCard /></div>
  </section>

  <FounderNote />
  <section class="pm-section">
    <SectionHeader title="Frequently asked questions.">Something not covered here? Write to <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.</SectionHeader>
    <div class="pm-mt-16"><FAQ items={faqs} open={0} /></div>
  </section>

  <section class="pm-section">
    <SectionHeader title="From the blog." subtitle="Guides for every format, free." />
    <div class="pm-grid3 pm-mt-16">{posts.map((p) => <PostCard post={p} />)}</div>
  </section>

  <div class="pm-section"><CtaBand title="Stop uploading your files." /></div>
</div>
