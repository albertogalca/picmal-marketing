---
import H3 from "./H3.astro";
import Paragraph from "./Paragraph.astro";

export interface Props {
  title: string;
  description: string;
  iconBgClass?: string;
  iconClass?: string;
  titleClass?: string;
  descriptionClass?: string;
}

const {
  title,
  description,
  iconBgClass = "bg-background-subtle border border-text/10",
  iconClass = "w-9 h-9 [&_path]:stroke-text [&_path]:stroke-[2.5px]",
  titleClass = "mb-2",
  descriptionClass = "mb-10 ",
} = Astro.props;
---

<div class="bg-background-subtle p-8 rounded-lg">
  <div
    class={`w-12 h-12 rounded-lg flex items-center justify-center mb-8 ${iconBgClass}`}
  >
    <div class={iconClass}>
      <slot name="icon" />
    </div>
  </div>
  <H3 class={titleClass}>
    {title}
  </H3>
  <Paragraph class={descriptionClass}>
    {description}
  </Paragraph>
</div>
