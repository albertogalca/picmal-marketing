---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import FAQSchema from "../components/schema/FAQSchema.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import FeatureCard from "../components/FeatureCard.astro";
import { Image } from "astro:assets";
import Button from "../components/Button.astro";
import Testimonials from "../components/Testimonials.astro";
import Paragraph from "../components/Paragraph.astro";
import H3 from "../components/H3.astro";

const SITE_TITLE =
  "Picmal - Convert & compress multiple images without leaving your Mac";
const SITE_DESCRIPTION =
  "Batch convert and compress images offline on your Mac. Beautiful, private, and straightforward.";

const faqs = [
  {
    question: "Is Picmal available for Windows or Linux?",
    answer:
      "Picmal is a native Mac app, so it's only available for Mac. For now and forever.",
  },
  {
    question: "What image formats does Picmal support?",
    answer:
      "Picmal supports 20+ formats including JPEG, PNG, WEBP, AVIF, HEIC, RAW (CR2, NEF, ARW), TIFF, PSD, GIF, BMP, SVG, EPS, AI, ICO, and more.",
  },
  {
    question: "What compression formats are supported?",
    answer:
      "Picmal supports compression for the following formats: JPEG, WebP, PNG, GIF, TIFF, AVIF and PDF. You can either compress images directly without converting them or compress them after converting them to one of these formats.",
  },
  {
    question: "Where are my images processed?",
    answer:
      "All image processing happens locally on your Mac. Picmal does not upload your images to any servers.",
  },
  {
    question: "Can I convert multiple images at once?",
    answer:
      "Yes! Picmal excels at batch processing. Simply drag and drop multiple images, or even entire folders, and convert them all at once.",
  },
  {
    question: "Can I compress without converting?",
    answer:
      "Yes! You can compress images in their current format without converting them. Just select the compression option and adjust the quality slider to reduce file size while maintaining the original format.",
  },
  {
    question: "How much smaller will my files be?",
    answer:
      "It depends on the format and compression settings, but you can typically reduce file sizes by 50-80% with minimal quality loss. HEIC to JPG conversions often save 40-60%, while modern formats like WebP and AVIF can achieve even better compression.",
  },
  {
    question: "What macOS versions are supported?",
    answer:
      "Picmal requires macOS Sonoma (14.0) or later. It's optimized for Apple Silicon Macs but also works great on Intel Macs.",
  },
  {
    question: "Do I need an internet connection to use Picmal?",
    answer:
      "No internet connection is required after installation. Picmal works completely offline, ensuring your images never leave your device.",
  },
];

const licenseFaqs = [
  {
    question: "How does the license work?",
    answer:
      "When you purchase a Picmal license, you can use it indefinitely without any additional fees. This means you won't need to renew your license or make any regular payments to continue using it. You can move your license between devices, but you must first deactivate the license on the current device before activating it on a new one.",
  },
  {
    question: "How many devices can I use Picmal on?",
    answer:
      "Each license lets you use Picmal on that number of different Macs — for example, the 2-device license works on two Macs, the 5-device license on five, and so on.",
  },
  {
    question: "Can I use Picmal on multiple Macs?",
    answer:
      "While your license is tied to one active device at a time, you can transfer it between your Macs. Simply deactivate the license from your current Mac and activate it on another Mac when needed.",
  },
  {
    question: "What happens if I get a new Mac?",
    answer:
      "You can easily transfer your Picmal license to your new Mac. Just deactivate the license on your old Mac (via Picmal → Register license), then install Picmal on your new Mac and activate it with your existing license key.",
  },
  {
    question: "Can I get a refund?",
    answer:
      "Yes, there is a 14-day money-back guarantee. No questions asked. If you're not satisfied with Picmal, send your refund request to support@picmal.app and I'd love to hear your feedback too!",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <FAQSchema />
  </head>
  <body class="bg-background">
    <Header />

    <!-- Hero Section -->
    <main id="main-content" class="relative z-10 px-6 pt-32 pb-16">
      <!-- Background Images -->
      <div class="absolute inset-0 -z-10 overflow-hidden hidden md:block">
        <Image
          src="/background.png"
          alt=""
          class="w-full h-full object-cover block dark:hidden"
          width={1920}
          height={1080}
          loading="eager"
        />
        <Image
          src="/background_dark.png"
          alt=""
          class="w-full h-full object-cover hidden dark:block opacity-10"
          width={1920}
          height={1080}
          loading="eager"
        />
      </div>

      <div class="max-w-5xl mx-auto text-center">
        <div class="max-w-3xl mx-auto">
          <H1 class="mb-6">
            Convert & compress multiple images without leaving your Mac
          </H1>
          <Paragraph class="mb-8 max-w-xl mx-auto">
            Picmal makes converting and compressing images a breeze. Convert or
            compress batches of images, entirely offline on your Mac—fast and
            private.
          </Paragraph>
        </div>

        <div class="flex flex-col items-center gap-4 mb-16">
          <div
            class="flex flex-col sm:flex-row gap-3 items-center justify-center"
          >
            <Button text="Buy for Mac" />
            <a
              href="/apps/picmal/updates/Picmal.dmg"
              class="block rounded-lg transition-colors text-center cursor-pointer font-semibold px-6 text-base py-3 bg-background-subtle text-text hover:bg-background border border-text/10"
            >
              <svg
                class="w-4 h-4 inline-block mr-2"
                fill="currentColor"
                stroke="none"
                viewBox="0 0 24 24"
                ><path
                  d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8 4.35 4.35 0 0 1-2.59-4.03z"
                ></path></svg
              >
              Download
            </a>
          </div>
          <Paragraph size="small">
            One-time purchase • 14-day money back guarantee
          </Paragraph>
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-4xl mx-auto mb-12 rounded-xl overflow-hidden border border-text-secondary/20"
        >
          <video
            src="/main.mp4"
            class="w-full h-auto block dark:hidden"
            autoplay
            loop
            muted
            playsinline
            aria-label="Picmal app interface showing drag and drop conversion"
          >
          </video>
          <video
            src="/main_dark.mp4"
            class="w-full h-auto hidden dark:block"
            autoplay
            loop
            muted
            playsinline
            aria-label="Picmal app interface showing drag and drop conversion"
          >
          </video>
        </div>
      </div>
    </main>

    <!-- Testimonials Marquee - Full Width -->
    <section class="relative z-10 pb-16">
      <Testimonials />
    </section>

    <!-- Convert Between Formats Section -->
    <section id="features" class="relative z-10 px-6 py-20">
      <div class="max-w-5xl mx-auto">
        <H2 class="mb-6 text-center">Convert between<br />20+ formats</H2>
        <Paragraph class="text-center mb-12 max-w-xl mx-auto">
          From PSD to PNG, RAW to JPEG, or AI to SVG—handle any image format
          with professional-grade quality. No technical knowledge needed.
        </Paragraph>

        <!-- Demo Interface -->
        <div
          class="max-w-4xl mx-auto mb-12 rounded-xl overflow-hidden border border-text-secondary/20"
        >
          <video
            src="/convert.mp4"
            class="w-full h-auto block dark:hidden"
            autoplay
            loop
            muted
            playsinline
            aria-label="Picmal conversion interface showing PNG to WEBP conversion"
          >
          </video>
          <video
            src="/convert_dark.mp4"
            class="w-full h-auto hidden dark:block"
            autoplay
            loop
            muted
            playsinline
            aria-label="Picmal conversion interface showing PNG to WEBP conversion"
          >
          </video>
        </div>
      </div>
    </section>

    <!-- Compress Section -->
    <section class="relative z-10 px-6 py-20">
      <div class="max-w-5xl mx-auto">
        <H2 class="mb-6 text-center"
          >Compress without<br />compromising quality</H2
        >
        <Paragraph class="text-center mb-12 max-w-xl mx-auto">
          Reduce file sizes while maintaining visual quality. Perfect for web
          optimization, email attachments, or freeing up storage space.
        </Paragraph>

        <!-- Compression Demo -->
        <div
          class="max-w-4xl mx-auto mb-12 rounded-xl overflow-hidden border border-text-secondary/20"
        >
          <video
            src="/compress.mp4"
            class="w-full h-auto block dark:hidden"
            autoplay
            loop
            muted
            playsinline
            aria-label="Picmal compression interface showing multiple images ready for compression"
          >
          </video>
          <video
            src="/compress_dark.mp4"
            class="w-full h-auto hidden dark:block"
            autoplay
            loop
            muted
            playsinline
            aria-label="Picmal compression interface showing multiple images ready for compression"
          >
          </video>
        </div>
      </div>
    </section>

    <!-- And More Features Section -->
