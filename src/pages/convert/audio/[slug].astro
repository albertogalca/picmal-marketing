---
import MarketingLayout from "../../../layouts/MarketingLayout.astro";
import BlockGrid from "../../../components/BlockGrid.astro";
import ComparisonHero from "../../../components/ComparisonHero.astro";
import ProductSchema from "../../../components/schema/ProductSchema.astro";
import Section from "../../../components/Section.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import BenefitsCard from "../../../components/BenefitsCard.astro";
import ConversionGrid from "../../../components/ConversionGrid.astro";
import FAQSection from "../../../components/FAQSection.astro";
import FAQSchema from "../../../components/schema/FAQSchema.astro";
import GuideCrossLink from "../../../components/GuideCrossLink.astro";

import {
  audioConversions,
  audioFormats,
  getRelatedAudioConversions,
  isAudioConversionIndexed,
} from "../../../data/audioConversions";

export function getStaticPaths() {
  return audioConversions.map((c) => ({
    params: { slug: c.slug },
    props: { conversion: c },
  }));
}

const { conversion } = Astro.props;

// Blog post cross-links for audio conversion pages
const blogGuides: Record<string, { title: string; slug: string }> = {
  "flac-to-alac": {
    title: "How to Convert FLAC to ALAC on Mac (4 Free Methods)",
    slug: "convert-flac-to-alac-mac",
  },
  "wav-to-mp3": {
    title: "How to Convert WAV to MP3 on Mac (3 Free Methods)",
    slug: "convert-wav-to-mp3-mac",
  },
};
const blogGuide = blogGuides[conversion.slug];
const from = audioFormats[conversion.from];
const to = audioFormats[conversion.to];
const related = getRelatedAudioConversions(conversion.slug, 6);

const title = conversion.metaTitle;
const description = conversion.metaDescription;

// Low-demand templated pairs are de-indexed to concentrate site quality on winners.
const noindex = !isAudioConversionIndexed(conversion.slug);
---

<MarketingLayout
  title={title}
  description={description}
  noindex={noindex}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema faqs={conversion.faqs} />
  </Fragment>

  <ComparisonHero
    pricingHref="/#pricing"
    title={`Convert ${from.name} to ${to.name} on Mac`}
    subhead={conversion.whyConvert}
    buyEvent={`buy_clicked_audio_${conversion.slug}`}
    defaultTab="convert"
  />

  <!-- Benefits -->
  <Section width="narrow">
    <BenefitsCard
      heading={`Why convert ${from.name} to ${to.name} with Picmal`}
      benefits={conversion.benefits}
    />
  </Section>

  <!-- How it works -->
  <BlockGrid ordered
    heading="Convert in 3 steps"
    items={[
      {
        title: `Drop your ${from.name} files`,
        description: "Drag and drop one file or a whole folder.",
      },
      {
        title: `Choose ${to.name}`,
        description: "Pick the output format and quality.",
      },
      {
        title: "Convert",
        description: "Click Convert. Everything runs on your Mac.",
      },
    ]}
  />

  <!-- FAQ -->
  <FAQSection faqs={conversion.faqs} />

  {
    blogGuide && (
      <GuideCrossLink
        href={`/blog/${blogGuide.slug}`}
        title={blogGuide.title}
      />
    )
  }

  <!-- Related audio conversions -->
  <Section>
    <SectionHeading class="mb-8">More audio conversions</SectionHeading>
    <ConversionGrid
      links={related.map((c) => ({
        href: `/convert/audio/${c.slug}`,
        label: `${audioFormats[c.from].name} to ${audioFormats[c.to].name}`,
      }))}
      linkText="All audio conversions"
      linkHref="/audio-converter-mac"
    />
  </Section>
</MarketingLayout>
