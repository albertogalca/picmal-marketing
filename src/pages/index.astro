---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import WebSiteSchema from "../components/schema/WebSiteSchema.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import FAQSchema, { faqs } from "../components/schema/FAQSchema.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Button from "../components/Button.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import Paragraph from "../components/Paragraph.astro";
import FeaturedOn from "../components/FeaturedOn.astro";
import SectionDivider from "../components/SectionDivider.astro";
import BentoFeatures from "../components/BentoFeatures.astro";
import SegmentedControl from "../components/SegmentedControl.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import CompressFormatsModal from "../components/CompressFormatsModal.astro";
import TrustBar from "../components/TrustBar.astro";
import PricingSection from "../components/PricingSection.astro";
import FeaturedReview from "../components/FeaturedReview.astro";
import Lead from "../components/Lead.astro";
import { getEntryUrl, isStandalone } from "../utils/changelog";

const SITE_TITLE = "Convert, Compress & Create Media on Mac | Picmal";
const SITE_DESCRIPTION =
  "Your Mac's media toolkit. Batch convert and compress images, video, and audio, combine PDFs, and turn images into PDFs — all on your Mac. No internet needed, no subscription.";

const changelogEntries = await getCollection("changelog");
const latestRelease = changelogEntries.sort((a, b) =>
  b.data.version.localeCompare(a.data.version, undefined, {
    numeric: true,
    sensitivity: "base",
  }),
)[0];
const latestReleaseHref = isStandalone(latestRelease)
  ? getEntryUrl(latestRelease)
  : `/changelog#v${latestRelease.data.version}`;
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <WebSiteSchema url={Astro.site!.href} />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <!-- Hero Section -->
    <main id="main-content" class="relative z-10 pt-32 pb-16 sm:pb-20">
      <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12 sm:mb-16">
          <div
            class="max-w-4xl mx-auto flex justify-center items-center flex-col"
          >
            <a
              href={latestReleaseHref}
              class="group/release mb-6 inline-flex items-center gap-2 max-w-full rounded-full border border-border bg-background-subtle py-1 pl-1 pr-3 text-body-sm text-text-secondary whitespace-nowrap hover:text-text hover:border-border/60 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
            >
              <span
                class="shrink-0 rounded-full bg-accent/10 px-2 py-0.5 text-caption font-semibold leading-none text-accent"
                >v{latestRelease.data.version}</span
              >
              <span class="hidden sm:inline truncate"
                >{latestRelease.data.title}</span
              >
              <span class="sm:hidden">What's new</span>
              <span
                class="shrink-0 transition-transform duration-200 ease-out motion-safe:group-hover/release:translate-x-0.5"
                aria-hidden="true">&rarr;</span
              >
            </a>
            <H1 class="mb-6 max-w-2xl mx-auto">Your Mac's media toolkit</H1>
            <Lead class="mb-6 sm:mb-8 max-w-xl mx-auto px-4 sm:px-0">
              Convert, compress, and create multiple files from different types
              of media, like images, videos, and audio. Everything works offline
              and respects your privacy.
            </Lead>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col items-center gap-4 sm:gap-6">
            <div
              class="flex flex-col sm:flex-row gap-3 items-center justify-center w-full sm:w-auto"
            >
              <Button
                text="Get Picmal for $15.99"
                id="buy-cta-button"
                class="w-full sm:w-auto"
              />
              <a
                href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg"
                class="block rounded-lg transition-[colors,scale] duration-200 active:scale-[0.96] text-center cursor-pointer font-semibold px-6 text-body py-3 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto"
                id="download-cta-button"
              >
                <svg
                  class="size-4 inline-block mr-2"
                  fill="currentColor"
                  stroke="none"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  ><path
                    d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8 4.35 4.35 0 0 1-2.59-4.03z"
                  ></path></svg
                >
                Download
              </a>
            </div>

            <!-- Social Proof & Guarantee -->
            <div class="flex flex-col items-center gap-3">
              <TrustBar />
              <p class="text-body-sm text-text-secondary text-pretty">
                One payment, yours for good • 14-day money back
              </p>
            </div>
          </div>
        </div>

        <!-- Demo Video + filter -->
        <div class="max-w-5xl mx-auto mt-8 sm:mt-12">
          <SegmentedControl
            ariaLabel="Filter demo by action"
            mode="tabs"
            segmentClass="hero-demo-tab"
            activeId="convert"
            segments={[
              { id: "convert", label: "Convert" },
              { id: "compress", label: "Compress" },
              { id: "pdf", label: "PDF" },
            ]}
          />
          <div
            class="mt-6 rounded-lg sm:rounded-xl overflow-hidden border border-border"
          >
            <div class="aspect-video bg-background-subtle">
              <video
                id="hero-demo-video"
                class="w-full h-full object-cover opacity-0 motion-safe:transition-opacity motion-safe:duration-300 ease-out"
                width="1920"
                height="1080"
                autoplay
                loop
                muted
                playsinline
                preload="metadata"
                aria-label="Picmal demo"
              >
              </video>
            </div>
          </div>
        </div>
      </div>
      <FeaturedReview />
    </main>

    <SectionDivider />

    <section id="features" class="relative z-10">
      <BentoFeatures />
    </section>

    <SectionDivider />

    <section id="testimonials" class="relative z-10">
      <MasonryTestimonials />
    </section>

    <section id="featured" class="relative z-10">
      <FeaturedOn />
    </section>

    <!-- Pricing -->
    <section
      id="pricing"
      class="relative z-10 px-6 py-16 sm:py-20 bg-background-subtle/50 border-y border-border"
    >
      <PricingSection />
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <H2 class="mb-4">Frequently Asked Questions</H2>
          <Paragraph class="max-w-2xl mx-auto">
            Something not covered here? Write to support@picmal.app
          </Paragraph>
        </div>
        <div
          class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />

    <!-- Modal rendered at page level to avoid z-index issues -->
    <SupportedFormatsModal />
    <CompressFormatsModal />

    <!-- Hero demo filter: swap video by action -->
    <script>
      const heroVideo = document.getElementById(
        "hero-demo-video",
      ) as HTMLVideoElement | null;
      if (heroVideo) {
        const sources: Record<string, { label: string; src: string }> = {
          convert: { label: "Convert", src: "/convert.mp4" },
          compress: { label: "Compress", src: "/compress.mp4" },
          pdf: { label: "PDF", src: "/pdf.mp4" },
        };
        let currentId = "convert";

        heroVideo.addEventListener("loadeddata", () => {
          heroVideo.classList.remove("opacity-0");
        });

        function setVideo(id: string) {
          const pair = sources[id];
          if (!pair) return;
          heroVideo!.setAttribute("aria-label", `Picmal ${pair.label} demo`);
          if (
            heroVideo!.src === new URL(pair.src, window.location.origin).href
          )
            return;
          heroVideo!.classList.add("opacity-0");
          heroVideo!.src = pair.src;
          heroVideo!.load();
          heroVideo!.play().catch(() => {});
        }

        setVideo(currentId);

        document.querySelectorAll(".hero-demo-tab").forEach((btn) => {
          btn.addEventListener("click", () => {
            const id = (btn as HTMLElement).dataset.segment;
            if (!id || id === currentId) return;
            currentId = id;
            document.querySelectorAll(".hero-demo-tab").forEach((b) => {
              const active = b === btn;
              b.classList.toggle("active", active);
              b.setAttribute("aria-selected", active ? "true" : "false");
            });
            setVideo(id);
          });
        });
      }
    </script>

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "cantimplorastudio" };
    </script>
    <script
      src="https://lmsqueezy.com/affiliate.js"
      defer
      onerror="console.warn('Failed to load Lemon Squeezy affiliate script')"
    ></script>

    <!-- PostHog Analytics with keyboard accessibility -->
    <script>
      // Track buy button clicks (both mouse and keyboard)
      document
        .getElementById("buy-cta-button")
        ?.addEventListener("click", () => {
          if (typeof posthog !== "undefined") posthog.capture("buy_clicked");
        });

      // Track download button clicks
      document
        .getElementById("download-cta-button")
        ?.addEventListener("click", () => {
          if (typeof posthog !== "undefined")
            posthog.capture("download_clicked");
        });
    </script>
  </body>
</html>
