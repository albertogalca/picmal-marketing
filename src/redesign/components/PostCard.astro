---
import type { CollectionEntry } from "astro:content";
import { postCover, postCoverDark, displayCategory } from "../../utils/posts";

// Uses the real generated covers (scripts/generate-blog-covers.js --cards):
// they already are the pixel art, drawn by the same dune as PixelField.
interface Props { post: CollectionEntry<"blog">; excerpt?: boolean; base?: string }
const { post, excerpt = false, base = "/next/blog" } = Astro.props;
const cover = postCover(post);
const coverDark = postCoverDark(post);
const date = post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<a class="pm-post" href={`${base}/${post.id}`}>
  <div class="pm-post__img">
    <img src={typeof cover === "string" ? cover : cover.src} alt="" loading="lazy" class={coverDark ? "pm-light-only" : undefined} />
    {coverDark && <img src={coverDark} alt="" loading="lazy" class="pm-dark-only" />}
  </div>
  <div class="pm-post__meta">{[displayCategory(post.data.category), date].filter(Boolean).join(" · ")}</div>
  <div class="pm-post__title">{post.data.title}</div>
  {excerpt && <p class="pm-post__excerpt">{post.data.description}</p>}
</a>
