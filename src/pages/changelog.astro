---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import Paragraph from "../components/Paragraph.astro";
import { SITE_TITLE } from "../consts";
import { getCollection, render } from "astro:content";
import { getEntrySlug, sortEntries } from "../utils/changelog";
import "../styles/global.css";

const entries = sortEntries(await getCollection("changelog"));

// Render every release's full notes inline so /changelog is the single
// scrollable source of truth (CleanShot/Linear style).
const rows = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    const version = entry.data.version;
    return {
      version,
      slug: getEntrySlug(entry),
      title: entry.data.title ?? `Version ${version}`,
      pubDate: entry.data.pubDate,
      Content,
      downloadUrl: `https://github.com/albertogalca/picmal-releases/releases/download/v${version}/Picmal.dmg`,
      hasDownload:
        version.localeCompare("1.2.7", undefined, { numeric: true }) >= 0,
    };
  }),
);

const latestVersion = entries[0]?.data.version ?? "1.0.0";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE_TITLE,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "macOS",
  softwareVersion: latestVersion,
  url: "https://picmal.app/changelog",
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Picmal: Changelog"
      description="Full changelog and release notes for Picmal, the macOS image converter. See every new feature, format addition, performance boost and bug fix shipped across versions."
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: "Picmal Changelog",
        description: "Version history and release notes for Picmal",
        itemListElement: rows.map((row, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: `Picmal v${row.version} - ${row.title}`,
          url: `https://picmal.app/changelog#${row.slug}`,
        })),
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(softwareSchema)}
    />
  </head>
  <body class="bg-background text-text min-h-dvh overflow-x-hidden">
    <Header />

    <main class="relative z-10 pt-32 pb-20">
      <div class="max-w-5xl mx-auto px-6">
        <SectionHeading
          level={1}
          sublead="Latest updates, new features, and improvements to Picmal."
        >
          Changelog
        </SectionHeading>

        <Card class="mb-16 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 sm:gap-6">
          <Paragraph class="mb-0 flex-1">
            As an indie developer, Picmal grows through word of mouth. A review
            only takes a minute and makes a huge difference.
          </Paragraph>
          <Button
            href="https://tally.so/r/Me18qE"
            text="Leave a Review"
            size="small"
            class="w-full sm:w-auto whitespace-nowrap"
          />
        </Card>
        {
          rows.map((row) => (
            <article
              id={row.slug}
              class="scroll-mt-28 border-t border-border first:border-t-0 pt-12 pb-16 first:pt-0 last:pb-0"
            >
              {/* version anchor preserved for legacy #v<version> deep links */}
              <span id={`v${row.version}`} class="block scroll-mt-28" />

              <div class="flex flex-col gap-3 sm:grid sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-x-10">
                {/* Left: metadata */}
                <div class="flex flex-wrap items-center gap-3 sm:flex-col sm:items-start sm:gap-1.5 sm:sticky sm:top-28 sm:self-start sm:pt-2">
                  <span class="inline-block text-small font-semibold leading-none px-2 py-0.5 rounded-xl bg-accent/10 text-accent">
                    v{row.version}
                  </span>
                  {row.pubDate && (
                    <span class="text-small text-text-secondary">
                      <FormattedDate date={row.pubDate} />
                    </span>
                  )}
                  {row.hasDownload && (
                    <a
                      href={row.downloadUrl}
                      class="flex items-center gap-1.5 text-small text-text-secondary sm:mt-1 transition-colors duration-150 hover:text-text rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                        <polyline points="7 10 12 15 17 10" />
                        <line x1="12" y1="15" x2="12" y2="3" />
                      </svg>
                      Download
                    </a>
                  )}
                </div>

                {/* Right: title + full release notes */}
                <div class="min-w-0">
                  <h2 class="text-h2 text-text text-balance mb-3">
                    <a
                      href={`#${row.slug}`}
                      class="rounded-xl hover:text-accent transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                    >
                      {row.title}
                    </a>
                  </h2>
                  <div
                    class="release-notes prose max-w-none
                      prose-headings:text-text prose-headings:font-semibold
                      prose-p:text-text-secondary prose-p:leading-relaxed
                      prose-strong:text-text
                      prose-ul:text-text-secondary
                      prose-ol:text-text-secondary
                      prose-li:text-text-secondary
                      prose-img:rounded-lg prose-img:border prose-img:border-border"
                  >
                    <row.Content />
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </main>

    <Footer />

    <style>
      /* Release notes read at a comfortable measure while the app screenshots
         keep the full column. 56ch lands at ~75 characters here: `ch` is the
         width of "0", which runs wider than the average glyph in SF Pro Text.
         Children come from the MDX collection, so they need :global() to
         escape Astro's scoping. */
      .release-notes :global(:is(p, li, h2, h3, h4, blockquote)) {
        max-width: 56ch;
      }
      .release-notes :global(:is(p, li):has(> img)) {
        max-width: none;
      }
    </style>
  </body>
</html>
