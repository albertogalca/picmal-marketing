---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import FormattedDate from "./FormattedDate.astro";
import ogImage from "../../public/og.png";

interface Props {
  currentSlug: string;
  category?: string;
  tags?: string[];
  limit?: number;
}

const { currentSlug, category, tags = [], limit = 2 } = Astro.props;

// Get all blog posts
const allPosts = await getCollection("blog");

// Filter and sort related posts
const relatedPosts = allPosts
  .filter((post) => post.id !== currentSlug) // Exclude current post
  .map((post) => {
    let relevanceScore = 0;

    // Score by matching category
    if (category && post.data.category === category) {
      relevanceScore += 10;
    }

    // Score by matching tags
    const postTags = post.data.tags || [];
    const matchingTags = tags.filter((tag) =>
      postTags.some(
        (postTag: string) => postTag.toLowerCase() === tag.toLowerCase()
      )
    );
    relevanceScore += matchingTags.length * 5;

    return { post, relevanceScore };
  })
  .filter((item) => item.relevanceScore > 0) // Only posts with some relevance
  .sort((a, b) => {
    // Sort by relevance first, then by date
    if (b.relevanceScore !== a.relevanceScore) {
      return b.relevanceScore - a.relevanceScore;
    }
    return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
  })
  .slice(0, limit)
  .map((item) => item.post);

// If no related posts by category/tags, show recent posts
const postsToShow =
  relatedPosts.length > 0
    ? relatedPosts
    : allPosts
        .filter((post) => post.id !== currentSlug)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
        .slice(0, limit);
---

{
  postsToShow.length > 0 && (
    <section class="mt-16 pt-12 border-t border-border">
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-text mb-2">
          {relatedPosts.length > 0 ? "Related articles" : "Recent articles"}
        </h2>
        <p class="text-text-secondary">
          {relatedPosts.length > 0
            ? "Continue exploring similar topics"
            : "Check out our latest posts"}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {postsToShow.map((post) => (
          <article class="group">
            <a
              href={`/blog/${post.id}`}
              class="block rounded-lg border border-border bg-background-subtle hover:border-accent/50 transition-all duration-200 overflow-hidden h-full"
            >
              <div class="aspect-video overflow-hidden bg-background-subtle">
                <Image
                  src={post.data.heroImage || ogImage}
                  alt={post.data.title}
                  width={400}
                  height={225}
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                />
              </div>

              <div class="p-5">
                {post.data.category && (
                  <span class="inline-block px-2 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-3">
                    {post.data.category}
                  </span>
                )}

                <h3 class="text-lg font-semibold text-text mb-2 group-hover:text-accent transition-colors line-clamp-2">
                  {post.data.title}
                </h3>

                <p class="text-sm text-text-secondary mb-3 line-clamp-2">
                  {post.data.description}
                </p>

                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="text-xs text-text-secondary"
                >
                  <FormattedDate date={post.data.pubDate} />
                </time>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  )
}

