---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import PricingSection from "../../components/PricingSection.astro";
import FounderLetter from "../../components/FounderLetter.astro";
import Section from "../../components/Section.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import AlternativeVerdict from "../../components/AlternativeVerdict.astro";
import RelatedGrid from "../../components/RelatedGrid.astro";
import Paragraph from "../../components/Paragraph.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";
import FAQSection from "../../components/FAQSection.astro";

const SITE_DESCRIPTION =
  "Want a HandBrake alternative on Mac? Picmal handles images, video, audio, and PDFs in one native Mac app. Convert, compress, and edit, with Shortcuts and folder monitoring. Files never leave your Mac. Pay $29 once.";

const faqs = [
  {
    question: "Is Picmal a good HandBrake alternative?",
    answer:
      "If you're on a Mac and also work with images, audio, and PDFs, yes. Picmal is a native Mac app, it works with Shortcuts, and it handles more file types. HandBrake is the better pick if you want deep video encoding controls and would rather not pay for an app.",
  },
  {
    question: "Why pay for Picmal when HandBrake is free?",
    answer:
      "HandBrake is great at video encoding, and it costs nothing. Picmal adds image conversion, audio, PDF tools, folder monitoring, and a Finder right-click, and it feels like a real Mac app. If video encoding is all you need, HandBrake is honestly a fine choice.",
  },
  {
    question: "Can Picmal convert images? Can HandBrake?",
    answer:
      "Picmal converts 20+ image formats (HEIC, JPG, PNG, WebP, and more) and reads RAW files. HandBrake is video only. It doesn't touch images.",
  },
  {
    question: "Does HandBrake have more video options than Picmal?",
    answer:
      "Yes. Device presets, CRF tuning, DVD and Blu-ray ripping, subtitle tracks, HDR. HandBrake goes deep on video. Picmal picks good defaults so you don't have to think about codecs, and it also handles images, audio, and PDFs.",
  },
  {
    question: "Does Picmal work on Windows or Linux like HandBrake?",
    answer:
      "No. Picmal is Mac-only. HandBrake runs on Windows and Linux too.",
  },
  {
    question: "What is the best free HandBrake alternative on Mac?",
    answer:
      "Honestly, for pure video encoding there isn't one. ffmpeg does more but lives in the Terminal, and QuickTime and VLC only cover basic exports. If HandBrake's interface is the problem rather than the price, that's the gap paid apps like Picmal fill: simpler, native, and covering images, audio, and PDFs too.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Just email support@picmal.app.",
  },
];
---

<MarketingLayout
  title="Picmal: The HandBrake alternative for Mac, no presets"
  description={SITE_DESCRIPTION}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
        <FAQSchema faqs={faqs} />
  </Fragment>

  <ComparisonHero
    title="A native Mac HandBrake alternative"
    subhead="HandBrake is powerful and free. If you also work with images, audio, and PDFs, and you want something that feels like a proper Mac app, Picmal handles all of it for $29."
    buyEvent="buy_clicked_handbrake_comparison"
  />

  <ComparisonVerdict
    competitor="HandBrake"
    summary="HandBrake is free, open source, and runs on Windows, Linux, and Mac with serious encoding controls. Picmal is Mac only and costs $29 once. It handles images, audio, and PDFs alongside video, and it feels at home on your Mac. Neither one uploads your files."
    picmalFor="You're on a Mac and you need images, audio, or PDFs as well as video. Or you just want an app that feels native and works with Shortcuts."
    competitorFor="You need CRF tuning, device presets, DVD or Blu-ray ripping, or Windows and Linux support. And free matters to you."
  />

  <!-- Why people look for an alternative -->
  <Section width="narrow">
    <SectionHeading align="left">
      Why people go looking for a HandBrake alternative
    </SectionHeading>
    <div class="space-y-4">
      <Paragraph>
        Rarely because HandBrake is bad. It's free, open source, and after two
        decades it's still the reference tool for video encoding. When people
        search for an alternative, it's usually one of three things.
      </Paragraph>
      <Paragraph>
        <strong class="text-text">The interface asks a lot.</strong> Presets,
        CRF values, encoder tuning, filter tabs. If you know video, that
        depth is the whole point. If you just want this MOV as a smaller MP4,
        it's a wall of decisions you didn't want to make.
      </Paragraph>
      <Paragraph>
        <strong class="text-text">It only does video.</strong> The same
        project that produced the screen recording usually comes with
        screenshots to compress, audio to convert, or a PDF to shrink.
        HandBrake handles none of that, so you end up with a folder of
        single-purpose tools.
      </Paragraph>
      <Paragraph>
        <strong class="text-text">It doesn't feel like a Mac app.</strong> No
        Finder right-click, no Shortcuts actions, no folder watching. It runs
        fine on a Mac, it just doesn't plug into one.
      </Paragraph>
      <Paragraph>
        If none of those bother you, keep HandBrake, it's excellent. If they
        do, that's the gap I built <a href="/" class="link">Picmal</a> for:
        drag files in, pick a format, done, and it covers
        <a href="/compress-video-mac" class="link">video compression</a>,
        images, audio, and PDFs in one app.
      </Paragraph>
    </div>
  </Section>

  <!-- Comparison Table -->
  <Section width="default">
    <SectionHeading>
      Picmal vs HandBrake at a glance
      <Fragment slot="sublead">
        HandBrake is a free video encoder with serious encoding controls.
        Picmal is a paid Mac app that handles images, audio, and PDFs as well
        as video, with a simpler interface. Different tradeoffs, so pick the
        one that fits.
      </Fragment>
    </SectionHeading>
    <ComparisonTable
      competitor="HandBrake"
      rows={[
      {
        feature: "Price",
        picmal: "$29 one-time",
        competitor: "Free (open source)",
      },
      {
        feature: "Platforms",
        picmal: "macOS only",
        competitor: "Windows, Mac, Linux",
      },
      {
        feature: "Privacy",
        picmal: "100% offline",
        competitor: "100% offline",
      },
      {
        feature: "Interface",
        picmal: "Native macOS, clean UI",
        competitor: "Cross-platform, gets the job done",
      },
      {
        feature: "Image conversion",
        picmal: "Yes, 20+ formats",
        competitor: "No",
      },
      {
        feature: "Video conversion",
        picmal: "Yes, common formats",
        competitor: "Yes, advanced encoding options",
      },
      {
        feature: "Audio conversion",
        picmal: "Yes, MP3, WAV, FLAC, and more",
        competitor: "Audio within video only",
      },
      {
        feature: "Compression",
        picmal: "Images, video, audio &amp; PDF",
        competitor: "Video encoding only",
      },
      {
        feature: "PDF tools",
        picmal: "Yes, compress, combine, images&rarr;PDF",
        competitor: "No",
      },
      {
        feature: "DVD/BluRay ripping",
        picmal: "No",
        competitor: "Yes (unprotected)",
      },
      {
        feature: "Device presets",
        picmal: "No",
        competitor: "Yes, Apple, Android, web, and more",
      },
      {
        feature: "Video filters",
        picmal: "Basic",
        competitor: "Advanced (deinterlace, denoise, HDR)",
      },
      {
        feature: "Subtitle support",
        picmal: "No",
        competitor: "Yes, SRT, SSA, VobSub, CEA-608",
      },
      {
        feature: "Metadata removal",
        picmal: "Yes",
        competitor: "Limited",
      },
      {
        feature: "Shortcuts integration",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "Folder monitoring",
        picmal: "Yes",
        competitor: "No",
      },
      {
        feature: "Finder right-click",
        picmal: "Yes",
        competitor: "No",
      },
    ]}
    />
  </Section>

  <!-- Who Picmal Is For / Who Should Stick with HandBrake -->
  <AlternativeVerdict
    sublead="Here's where each one makes more sense."
    picmal={{
      heading: "Choose Picmal",
      lead: "Mac-native. Images, audio, PDFs, and video in one place.",
      items: [
        "You want to convert, compress, and edit images, video, audio, and PDFs without juggling five apps",
        "You automate things with Apple Shortcuts",
        "You want an app that actually looks and feels like a Mac app",
        "You want folder monitoring and a Finder right-click",
      ],
    }}
    rival={{
      heading: "Choose HandBrake",
      lead: "Free, powerful video encoding, runs everywhere.",
      items: [
        "Video transcoding and encoding is all you need",
        "You're on Windows or Linux",
        "You'd rather not pay for an app",
        "You need DVD or Blu-ray ripping, or subtitle tracks",
      ],
    }}
  />

  <!-- Features -->
  <FeatureGrid
    heading="Everything else Picmal does"
    subleadIntro="One app for images, video, audio, and PDFs. Convert, compress, and edit, all on your Mac."
  />

  <!-- Testimonials Section -->

  <!-- Related guides -->
  <RelatedGrid
    heading="Related guides"
    links={[
      {
        href: "/blog/compress-video-with-handbrake",
        label: "HandBrake settings for compressing video",
      },
      {
        href: "/blog/best-media-converter-mac-2026",
        label: "The best media converter for Mac in 2026",
      },
    ]}
  />

  <MasonryTestimonials />

  <!-- Pricing -->
  <PricingSection />

  <!-- Founder letter -->
  <FounderLetter />

  <!-- FAQ Section -->
  <FAQSection
    faqs={faqs}
    heading="Frequently asked questions"
    sublead="Can't find what you're looking for? Email support@picmal.app"
  />

  <Fragment slot="after">
    <SupportedFormatsModal />
  </Fragment>
</MarketingLayout>
