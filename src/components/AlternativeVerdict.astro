---
import Card from "./Card.astro";
import H3 from "./H3.astro";
import Paragraph from "./Paragraph.astro";
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";

/**
 * AlternativeVerdict - the "which one is right for you?" block on the
 * /alternative pages. Two columns, each an affirmative list: reasons to pick
 * Picmal, and reasons to stay where you are.
 *
 * Both columns use a check, because both list reasons FOR that choice. Only
 * the colour differs: accent on the Picmal side, secondary ink on the other,
 * so the page has a point of view without calling the alternative wrong.
 */
interface Column {
  heading: string;
  lead: string;
  items: string[];
}

interface Props {
  picmal: Column;
  rival: Column;
  sublead?: string;
}

const {
  picmal,
  rival,
  sublead = "Here's where each one makes more sense.",
} = Astro.props;

const columns = [
  { column: picmal, tone: "text-accent" },
  { column: rival, tone: "text-text-secondary" },
];
---

<Section width="default">
  <SectionHeading>
    Which one is right for you?
    <Fragment slot="sublead">{sublead}</Fragment>
  </SectionHeading>

  <div class="grid md:grid-cols-2 gap-6">
    {
      columns.map(({ column, tone }) => (
        <Card>
          <div class="mb-6">
            <H3 class="mb-2">{column.heading}</H3>
            <Paragraph color="secondary">{column.lead}</Paragraph>
          </div>

          <ul class="space-y-4">
            {column.items.map((item) => (
              <li class="flex gap-3 items-start">
                <svg
                  class:list={["w-6 h-6 flex-shrink-0 mt-0.5", tone]}
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
                <span class="text-text">{item}</span>
              </li>
            ))}
          </ul>
        </Card>
      ))
    }
  </div>
</Section>
