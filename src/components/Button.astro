---
import { cn } from "../utils/cn";
import { TIERS } from "../config/pricing";

export interface Props {
  class?: string;
  href?: string;
  /** Stripe Price ID. When set (or when no href is given) the button starts
   *  Stripe Checkout via licencio instead of navigating. Defaults to the 1-device tier. */
  priceId?: string;
  text?: string;
  size?: "small" | "normal";
  variant?: "primary" | "secondary" | "overlay";
  type?: "link" | "submit" | "button";
  disabled?: boolean;
  icon?: string;
  iconType?: "stroke" | "fill";
  id?: string;
  title?: string;
  ariaLabel?: string;
  target?: string;
  rel?: string;
  onclick?: string;
  download?: boolean | string;
}

const {
  class: className = "",
  href,
  priceId,
  text = "",
  size = "normal",
  variant = "primary",
  type = "link",
  disabled = false,
  icon,
  iconType = "stroke",
  id,
  title,
  ariaLabel,
  target = "_blank",
  rel = "noopener noreferrer",
  onclick,
  download,
} = Astro.props;

const isIconOnly = !!icon && !text;

const sizeClasses = {
  small: "text-small py-2 px-4 gap-1.5",
  normal: "text-body py-3 px-6 gap-2",
};

// Icon-only buttons: square, sized to meet/approach a 44px touch target.
const iconOnlySizeClasses = {
  small: "p-0 w-10 h-10",
  normal: "p-0 w-12 h-12",
};

const iconSizeClasses = {
  small: "w-4 h-4",
  normal: "w-5 h-5",
};

const variantClasses = {
  primary:
    "bg-accent text-white shadow-sm shadow-accent/25 hover:bg-accent-dark hover:shadow-md hover:shadow-accent/30",
  secondary:
    "bg-background text-text border border-border shadow-xs hover:bg-background-subtle hover:border-border/70 hover:shadow-sm",
  overlay: "bg-white text-black shadow-sm hover:bg-white/90 hover:shadow-md",
};

const layoutClasses = isIconOnly
  ? iconOnlySizeClasses[size]
  : sizeClasses[size];

const baseClasses = cn(
  "inline-flex items-center justify-center rounded-xl font-semibold cursor-pointer",
  "transition-[scale,box-shadow,background-color,border-color] duration-200 ease-out motion-reduce:transition-none",
  "active:scale-[0.97] active:shadow-sm motion-reduce:active:scale-100",
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
  "disabled:opacity-60 disabled:cursor-not-allowed disabled:shadow-none disabled:active:scale-100",
  layoutClasses,
  variantClasses[variant],
  className,
);

// Icon-only buttons need an accessible name; fall back to title if no aria-label.
const accessibleLabel = ariaLabel ?? (isIconOnly ? title : undefined);

const isStroke = iconType === "stroke";

// A link button with no explicit href (or an explicit priceId) is a buy button:
// it starts Stripe Checkout via the delegated handler below instead of navigating.
const isCheckout = type === "link" && href === undefined;
const checkoutPrice = priceId ?? TIERS[0].priceId;
---

{
  type === "link" ? (
    <a
      href={disabled ? undefined : isCheckout ? "#" : href}
      data-checkout-price={isCheckout ? checkoutPrice : undefined}
      target={isCheckout ? undefined : target}
      rel={rel}
      class={baseClasses}
      id={id}
      title={title}
      aria-label={accessibleLabel}
      aria-disabled={disabled || undefined}
      tabindex={disabled ? -1 : undefined}
      onclick={onclick}
      download={download}
    >
      {icon && (
        <svg
          class={iconSizeClasses[size]}
          fill={isStroke ? "none" : "currentColor"}
          stroke={isStroke ? "currentColor" : "none"}
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap={isStroke ? "round" : undefined}
            stroke-linejoin={isStroke ? "round" : undefined}
            stroke-width={isStroke ? 2 : undefined}
            d={icon}
          />
        </svg>
      )}
      {text}
    </a>
  ) : (
    <button
      disabled={disabled}
      type={type === "submit" ? "submit" : "button"}
      class={baseClasses}
      id={id}
      title={title}
      aria-label={accessibleLabel}
    >
      {icon && (
        <svg
          class={iconSizeClasses[size]}
          fill={isStroke ? "none" : "currentColor"}
          stroke={isStroke ? "currentColor" : "none"}
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap={isStroke ? "round" : undefined}
            stroke-linejoin={isStroke ? "round" : undefined}
            stroke-width={isStroke ? 2 : undefined}
            d={icon}
          />
        </svg>
      )}
      {text}
    </button>
  )
}

<script>
  // Delegated Stripe Checkout starter. Astro hoists this once for the whole site.
  // Any [data-checkout-price] element POSTs to licencio, which returns a Stripe
  // Checkout URL. ph_distinct_id is forwarded for purchase attribution (licencio side).
  import { LICENCIO_URL } from "../config/pricing";

  document.addEventListener("click", async (e) => {
    const target = e.target as Element | null;
    const el = target?.closest?.("[data-checkout-price]");
    if (!el) return;
    e.preventDefault();
    if (el.getAttribute("aria-busy") === "true") return; // ignore double-clicks
    el.setAttribute("aria-busy", "true");

    const ph = (window as any).posthog;
    try {
      const res = await fetch(`${LICENCIO_URL}/api/checkout`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          product_slug: "picmal",
          price_id: el.getAttribute("data-checkout-price"),
          ph_distinct_id: ph?.get_distinct_id?.() ?? null,
        }),
      });
      if (!res.ok) throw new Error(`checkout ${res.status}`);
      const { url } = await res.json();
      window.location.href = url;
    } catch (err) {
      el.setAttribute("aria-busy", "false");
      console.error("[checkout]", err);
      alert("Checkout is temporarily unavailable. Please try again in a moment.");
    }
  });
</script>
