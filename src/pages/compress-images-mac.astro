---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import H3 from "../components/H3.astro";
import Button from "../components/Button.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import Paragraph from "../components/Paragraph.astro";
import TrustBar from "../components/TrustBar.astro";
import SectionDivider from "../components/SectionDivider.astro";
import CTASection from "../components/CTASection.astro";
import BentoFeatures from "../components/BentoFeatures.astro";
import FeaturedOn from "../components/FeaturedOn.astro";

const SITE_TITLE = "Compress Images on Mac - Reduce File Size Up to 90%";
const SITE_DESCRIPTION =
  "Compress JPG, PNG, WebP, AVIF, and other image files on Mac. Reduce file sizes by up to 90% while maintaining visual quality. Batch processing, 100% offline, no file limits.";

const faqs = [
  {
    question: "How much can I compress image files?",
    answer:
      "Compression results vary by format and content. JPG images can typically be reduced by 50-80% with minimal quality loss. PNG images can be compressed 40-70%. Modern formats like WebP and AVIF offer even better compression, often 30-50% smaller than JPG at the same quality.",
  },
  {
    question: "Will image compression reduce quality?",
    answer:
      "Picmal gives you full control over the quality-to-size tradeoff. You can use lossless compression (no quality loss) or lossy compression (smaller files with minimal visual impact). Most users can't tell the difference at 85-90% quality settings.",
  },
  {
    question: "What's the best format for compressed images?",
    answer:
      "For photos, WebP or AVIF offer the best compression with excellent quality. For universal compatibility, use JPG at 85-90% quality. For graphics with transparency, use PNG with compression or WebP. For web use, AVIF provides the smallest files.",
  },
  {
    question: "Can I compress thousands of images at once?",
    answer:
      "Yes! Picmal is built for batch processing. Drop entire folders of images and compress them all with the same settings. No file count limits, and all processing happens in parallel for maximum speed.",
  },
  {
    question: "Does Picmal support lossless compression?",
    answer:
      "Yes. Picmal supports lossless compression for PNG, WebP, and AVIF formats. This reduces file size without any quality loss, perfect for archiving or when you need pixel-perfect results.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <OrganizationSchema url={Astro.site!.href} />
    <link
      rel="preload"
      href="/picmal-1.2.0-demo.mp4"
      as="video"
      type="video/mp4"
    />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <!-- Subtle gradient background - Apple style -->
    <div class="fixed inset-0 -z-20 apple-gradient"></div>

    <Header />

    <!-- Hero Section -->
    <main id="main-content" class="relative z-10 pt-32 pb-12 sm:pb-16 md:pb-20">

      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-8 sm:mb-12">
          <div
            class="max-w-4xl mx-auto flex justify-center items-center flex-col"
          >
            <H1 class="mb-4 sm:mb-6 max-w-2xl mx-auto hero-title">
              Compress images on Mac without losing quality
            </H1>
            <p
              class="mb-8 sm:mb-10 max-w-2xl mx-auto text-base sm:text-lg md:text-xl leading-relaxed text-text-secondary px-4 sm:px-0 hero-subtitle"
            >
              Reduce image file sizes by up to 90% while maintaining visual
              quality. Perfect for web, email, and storage. Batch process
              thousands of images offline.
            </p>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col items-center gap-3 sm:gap-4 hero-cta">
            <div
              class="flex flex-col sm:flex-row gap-2 items-center justify-center"
            >
              <Button
                text="Get Picmal for $15.99"
                onclick="posthog.capture('buy_clicked_compress_images_mac')"
                class="apple-button-primary"
              />
              <a
                href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg"
                class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-base py-3 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto apple-button-secondary"
              >
                <svg
                  class="w-4 h-4 inline-block mr-2"
                  fill="currentColor"
                  stroke="none"
                  viewBox="0 0 24 24"
                  ><path
                    d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8a4.35 4.35 0 0 1-2.59-4.03z"
                  ></path></svg
                >
                Download for Mac
              </a>
            </div>
            <p class="text-xs sm:text-sm text-text-secondary">
              One-time purchase • 14-day money back • macOS 14+
            </p>
          </div>

          <!-- Social Proof -->
          <div class="mt-6 sm:mt-8 hero-trust">
            <TrustBar />
          </div>
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-5xl mx-auto mb-6 sm:mb-8 rounded-lg sm:rounded-xl overflow-hidden border border-border hero-video"
        >
          <div class="aspect-[16/10]">
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover block dark:hidden"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal image compression interface"
            >
            </video>
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover hidden dark:block"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal image compression interface"
            >
