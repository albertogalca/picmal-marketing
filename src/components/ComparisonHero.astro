---
import ReleaseBadge from "./ReleaseBadge.astro";
import Button from "./Button.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  /** Hero H1 text */
  title: string;
  /** Hero subhead (sublead) text */
  subhead: string;
  /** PostHog event fired on the buy click, e.g. "buy_clicked_compresto_comparison" */
  buyEvent: string;
  /** PostHog event fired on the download click */
  downloadEvent?: string;
  /** Which demo video to show (default: convert) */
  defaultTab?: "convert" | "compress" | "pdf";
}

const {
  title,
  subhead,
  buyEvent,
  downloadEvent = "download_clicked",
  defaultTab = "convert",
} = Astro.props;
---

<!-- Hero Section — mirrors the landing page hero (src/pages/index.astro) -->
<main id="main-content" class="relative z-10 pt-32 pb-20">
  <div class="max-w-7xl mx-auto px-6 xl:px-0">
    <slot name="breadcrumb" />
    <div class="max-w-3xl">
      <div class="hero-reveal" style="--d: 0ms">
        <ReleaseBadge class="mb-6" />
      </div>
      <div class="hero-reveal" style="--d: 80ms">
        <SectionHeading
          level={1}
          align="left"
          class="mb-8"
          headingClass="mb-6"
          subleadClass="max-w-xl"
        >
          {title}
          <Fragment slot="sublead">{subhead}</Fragment>
        </SectionHeading>
      </div>
      <div
        class="hero-reveal flex flex-col sm:flex-row gap-3"
        style="--d: 160ms"
      >
        <Button
          text="Buy for Mac"
          href="/#pricing"
          target="_self"
          class="w-full sm:w-auto"
          onclick={import.meta.env.PROD
            ? `window.seline?.track('${buyEvent}')`
            : undefined}
        />
        <Button
          text="Download"
          href="/download"
          variant="secondary"
          target="_self"
          icon="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 14.25 3.51 5.71 9.05 5.43c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 3.97l.01-.01zM12.03 5.38c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"
          iconType="fill"
          class="w-full sm:w-auto"
          onclick={import.meta.env.PROD
            ? `window.seline?.track('${downloadEvent}')`
            : undefined}
        />
      </div>
    </div>

    <!-- Demo Video -->
    <div class="hero-reveal mt-12" style="--d: 240ms">
      <div
        class="rounded-xl overflow-hidden ring-1 ring-black/[0.08] dark:ring-white/10 shadow-[0_2px_4px_-1px_rgba(0,0,0,0.06),0_16px_32px_-8px_rgba(0,0,0,0.12)]"
      >
        <div class="aspect-video bg-background-subtle">
          <video
            id="hero-demo-video"
            class="w-full h-full object-cover"
            width="1280"
            height="720"
            src={`/${defaultTab}.mp4`}
            poster={`/${defaultTab}-poster.webp`}
            loop
            muted
            playsinline
            preload="metadata"
            aria-label="Picmal demo"
          >
          </video>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- One-time hero entrance: staggered ~80ms apart. Opacity + transform only
     (GPU-composited); disabled under reduced motion. -->
<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-reveal {
      opacity: 0;
      animation: hero-reveal 0.6s cubic-bezier(0.2, 0, 0, 1) both;
      animation-delay: var(--d, 0ms);
    }
    @keyframes hero-reveal {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>

<!-- Hero demo: autoplay the loop unless the user prefers reduced motion. -->
<script>
  const heroVideo = document.getElementById(
    "hero-demo-video",
  ) as HTMLVideoElement | null;
  if (
    heroVideo &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    heroVideo.play().catch(() => {});
  }
</script>
