                        class="w-5 h-5 rounded-full border-2 border-background-subtle bg-background flex-shrink-0"
                      >
                      </div>
                      <Paragraph size="small"
                        >$13.99 for customers 41-50</Paragraph
                      >
                    </div>

                    <!-- Tier 6 -->
                    <div class="flex items-center gap-3">
                      <div
                        class="w-5 h-5 rounded-full border-2 border-background-subtle bg-background flex-shrink-0"
                      >
                      </div>
                      <Paragraph size="small"
                        >$15.99 for customers 51+</Paragraph
                      >
                    </div>
                  </div>
                </div>
              </div>

              <!-- CTA Button -->
              <Button text="Buy for Mac" class="w-full" />
            </div>
            <Paragraph
              size="small"
              class="text-center text-text-secondary mt-4"
            >
              Prices in USD. VAT may apply. Secure payment via Lemon Squeezy.
            </Paragraph>
          </div>

          <!-- FAQs for mobile (appears third on mobile, hidden on desktop) -->
          <div class="md:hidden">
            <FAQ faqs={licenseFaqs} />
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-20">
      <div class="max-w-2xl mx-auto">
        <H2 class="mb-12 text-center">Frequently asked questions</H2>
        <FAQ faqs={faqs} />
      </div>
    </section>

    <Footer />
  </body>
</html>
