---
import testimonials from "../data/testimonials.json";
import Card from "./Card.astro";
import H2 from "./H2.astro";
import TestimonialCard from "./TestimonialCard.astro";
import TrustBar from "./TrustBar.astro";
import Section from "./Section.astro";

interface Props {
  heading?: string;
  showTrustBar?: boolean;
  trustSuffix?: string;
}
const { heading, showTrustBar = false, trustSuffix } = Astro.props;

// Six quotes, picked, standing still (Sep 2026). The wall used to be all
// thirty, scrolling in three columns on a loop, and it proved the wrong thing:
// that there were many quotes, most of them "great app!". A cold reader stops on
// a quote that names a job they have. Each pick below names one, and together
// they cover video, images, PDFs, a workflow and the web tools Picmal replaces.
// Order is reading order: CSS columns fill top to bottom, one column at a time.
// The highlight chips are gone here too: one accent mark per card, six cards
// in a row, read as ad copy. The hero press quote keeps its one.
const PICKS = [25, 9, 6, 19, 27, 21];

const byId = new Map(testimonials.map((t) => [t.id, t]));
const cards = PICKS.map((id) => byId.get(id))
  .filter((t) => t !== undefined && t.type !== "press")
  .map((t) => ({ ...t!, highlight: undefined }));

// No JSON-LD here on purpose. The rating lives on the single
// SoftwareApplication node in ProductSchema (@id .../#software), which every
// page rendering this wall also includes. Emitting a second SoftwareApplication
// from a presentational component is what split the entity in the first place.
---

<Section id="testimonials" width="wide">
  <div class="text-center mb-12">
    <H2 class="mb-6 max-w-3xl mx-auto">
      {
        heading ? (
          heading
        ) : (
          <>
            What people are <br /> saying about Picmal
          </>
        )
      }
    </H2>
    {showTrustBar && <TrustBar prefix="" suffix={trustSuffix} />}
  </div>

  <div class="columns-1 md:columns-2 lg:columns-3 gap-6">
    {
      cards.map((t) =>
        t.link ? (
          <a
            href={t.link}
            target="_blank"
            rel="nofollow noreferrer"
            class="block mb-6 break-inside-avoid rounded-2xl hover:opacity-80 active:scale-[0.98] transition-[opacity,scale] duration-200 ease-out motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            <Card>
              <TestimonialCard testimonial={t} align="left" />
            </Card>
          </a>
        ) : (
          <Card class="mb-6 break-inside-avoid">
            <TestimonialCard testimonial={t} align="left" />
          </Card>
        )
      )
    }
  </div>
</Section>
