---
interface Props {
  url: string;
}

const { url } = Astro.props;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Picmal",
  description:
    "All-in-one media converter for Mac. Batch convert and compress images, videos, and audio files offline on your Mac.",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "macOS 11.0 or later",
  offers: {
    "@type": "Offer",
    price: "15.99",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: new URL("/", url).href,
    priceValidUntil: "2026-12-31",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.8",
    ratingCount: "150",
    bestRating: "5",
    worstRating: "1",
  },
  author: {
    "@type": "Person",
    name: "Alberto Gallego",
    url: "https://albertogalca.com",
  },
  publisher: {
    "@type": "Organization",
    name: "Picmal",
    logo: {
      "@type": "ImageObject",
      url: new URL("/logo.webp", url).href,
    },
  },
  softwareVersion: "1.1.4",
  datePublished: "2024-01-15",
  dateModified: "2025-01-01",
  screenshot: new URL("/og.png", url).href,
  downloadUrl:
    "https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg",
  fileSize: "25MB",
  installUrl:
    "https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg",
  softwareRequirements: "macOS 11.0 or later",
  featureList: [
    "Batch convert images, videos, and audio files",
    "Compress media files without quality loss",
    "Offline processing for privacy",
    "Support for 30+ image, video, and audio formats",
    "Folder watching for automatic conversion",
    "Shortcuts integration",
    "Color space conversion",
    "Metadata preservation",
  ],
  keywords:
    "image converter, video converter, audio converter, Mac app, batch conversion, offline converter, HEIC converter, media compression",
};
---

<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
