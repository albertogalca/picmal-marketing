---
import { Image } from "astro:assets";
import testimonials from "../data/testimonials.json";
import H2 from "./H2.astro";
import Paragraph from "./Paragraph.astro";
import { getGravatarUrl } from "../utils/gravatar";

const userTestimonials = testimonials.filter((t) => t.type !== "press");

const reviewSchemas = userTestimonials.map((t) => ({
  "@type": "Review",
  author: { "@type": "Person", name: t.name },
  reviewBody: t.content,
  reviewRating: {
    "@type": "Rating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "1",
  },
}));

const aggregateRatingSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Picmal",
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.8",
    reviewCount: String(userTestimonials.length),
    bestRating: "5",
    worstRating: "1",
  },
  review: reviewSchemas,
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(aggregateRatingSchema)}
/>

<section id="testimonials" class="relative z-10 px-6 py-20">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <div class="flex justify-center gap-1 mb-6">
        {
          [...Array(5)].map(() => (
            <svg
              class="w-6 h-6 text-text"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))
        }
      </div>
      <H2 class="mb-4">What people are <br /> saying about Picmal</H2>
    </div>

    <div class="masonry-grid">
      {
        testimonials.map((testimonial) => {
          const isPress = testimonial.type === "press";
          const hasLink = !!testimonial.link;
          const CardWrapper = hasLink ? "a" : "div";

          return (
            <div class="masonry-item">
              <CardWrapper
                href={hasLink ? testimonial.link : undefined}
                target={hasLink ? "_blank" : undefined}
                rel={hasLink ? "nofollow noreferrer" : undefined}
                class:list={[
                  "block bg-background-subtle rounded-lg p-6 border border-border",
                  hasLink && "hover:border-border/20 cursor-pointer",
                ]}
              >
                <Paragraph class="mb-6">"{testimonial.content}"</Paragraph>

                <div class="flex items-center gap-3">
                  {isPress ? (
                    <Image
                      src={testimonial.logo}
                      alt={`${testimonial.publication} logo`}
                      width={120}
                      height={120}
                      class="h-8 w-auto max-w-[120px] object-contain"
                      loading="lazy"
                    />
                  ) : (
                    <>
                      <Image
                        src={
                          testimonial.image ||
                          getGravatarUrl(testimonial.email || "", 64)
                        }
                        alt={`${testimonial.name}, Picmal user`}
                        width={64}
                        height={64}
                        class="w-10 h-10 rounded-full flex-shrink-0 testimonial-avatar"
                        loading="lazy"
                        data-initials={testimonial.name.split(" ").map((n: string) => n[0]).join("").toUpperCase().slice(0, 2)}
                      />
                      <span class="font-semibold text-text">
                        {testimonial.name}
                      </span>
                    </>
                  )}
                </div>
              </CardWrapper>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .masonry-grid {
    columns: 1;
    column-gap: 1rem;
  }

  @media (min-width: 640px) {
    .masonry-grid {
      columns: 2;
    }
  }

  @media (min-width: 1024px) {
    .masonry-grid {
      columns: 3;
    }
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 1rem;
  }
</style>

<script>
  document.querySelectorAll('.testimonial-avatar').forEach((img) => {
    img.addEventListener('error', function () {
      const initials = this.getAttribute('data-initials') || '?';
      const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40"><rect width="40" height="40" rx="20" fill="%23e5e7eb"/><text x="50%" y="50%" dominant-baseline="central" text-anchor="middle" font-family="system-ui,sans-serif" font-size="16" font-weight="600" fill="%236b7280">${initials}</text></svg>`;
      this.src = `data:image/svg+xml,${svg}`;
      this.onerror = null;
    });
  });
</script>
