---
export interface Props {
  value: string;
  label: string;
  icon?: boolean;
}

const { value, label, icon = false } = Astro.props;
---

<div
  class="inline-flex items-center gap-3 px-6 py-3 bg-background-subtle border border-text/10 rounded-full hover:border-accent/30 transition-all duration-300 group"
>
  {
    icon && (
      <div class="w-8 h-8 rounded-full bg-accent/10 flex items-center justify-center group-hover:bg-accent/20 transition-colors">
        <slot name="icon" />
      </div>
    )
  }
  <div>
    <div class="text-2xl font-bold text-text group-hover:text-accent transition-colors">
      {value}
    </div>
    <div class="text-xs text-text-secondary uppercase tracking-wider">
      {label}
    </div>
  </div>
</div>
