---
import { getEntry, render } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE } from "../../consts";
import "../../styles/global.css";
import H1 from "../../components/H1.astro";
import Paragraph from "../../components/Paragraph.astro";

const changelog = await getEntry("blog", "changelog");
if (!changelog) {
  throw new Error("Changelog not found");
}
const { Content } = await render(changelog);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Changelog - ${SITE_TITLE}`}
      description="Stay updated with the latest Picmal updates, new features, and improvements in our changelog."
    />
  </head>
  <body class="bg-background">
    <Header />

    <!-- Hero with gradient -->
    <main class="relative z-10 pt-32 pb-20">
      <div class="absolute inset-0 -z-10 overflow-hidden"></div>

      <div class="max-w-3xl mx-auto px-6">
        <div class="text-center mb-16">
          <H1 class="mb-4">Changelog</H1>
          <Paragraph class="max-w-2xl mx-auto">
            Latest updates, new features, and improvements to Picmal.
          </Paragraph>
        </div>

        <!-- Review CTA -->
        <div class="relative overflow-hidden rounded-lg mb-12">
          <div
            class="relative bg-background-subtle border border-border rounded-lg p-6 flex flex-col sm:items-start sm:justify-between gap-4 sm:gap-6"
          >
            <div class="flex items-start sm:items-center gap-4">
              <Paragraph>
                As an indie developer, Picmal grows through word of mouth. A
                review only takes a minute and makes a huge difference.
              </Paragraph>
            </div>
            <a
              href="https://tally.so/r/Me18qE"
              target="_blank"
              rel="noopener noreferrer"
              class="flex-shrink-0 inline-flex items-center justify-center gap-2 font-semibold transition-colors w-full sm:w-auto"
            >
              Leave a review
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- Changelog Content -->
        <div
          class="changelog-content space-y-12 prose prose-lg max-w-none
                 prose-headings:text-text prose-headings:font-semibold
                 prose-p:text-text-secondary prose-p:leading-relaxed
                 prose-h3:text-xl prose-h3:mb-3
                 prose-h4:text-base prose-h4:mb-2
                 prose-a:text-accent prose-a:no-underline hover:prose-a:underline
                 prose-img:rounded-lg prose-img:my-6 prose-img:shadow-lg prose-img:border prose-img:border-border
                 prose-video:rounded-lg prose-video:my-6 prose-video:shadow-lg
                 prose-li:text-text-secondary prose-li:leading-relaxed
                 prose-ul:space-y-2
                 prose-strong:text-text prose-strong:font-semibold
                 prose-code:text-accent prose-code:bg-accent/10 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
                 prose-pre:bg-background-subtle prose-pre:border prose-pre:border-border
                 prose-blockquote:border-l-accent prose-blockquote:text-text-secondary prose-blockquote:bg-background-subtle/50"
        >
          <Content />
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
