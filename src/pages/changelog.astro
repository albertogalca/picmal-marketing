---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import FormattedDate from "../components/FormattedDate.astro";
import H1 from "../components/H1.astro";
import Paragraph from "../components/Paragraph.astro";
import { SITE_TITLE } from "../consts";
import { getCollection } from "astro:content";
import {
  getEntryUrl,
  getEntryDescription,
  getFirstImage,
  isStandalone,
  sortEntries,
} from "../utils/changelog";
import "../styles/global.css";

const entries = sortEntries(await getCollection("changelog"));

const latestVersion = entries[0]?.data.version ?? "1.0.0";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE_TITLE,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "macOS",
  softwareVersion: latestVersion,
  url: "https://picmal.app/changelog",
};

const rows = entries.map((entry) => {
  const standalone = isStandalone(entry);
  const version = entry.data.version;
  return {
    version,
    title: entry.data.title ?? `Version ${version}`,
    pubDate: entry.data.pubDate,
    summary: getEntryDescription(entry),
    standalone,
    url: standalone ? getEntryUrl(entry) : `/changelog#v${version}`,
    image: getFirstImage(entry),
    downloadUrl: `https://github.com/albertogalca/picmal-releases/releases/download/v${version}/Picmal.dmg`,
    hasDownload:
      version.localeCompare("1.2.7", undefined, { numeric: true }) >= 0,
  };
});
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Changelog - ${SITE_TITLE}`}
      description="Full changelog and release notes for Picmal, the macOS image converter. See every new feature, format addition, performance boost and bug fix shipped across versions."
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: "Picmal Changelog",
        description: "Version history and release notes for Picmal",
        itemListElement: rows.map((row, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: `Picmal v${row.version} - ${row.title}`,
          url: `https://picmal.app${row.url}`,
        })),
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(softwareSchema)}
    />
  </head>
  <body class="bg-background text-text min-h-dvh">
    <Header />

    <main class="relative z-10 pt-32 pb-20">
      <div class="text-center mb-16 px-6">
        <H1 class="mb-4">Changelog</H1>
        <Paragraph class="max-w-2xl mx-auto">
          Latest updates, new features, and improvements to Picmal.
        </Paragraph>
      </div>

      <div class="max-w-2xl mx-auto px-6 mb-16">
        <div
          class="relative bg-background-subtle border border-border rounded-2xl p-6 sm:p-7 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 sm:gap-6"
        >
          <Paragraph class="mb-0 flex-1 text-body">
            As an indie developer, Picmal grows through word of mouth. A review
            only takes a minute and makes a huge difference.
          </Paragraph>
          <a
            href="https://tally.so/r/Me18qE"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-accent text-white font-semibold text-body-sm rounded-lg transition duration-200 hover:bg-accent-dark hover:scale-[1.02] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent whitespace-nowrap w-full sm:w-auto"
          >
            Leave a Review
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="max-w-3xl mx-auto px-6 pb-20">
        <ul class="flex flex-col">
          {
            rows.map((row) => (
              <li
                id={`v${row.version}`}
                class="scroll-mt-28 border-t border-border first:border-t-0"
              >
                <div class="flex flex-col sm:flex-row gap-2 sm:gap-6 py-6">
                  {/* Left: metadata */}
                  <div class="flex items-center gap-3 sm:flex-col sm:items-start sm:gap-1.5 sm:w-[140px] sm:shrink-0 sm:pt-0.5">
                    {row.pubDate && (
                      <span class="text-body-sm text-text-secondary order-2 sm:order-1">
                        <FormattedDate date={row.pubDate} />
                      </span>
                    )}
                    <span class="inline-block text-caption font-mono px-2 py-1 rounded-md bg-accent/10 text-accent order-1 sm:order-2">
                      v{row.version}
                    </span>
                    {row.hasDownload && (
                      <a
                        href={row.downloadUrl}
                        class="flex items-center gap-1.5 text-body-sm text-text-secondary sm:mt-1 transition-colors duration-150 hover:text-text rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent order-3"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                          <polyline points="7 10 12 15 17 10" />
                          <line x1="12" y1="15" x2="12" y2="3" />
                        </svg>
                        Download
                      </a>
                    )}
                  </div>

                  {/* Right: image + title + summary */}
                  <div class="flex-1">
                    {row.image &&
                      (row.standalone ? (
                        <a
                          href={row.url}
                          aria-hidden="true"
                          tabindex="-1"
                          class="group/img block mb-4"
                        >
                          <img
                            src={row.image.src}
                            alt={row.image.alt}
                            loading="lazy"
                            decoding="async"
                            class="w-full max-h-72 object-cover object-top border border-border transition-opacity duration-200 group-hover/img:opacity-90"
                          />
                        </a>
                      ) : (
                        <img
                          src={row.image.src}
                          alt={row.image.alt}
                          loading="lazy"
                          decoding="async"
                          class="w-full max-h-72 object-cover object-top border border-border mb-4"
                        />
                      ))}
                    {row.standalone ? (
                      <a
                        href={row.url}
                        class="group inline-block rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                      >
                        <h2 class="text-body-lg font-semibold text-text mb-1.5 transition-colors duration-200 group-hover:text-accent">
                          {row.title}
                        </h2>
                      </a>
                    ) : (
                      <h2 class="text-body-lg font-semibold text-text mb-1.5">
                        {row.title}
                      </h2>
                    )}
                    <p class="text-body-sm text-text/65 leading-relaxed">
                      {row.summary}
                    </p>
                    {row.standalone && (
                      <a
                        href={row.url}
                        aria-label={`Read more about ${row.title}`}
                        class="group inline-flex items-center gap-1 text-body-sm text-accent mt-2 font-medium rounded-sm hover:text-accent-dark transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                      >
                        Read more
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                          class="transition-transform duration-200 motion-safe:group-hover:translate-x-0.5"
                        >
                          <path d="M5 12h14" />
                          <path d="m12 5 7 7-7 7" />
                        </svg>
                      </a>
                    )}
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </main>

    <Footer />
  </body>
</html>
