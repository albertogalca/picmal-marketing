---
import { twMerge } from "tailwind-merge";

export interface Props {
  class?: string;
  id?: string;
}

const { class: className = "", id } = Astro.props;
const defaultClasses =
  "text-4xl md:text-7xl font-semibold leading-tight text-text";
const mergedClasses = twMerge(defaultClasses, className);
---

<h1 id={id} class={mergedClasses}>
  <slot />
</h1>
