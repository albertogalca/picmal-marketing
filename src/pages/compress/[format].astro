---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import BlockGrid from "../../components/BlockGrid.astro";
import FileSizeTable from "../../components/FileSizeTable.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";
import CTASection from "../../components/CTASection.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import Section from "../../components/Section.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import BenefitsCard from "../../components/BenefitsCard.astro";
import ConversionGrid from "../../components/ConversionGrid.astro";
import { conversions, formats } from "../../data/conversions";
import FAQSection from "../../components/FAQSection.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import GuideCrossLink from "../../components/GuideCrossLink.astro";

import {
  compressions,
  type CompressionFileSizeExample,
  type CompressionUseCase,
} from "../../data/compressions";

export function getStaticPaths() {
  return compressions.map((c) => ({
    params: { format: c.slug },
    props: { compression: c },
  }));
}

const { compression } = Astro.props;

const title = compression.metaTitle;
const description = compression.metaDescription;

const relatedConversions = conversions
  .filter((c) => c.from === compression.format)
  .slice(0, 4);

// Blog post cross-links for compress pages
const blogGuides: Record<string, { title: string; slug: string }> = {
  pdf: {
    title: "How to Compress a PDF on Mac (4 Free Methods)",
    slug: "compress-pdf-mac",
  },
};
const blogGuide = blogGuides[compression.slug];
---

<MarketingLayout
  title={title}
  description={description}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema faqs={compression.faqs} />
  </Fragment>

  <ComparisonHero
    pricingHref="/#pricing"
    title={`Compress ${compression.name} files on Mac`}
    subhead={compression.whyCompress}
    buyEvent={`buy_clicked_compress_${compression.slug}`}
    defaultTab="compress"
  />

  <!-- Benefits -->
  <Section width="narrow">
    <BenefitsCard
      heading={`Why compress ${compression.name} files?`}
      benefits={compression.benefits}
    />
  </Section>

  <!-- How To Steps -->
  <BlockGrid ordered
    heading={`How to compress ${compression.name} files on Mac`}
    items={[
      {
        title: "Open Picmal",
        description: "Download and open Picmal on your Mac.",
      },
      {
        title: `Add your ${compression.name} files`,
        description: `Drag and drop your ${compression.name} files or entire folders into Picmal.`,
      },
      {
        title: "Adjust quality and compress",
        description:
          "Set your preferred quality level and click Compress to reduce file sizes.",
      },
    ]}
  />

  <!-- File Size Comparison -->
  <Section width="narrow">
    <SectionHeading>{compression.name} compression results</SectionHeading>
    <FileSizeTable
      columns={["Original", "Compressed", "Savings"]}
      rows={compression.fileSizeExamples}
      speed={compression.compressionSpeed}
    />
  </Section>

  <!-- Use Cases -->
  <Section>
    <SectionHeading>When to compress {compression.name} files</SectionHeading>
    <BlockGrid items={compression.useCases} />
  </Section>

  <!-- FAQ -->
  <FAQSection faqs={compression.faqs} />

  {
    blogGuide && (
      <GuideCrossLink
        href={`/blog/${blogGuide.slug}`}
        title={blogGuide.title}
      />
    )
  }

  <!-- Related Conversions -->
  {
    relatedConversions.length > 0 && (
      <Section width="narrow">
        <SectionHeading>
          Convert {compression.name} to other formats
        </SectionHeading>
        <ConversionGrid
          columns={4}
          links={relatedConversions.map((c) => ({
            href: `/convert/${c.slug}`,
            label: `${formats[c.from].name} to ${formats[c.to].name}`,
          }))}
        />
      </Section>
    )
  }

  <CTASection
    heading={`Compress ${compression.name} files with Picmal`}
    analyticsEvent={`buy_clicked_compress_${compression.slug}_bottom`}
  />
</MarketingLayout>
