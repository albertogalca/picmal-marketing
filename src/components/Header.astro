---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import Paragraph from "./Paragraph.astro";
import { DEFAULT_TIER } from "../config/pricing";

const currentPage = Astro.url.pathname;

type NavItem = {
  href: string;
  label: string;
  iconPath: string;
  routePrefix?: string;
};

const navItems: NavItem[] = [
  {
    href: "/#features",
    label: "Features",
    iconPath: "M13 10V3L4 14h7v7l9-11h-7z",
  },
  {
    // The page, not the homepage anchor. /pricing is the indexable, linkable
    // answer to "what does Picmal cost"; the homepage band stays at #pricing
    // for every in-page CTA that already points there.
    href: "/pricing",
    label: "Pricing",
    iconPath:
      "M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z",
  },
  {
    // Replaced the #testimonials anchor. Testimonials are a section people
    // scroll past anyway, and the free tools were reachable only from the
    // footer, which is a bad place to keep the one thing a stranger can use
    // before paying. Six items is already the ceiling here, so this is a swap
    // rather than an addition.
    href: "/tools",
    label: "Tools",
    routePrefix: "/tools",
    iconPath:
      "M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409",
  },
  {
    href: "/#faq",
    label: "FAQ",
    iconPath:
      "M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    href: "/blog",
    label: "Blog",
    routePrefix: "/blog",
    iconPath:
      "M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z",
  },
  {
    href: "/docs",
    label: "Docs",
    routePrefix: "/docs",
    iconPath:
      "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
  },
];

const isActive = (item: NavItem) =>
  !!item.routePrefix && currentPage.startsWith(item.routePrefix);

const focusRing =
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
const desktopLinkBase = `text-body transition-colors cursor-pointer rounded-xl ${focusRing}`;
const desktopLinkIdle =
  "text-text-secondary hover:text-text focus-visible:text-text";
const mobileLinkBase = `flex text-small items-center gap-3 p-3 rounded-xl hover:bg-background-subtle focus-visible:bg-background-subtle transition-[color,background-color,scale] active:scale-[0.98] motion-reduce:transition-none ${focusRing}`;
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-30 text-body transition-colors duration-300 bg-background/80 backdrop-blur-lg border-b border-border"
>
  <div class="px-6 xl:px-0 py-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center">
        <a
          href="/"
          class="flex items-center gap-3 cursor-pointer transition-[scale] active:scale-[0.97] motion-reduce:transition-none"
        >
          <Image
            src="/logo.webp"
            alt="Picmal - Mac media converter app logo"
            width={40}
            height={40}
            class="rounded-xl w-8 h-8 sm:w-10 sm:h-10 object-cover"
            loading="eager"
          />
          <Paragraph class="text-text font-semibold text-body">Picmal</Paragraph
          >
        </a>
      </div>

      <div class="hidden md:flex items-center space-x-6">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={`${desktopLinkBase} ${isActive(item) ? "text-accent" : desktopLinkIdle}`}
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <div class="flex items-center space-x-3">
        {/* Was "Buy for Mac" -> /#pricing, sitting next to a "Pricing" nav
            item that already went to /pricing: two links to two different
            price lists, one of them labelled buy. It now does what it says
            and goes straight to checkout, the same as every other buy button.
            See HeroCTA: pointing a buy button at #pricing turned every
            recorded buy_clicked into a scroll. */}
        <Button
          class="hidden md:block m-0"
          size="small"
          text={`Buy for $${DEFAULT_TIER.price}`}
          href={DEFAULT_TIER.checkoutUrl}
          onclick={import.meta.env.PROD
            ? `window.seline?.track('buy_clicked', { macs: ${DEFAULT_TIER.macs}, source: 'header' })`
            : undefined}
        />

        <button
          id="mobile-menu-button"
          class={`md:hidden inline-flex items-center justify-center p-2.5 rounded-xl text-text-secondary hover:text-text hover:bg-background-subtle transition-[color,background-color,scale] active:scale-[0.96] motion-reduce:transition-none ${focusRing}`}
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <svg
            class="h-6 w-6 mobile-menu-open-icon"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            class="h-6 w-6 mobile-menu-close-icon hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden">
      <div class="pt-8">
        <div class="grid grid-cols-2 gap-6">
          {
            navItems.map((item) => {
              const active = isActive(item);
              const accent = active ? "text-accent" : "text-text";
              return (
                <a
                  href={item.href}
                  class={`${mobileLinkBase} ${active ? "bg-background-subtle" : ""}`}
                >
                  <svg
                    class={`w-5 h-5 ${accent}`}
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d={item.iconPath}
                    />
                  </svg>
                  <span class={`text-body ${accent}`}>{item.label}</span>
                </a>
              );
            })
          }
        </div>

        {/* The desktop buy button is `hidden md:block`, so on a phone the menu
            was six links and no CTA. It renders an <a>, which the menu's own
            click handler already catches, so picking it closes the menu. */}
        <Button
          class="mt-6 w-full"
          text={`Buy for $${DEFAULT_TIER.price}`}
          href={DEFAULT_TIER.checkoutUrl}
          onclick={import.meta.env.PROD
            ? `window.seline?.track('buy_clicked', { macs: ${DEFAULT_TIER.macs}, source: 'header_mobile' })`
            : undefined}
        />
      </div>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const mobileMenuButton = document.getElementById("mobile-menu-button");
      const mobileMenu = document.getElementById("mobile-menu");
      const openIcon = mobileMenuButton?.querySelector(
        ".mobile-menu-open-icon",
      );
      const closeIcon = mobileMenuButton?.querySelector(
        ".mobile-menu-close-icon",
      );

      function closeMenu() {
        mobileMenu?.classList.add("hidden");
        mobileMenuButton?.setAttribute("aria-expanded", "false");
        openIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
      }

      function openMenu() {
        mobileMenu?.classList.remove("hidden");
        mobileMenuButton?.setAttribute("aria-expanded", "true");
        openIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
      }

      if (mobileMenuButton && mobileMenu) {
        mobileMenuButton.addEventListener("click", () => {
          const isExpanded =
            mobileMenuButton.getAttribute("aria-expanded") === "true";
          if (isExpanded) {
            closeMenu();
          } else {
            openMenu();
          }
        });

        const mobileMenuLinks = mobileMenu.querySelectorAll("a");
        mobileMenuLinks.forEach((link) => {
          link.addEventListener("click", closeMenu);
        });

        document.addEventListener("keydown", (e) => {
          if (
            e.key === "Escape" &&
            mobileMenuButton.getAttribute("aria-expanded") === "true"
          ) {
            closeMenu();
          }
        });
      }
    });
  </script>
</nav>
