    <SectionDivider />

    <!-- CTA Section -->
    <CTASection
      heading="Start compressing videos on your Mac"
      analyticsEvent="buy_clicked_compress_video_mac_bottom"
    />

    <SectionDivider />

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-20">
