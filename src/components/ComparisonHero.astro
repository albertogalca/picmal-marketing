---
import ReleaseBadge from "./ReleaseBadge.astro";
import HeroCTA from "./HeroCTA.astro";
import Section from "./Section.astro";
import DemoReel from "./DemoReel.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  /** Hero H1 text */
  title: string;
  /** Hero subhead (sublead) text */
  subhead: string;
  /** PostHog event fired on the buy click, e.g. "buy_clicked_compresto_comparison" */
  buyEvent: string;
  /** Which demo video to show (default: convert) */
  defaultTab?: "convert" | "compress" | "pdf";
  /** Where the seat-ladder link points. Most of these pages render their own
      PricingSection; the few that don't pass "/#pricing". */
  pricingHref?: string;
  /** The "What's new" pill. Off on the /alternative pages: a release note
      has nothing to say to someone comparing two apps. */
  releaseBadge?: boolean;
  /** The demo reel under the hero. Off on the /convert and /compress hubs:
      someone who opens an index wants the list, and the reel pushed it
      1200px down the page. */
  demo?: boolean;
}

const {
  title,
  subhead,
  buyEvent,
  defaultTab = "convert",
  pricingHref = "#pricing",
  releaseBadge = true,
  demo = true,
} = Astro.props;
---

{/* Mirrors the landing page hero. This used to open its own <main> and close
    it 50 lines later, which meant the 33 pages using it had their hero inside
    the landmark and everything after it outside. The landmark belongs to the
    page; this is a section like any other. */}
<Section width="wide" class="pt-32 sm:pt-32">
  <slot name="breadcrumb" />
  <div class="max-w-3xl">
    {releaseBadge && (
      <div class="hero-reveal" style="--d: 0ms">
        <ReleaseBadge class="mb-6" />
      </div>
    )}
    <div class="hero-reveal" style="--d: 80ms">
      <SectionHeading
        level={1}
        align="left"
        class="mb-8"
        headingClass="mb-6"
        subleadClass="max-w-xl"
      >
        {title}
        <Fragment slot="sublead">{subhead}</Fragment>
      </SectionHeading>
    </div>
    <HeroCTA buyEvent={buyEvent} pricingHref={pricingHref} />
  </div>

  <!-- The same reel the homepage runs, opened on whichever clip matches this
       page's search intent. These pages used to show one static clip with no
       dock and no pause control, which was the only thing separating them from
       the home page. -->
  {demo && (
    <div class="hero-reveal mt-12" style="--d: 240ms">
      <DemoReel start={defaultTab} />
    </div>
  )}
</Section>
