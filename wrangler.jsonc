{
  "name": "picmal-marketing",
  "compatibility_date": "2025-12-05",
  // The worker only proxies /r/* (Affonso pixel); all other requests are
  // served from the assets binding exactly as before.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // A browser click on the DMG link is a navigation request, and with
    // not_found_handling set Cloudflare answers navigations from the assets
    // layer without ever running the Worker: /downloads/* has no asset, so the
    // buyer got the HTML 404 page. curl, Homebrew and Sparkle don't navigate,
    // which is why it only broke for people. Route downloads to the Worker first.
    // The same trap hid the www -> apex 301 in worker/index.js: the assets layer
    // answered www.picmal.app with a full duplicate site (found 2026-09-28, 3 www
    // URLs in GSC). A path pattern cannot match a hostname, so every request goes
    // to the Worker first. It falls through to ASSETS for everything it doesn't own.
    "run_worker_first": true
  },
  // The DMG lives in R2 and is served from picmal.app itself (see /downloads/*
  // in worker/index.js), so the URL a buyer clicks is the URL Homebrew fetches.
  "r2_buckets": [
    { "binding": "DOWNLOADS", "bucket_name": "picmal-downloads" }
  ],
  "routes": [
    { "pattern": "picmal.app", "custom_domain": true },
    { "pattern": "www.picmal.app", "custom_domain": true }
  ]
}
