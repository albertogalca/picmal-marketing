---
import { getCollection, render } from "astro:content";
import ChangelogEntry from "../../layouts/ChangelogEntry.astro";
import {
  getEntrySlug,
  getEntryDescription,
  isStandalone,
  sortEntries,
} from "../../utils/changelog";
import "../../styles/global.css";

export async function getStaticPaths() {
  const all = sortEntries(await getCollection("changelog"));
  // Only releases with substantial notes get their own page.
  const standalone = all.filter(isStandalone);

  return standalone.map((entry) => ({
    params: { slug: getEntrySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ChangelogEntry
  version={entry.data.version}
  title={entry.data.title ?? `Version ${entry.data.version}`}
  pubDate={entry.data.pubDate}
  description={getEntryDescription(entry)}
  slug={getEntrySlug(entry)}
>
  <Content />
</ChangelogEntry>
