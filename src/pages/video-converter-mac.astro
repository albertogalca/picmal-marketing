---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Paragraph from "../components/Paragraph.astro";
import Button from "../components/Button.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import TrustBar from "../components/TrustBar.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import SectionDivider from "../components/SectionDivider.astro";
import PricingSection from "../components/PricingSection.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import { videoConversions, videoFormats } from "../data/videoConversions";

const title = "Video Converter for Mac — MOV to MP4, MKV, AVI & More | Picmal";
const description =
  "Convert video on your Mac — MOV, MKV, AVI, WebM, WMV, FLV and more to MP4. Compress with H.264/H.265, batch process, burn in subtitles. Offline, no watermark, $15.99 one-time.";

const toMp4 = videoConversions.filter((c) => c.to === "mp4");
const other = videoConversions.filter((c) => c.to !== "mp4");

const faqs = [
  {
    question: "Which video formats can Picmal convert?",
    answer:
      "Picmal reads and writes MP4, MOV, AVI, MKV, WebM, M4V, MPG/MPEG, HEVC, FLV, WMV, 3GP, M2TS/MTS, VOB, TS and more, and can extract audio to MP3 or turn clips into GIFs. It uses H.264, H.265 (HEVC), VP9, and AV1.",
  },
  {
    question: "Can Picmal compress videos, not just convert them?",
    answer:
      "Yes. Picmal exposes a CRF quality slider, encoding-speed presets, codec choice, and frame-rate control, and shows an estimated output size before you encode — so you can shrink a video to a target size with predictable quality.",
  },
  {
    question: "Is there a file-size limit or watermark?",
    answer:
      "No. Unlike online converters, Picmal runs entirely on your Mac — no upload limits, no queues, no watermark on the output. Process files of any size, fully offline.",
  },
  {
    question: "Can I batch convert a folder of videos?",
    answer:
      "Yes. Drag in multiple videos or a whole folder and Picmal converts them all in one pass, each with its own progress.",
  },
  {
    question: "Can Picmal burn subtitles into a video?",
    answer:
      "Yes. Attach an SRT or VTT file and Picmal renders the subtitles directly into the frames, so they play on any device with no separate subtitle track.",
  },
  {
    question: "Do my videos leave my Mac?",
    answer:
      "No. All conversion and compression happens locally. Picmal works completely offline — your videos never touch a server.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <link
      rel="preload"
      href="/picmal-1.2.0-demo.mp4"
      as="video"
      type="video/mp4"
    />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <main id="main-content" class="relative z-10 pt-32 pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <Breadcrumb
          items={[
            { label: "Home", href: "/" },
            { label: "Video Converter for Mac" },
          ]}
        />

        <div class="text-center mb-12">
          <H1 class="mb-6 max-w-3xl mx-auto"
            >Convert and compress video on your Mac</H1
          >
          <Paragraph class="max-w-2xl mx-auto mb-8">
            MOV, MKV, AVI, WebM and more — Picmal converts to MP4 (H.264/H.265),
            compresses with a quality slider, and batch-processes whole folders.
            Offline, no watermark, no file-size limit.
          </Paragraph>
          <div
            class="flex flex-col sm:flex-row gap-3 items-center justify-center mb-6"
          >
            <Button
              text="Get Picmal for $15.99"
              onclick="posthog.capture('buy_clicked_video_converter_mac')"
            />
            <a
              href="https://github.com/albertogalca/picmal-releases/releases/latest/download/Picmal.dmg"
              class="block rounded-lg transition-all duration-200 text-center cursor-pointer font-semibold px-6 text-base py-3 bg-background-subtle text-text hover:bg-background border border-border hover:border-border/20 w-full sm:w-auto"
            >
              <svg
                class="size-4 inline-block mr-2"
                fill="currentColor"
                stroke="none"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87A4.92 4.92 0 0 0 4.69 9.39c-1.77 3-0.46 7.42 1.27 9.85 0.84 1.18 1.85 2.5 3.16 2.45s1.73-0.79 3.25-0.79 2 0.79 3.3 0.76 2.21-1.2 3-2.4a10.5 10.5 0 0 0 1.38-2.8 4.35 4.35 0 0 1-2.59-4.03z"
                ></path></svg
              >
              Download
            </a>
          </div>
          <TrustBar />
        </div>

        <!-- Demo Video -->
        <div
          class="max-w-5xl mx-auto rounded-lg sm:rounded-xl overflow-hidden border border-border"
        >
          <div class="aspect-[16/10]">
            <video
              src="/picmal-1.2.0-demo.mp4"
              class="w-full h-full object-cover"
              width="1920"
              height="1200"
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              aria-label="Picmal video conversion interface"></video>
          </div>
        </div>
      </div>
    </main>

    <SectionDivider />

    <!-- Convert to MP4 -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-3 text-center">Convert any video to MP4</H2>
        <Paragraph class="text-center max-w-2xl mx-auto mb-8">
          MP4 (H.264) plays on every device, browser, and editor. Pick your
          source format below.
        </Paragraph>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          {
            toMp4.map((c) => (
              <a
                href={`/convert/video/${c.slug}`}
                class="bg-background-subtle/50 border border-border rounded-lg p-4 text-center transition-colors hover:border-accent/30"
              >
                <span class="text-sm font-medium text-text">
                  {videoFormats[c.from].name} to MP4
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- MP4, GIF & audio -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-3 text-center">Convert to GIF, audio & web formats</H2>
        <Paragraph class="text-center max-w-2xl mx-auto mb-8">
          Turn clips into shareable GIFs, extract audio, or re-encode for the
          web.
        </Paragraph>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          {
            other.map((c) => (
              <a
                href={`/convert/video/${c.slug}`}
                class="bg-background-subtle/50 border border-border rounded-lg p-4 text-center transition-colors hover:border-accent/30"
              >
                <span class="text-sm font-medium text-text">
                  {videoFormats[c.from].name} to {videoFormats[c.to].name}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- Why Picmal for video -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-8 text-center">More than a converter</H2>
        <div class="grid sm:grid-cols-3 gap-6">
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6">
            <h3 class="font-semibold text-text mb-2">Real compression</h3>
            <Paragraph
              >CRF quality slider, codec choice (H.264/H.265/VP9/AV1), and frame
              rate — with a size estimate before you encode.</Paragraph
            >
          </div>
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6">
            <h3 class="font-semibold text-text mb-2">Subtitle burn-in</h3>
            <Paragraph
              >Bake SRT or VTT subtitles straight into the frames so they play
              anywhere, with no separate track.</Paragraph
            >
          </div>
          <div class="bg-background-subtle/50 border border-border rounded-xl p-6">
            <h3 class="font-semibold text-text mb-2">No limits, no watermark</h3>
            <Paragraph
              >Any file size, fully offline, no watermark — a one-time $15.99,
              not a subscription or an online upload.</Paragraph
            >
          </div>
        </div>
        <div class="text-center mt-8">
          <a
            href="/compress-video-mac"
            class="text-sm text-accent hover:underline"
            >Just need a smaller file? Compress video on Mac &rarr;</a
          >
        </div>
      </div>
    </section>

    <SectionDivider />
    <MasonryTestimonials />
    <SectionDivider />

    <section
      id="pricing"
      class="relative z-10 px-6 py-16 sm:py-20 bg-background-subtle/50 border-y border-border"
    >
      <PricingSection />
    </section>

    <section id="faq" class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-8 text-center">Frequently asked questions</H2>
        <div
          class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />
    <SupportedFormatsModal />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "cantimplorastudio" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
