---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Testimonial {
  name?: string;
  description?: string;
  image?: string;
  content: string;
  highlight?: string;
  link?: string;
  type?: string;
  publication?: string;
  logo?: string | ImageMetadata;
}

interface Props {
  testimonial: Testimonial;
  /** "center" = hero (big, centered), "left" = testimonials grid */
  align?: "left" | "center";
  class?: string;
}

const { testimonial: t, align = "left", class: className = "" } = Astro.props;

const isPress = t.type === "press";
const isCenter = align === "center";

function getInitialsAvatar(name: string): string {
  const words = name.replace(/^@/, "").split(/\s+/);
  const initials = words
    .slice(0, 2)
    .map((w) => w[0] ?? "")
    .join("")
    .toUpperCase();
  const palette = [
    "#4F46E5",
    "#7C3AED",
    "#0891B2",
    "#059669",
    "#D97706",
    "#DC2626",
    "#DB2777",
  ];
  const bg = palette[name.charCodeAt(0) % palette.length];
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 80 80"><rect width="80" height="80" rx="40" fill="${bg}"/><text x="40" y="54" text-anchor="middle" font-family="system-ui,sans-serif" font-size="30" font-weight="600" fill="white">${initials}</text></svg>`;
  return `data:image/svg+xml;base64,${Buffer.from(svg).toString("base64")}`;
}

// Split the quote around the highlighted phrase so it can carry the accent
// treatment shared by the hero and the testimonials grid.
const at = t.highlight ? t.content.indexOf(t.highlight) : -1;
const quote =
  at === -1
    ? { before: t.content, mark: "", after: "" }
    : {
        before: t.content.slice(0, at),
        mark: t.highlight!,
        after: t.content.slice(at + t.highlight!.length),
      };
---

<div class:list={[isCenter && "text-center", className]}>
  <!-- Stars -->
  <div
    class:list={["flex gap-1 mb-4", isCenter && "justify-center"]}
    role="img"
    aria-label="Rated 5 out of 5 stars"
  >
    {
      [...Array(5)].map(() => (
        <svg
          class="w-4 h-4 text-amber-400"
          fill="currentColor"
          viewBox="0 0 20 20"
          aria-hidden="true"
        >
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      ))
    }
  </div>

  <!-- Quote -->
  <p class:list={["text-text-secondary text-pretty mb-6 text-body"]}>
    "{quote.before}
    {
      quote.mark && (
        <span class="bg-accent/15 text-text px-1 py-0.5 font-medium box-decoration-clone">
          {quote.mark}
        </span>
      )
    }
    {quote.after}"
  </p>

  <!-- Attribution -->
  {
    isPress ? (
      <div class:list={["flex", isCenter ? "justify-center" : "items-center"]}>
        {t.link ? (
          <a
            href={t.link}
            target="_blank"
            rel="nofollow noreferrer"
            aria-label={`Read the ${t.publication} review of Picmal`}
            class="inline-flex items-center justify-center py-1 rounded-xl transition-[scale,opacity] duration-200 hover:opacity-70 active:scale-[0.96] motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
          >
            <Image
              src={t.logo!}
              alt={t.publication ?? ""}
              width={240}
              height={73}
              class="h-8 sm:h-9 w-auto object-contain"
              loading="lazy"
            />
          </a>
        ) : (
          <Image
            src={t.logo!}
            alt={t.publication ?? ""}
            width={240}
            height={73}
            class="h-8 sm:h-9 w-auto object-contain"
            loading="lazy"
          />
        )}
      </div>
    ) : (
      <div
        class:list={[
          "flex items-center gap-3",
          isCenter && "flex-col justify-center text-center",
        ]}
      >
        <img
          src={t.image || getInitialsAvatar(t.name ?? "")}
          alt={`${t.name}, Picmal user`}
          width={40}
          height={40}
          class="w-10 h-10 rounded-full flex-shrink-0 object-cover ring-1 ring-black/10 dark:ring-white/10"
          loading="lazy"
        />
        <div class:list={["flex flex-col", isCenter && "items-center"]}>
          <span class="font-semibold text-text">{t.name}</span>
          {t.description && (
            <span class="text-small text-text-secondary">{t.description}</span>
          )}
        </div>
      </div>
    )
  }
</div>
