---
export interface Props {
  title: string;
  description: string;
  size?: "small" | "medium" | "large";
  videoSrc?: string;
  videoSrcDark?: string;
  icon?: boolean;
  accent?: boolean;
}

const {
  title,
  description,
  size = "medium",
  videoSrc,
  videoSrcDark,
  icon = false,
  accent = false,
} = Astro.props;

const sizeClasses = {
  small: "md:col-span-1 md:row-span-1",
  medium: "md:col-span-1 md:row-span-2",
  large: "md:col-span-2 md:row-span-2",
};

const accentClass = accent
  ? "bg-gradient-to-br from-accent/5 to-accent/10 border-accent/20"
  : "bg-background-subtle border-text/10";
---

<div
  class={`group relative overflow-hidden rounded-2xl border transition-all duration-500 hover:border-text/20 hover:shadow-xl hover:shadow-accent/5 hover:-translate-y-1 ${sizeClasses[size]} ${accentClass}`}
>
  <!-- Subtle gradient overlay on hover -->
  <div
    class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
    style="background: radial-gradient(circle at 50% 0%, rgba(27, 91, 255, 0.03), transparent 70%);"
  >
  </div>

  <div class="h-full flex flex-col p-8 relative z-10">
    <!-- Icon slot -->
    {
      icon && (
        <div class="mb-6">
          <div class="w-14 h-14 rounded-xl bg-background flex items-center justify-center border border-text/10 group-hover:border-accent/30 group-hover:bg-accent/5 transition-all duration-300">
            <div class="w-8 h-8 [&_path]:stroke-text [&_path]:stroke-[2.5px] [&_path]:transition-all [&_path]:duration-300 group-hover:[&_path]:stroke-accent">
              <slot name="icon" />
            </div>
          </div>
        </div>
      )
    }

    <!-- Text content -->
    <div class="flex-shrink-0 mb-6">
      <h3
        class="text-2xl font-semibold mb-3 text-text group-hover:text-accent transition-colors"
      >
        {title}
      </h3>
      <p class="text-text-secondary leading-relaxed text-base">
        {description}
      </p>
    </div>

    <!-- Video content -->
    {
      videoSrc && (
        <div class="flex-grow flex items-end mt-auto">
          <div class="w-full rounded-lg overflow-hidden border border-text/10 shadow-sm group-hover:shadow-md transition-shadow">
            <video
              src={videoSrc}
              class="w-full h-auto block dark:hidden"
              autoplay
              loop
              muted
              playsinline
              aria-label={`${title} demonstration`}
            />
            {videoSrcDark && (
              <video
                src={videoSrcDark}
                class="w-full h-auto hidden dark:block"
                autoplay
                loop
                muted
                playsinline
                aria-label={`${title} demonstration`}
              />
            )}
          </div>
        </div>
      )
    }

    <!-- Custom slot for additional content -->
    <div class="flex-grow">
      <slot />
    </div>
  </div>
</div>
