---
import { Icon } from "astro-icon/components";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Card from "../components/Card.astro";
import H3 from "../components/H3.astro";
import Button from "../components/Button.astro";
import Paragraph from "../components/Paragraph.astro";
import FAQ from "../components/FAQ.astro";
import FeaturedReview from "../components/FeaturedReview.astro";

const SITE_DESCRIPTION =
  "Earn 30% commission on every Picmal sale you refer. 60-day cookie, $10 payout threshold, no quotas.";

// Affonso portal: one auth page covers both sign-up and sign-in.
const SIGNUP_URL = "https://picmal.affonso.io/";
const SIGNIN_URL = "https://picmal.affonso.io/";

const steps = [
  {
    title: "Sign up",
    body: "Register in a couple of minutes and get your unique affiliate link.",
    icon: "ph:user-plus-duotone",
  },
  {
    title: "Share your link",
    body: "Share Picmal on your website, blog, or social media.",
    icon: "ph:share-network-duotone",
  },
  {
    title: "Earn commission",
    body: "Watch clicks and sales land in your dashboard. Payouts go out monthly.",
    icon: "ph:coins-duotone",
  },
];

const affiliateFaqs = [
  {
    question: "Why promote Picmal?",
    answer:
      "Honestly? Because HEIC files, huge photos, and slow online converters are problems Mac users actually have, and Picmal fixes them. There's not much affiliate competition in this niche, and because it's a one-time purchase rather than a subscription, people are quicker to say yes.",
  },
  {
    question: "Who does best with this program?",
    answer:
      "Mac bloggers, photo and video YouTubers, newsletter writers, and people who run 'best Mac apps' style sites. If your audience ever complains about HEIC files or the size of their photo library, Picmal is an easy recommendation.",
  },
  {
    question: "Do you provide creative assets?",
    answer:
      "Yes. There's a press kit in the footer with screenshots, demo videos, and the app icon you can use. If you need a different format or something specific, email support@picmal.app and I'll send it over.",
  },
  {
    question: "How do I make money as an affiliate?",
    answer:
      "Put your link in a blog post, video description, newsletter, tweet, wherever it fits. We track the clicks and sales. The 60-day cookie means people don't have to buy on the first visit for you to get credit.",
  },
  {
    question: "How much can I earn?",
    answer:
      "You get 30% of every sale, which is about $9 to $45 per customer depending on how many Macs they buy for. Since Picmal is a one-time purchase, you get the full commission upfront. No waiting on renewals.",
  },
  {
    question: "When do I get paid?",
    answer:
      "We pay out monthly once you've hit $10. You can track clicks, sales, and earnings from your dashboard.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Picmal: Affiliate program"
      description={SITE_DESCRIPTION}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: "Picmal Affiliate Program",
        description: SITE_DESCRIPTION,
        speakable: {
          "@type": "SpeakableSpecification",
          cssSelector: ["#main-content h1", "#main-content p"],
        },
      })}
    />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <!-- Hero — same rhythm as the reference hero (index.astro), but centered:
         heading → CTA → quiet proof line, then the framed demo below. -->
    <main id="main-content" class="relative z-10 pt-32 pb-20">
      <div class="max-w-7xl mx-auto px-6 xl:px-0">
        <div class="max-w-3xl mx-auto">
          <div class="hero-reveal" style="--d: 0ms">
            <SectionHeading
              level={1}
              class="mb-8"
              headingClass="mb-6"
              subleadClass="max-w-xl"
            >
              Become an affiliate and earn 30% on each sale
              <Fragment slot="sublead">
                That's about $12 to $20 per sale, depending on the plan. Clicks
                are tracked for 60 days, so you still get credit when people
                come back later to buy.
              </Fragment>
            </SectionHeading>
          </div>

          <div
            class="hero-reveal flex flex-col items-center gap-3"
            style="--d: 80ms"
          >
            <Button
              href={SIGNUP_URL}
              text="Become an affiliate"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto"
            />
            <a
              href={SIGNIN_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="link inline-block py-1 text-small text-text-secondary"
            >
              Already an affiliate? Sign in
            </a>
          </div>

          <p
            class="hero-reveal mt-5 flex items-center justify-center gap-2 text-small text-text-secondary"
            style="--d: 160ms"
          >
            <svg
              class="w-4 h-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
            Free to join, no quotas. Approved manually by me.
          </p>
        </div>

        <!-- The product they'd promote, shown working — same framed demo
             video as the homepage hero, so the page doesn't just tell. -->
        <div class="hero-reveal mt-12" style="--d: 240ms">
          <div
            class="rounded-xl overflow-hidden ring-1 ring-black/[0.08] dark:ring-white/10 shadow-[0_2px_4px_-1px_rgba(0,0,0,0.06),0_16px_32px_-8px_rgba(0,0,0,0.12)]"
          >
            <div class="aspect-video bg-background-subtle">
              <video
                id="hero-demo-video"
                class="w-full h-full object-cover"
                width="1280"
                height="720"
                src="/convert.mp4"
                poster="/convert-poster.webp"
                loop
                muted
                playsinline
                preload="metadata"
                aria-label="Picmal convert demo"
              >
              </video>
            </div>
          </div>
        </div>

        <!-- Outside voice: proof the app is a legit, easy recommendation. -->
        <div class="hero-reveal mt-16" style="--d: 320ms">
          <FeaturedReview publication="MacStories" />
        </div>
      </div>
    </main>

    <!-- How It Works — same shape as the homepage feature grid (FeatureGrid):
         wide section, duotone icon above the title, three columns. -->
    <Section width="wide">
      <SectionHeading align="left" subleadClass="max-w-xl">
        How it works
        <Fragment slot="sublead">
          Three steps, and you're set up in a couple of minutes.
        </Fragment>
      </SectionHeading>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10">
        {
          steps.map((step) => (
            <div>
              <Icon name={step.icon} class="w-10 h-10 mb-4 text-text" />
              <H3 class="text-h4 mb-1">{step.title}</H3>
              <Paragraph>{step.body}</Paragraph>
            </div>
          ))
        }
      </div>
    </Section>

    <!-- FAQ -->
    <Section id="faq" width="narrow">
      <SectionHeading>Frequently asked questions</SectionHeading>
      <Card>
        <FAQ faqs={affiliateFaqs} />
      </Card>
    </Section>

    <!-- Closing CTA — one action, plus a plain first-person reassurance.
         The numbers already live in the hero and the FAQ; don't repeat them here. -->
    <Section bg="subtle">
      <SectionHeading>
        Ready to earn 30%?
        <Fragment slot="sublead">
          It's just me, Alberto, behind Picmal and this program. Sign-up takes
          a couple of minutes, and you get your link as soon as I approve you.
        </Fragment>
      </SectionHeading>
      <div class="flex justify-center">
        <Button
          href={SIGNUP_URL}
          text="Become an affiliate"
          target="_blank"
          rel="noopener noreferrer"
        />
      </div>
      <Paragraph size="small" class="text-center mt-8">
        Questions? Email me at <a class="link" href="mailto:support@picmal.app"
          >support@picmal.app</a
        >, or grab the <a
          class="link"
          href="https://drive.google.com/drive/folders/1Ee9FqH7g9tTqiOd529iSceHyo9J-PYYC?usp=sharing"
          target="_blank"
          rel="noopener">press kit</a
        >.
      </Paragraph>
    </Section>

    <Footer />

    

    <!-- Hero demo: autoplay the loop unless the user prefers reduced motion
         (then the poster stays put). Same as the homepage hero. -->
    <script>
      const heroVideo = document.getElementById(
        "hero-demo-video",
      ) as HTMLVideoElement | null;
      if (
        heroVideo &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        heroVideo.play().catch(() => {});
      }
    </script>
  </body>
</html>
