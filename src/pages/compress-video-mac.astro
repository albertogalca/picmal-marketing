          <!-- Feature 4 -->
          <div class="bg-background-subtle rounded-xl p-8 border border-border">
            <H3 class="mb-4">Full quality control</H3>
            <Paragraph class="mb-4">
              Fine-tune compression with precise control over bitrate,
