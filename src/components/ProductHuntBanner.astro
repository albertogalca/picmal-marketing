---
import Paragraph from "./Paragraph.astro";

// Product Hunt Launch Banner
---

<div
  id="ph-banner"
  class="bg-[#DA552F] text-white py-2.5 px-4 sticky top-0 z-50 shadow-md relative"
>
  <div class="max-w-6xl mx-auto">
    <!-- Mobile Layout -->
    <div class="flex md:hidden flex-col items-center gap-2 text-center pr-8">
      <div class="flex items-center gap-1.5 text-sm">
        <span class="font-semibold">We're live on Product Hunt!</span>
        <span>Get <strong>10% off</strong>:</span>
      </div>
      <div class="flex items-center gap-2">
        <button
          id="copy-code-btn"
          class="inline-flex items-center gap-1.5 bg-white text-[#DA552F] px-3 py-1.5 rounded-md font-mono font-bold text-sm hover:bg-gray-100 transition-all active:scale-95"
          aria-label="Copy discount code"
        >
          <span id="code-text" class="text-sm text-[#DA552F]">PHLAUNCH</span>
          <svg
            id="copy-icon"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
            ></path>
          </svg>
          <svg
            id="check-icon"
            class="hidden"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>
        <a
          href="https://www.producthunt.com/posts/picmal"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center bg-white text-[#DA552F] px-3 py-1.5 rounded-md font-semibold text-sm hover:bg-gray-100 transition-all"
        >
          Upvote us
        </a>
      </div>
    </div>

    <!-- Desktop Layout -->
    <div class="hidden md:flex items-center justify-between gap-4">
      <!-- Left Side: Message and Code -->
      <div class="flex items-center gap-3">
        <span class="font-semibold text-sm lg:text-base whitespace-nowrap"
          >We're live on Product Hunt!</span
        >
        <span class="text-sm lg:text-base whitespace-nowrap"
          >Get <strong>10% off</strong> with code:</span
        >

        <!-- Copy Code Button -->
        <button
          id="copy-code-btn-desktop"
          class="inline-flex items-center gap-2 bg-white text-[#DA552F] px-3 py-1.5 rounded-md font-mono font-bold text-sm hover:bg-gray-100 transition-all active:scale-95"
          aria-label="Copy discount code"
        >
          <span id="code-text-desktop" class="text-sm text-[#DA552F]"
            >PHLAUNCH</span
          >
          <svg
            id="copy-icon-desktop"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
            ></path>
          </svg>
          <svg
            id="check-icon-desktop"
            class="hidden"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>
      </div>

      <!-- Right Side: Upvote Button -->
      <a
        href="https://www.producthunt.com/posts/picmal"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-white text-[#DA552F] px-4 py-1.5 rounded-md font-semibold text-sm hover:bg-gray-100 transition-all whitespace-nowrap"
      >
        <span>Upvote us</span>
      </a>
    </div>

    <!-- Close Button (Shared) -->
    <button
      id="close-banner-btn"
      class="absolute top-1/2 -translate-y-1/2 right-2 text-white hover:text-gray-200 transition-colors p-1"
      aria-label="Close banner"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</div>

<script>
  // Copy to clipboard functionality for mobile
  const copyBtn = document.getElementById("copy-code-btn");
  const codeText = document.getElementById("code-text");
  const copyIcon = document.getElementById("copy-icon");
  const checkIcon = document.getElementById("check-icon");

  if (copyBtn && codeText && copyIcon && checkIcon) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText("PHLAUNCH");
        copyIcon.classList.add("hidden");
        checkIcon.classList.remove("hidden");
        codeText.textContent = "Copied!";
        setTimeout(() => {
          copyIcon.classList.remove("hidden");
          checkIcon.classList.add("hidden");
          codeText.textContent = "PHLAUNCH";
        }, 2000);
      } catch (err) {
        console.error("Failed to copy:", err);
      }
    });
  }

  // Copy to clipboard functionality for desktop
  const copyBtnDesktop = document.getElementById("copy-code-btn-desktop");
  const codeTextDesktop = document.getElementById("code-text-desktop");
  const copyIconDesktop = document.getElementById("copy-icon-desktop");
  const checkIconDesktop = document.getElementById("check-icon-desktop");

  if (
    copyBtnDesktop &&
    codeTextDesktop &&
    copyIconDesktop &&
    checkIconDesktop
  ) {
    copyBtnDesktop.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText("PHLAUNCH");
        copyIconDesktop.classList.add("hidden");
        checkIconDesktop.classList.remove("hidden");
        codeTextDesktop.textContent = "Copied!";
        setTimeout(() => {
          copyIconDesktop.classList.remove("hidden");
          checkIconDesktop.classList.add("hidden");
          codeTextDesktop.textContent = "PHLAUNCH";
        }, 2000);
      } catch (err) {
        console.error("Failed to copy:", err);
      }
    });
  }

  // Close banner functionality
  const closeBanner = document.getElementById("close-banner-btn");
  const banner = document.getElementById("ph-banner");

  if (closeBanner && banner) {
    closeBanner.addEventListener("click", () => {
      banner.style.display = "none";
      localStorage.setItem("phBannerDismissed", "true");
      window.dispatchEvent(new Event("storage"));
    });
  }

  // Check if banner was previously dismissed
  if (banner && localStorage.getItem("phBannerDismissed") === "true") {
    banner.style.display = "none";
  }
</script>
