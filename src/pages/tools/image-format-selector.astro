---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CTASection from "../../components/CTASection.astro";
import SelectionCard from "../../components/SelectionCard.astro";
import Button from "../../components/Button.astro";
import "../../styles/global.css";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import Paragraph from "../../components/Paragraph.astro";

const SITE_TITLE = "Image format selector";
const SITE_DESCRIPTION =
  "JPG, PNG, or WebP? Answer a few quick questions and get the perfect image format for your project. Free tool.";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
      url: "https://picmal.app/tools/image-format-selector",
      applicationCategory: "UtilityApplication",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    })} />
  </head>
  <body class="min-h-dvh bg-background text-text">
    <Header />

    <main class="pt-32 pb-16 sm:pb-20">
      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-16">
          <H1 class="mb-6 text-balance">Which image format should I use?</H1>
          <Paragraph
            class="max-w-2xl mx-auto text-base sm:text-lg text-text-secondary text-pretty"
          >
            Tell us about your project and we'll recommend the perfect format
            for your specific needs.
          </Paragraph>
        </div>

        <div id="format-selector" class="space-y-12">
          <!-- Question 1: Primary Use -->
          <div class="question-section">
            <H2 class="mb-8 text-balance">
              Where will you use these images?
            </H2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <SelectionCard
                title="Website or Social Media"
                description="For your website, blog, Instagram, or online portfolio"
                dataAttribute="data-use"
                dataValue="web"
              />
              <SelectionCard
                title="Printing"
                description="Business cards, posters, brochures, or photo prints"
                dataAttribute="data-use"
                dataValue="print"
              />
              <SelectionCard
                title="Design Work"
                description="Logos, icons, or graphics that need transparent backgrounds"
                dataAttribute="data-use"
                dataValue="graphics"
              />
              <SelectionCard
                title="Professional Photos"
                description="Photography work, photo editing, or archiving your images"
                dataAttribute="data-use"
                dataValue="photography"
              />
            </div>
          </div>

          <!-- Question 2: Image Type -->
          <div class="question-section" style="display: none;">
            <H2 class="mb-8 text-balance"> Tell me about your images </H2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <SelectionCard
                title="Real Photos"
                description="Those beautiful shots from your camera or phone"
                dataAttribute="data-type"
                dataValue="photo"
              />
              <SelectionCard
                title="Graphics & Illustrations"
                description="Logos, icons, drawings, or any designed graphics"
                dataAttribute="data-type"
                dataValue="graphic"
              />
              <SelectionCard
                title="Screenshots"
                description="Screen captures, app interfaces, or UI elements"
                dataAttribute="data-type"
                dataValue="screenshot"
              />
              <SelectionCard
                title="A bit of everything"
                description="Mix of photos, graphics, and other visual content"
                dataAttribute="data-type"
                dataValue="mixed"
              />
            </div>
          </div>

          <!-- Question 3: Requirements -->
          <div class="question-section" style="display: none;">
            <H2 class="mb-8 text-balance">
              What matters most to you right now?
            </H2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <SelectionCard
                title="Perfect Quality"
                description="I want my images to look absolutely stunning"
                dataAttribute="data-priority"
                dataValue="quality"
              />
              <SelectionCard
                title="Tiny File Sizes"
                description="I need them to load fast and take less space"
                dataAttribute="data-priority"
                dataValue="size"
              />
              <SelectionCard
                title="Universal Support"
                description="They should work everywhere without issues"
                dataAttribute="data-priority"
                dataValue="compatibility"
              />
              <SelectionCard
                title="Cool Features"
                description="Transparency, animations, or special effects"
                dataAttribute="data-priority"
                dataValue="features"
              />
            </div>
          </div>

          <!-- Results Section -->
          <div id="results" style="display: none;" class="space-y-8">
            <div class="flex justify-between items-start">
              <H2 class="text-balance">Here are your perfect matches! </H2>
              <Button
                type="button"
                variant="secondary"
                size="small"
                text=""
                id="restart-btn"
                title="Start over"
                icon="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              />
            </div>

            <div id="recommendations" class="space-y-4">
              <!-- Recommendations will be inserted here -->
            </div>

            <div
              class="bg-background-subtle/50 border border-border p-6 rounded-lg"
            >
              <div class="font-semibold text-text mb-5">Quick cheat sheet</div>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-4 text-sm">
                <div>
                  <div class="font-semibold text-text">JPEG/JPG</div>
                  <p class="text-text-secondary text-xs mt-0.5">
                    Photos, small files
                  </p>
                </div>
                <div>
                  <div class="font-semibold text-text">PNG</div>
                  <p class="text-text-secondary text-xs mt-0.5">
                    Logos, transparency
                  </p>
                </div>
                <div>
                  <div class="font-semibold text-text">WebP</div>
                  <p class="text-text-secondary text-xs mt-0.5">
                    Modern, efficient
                  </p>
                </div>
                <div>
                  <div class="font-semibold text-text">TIFF</div>
                  <p class="text-text-secondary text-xs mt-0.5">
                    Professional printing
                  </p>
                </div>
                <div>
                  <div class="font-semibold text-text">SVG</div>
                  <p class="text-text-secondary text-xs mt-0.5">
                    Vector, scalable
                  </p>
                </div>
                <div>
                  <div class="font-semibold text-text">HEIC</div>
                  <p class="text-text-secondary text-xs mt-0.5">
                    Apple, space-saving
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CTA Section -->
        <CTASection
          heading="Use Picmal to easily convert your media on your Mac"
          analyticsEvent="buy_clicked_image_format_selector"
        />
      </div>
    </main>

    <Footer />

    <script>
      const formatData = {
        recommendations: {
          web: {
            photo: {
              quality: ["WebP", "JPEG", "PNG"],
              size: ["WebP", "JPEG", "AVIF"],
              compatibility: ["JPEG", "PNG", "WebP"],
              features: ["WebP", "PNG", "AVIF"],
            },
            graphic: {
              quality: ["PNG", "SVG", "WebP"],
              size: ["SVG", "WebP", "PNG"],
              compatibility: ["PNG", "JPEG", "SVG"],
              features: ["SVG", "PNG", "WebP"],
            },
            screenshot: {
              quality: ["PNG", "WebP"],
              size: ["WebP", "PNG", "JPEG"],
              compatibility: ["PNG", "JPEG"],
              features: ["PNG", "WebP"],
            },
            mixed: {
              quality: ["WebP", "PNG"],
              size: ["WebP", "JPEG"],
              compatibility: ["JPEG", "PNG"],
              features: ["WebP", "PNG"],
            },
          },
          print: {
            photo: {
              quality: ["TIFF", "PNG", "JPEG"],
              size: ["JPEG", "PDF"],
              compatibility: ["PDF", "JPEG", "TIFF"],
              features: ["TIFF", "PDF", "PNG"],
            },
            graphic: {
              quality: ["PDF", "SVG", "TIFF"],
              size: ["PDF", "SVG"],
              compatibility: ["PDF", "PNG"],
              features: ["PDF", "SVG", "TIFF"],
            },
            screenshot: {
              quality: ["PNG", "TIFF", "PDF"],
              size: ["PDF", "PNG"],
              compatibility: ["PDF", "PNG"],
              features: ["PDF", "PNG", "TIFF"],
            },
            mixed: {
              quality: ["PDF", "TIFF", "PNG"],
              size: ["PDF", "JPEG"],
              compatibility: ["PDF", "JPEG"],
              features: ["PDF", "TIFF"],
            },
          },
          graphics: {
            photo: {
              quality: ["PNG", "TIFF"],
              size: ["PNG", "WebP"],
              compatibility: ["PNG", "JPEG"],
              features: ["PNG", "WebP"],
            },
            graphic: {
              quality: ["SVG", "PNG", "PDF"],
              size: ["SVG", "WebP"],
              compatibility: ["PNG", "PDF"],
              features: ["SVG", "PNG", "PDF"],
            },
            screenshot: {
              quality: ["PNG", "TIFF"],
              size: ["PNG", "WebP"],
              compatibility: ["PNG"],
              features: ["PNG"],
            },
            mixed: {
              quality: ["PNG", "PDF"],
              size: ["WebP", "PNG"],
              compatibility: ["PNG", "PDF"],
              features: ["PNG", "PDF"],
            },
          },
          photography: {
            photo: {
              quality: ["RAW", "TIFF", "PNG"],
              size: ["HEIC", "JPEG", "WebP"],
              compatibility: ["JPEG", "TIFF", "PNG"],
              features: ["RAW", "TIFF", "HEIC"],
            },
            graphic: {
              quality: ["PNG", "TIFF"],
              size: ["PNG", "WebP"],
              compatibility: ["PNG", "JPEG"],
              features: ["PNG", "TIFF"],
            },
            screenshot: {
              quality: ["PNG", "TIFF"],
              size: ["PNG", "JPEG"],
              compatibility: ["PNG", "JPEG"],
              features: ["PNG", "TIFF"],
            },
            mixed: {
              quality: ["TIFF", "PNG"],
              size: ["JPEG", "HEIC"],
              compatibility: ["JPEG", "PNG"],
              features: ["TIFF", "PNG"],
            },
          },
        },
        descriptions: {
          JPEG: "The classic choice! Works everywhere and keeps photo file sizes small. You might lose a tiny bit of quality, but most people won't notice.",
          PNG: "Perfect for graphics and logos! Keeps every pixel crisp and supports transparent backgrounds. Files are a bit larger, but quality is pristine.",
          WebP: "Google's modern powerhouse - up to 35% smaller files with better quality than JPEG. Not all browsers love it yet, but it's getting there!",
          TIFF: "The professional's choice for printing. Massive files but zero quality loss. Your printer will thank you!",
          SVG: "Vector magic! Scale it to billboard size or thumbnail - it always looks perfect. Ideal for logos and simple graphics.",
          PDF: "The reliable document format. Great when you need everything to look exactly the same everywhere, especially for printing.",
          HEIC: "Apple's space-saving genius - half the size of JPEG with better quality! Just make sure your audience can open it.",
          AVIF: "The new kid on the block with amazing compression. Better than WebP, but still gaining support across browsers.",
          RAW: "The photographer's goldmine - all the original camera data for maximum editing flexibility. You'll need special software though!",
        },
      };

      let selections = {};
      let currentQuestion = 0;
      const questions = document.querySelectorAll(".question-section");

      document
        .querySelectorAll("[data-use], [data-type], [data-priority]")
        .forEach((card) => {
          card.addEventListener("click", function () {
            const parent = this.closest(".question-section");
            parent
              .querySelectorAll("[data-use], [data-type], [data-priority]")
              .forEach((c) => {
                c.classList.remove("border-accent", "bg-accent/5");
                c.classList.add("border-border");
              });
            this.classList.remove("border-border");
            this.classList.add("border-accent", "bg-accent/5");

            if (this.dataset.use) {
              selections.use = this.dataset.use;
              showNextQuestion();
            } else if (this.dataset.type) {
              selections.type = this.dataset.type;
              showNextQuestion();
            } else if (this.dataset.priority) {
              selections.priority = this.dataset.priority;
              showResults();
            }
          });
        });

      function showNextQuestion() {
        questions[currentQuestion].style.display = "none";
        currentQuestion++;
        if (currentQuestion < questions.length) {
          questions[currentQuestion].style.display = "block";
          questions[currentQuestion].scrollIntoView({
            behavior: "smooth",
            block: "center",
          });
        }
      }

      function showResults() {
        questions.forEach((q) => (q.style.display = "none"));
        document.getElementById("results").style.display = "block";

        const formats =
          formatData.recommendations[selections.use][selections.type][
            selections.priority
          ];
        const recommendationsDiv = document.getElementById("recommendations");

        recommendationsDiv.innerHTML = formats
          .map((format, index) => {
            if (index === 0) {
              return `
                <div class="border-2 border-accent bg-accent/5 rounded-xl p-6 relative">
                  <div class="absolute top-4 right-4">
                    <span class="inline-block px-3 py-1.5 rounded-full text-xs font-semibold bg-accent text-white">Best choice</span>
                  </div>
                  <div class="pr-24">
                    <h3 class="text-2xl font-bold text-text mb-2">${format}</h3>
                    <p class="text-text-secondary leading-relaxed">${formatData.descriptions[format]}</p>
                  </div>
                </div>
              `;
            }

            return `
              <div class="border border-border rounded-lg p-5">
                <h3 class="text-lg font-semibold text-text mb-2">${format}</h3>
                <p class="text-text-secondary text-sm leading-relaxed">${formatData.descriptions[format]}</p>
              </div>
            `;
          })
          .join("");

        document
          .getElementById("results")
          .scrollIntoView({ behavior: "smooth", block: "start" });
      }

      document.getElementById("restart-btn").addEventListener("click", () => {
        selections = {};
        currentQuestion = 0;
        questions.forEach((q, i) => {
          q.style.display = i === 0 ? "block" : "none";
          q.querySelectorAll(
            "[data-use], [data-type], [data-priority]",
          ).forEach((c) => {
            c.classList.remove("border-accent", "bg-accent/5");
            c.classList.add("border-border");
          });
        });
        document.getElementById("results").style.display = "none";
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    </script>
  </body>
</html>
