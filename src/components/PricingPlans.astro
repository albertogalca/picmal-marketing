---
import { Icon } from "astro-icon/components";
import Button from "./Button.astro";
import Card from "./Card.astro";
import H3 from "./H3.astro";
import Paragraph from "./Paragraph.astro";
import type { Feature } from "../config/pricing";
import { MAC_APP_STORE, PLANS } from "../config/pricing";

const CHECK =
  "M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z";
const APPLE =
  "M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 14.25 3.51 5.71 9.05 5.43c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 3.97l.01-.01zM12.03 5.38c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z";

const [standard, pro] = PLANS;

// One shape for all three columns so the card markup stays a single loop. The
// App Store is a buying channel, not a tier, but it buys the same app at the
// same price, so it reads best as a third column.
interface PlanCard {
  key: string;
  name: string;
  price: number;
  features: Feature[];
  cta: {
    text: string;
    href: string;
    variant: "primary" | "secondary";
    event: string;
  };
  icon?: string;
}

// No highlight ring on the default plan: the filled button is the only emphasis
// the grid needs.
//
// Feature bullets render two ways. A plain string is split on the `{mac}` token,
// which becomes a laptop glyph (the word "Macs" stays in the accessibility tree).
// A link feature is split on its `linkText`, so the row reads as a bullet with
// one linked word rather than as a call to action.
const cards: PlanCard[] = [
  {
    key: standard.id,
    name: standard.name,
    price: standard.price,
    features: standard.features,
    cta: {
      text: `Get Picmal for $${standard.price}`,
      href: standard.checkoutUrl,
      variant: "primary",
      event: "buy_clicked",
    },
  },
  {
    key: pro.id,
    name: pro.name,
    price: pro.price,
    features: pro.features,
    cta: {
      text: `Get Picmal Pro for $${pro.price}`,
      href: pro.checkoutUrl,
      variant: "secondary",
      event: "buy_clicked_pro",
    },
  },
  {
    key: "app-store",
    name: "Mac App Store",
    icon: APPLE,
    price: MAC_APP_STORE.price,
    features: MAC_APP_STORE.features,
    cta: {
      text: "Get it on the App Store",
      href: MAC_APP_STORE.url,
      variant: "secondary",
      event: "buy_clicked_app_store",
    },
  },
];
---

<div class="grid gap-6 md:grid-cols-3 items-stretch">
  {
    cards.map((card) => (
      <Card padding="p-6" class="flex flex-col">
        <div class="flex items-center gap-2 mb-1">
          {card.icon && (
            <svg
              class="w-4 h-4 text-text-secondary shrink-0"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d={card.icon} />
            </svg>
          )}
          <H3 class="text-h4">{card.name}</H3>
        </div>

        <div class="flex items-baseline gap-1.5 mb-6">
          <span class="text-h2 font-semibold text-text tabular-nums">
            ${card.price}
          </span>
          <span class="text-small text-text-secondary">one-time</span>
        </div>

        <ul class="space-y-2.5 flex-1">
          {card.features.map((feature) => (
            <li class="flex items-start gap-2.5">
              <svg
                class="w-4 h-4 text-text-secondary shrink-0 mt-1"
                fill="currentColor"
                viewBox="0 0 20 20"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d={CHECK} clip-rule="evenodd" />
              </svg>
              <Paragraph size="small">
                {typeof feature === "string"
                  ? feature.split("{mac}").map((part, i) => (
                      <Fragment>
                        {i > 0 && (
                          <Fragment>
                            <Icon
                              name="ph:laptop"
                              class="inline w-4 h-4 align-[-0.2em]"
                              aria-hidden="true"
                            />
                            <span class="sr-only">Macs</span>
                          </Fragment>
                        )}
                        {part}
                      </Fragment>
                    ))
                  : feature.text.split(feature.linkText).map((part, i) => (
                      <Fragment>
                        {i > 0 && (
                          <a href={feature.href} class="link">
                            {feature.linkText}
                          </a>
                        )}
                        {part}
                      </Fragment>
                    ))}
              </Paragraph>
            </li>
          ))}
        </ul>

        <Button
          text={card.cta.text}
          href={card.cta.href}
          variant={card.cta.variant}
          class="w-full mt-6"
          onclick={
            import.meta.env.PROD
              ? `window.seline?.track('${card.cta.event}')`
              : undefined
          }
        />
      </Card>
    ))
  }
</div>

<Paragraph size="small" class="text-center mt-4">
  Prices in USD. Any tax is added at checkout. Secure payment via Stripe.
</Paragraph>
