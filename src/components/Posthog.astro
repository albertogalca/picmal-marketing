<!--
  Closed-loop attribution: forward the visitor's PostHog identity through the licencio
  checkout link as client_reference_id. licencio passes it to the Stripe Checkout
  Session, so it comes back on checkout.session.completed (session.client_reference_id)
  and source → click → revenue land on the same PostHog person. distinct_id is enough —
  PostHog already holds that person's first-touch UTMs. Capture phase + reading href
  at click time keeps every CTA (and DynamicPricing's tier-swapping href) working.
-->
<!--
  Affiliate attribution: capture ?ref=CODE into a 60-day first-party cookie, then
  append ref=<code> to every /api/checkout link. licencio resolves the code to an
  approved Affiliate and freezes commission at sale time (unknown codes ignored).
-->
<script is:inline>
  try {
    var refParam = new URLSearchParams(location.search).get("ref");
    if (refParam)
      document.cookie =
        "ref=" +
        encodeURIComponent(refParam) +
        "; max-age=5184000; path=/; samesite=lax"; // 60 days
  } catch (_) {}

  document.addEventListener(
    "click",
    function (e) {
      var a = e.target.closest && e.target.closest('a[href*="/api/checkout"]');
      if (!a) return;
      try {
        var url = new URL(a.href);
        var ph = window.posthog;
        var did = ph && ph.get_distinct_id && ph.get_distinct_id();
        if (did) url.searchParams.set("client_reference_id", did);
        var ref = document.cookie.match(/(?:^|;\s*)ref=([^;]*)/);
        if (ref) url.searchParams.set("ref", decodeURIComponent(ref[1]));
        a.href = url.toString();
      } catch (_) {}
    },
    true,
  );
</script>
