                <path
                  d="M10.708 16.542L6.33301 20.917L10.708 25.292"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </g>
              <defs>
                <clipPath id="clip0_1109_1381">
                  <rect
                    width="35"
                    height="35"
                    fill="white"
                    transform="translate(0.5 0.5)"></rect>
                </clipPath>
              </defs>
            </svg>
          </FeatureCard>

          <FeatureCard
            title="Smart compression"
            description="Reduce file sizes by up to 80% while maintaining quality. Works with images, videos, and audio files. Perfect for the web and email."
          >
            <svg
              slot="icon"
              viewBox="0 0 36 36"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <g clip-path="url(#clip0_1109_1387)">
                <path
                  d="M20.917 4.875V10.7083C20.917 11.0951 21.0706 11.466 21.3441 11.7395C21.6176 12.013 21.9886 12.1667 22.3753 12.1667H28.2087"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M7.79199 18V7.79167C7.79199 7.01812 8.09928 6.27625 8.64626 5.72927C9.19324 5.18229 9.93511 4.875 10.7087 4.875H20.917L28.2087 12.1667V18"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M23.833 26.75H26.0205C26.6007 26.75 27.1571 26.5195 27.5673 26.1093C27.9775 25.6991 28.208 25.1427 28.208 24.5625C28.208 23.9823 27.9775 23.4259 27.5673 23.0157C27.1571 22.6055 26.6007 22.375 26.0205 22.375H23.833V31.125"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M18 22.375V31.125"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M7.79199 22.375H12.167L7.79199 31.125H12.167"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </g>
              <defs>
                <clipPath id="clip0_1109_1387">
                  <rect
                    width="35"
                    height="35"
                    fill="white"
                    transform="translate(0.5 0.5)"></rect>
                </clipPath>
              </defs>
            </svg>
          </FeatureCard>

          <FeatureCard
            title="Privacy focused"
            description="Your files never leave your Mac. No uploads, no cloud storage, no tracking. Complete privacy."
          >
            <svg
              slot="icon"
              viewBox="0 0 36 36"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <g clip-path="url(#clip0_1109_1395)">
                <path
                  d="M4.875 23.8337V12.167"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M10.708 12.167V23.8337"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M4.875 18H10.7083"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M20.9163 12.167H17.9997M15.083 15.0837V23.8337H20.9163"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M15.083 18H17.9997"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M25.292 19.4587V15.0837C25.292 14.3101 25.5993 13.5682 26.1463 13.0213C26.6932 12.4743 27.4351 12.167 28.2087 12.167C28.9822 12.167 29.7241 12.4743 30.2711 13.0213C30.818 13.5682 31.1253 14.3101 31.1253 15.0837V23.8337"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M25.292 19.458H31.1253"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M4.875 4.875L31.125 31.125"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </g>
              <defs>
                <clipPath id="clip0_1109_1395">
                  <rect
                    width="35"
                    height="35"
                    fill="white"
                    transform="translate(0.5 0.5)"></rect>
                </clipPath>
              </defs>
            </svg>
          </FeatureCard>
        </div>
      </div>
    </section>

    <!-- Featured On Section -->
    <section class="relative z-10">
      <FeaturedOn />
    </section>

    <!-- Pricing -->
    <section id="pricing" class="relative z-10 px-6 py-20">
      <div class="max-w-5xl mx-auto">
        <div
          class="grid grid-cols-1 md:grid-cols-2 gap-2 md:gap-32 items-start"
        >
          <!-- Title and Description (appears first on mobile and desktop) -->
          <div class="md:order-1 text-center md:text-left">
            <H2 class="mb-6"
              >Pay only once,<br class="hidden md:block" /> own it forever</H2
            >
            <Paragraph class="mb-4 md:mb-8">
              No subscriptions, no hidden fees. Buy Picmal once and use it
              forever with all future updates included.
            </Paragraph>

            <!-- FAQs (appears third on mobile, with title on desktop) -->
            <div class="hidden md:block">
              <FAQ faqs={licenseFaqs} />
            </div>
          </div>

          <!-- Pricing Card (appears second on mobile and desktop) -->
          <div class="md:order-2">
            <DynamicPricing />
          </div>

          <!-- FAQs for mobile (appears third on mobile, hidden on desktop) -->
          <div class="md:hidden">
            <FAQ faqs={licenseFaqs} />
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="relative z-10 px-6 py-20">
      <div class="max-w-2xl mx-auto">
        <H2 class="mb-12 text-center">Frequently asked questions</H2>
        <FAQ faqs={faqs} />
      </div>
    </section>

    <Footer />
    <script>
      window.lemonSqueezyAffiliateConfig = { store: "picmal" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
