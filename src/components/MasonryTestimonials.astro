---
import testimonials from "../data/testimonials.json";
import Card from "./Card.astro";
import H2 from "./H2.astro";
import TestimonialCard from "./TestimonialCard.astro";
import TrustBar from "./TrustBar.astro";
import Section from "./Section.astro";

interface Props {
  heading?: string;
  showTrustBar?: boolean;
  trustSuffix?: string;
}
const { heading, showTrustBar = false, trustSuffix } = Astro.props;

const userTestimonials = testimonials.filter((t) => t.type !== "press");

// Three slowly scrolling columns. Each column's list is rendered twice and the
// track animates to -50%, so the loop closes seamlessly; the second copy is
// `inert` (out of the a11y tree and out of the tab order). Durations differ a
// little so the columns don't march in lockstep.
// Press reviews live in `FeaturedReview` (hero + below pricing), not in the
// wall: a logo card reads as an ad when it drifts past between user quotes.
const per = Math.ceil(userTestimonials.length / 3);
const columns = [
  { items: userTestimonials.slice(0, per), duration: "56s" },
  { items: userTestimonials.slice(per, per * 2), duration: "68s" },
  { items: userTestimonials.slice(per * 2), duration: "62s" },
].map((column) => ({
  duration: column.duration,
  cards: [...column.items, ...column.items].map((t, i) => ({
    t,
    dup: i >= column.items.length,
    isLink: !!t.link,
  })),
}));

const reviewSchemas = userTestimonials.map((t) => ({
  "@type": "Review",
  author: { "@type": "Person", name: t.name },
  reviewBody: t.content,
  reviewRating: {
    "@type": "Rating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "1",
  },
}));

const aggregateRatingSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Picmal",
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.8",
    reviewCount: String(userTestimonials.length),
    bestRating: "5",
    worstRating: "1",
  },
  review: reviewSchemas,
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(aggregateRatingSchema)}
/>

<Section id="testimonials" width="wide">
  <div class="text-center mb-12">
    <H2 class="mb-6 max-w-3xl mx-auto">
      {
        heading ? (
          heading
        ) : (
          <>
            What people are <br /> saying about Picmal
          </>
        )
      }
    </H2>
    {showTrustBar && <TrustBar prefix="" suffix={trustSuffix} />}
  </div>

  <div class="marquee flex justify-center gap-6" data-marquee>
    {
      columns.map((column, c) => (
        <div
          class:list={[
            "marquee-col",
            c === 1 && "hidden md:block",
            c === 2 && "hidden lg:block",
          ]}
        >
          <div class="marquee-track" style={`--duration:${column.duration}`}>
            {column.cards.map((card) =>
              card.isLink ? (
                <a
                  href={card.t.link}
                  target="_blank"
                  rel="nofollow noreferrer"
                  inert={card.dup}
                  class:list={[
                    "block rounded-2xl hover:opacity-80 active:scale-[0.98] transition-[opacity,scale] duration-200 ease-out motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
                    card.dup && "marquee-dup",
                  ]}
                >
                  <Card>
                    <TestimonialCard testimonial={card.t} align="left" />
                  </Card>
                </a>
              ) : (
                <Card inert={card.dup} class={card.dup ? "marquee-dup" : ""}>
                  <TestimonialCard testimonial={card.t} align="left" />
                </Card>
              )
            )}
          </div>
        </div>
      ))
    }
  </div>

  <div class="marquee-controls mt-8 flex justify-center">
    <button
      type="button"
      data-marquee-toggle
      aria-pressed="false"
      aria-label="Pause the scrolling reviews"
      class="inline-flex items-center justify-center w-10 h-10 rounded-full cursor-pointer text-text-secondary hover:text-text border bg-background border-border shadow-xs hover:bg-background-subtle dark:bg-white/[0.06] dark:border-white/[0.10] dark:shadow-[inset_0_1px_0_rgba(255,255,255,0.07)] dark:hover:bg-white/[0.10] transition-[color,scale,background-color,border-color] duration-200 ease-out motion-reduce:transition-none active:scale-[0.96] motion-reduce:active:scale-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      <svg
        class="icon-pause w-4 h-4"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <rect x="7" y="5" width="3.5" height="14" rx="1.25"></rect>
        <rect x="13.5" y="5" width="3.5" height="14" rx="1.25"></rect>
      </svg>
      <svg
        class="icon-play w-4 h-4 hidden"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M8 5.5a1 1 0 0 1 1.53-.85l9 6.5a1 1 0 0 1 0 1.7l-9 6.5A1 1 0 0 1 8 18.5v-13Z"
        ></path>
      </svg>
    </button>
  </div>
</Section>

<style>
  .marquee {
    max-height: 740px;
    /* `clip`, not `hidden`: a focused card near the edge would otherwise scroll
       this box and knock the loop out of alignment. */
    overflow: clip;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent,
      black 12%,
      black 88%,
      transparent
    );
    mask-image: linear-gradient(
      to bottom,
      transparent,
      black 12%,
      black 88%,
      transparent
    );
  }

  .marquee-col {
    width: 100%;
    max-width: 24rem;
  }

  .marquee-track {
    display: flex;
    flex-direction: column;
    /* Gap and trailing padding must match, or the loop seam shows. */
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    animation: marquee-scroll var(--duration, 60s) linear infinite;
    will-change: transform;
  }

  /* Reading a quote shouldn't be a moving target: hover and keyboard focus both
     hold the wall still. The button sets animation-play-state inline (a
     runtime-only class gets pruned from Astro's scoped sheet). */
  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }

  /* No motion: a plain scrollable wall, with the duplicate copies and the
     pause control (which would then do nothing) dropped. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-y: auto;
    }

    .marquee-track {
      animation: none;
      will-change: auto;
    }

    .marquee-dup,
    .marquee-controls {
      display: none;
    }
  }

  /* Keep @keyframes last: rules after it get dropped from the scoped sheet. */
  @keyframes marquee-scroll {
    to {
      transform: translateY(-50%);
    }
  }
</style>

<script>
  const marquee = document.querySelector<HTMLElement>("[data-marquee]");
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-marquee-toggle]",
  );

  const tracks = marquee
    ? [...marquee.querySelectorAll<HTMLElement>(".marquee-track")]
    : [];
  let paused = false;

  toggle?.addEventListener("click", () => {
    paused = !paused;
    tracks.forEach((track) => {
      track.style.animationPlayState = paused ? "paused" : "";
    });
    toggle.setAttribute("aria-pressed", String(paused));
    toggle.setAttribute(
      "aria-label",
      paused ? "Resume the scrolling reviews" : "Pause the scrolling reviews",
    );
    toggle.querySelector(".icon-pause")?.classList.toggle("hidden", paused);
    toggle.querySelector(".icon-play")?.classList.toggle("hidden", !paused);
  });

  // Focusing a card near the clipped edge would otherwise scroll this box and
  // knock the loop out of alignment. (Reduced motion turns it into a real
  // scroll area, so leave that alone.)
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    marquee?.addEventListener("scroll", () => {
      marquee.scrollTop = 0;
    });
  }
</script>
