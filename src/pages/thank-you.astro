---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { DMG_URL } from "../config/download";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Paragraph from "../components/Paragraph.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import TrustBar from "../components/TrustBar.astro";
import Confetti from "../components/Confetti.astro";

// Where licencio sends buyers after a successful Stripe checkout (set as the
// product's checkout success URL). The license key arrives by email once
// payment confirms, so this page's job is to say that plainly and hand over the
// download while they wait.

const RECOVERY_URL =
  "https://licenses.albertogalca.com/portal/recoveries/new?product=picmal";

// Buyer-side newsletter opt-in. Buying does NOT subscribe anyone to the
// newsletter; important notices still reach every buyer as transactional email
// regardless. This form is the one place a buyer can choose to also get the
// marketing newsletter. Same Loops form endpoint as the footer NewsletterSignup
// (adds to the "Picmal Newsletter" list), but its own ids so it doesn't collide
// with the footer form on this page.
const SUBSCRIBE_ENDPOINT =
  "https://app.loops.so/api/newsletter-form/cmiluz55e9uluzv0ibuw5hwgv";
// List must be passed explicitly on the POST — the form's Loops "Select a list"
// setting is ignored for raw API submissions.
const NEWSLETTER_LIST_ID = "cmrhv19wy17l10j22epyc5r8v";
---

<MarketingLayout
  title="Picmal: Thank you"
  description="Your Picmal license key is on its way to your inbox. Download Picmal for Mac and start converting."
  noindex={true}
  mainClass="relative z-10 pt-32 pb-16 sm:pb-20"
>
  <div class="max-w-3xl mx-auto px-6 text-center">
    <H1 class="mb-6 reveal">Thank you!</H1>
    <Paragraph
      size="lead"
      class="mb-8 max-w-xl mx-auto reveal [animation-delay:80ms]"
    >
      Your license key is on its way to the email you paid with. While it
      lands, grab the app.
    </Paragraph>

    <div
      class="flex flex-col items-center gap-3 reveal"
      style="animation-delay:160ms"
    >
      <Button
        href={DMG_URL}
        text="Download Picmal (.dmg)"
        class="w-full sm:w-auto"
        onclick={import.meta.env.PROD
          ? "window.seline?.track('download_dmg')"
          : undefined}
      />
      <p class="mt-2 text-small text-text-secondary">
        Requires macOS 15.0 (Sequoia) or later · Apple Silicon &amp; Intel
      </p>
    </div>

    <div class="mt-6 reveal" style="animation-delay:240ms">
      <TrustBar />
    </div>
  </div>

  <!-- The key arrives by email, not on this page. Say it once, clearly,
       where someone scanning for "so where is my key?" will look. -->
  <div class="max-w-2xl mx-auto px-6 mt-12 reveal" style="animation-delay:320ms">
    <Card padding="px-6 py-5 sm:px-7" class="flex items-start gap-3.5 text-left">
      <svg
        class="mt-0.5 shrink-0 text-accent"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="2.5" y="4.5" width="19" height="15" rx="2.5"></rect>
        <path d="m3 6 9 6 9-6"></path>
      </svg>
      <div>
        <H2 class="text-h4">Your key arrives by email</H2>
        <Paragraph class="mt-1.5">
          Stripe sends the receipt right away. Your license key follows in a
          separate email, usually within a minute. Open the app and go to
          <strong class="font-medium text-text"
            >Picmal → Register license</strong
          >, paste it in and click <strong class="font-medium text-text"
            >Activate</strong
          >. That's the whole setup.
        </Paragraph>
        <Paragraph class="mt-3">
          Nothing after a few minutes? Check your spam folder, then <a
            href={RECOVERY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="link">have it sent again</a
          >. Still stuck? Write to <a
            href="mailto:support@picmal.app"
            class="link">support@picmal.app</a
          > and I'll sort it out.
        </Paragraph>
      </div>
    </Card>
  </div>

  <!-- Optional newsletter opt-in. Buyers already get their license and any
       critical notices; this is purely the marketing newsletter, off by
       default, only if they ask for it. Kept as a light, unboxed footnote so
       it stays clearly secondary to the "your key arrives" card above. -->
  <div class="max-w-2xl mx-auto px-6 mt-8 pt-8 border-t border-border reveal text-left" style="animation-delay:400ms">
    <Paragraph size="small">
      <strong class="font-medium text-text">Want the occasional update?</strong>
      Your license and any important notices reach you either way. This is just
      the newsletter: now and then, a note on new Picmal features and other
      things I make. Leave anytime.
    </Paragraph>

    <form id="ty-optin-form" class="mt-3" data-endpoint={SUBSCRIBE_ENDPOINT} data-list={NEWSLETTER_LIST_ID} novalidate>
      <label for="ty-optin-email" class="sr-only">Email</label>
      <div class="flex flex-col gap-2 sm:flex-row sm:max-w-md">
        <input
          id="ty-optin-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="min-w-0 flex-1 rounded-xl border border-border bg-background px-3 py-2 text-body text-text placeholder:text-text-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        />
        <Button type="submit" text="Keep me posted" size="small" class="shrink-0" />
      </div>
      <!-- Honeypot: hidden from users, bots fill it. -->
      <input
        type="text"
        name="website"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
        class="hidden"
      />
      <p
        id="ty-optin-msg"
        class="mt-2 text-small text-text-secondary"
        role="status"
        aria-live="polite"
      >
      </p>
    </form>
  </div>

  <Fragment slot="after">
    <Confetti />

    <script>
          function initThankYouOptIn() {
            const form = document.getElementById(
              "ty-optin-form",
            ) as HTMLFormElement | null;
            if (!form || form.dataset.bound) return;
            form.dataset.bound = "true";

            const msg = document.getElementById("ty-optin-msg") as HTMLElement;
            const button = form.querySelector(
              'button[type="submit"]',
            ) as HTMLButtonElement;

            form.addEventListener("submit", async (e) => {
              e.preventDefault();
              const data = new FormData(form);
              const email = String(data.get("email") || "").trim();
              const website = String(data.get("website") || "");

              // Honeypot: a real user never fills this. Fake success, never hit Loops.
              if (website) {
                form.reset();
                msg.textContent = "Thanks — you're on the list.";
                return;
              }
              if (!email) {
                msg.textContent = "Please enter your email.";
                return;
              }

              button.disabled = true;
              msg.textContent = "Subscribing…";

              try {
                const res = await fetch(form.dataset.endpoint!, {
                  method: "POST",
                  headers: { "Content-Type": "application/x-www-form-urlencoded" },
                  body: new URLSearchParams({ email, mailingLists: form.dataset.list! }),
                });
                const out = await res.json().catch(() => ({}));
                if (res.ok && out.success) {
                  form.reset();
                  msg.textContent = "Thanks — you're on the list.";
                  if (import.meta.env.PROD)
                    window.seline?.track("newsletter_subscribed", {
                      source: "post_purchase",
                    });
                } else {
                  msg.textContent = out.message || "Something went wrong. Try again.";
                  button.disabled = false;
                }
              } catch {
                msg.textContent = "Network error. Try again.";
                button.disabled = false;
              }
            });
          }

          initThankYouOptIn();
          document.addEventListener("astro:page-load", initThankYouOptIn);
        </script>



        <!-- Split-and-stagger entrance: each chunk fades up ~80ms after the last,
             so the page assembles itself rather than popping in as one block.
             translateY is a small fixed nudge, not full height. -->
        <style>
          .reveal {
            opacity: 0;
            animation: reveal-up 0.5s cubic-bezier(0.2, 0, 0, 1) both;
          }
          @keyframes reveal-up {
            from {
              opacity: 0;
              transform: translateY(8px);
            }
            to {
              opacity: 1;
              transform: translateY(0);
            }
          }
          @media (prefers-reduced-motion: reduce) {
            .reveal {
              opacity: 1;
              animation: none;
            }
          }
        </style>
  </Fragment>
</MarketingLayout>
