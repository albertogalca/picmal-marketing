---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Paragraph from "../components/Paragraph.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import CTASection from "../components/CTASection.astro";
import ProductSchema from "../components/schema/ProductSchema.astro";
import MasonryTestimonials from "../components/MasonryTestimonials.astro";
import SectionDivider from "../components/SectionDivider.astro";
import PricingSection from "../components/PricingSection.astro";
import SupportedFormatsModal from "../components/SupportedFormatsModal.astro";
import ComparisonHero from "../components/ComparisonHero.astro";

const title =
  "HEIC Converter for Mac — Convert HEIC to JPG, PNG, WebP | Picmal";
const description =
  "Convert HEIC files from your iPhone to JPG, PNG, WebP, or any format on your Mac. Batch conversion, offline, no quality loss. $15.99 one-time.";

const faqs = [
  {
    question: "What is HEIC and why do I need to convert it?",
    answer:
      "HEIC is Apple's image format used by iPhones since iOS 11. While it offers better compression than JPG, many websites, Windows PCs, and older apps can't open HEIC files. Converting to JPG or PNG makes them universally compatible.",
  },
  {
    question: "What formats can I convert HEIC to?",
    answer:
      "Picmal converts HEIC to JPG, PNG, WebP, AVIF, TIFF, GIF, DNG, and more — any image format you need.",
  },
  {
    question: "Can I batch convert all my iPhone photos at once?",
    answer:
      "Yes. Drag and drop hundreds or thousands of HEIC files from your Photos library or any folder. Picmal converts them all at once.",
  },
  {
    question: "Does converting HEIC to JPG lose quality?",
    answer:
      "JPG uses lossy compression, so there's a slight quality reduction. Picmal lets you adjust the quality slider — at 90%+ quality, the difference is imperceptible.",
  },
  {
    question: "Is this different from Preview's export feature?",
    answer:
      "Preview can convert one file at a time. Picmal handles batch conversion of hundreds of files, offers more output formats, and lets you fine-tune quality settings.",
  },
  {
    question: "Do my photos leave my Mac?",
    answer:
      "No. All conversion happens locally on your Mac. Picmal works completely offline — your photos never touch any server.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

        <ComparisonHero
      title="Convert HEIC photos on your Mac in seconds"
      subhead="Your iPhone shoots HEIC, but the world runs on JPG. Picmal batch converts your HEIC files to JPG, PNG, WebP, or any format — fast, offline, and private."
      buyEvent="buy_clicked_heic_converter_mac"
      defaultTab="convert"
    />

    <SectionDivider />

    <!-- How It Works -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-8 text-center">Convert HEIC in 3 steps</H2>
        <div class="grid md:grid-cols-3 gap-6">
          <div
            class="bg-background-subtle/50 border border-border rounded-2xl p-6 text-center"
          >
            <div
              class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-4 font-semibold"
            >
              1
            </div>
            <h3 class="font-semibold text-text mb-2">Drop your HEIC files</h3>
            <Paragraph
              >Drag and drop HEIC files from Finder, Photos, or any folder.</Paragraph
            >
          </div>
          <div
            class="bg-background-subtle/50 border border-border rounded-2xl p-6 text-center"
          >
            <div
              class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-4 font-semibold"
            >
              2
            </div>
            <h3 class="font-semibold text-text mb-2">Choose output format</h3>
            <Paragraph>Select JPG, PNG, WebP, or any other format.</Paragraph>
          </div>
          <div
            class="bg-background-subtle/50 border border-border rounded-2xl p-6 text-center"
          >
            <div
              class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-4 font-semibold"
            >
              3
            </div>
            <h3 class="font-semibold text-text mb-2">Convert</h3>
            <Paragraph
              >Click Convert and your files are ready in seconds.</Paragraph
            >
          </div>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- HEIC Conversion Options -->
    <section class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto">
        <H2 class="mb-8 text-center">Convert HEIC to any format</H2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          {
            [
              "heic-to-jpg",
              "heic-to-png",
              "heic-to-webp",
              "heic-to-avif",
              "heic-to-tiff",
              "heic-to-gif",
            ].map((slug) => (
              <a
                href={`/convert/${slug}`}
                class="bg-background-subtle/50 border border-border rounded-xl p-4 text-center transition-colors hover:border-accent/30"
              >
                <span class="text-small font-medium text-text">
                  {slug.replace("heic-to-", "HEIC to ").toUpperCase()}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <SectionDivider />
    <MasonryTestimonials />
    <SectionDivider />

    <section
      id="pricing"
      class="relative z-10 px-6 py-16 sm:py-20 bg-background-subtle/50 border-y border-border"
    >
      <PricingSection />
    </section>

    <section id="faq" class="relative z-10 px-6 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <H2 class="mb-8 text-center">Frequently Asked Questions</H2>
        <div
          class="bg-background-subtle/50 border border-border rounded-2xl p-6 md:p-8"
        >
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <Footer />
    <SupportedFormatsModal />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "cantimplorastudio" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
