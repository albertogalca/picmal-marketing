---
interface Props { items: { title: string; text?: string }[] }
const { items } = Astro.props;
---

<ol class="pm-steps">
  {items.map((it, i) => (
    <li>
      <span class="pm-steps__n">{i + 1}</span>
      <div><div class="pm-steps__title">{it.title}</div>{it.text && <div class="pm-steps__text">{it.text}</div>}</div>
    </li>
  ))}
</ol>
