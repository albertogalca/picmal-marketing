---
import macStoriesLogo from "../../public/macstories_proof.webp";
import TestimonialCard from "./TestimonialCard.astro";

// Abridged MacStories pull-quote shown in the hero. Kept here (not in
// testimonials.json) so the hero can run a tighter edit than the full review.
const macStories = {
  type: "press",
  publication: "MacStories",
  logo: macStoriesLogo,
  content:
    "Picmal is an excellent way to manage file conversion and compression jobs of any size. The simplicity and speed with which you can manage batch conversion and compression sets it apart and makes it worth checking out.",
  highlight: "The simplicity and speed",
  link: "https://www.macstories.net/reviews/picmal-streamlines-batch-conversion-and-compression-on-the-mac/",
};
---

<section class="relative z-10 px-6 pt-8 sm:pt-10 pb-4">
  <div class="max-w-2xl mx-auto">
    <TestimonialCard testimonial={macStories} align="center" />
  </div>
</section>
