---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import Paragraph from "../../components/Paragraph.astro";
import HeroCTA from "../../components/HeroCTA.astro";
import DemoVideo from "../../components/DemoVideo.astro";
import FeaturedReview from "../../components/FeaturedReview.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import CTASection from "../../components/CTASection.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import TrustBar from "../../components/TrustBar.astro";
import {
  compressions,
  type CompressionFileSizeExample,
  type CompressionUseCase,
} from "../../data/compressions";
import { conversions, formats } from "../../data/conversions";

export function getStaticPaths() {
  return compressions.map((c) => ({
    params: { format: c.slug },
    props: { compression: c },
  }));
}

const { compression } = Astro.props;

const title = compression.metaTitle;
const description = compression.metaDescription;

const relatedConversions = conversions
  .filter((c) => c.from === compression.format)
  .slice(0, 4);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: compression.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ProductSchema url={Astro.site!.href} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body
    class="min-h-dvh transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <main id="main-content" class="relative z-10 pt-32 pb-16 sm:pb-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <Breadcrumb
          items={[
            { label: "Home", href: "/" },
            { label: "Compress", href: "/compress" },
            { label: compression.name },
          ]}
        />

        <!-- Hero -->
        <div class="text-center mb-16 sm:mb-20">
          <div class="flex items-center justify-center gap-3 mb-8">
            <span
              class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-background-subtle border border-border text-body-sm font-mono font-medium text-text tracking-wide"
            >
              .{compression.format}
            </span>
            <svg
              class="w-5 h-5 text-accent"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
            <span
              class="inline-flex items-center justify-center px-3 py-2 rounded-lg bg-accent/10 border border-accent/20 text-caption font-medium text-accent tracking-wide"
            >
              Smaller
            </span>
          </div>

          <H1 class="mb-6">Compress {compression.name} Files on Mac</H1>
          <Paragraph class="max-w-2xl mx-auto mb-4">
            {compression.whyCompress}
          </Paragraph>
          <Paragraph class="max-w-xl mx-auto mb-8 text-pretty">
            Online compressors need your files on their servers. Picmal
            compresses folders on your Mac, offline, with a quality slider so
            you control how small the output gets.
          </Paragraph>
          <HeroCTA
            buyEvent={`buy_clicked_compress_${compression.slug}`}
            class="mb-4"
          />
          <p class="text-body-sm text-text-secondary mb-6">
            One-time $15.99 · no subscription · 14-day money-back
          </p>
          <TrustBar />

          <DemoVideo
            src="/compress.mp4"
            poster="/compress-poster.webp"
            label={`Compress ${compression.name} files in Picmal`}
            class="max-w-3xl mx-auto mt-10 sm:mt-12"
          />
        </div>

        <FeaturedReview />

        <!-- Benefits -->
        <section class="mb-16 sm:mb-20">
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8"
          >
            <H2 class="mb-6">Why compress {compression.name} files?</H2>
            <ul class="space-y-4">
              {
                compression.benefits.map((benefit) => (
                  <li class="flex gap-3 items-start">
                    <svg
                      class="w-5 h-5 text-accent flex-shrink-0 mt-0.5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                    <span class="text-text">{benefit}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </section>

        <!-- How To Steps -->
        <section class="mb-16 sm:mb-20">
          <H2 class="mb-8 text-center"
            >How to compress {compression.name} files on Mac</H2
          >
          <div class="grid md:grid-cols-3 gap-4 relative">
            <div
              class="hidden md:block absolute top-[2.25rem] left-[calc(33.33%_-_0.5rem)] right-[calc(33.33%_-_0.5rem)] h-px bg-border z-0"
            >
            </div>

            <div
              class="bg-background-subtle/50 border border-border rounded-xl p-6 text-center relative z-10"
            >
              <div
                class="w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center mx-auto mb-4 font-semibold text-body-sm"
              >
                1
              </div>
              <h3 class="font-semibold text-text mb-2">Open Picmal</h3>
              <Paragraph>Download and open Picmal on your Mac.</Paragraph>
            </div>
            <div
              class="bg-background-subtle/50 border border-border rounded-xl p-6 text-center relative z-10"
            >
              <div
                class="w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center mx-auto mb-4 font-semibold text-body-sm"
              >
                2
              </div>
              <h3 class="font-semibold text-text mb-2">
                Add your {compression.name} files
              </h3>
              <Paragraph
                >Drag and drop your {compression.name} files or entire folders into
                Picmal.</Paragraph
              >
            </div>
            <div
              class="bg-background-subtle/50 border border-border rounded-xl p-6 text-center relative z-10"
            >
              <div
                class="w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center mx-auto mb-4 font-semibold text-body-sm"
              >
                3
              </div>
              <h3 class="font-semibold text-text mb-2">
                Adjust quality and compress
              </h3>
              <Paragraph
                >Set your preferred quality level and click Compress to reduce
                file sizes.</Paragraph
              >
            </div>
          </div>
        </section>

        <!-- File Size Comparison -->
        <section class="mb-16 sm:mb-20">
          <H2 class="mb-8 text-center"
            >{compression.name} Compression Results</H2
          >
          <div
            class="bg-background-subtle/50 border border-border rounded-xl overflow-hidden"
          >
            <table class="w-full">
              <thead>
                <tr class="border-b border-border">
                  <th
                    class="text-left text-eyebrow font-medium text-text-secondary uppercase tracking-wider px-6 py-4"
                    >File Type</th
                  >
                  <th
                    class="text-right text-eyebrow font-medium text-text-secondary uppercase tracking-wider px-6 py-4"
                    >Original</th
                  >
                  <th
                    class="text-right text-eyebrow font-medium text-text-secondary uppercase tracking-wider px-6 py-4"
                    >Compressed</th
                  >
                  <th
                    class="text-right text-eyebrow font-medium text-text-secondary uppercase tracking-wider px-6 py-4"
                    >Savings</th
                  >
                </tr>
              </thead>
              <tbody>
                {
                  compression.fileSizeExamples.map(
                    (example: CompressionFileSizeExample, i: number) => (
                      <tr
                        class={
                          i < compression.fileSizeExamples.length - 1
                            ? "border-b border-border/50"
                            : ""
                        }
                      >
                        <td class="px-6 py-4 text-body-sm text-text">
                          {example.label}
                        </td>
                        <td class="px-6 py-4 text-body-sm text-text-secondary text-right font-mono">
                          {example.originalSize}
                        </td>
                        <td class="px-6 py-4 text-body-sm text-text text-right font-mono font-medium">
                          {example.compressedSize}
                        </td>
                        <td class="px-6 py-4 text-body-sm text-accent text-right">
                          {example.savings}
                        </td>
                      </tr>
                    ),
                  )
                }
              </tbody>
            </table>
            <div class="px-6 py-4 border-t border-border bg-background/50">
              <div class="flex items-center gap-2 text-body-sm text-text-secondary">
                <svg
                  class="w-4 h-4 text-accent flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                <span
                  >Speed: <strong class="text-text"
                    >{compression.compressionSpeed}</strong
                  ></span
                >
              </div>
            </div>
          </div>
        </section>

        <!-- Use Cases -->
        <section class="mb-16 sm:mb-20">
          <H2 class="mb-8 text-center"
            >When to compress {compression.name} files</H2
          >
          <div class="grid md:grid-cols-2 gap-4">
            {
              compression.useCases.map((useCase: CompressionUseCase) => (
                <div class="bg-background-subtle/50 border border-border rounded-xl p-6">
                  <h3 class="font-semibold text-text mb-2">{useCase.title}</h3>
                  <Paragraph class="text-body-sm">{useCase.description}</Paragraph>
                </div>
              ))
            }
          </div>
        </section>

        <!-- FAQ -->
        <section class="mb-16 sm:mb-20">
          <H2 class="mb-8 text-center">Frequently Asked Questions</H2>
          <div
            class="bg-background-subtle/50 border border-border rounded-xl p-6 md:p-8"
          >
            <FAQ faqs={compression.faqs} />
          </div>
        </section>

        <!-- Related Conversions -->
        {
          relatedConversions.length > 0 && (
            <section class="mb-16 sm:mb-20">
              <H2 class="mb-8 text-center">
                Convert {compression.name} to Other Formats
              </H2>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                {relatedConversions.map((c) => (
                  <a
                    href={`/convert/${c.slug}`}
                    class="group bg-background-subtle/50 border border-border rounded-lg p-4 text-center transition-all duration-200 hover:border-accent/30 hover:bg-accent/[0.03]"
                  >
                    <div class="flex items-center justify-center gap-2 mb-1">
                      <span class="text-caption font-mono text-text-secondary">
                        .{formats[c.from].extension}
                      </span>
                      <svg
                        class="w-3 h-3 text-text-secondary/50 group-hover:text-accent transition-colors"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M13 7l5 5m0 0l-5 5m5-5H6"
                        />
                      </svg>
                      <span class="text-caption font-mono text-text-secondary">
                        .{formats[c.to].extension}
                      </span>
                    </div>
                    <span class="text-body-sm font-medium text-text">
                      {formats[c.from].name} to {formats[c.to].name}
                    </span>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <CTASection
          heading={`Compress ${compression.name} files with Picmal`}
          analyticsEvent={`buy_clicked_compress_${compression.slug}_bottom`}
        />
      </div>
    </main>

    <Footer />

    <script>
      window.lemonSqueezyAffiliateConfig = { store: "cantimplorastudio" };
    </script>
    <script src="https://lmsqueezy.com/affiliate.js" defer></script>
  </body>
</html>
