---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import Paragraph from "./Paragraph.astro";

const currentPage = Astro.url.pathname;
---

<nav
  id="main-nav"
  class="fixed left-0 right-0 z-30 text-sm transition-all duration-300 bg-background/80 backdrop-blur-lg border-b border-border"
  style="top: 0;"
>
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-white focus:rounded-lg focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
  >
    Skip to main content
  </a>
  <div class="px-6 xl:px-0 py-4">
    <div class="max-w-5xl mx-auto flex items-center justify-between">
      <div class="flex items-center">
        <a href="/" class="flex items-center gap-3 cursor-pointer">
          <Image
            src="/logo.webp"
            alt="Picmal - Mac media converter app logo"
            width={40}
            height={40}
            class="rounded-lg w-8 h-8 sm:w-10 sm:h-10 object-cover"
            loading="eager"
          />
          <Paragraph class="text-text font-semibold text-sm sm:text-base">Picmal</Paragraph>
        </a>
      </div>

      <div class="hidden md:flex items-center space-x-6 2md:space-x-8">
        <a
          href="/#features"
          class="text-sm transition-colors cursor-pointer text-text-secondary hover:text-text focus-visible:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded-sm"
        >
          Features
        </a>
        <a
          href="/#pricing"
          class="text-sm transition-colors cursor-pointer text-text-secondary hover:text-text focus-visible:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded-sm"
        >
          Pricing
        </a>
        <a
          href="/#testimonials"
          class="text-sm transition-colors cursor-pointer text-text-secondary hover:text-text focus-visible:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded-sm"
        >
          Testimonials
        </a>
        <a
          href="/#faq"
          class="text-sm transition-colors cursor-pointer text-text-secondary hover:text-text focus-visible:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded-sm"
        >
          FAQ
        </a>
        <a
          href="/changelog"
          class={`text-sm transition-colors cursor-pointer rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent ${
            currentPage.startsWith("/changelog")
              ? "text-accent"
              : "text-text-secondary hover:text-text-secondary"
          }`}
        >
          Changelog
        </a>
        <a
          href="/blog"
          class={`text-sm transition-colors cursor-pointer rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent ${
            currentPage.startsWith("/blog") &&
            !currentPage.startsWith("/changelog")
              ? "text-accent"
              : "text-text-secondary hover:text-text-secondary"
          }`}
        >
          Blog
        </a>
               <a
          href="/docs"
          class={`text-sm transition-colors cursor-pointer rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent ${
            currentPage.startsWith("/docs")
              ? "text-accent"
              : "text-text-secondary hover:text-text-secondary"
          }`}
        >
          Docs
        </a>
      </div>

      <div class="flex items-center space-x-3">
        <!-- Buy button - always visible -->
        <Button
          class="hidden md:block m-0"
          size="small"
          text="Buy for Mac"
          onclick="posthog.capture('buy_clicked')"
        />

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-button"
          class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-text-secondary hover:text-text-secondary hover:bg-background-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent text-sm transition-colors"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden">
      <div class="pt-8">
        <div class="grid grid-cols-2 gap-6">
          <a
            href="/#features"
            class="flex items-center gap-3 rounded-lg hover:bg-background-subtle focus-visible:bg-background-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-colors"
          >
            <svg
              class="w-5 h-5 text-text"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span class="text-sm text-text">Features</span>
          </a>

          <a
            href="/#pricing"
            class="flex items-center gap-3 rounded-lg hover:bg-background-subtle focus-visible:bg-background-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-colors"
          >
            <svg
              class="w-5 h-5 text-text"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
              ></path>
            </svg>
            <span class="text-sm text-text">Pricing</span>
          </a>

          <a
            href="/#testimonials"
            class="flex items-start gap-3 rounded-lg hover:bg-background-subtle focus-visible:bg-background-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-colors"
          >
            <svg
              class="w-5 h-5 text-text"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
              ></path>
            </svg>
            <span class="text-sm text-text">Testimonials</span>
          </a>

          <a
            href="/#faq"
            class="flex items-start gap-3 rounded-lg hover:bg-background-subtle focus-visible:bg-background-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-colors"
          >
            <svg
              class="w-5 h-5 text-text"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
            <span class="text-sm text-text">FAQ</span>
          </a>

          <a
            href="/changelog"
            class="flex items-start gap-3 rounded-lg hover:bg-background-subtle focus-visible:bg-background-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-colors"
          >
            <svg
              class="w-5 h-5 text-text"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
              ></path>
            </svg>
            <span class="text-sm text-text">Changelog</span>
          </a>

          <a
            href="/blog"
            class="flex items-start gap-3 rounded-lg hover:bg-background-subtle focus-visible:bg-background-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-colors"
          >
            <svg
              class="w-5 h-5 text-text"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
              ></path>
            </svg>
            <span class="text-sm text-text">Blog</span>
          </a>

          <a
            href="/docs"
            class="flex items-start gap-3 rounded-lg hover:bg-background-subtle focus-visible:bg-background-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-colors"
          >
            <svg
              class="w-5 h-5 text-text"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              ></path>
            </svg>
            <span class="text-sm text-text">Docs</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const mobileMenuButton = document.getElementById("mobile-menu-button");
      const mobileMenu = document.getElementById("mobile-menu");

      if (mobileMenuButton && mobileMenu) {
        mobileMenuButton.addEventListener("click", () => {
          const isExpanded =
            mobileMenuButton.getAttribute("aria-expanded") === "true";

          mobileMenuButton.setAttribute("aria-expanded", String(!isExpanded));

          if (isExpanded) {
            mobileMenu.classList.add("hidden");
          } else {
            mobileMenu.classList.remove("hidden");
          }
        });

        const mobileMenuLinks = mobileMenu.querySelectorAll("a");
        mobileMenuLinks.forEach((link) => {
          link.addEventListener("click", () => {
            mobileMenu.classList.add("hidden");
            mobileMenuButton.setAttribute("aria-expanded", "false");
          });
        });
      }
    });
  </script>
</nav>
