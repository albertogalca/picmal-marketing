---
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

export interface Props {
  meta: {
    title: string;
    description: string;
    date: string;
  };
}

const { meta } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={meta.title} description={meta.description} />
  </head>
  <body class="bg-white">
    <Header />

    <!-- Back to Home Link -->
    <div class="relative z-10 px-6 pt-32 pb-6">
      <div class="max-w-3xl mx-auto">
        <a
          href="/"
          class="inline-flex items-center text-sm transition-colors cursor-pointer text-slate-500 hover:text-slate-900"
        >
          ← Back to home
        </a>
      </div>
    </div>

    <!-- Page Content -->
    <article class="relative z-10 px-6 pb-20">
      <div class="max-w-3xl mx-auto">
        <!-- Header -->
        <header class="mb-8">
          <h1 class="text-4xl md:text-5xl font-bold mb-4 leading-tight text-slate-900">
            {meta.title}
          </h1>
          <p class="text-sm text-slate-500 mb-6">
            {meta.date}
          </p>
        </header>

        <!-- Content -->
        <div class="prose prose-lg max-w-none
                    prose-headings:text-slate-900
                    prose-p:text-slate-700
                    prose-a:text-[#1B5BFF] hover:prose-a:text-[#1548CC]
                    prose-strong:text-slate-900
                    prose-code:text-[#1B5BFF] prose-code:bg-slate-100
                    prose-pre:bg-slate-900
                    prose-blockquote:border-l-[#1B5BFF] prose-blockquote:text-slate-600
                    prose-th:text-slate-900
                    prose-td:text-slate-700
                    prose-ul:text-slate-700
                    prose-ol:text-slate-700
                    prose-li:text-slate-700">
          <slot />
        </div>
      </div>
    </article>

    <Footer />
  </body>
</html>