---
import { Icon } from "astro-icon/components";
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import Paragraph from "../../components/Paragraph.astro";
import BlockGrid from "../../components/BlockGrid.astro";
import FileSizeTable from "../../components/FileSizeTable.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";
import CTASection from "../../components/CTASection.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import Section from "../../components/Section.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ConversionGrid from "../../components/ConversionGrid.astro";
import { compressions } from "../../data/compressions";
import FAQSection from "../../components/FAQSection.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import FormatPill from "../../components/FormatPill.astro";

import {
  conversions,
  formats,
  getRelatedConversions,
  isConversionIndexed,
  type FileSizeExample,
  type UseCase,
} from "../../data/conversions";


export function getStaticPaths() {
  return conversions.map((c) => ({
    params: { from: c.from, to: c.to },
    props: { conversion: c },
  }));
}

const { conversion } = Astro.props;

// Blog post cross-links for conversion pages
const blogGuides: Record<string, { title: string; slug: string }> = {
  "webp-to-jpg": {
    title: "How to Convert WebP to JPG on Mac (4 Methods)",
    slug: "convert-webp-to-jpg-mac",
  },
  "webp-to-png": {
    title: "How to Convert WebP to PNG on Mac (4 Methods)",
    slug: "convert-webp-to-png-mac",
  },
  "tiff-to-jpg": {
    title: "How to Convert TIFF to JPG on Mac (4 Methods)",
    slug: "convert-tiff-to-jpg-mac",
  },
  "svg-to-png": {
    title: "How to Convert SVG to PNG on Mac (4 Methods)",
    slug: "convert-svg-to-png-mac",
  },
  "heic-to-jpg": {
    title: "How to Convert HEIC to JPG on Mac (2026 Guide)",
    slug: "how-to-convert-heic-to-jpg-mac",
  },
  "heic-to-png": {
    title: "How to Convert HEIC to PNG on Mac (4 Methods)",
    slug: "convert-heic-to-png-mac",
  },
  "avif-to-jpg": {
    title: "How to Convert AVIF to JPG on Mac (3 Methods)",
    slug: "convert-avif-to-jpg-mac",
  },
  // No png-to-jpg entry on purpose. The guide it pointed at was a 95% copy of
  // /blog/what-is-image-file-format wearing a conversion title, it took zero
  // impressions in 90 days, and this page already ranks for the intent
  // (position 9 on "batch convert png to jpg mac"). It now 301s here.
  "arw-to-jpg": {
    title: "How to Convert ARW to JPG on Mac (4 Free Methods)",
    slug: "convert-arw-to-jpg-mac",
  },
};
const blogGuide = blogGuides[conversion.slug];
const from = formats[conversion.from];
const to = formats[conversion.to];
const related = getRelatedConversions(conversion.from, conversion.to, 6);

const fromCompress = compressions.find((c) => c.format === conversion.from);
const toCompress = compressions.find((c) => c.format === conversion.to);

// The hero says what the page does and that it happens on the Mac. The longer
// "why" paragraph used to sit here and pushed both of those out; it now opens
// the first section.
const heroLine =
  conversion.heroLine ??
  `Convert ${from.name} files to ${to.name} on your Mac, one file or a whole folder. Nothing gets uploaded.`;

const title =
  conversion.metaTitle || `Convert ${from.name} to ${to.name} on Mac, offline and in batches`;
const description = conversion.metaDescription;

// Low-demand templated pairs are de-indexed to concentrate site quality on winners.
const noindex = !isConversionIndexed(conversion.slug);
---

<MarketingLayout
  title={title}
  description={description}
  noindex={noindex}
>
  <Fragment slot="head">
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema faqs={conversion.faqs} />
  </Fragment>

  <ComparisonHero
    pricingHref="/#pricing"
    title={`Convert ${from.name} to ${to.name} on Mac`}
    subhead={heroLine}
    buyEvent={`buy_clicked_convert_${conversion.slug}`}
    defaultTab="convert"
    art={{ title: `${from.name} → ${to.name}`, texture: "dissolve" }}
    demo={false}
  />

  {/* Every section below sits on the hero's left edge, with its heading on
      that edge too. The page used to change width seven times on the way
      down, so its left edge wandered between four positions. Content that
      reads better narrow (the table, the FAQ) caps its own width instead. */}

  <!-- Why -->
  <Section width="wide">
    <SectionHeading align="left" class="mb-8">
      Why convert {from.name} to {to.name}?
    </SectionHeading>
    <Paragraph size="lead" class="max-w-[65ch] mb-10">
      {conversion.whyConvert}
    </Paragraph>
    <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3 max-w-4xl">
      {
        conversion.benefits.map((benefit) => (
          <li class="flex items-start gap-3">
            <Icon
              name="ph:check"
              class="w-5 h-5 text-accent shrink-0 mt-0.5"
              aria-hidden="true"
            />
            <span class="text-text-secondary text-pretty">{benefit}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- File Size Comparison -->
  {
    conversion.fileSizeExamples && conversion.fileSizeExamples.length > 0 && (
      <Section width="wide">
        <SectionHeading align="left" class="mb-8">
          {from.name} vs {to.name} file sizes
        </SectionHeading>
        <div class="max-w-3xl">
          <FileSizeTable
            columns={[from.name, to.name, "Saved"]}
            rows={conversion.fileSizeExamples.map((e: FileSizeExample) => ({
              label: e.label,
              originalSize: e.fromSize,
              compressedSize: e.toSize,
              savings: e.savings,
            }))}
            speed={conversion.conversionSpeed}
          />
        </div>
      </Section>
    )
  }

  <!-- Real-World Use Cases -->
  {
    conversion.useCases && conversion.useCases.length > 0 && (
      <Section width="wide">
        <SectionHeading align="left" class="mb-8">
          When to convert {from.name} to {to.name}
        </SectionHeading>
        <BlockGrid items={conversion.useCases} />
      </Section>
    )
  }

  <!-- How To Steps -->
  <Section width="wide">
    <SectionHeading align="left" class="mb-8">
      How to convert {from.name} to {to.name} on Mac
    </SectionHeading>
    <BlockGrid
      ordered
      items={[
        {
          title: "Open Picmal",
          description: "Download and open Picmal on your Mac.",
        },
        {
          title: `Add your ${from.name} files`,
          description: `Drag and drop your ${from.name} files or entire folders into Picmal.`,
        },
        {
          title: `Select ${to.name} and convert`,
          description: `Choose ${to.name} as the output format and click Convert.`,
        },
      ]}
    />
  </Section>

  <!-- Format Comparison -->
  <Section width="wide">
    <SectionHeading align="left" class="mb-8">
      {from.name} vs {to.name}
    </SectionHeading>
    <div
      class="grid md:grid-cols-2 gap-px bg-border rounded-xl overflow-hidden border border-border"
    >
      {
        [
          { f: from, variant: "default" as const },
          { f: to, variant: "accent" as const },
        ].map(({ f, variant }) => (
          <div class="bg-surface p-6 md:p-8">
            <div class="flex items-center gap-3 mb-4">
              <FormatPill ext={f.extension} variant={variant} />
              <h3 class="font-semibold text-text">{f.name}</h3>
            </div>
            <p class="text-small text-text-secondary mb-3">{f.fullName}</p>
            <Paragraph class="mb-4">{f.description}</Paragraph>
            <div class="pt-4 border-t border-border">
              <p class="text-small font-medium text-text-secondary mb-2">
                Best for
              </p>
              <p class="text-small text-text">{f.bestFor}</p>
              {f.standardBody && (
                <p class="text-small text-text-secondary mt-3">
                  Defined by {f.standardBody}.
                  {f.sourceUrl && (
                    <a
                      href={f.sourceUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link ml-1"
                    >
                      Specification <span aria-hidden="true">&rarr;</span>
                    </a>
                  )}
                </p>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- FAQ -->
  <FAQSection faqs={conversion.faqs} align="left" />

  <!-- Related: other conversions, the compress pages for either format, and
       the long guide when one exists. These were three separate boxed
       sections, each a card around one or two links. -->
  <Section width="wide">
    <SectionHeading align="left" class="mb-8">Related</SectionHeading>
    {
      blogGuide && (
        <Paragraph class="mb-6 max-w-[65ch]">
          Want the free methods too (Preview, Terminal, online tools)? Read{" "}
          <a href={`/blog/${blogGuide.slug}`} class="link">
            {blogGuide.title}
          </a>.
        </Paragraph>
      )
    }
    <ConversionGrid
      columns={3}
      links={[
        ...related.map((r) => ({
          href: `/convert/${r.slug}`,
          label: `${formats[r.from].name} to ${formats[r.to].name}`,
        })),
        ...[fromCompress, toCompress]
          .filter((c) => c !== undefined)
          .map((c) => ({
            href: `/compress/${c.slug}`,
            label: `Compress ${c.name}`,
          })),
      ]}
      linkText="View all conversions"
      linkHref="/convert"
      linkAlign="left"
    />
  </Section>

  <!-- CTA -->
  <CTASection
    heading={`Convert ${from.name} to ${to.name} with Picmal`}
    analyticsEvent={`buy_clicked_convert_${conversion.slug}_bottom`}
  />
</MarketingLayout>
