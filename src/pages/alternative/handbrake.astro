---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import MasonryTestimonials from "../../components/MasonryTestimonials.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import PricingSection from "../../components/PricingSection.astro";
import FounderLetter from "../../components/FounderLetter.astro";
import Section from "../../components/Section.astro";
import Card from "../../components/Card.astro";
import H3 from "../../components/H3.astro";
import Paragraph from "../../components/Paragraph.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SupportedFormatsModal from "../../components/SupportedFormatsModal.astro";
import ComparisonVerdict from "../../components/ComparisonVerdict.astro";
import ComparisonHero from "../../components/ComparisonHero.astro";

const SITE_DESCRIPTION =
  "Want a HandBrake alternative on Mac? Picmal handles images, video, audio, and PDFs in one native Mac app. Convert, compress, and edit, with Shortcuts and folder monitoring. Files never leave your Mac. Pay $29 once.";

const faqs = [
  {
    question: "Is Picmal a good HandBrake alternative?",
    answer:
      "If you're on a Mac and also work with images, audio, and PDFs, yes. Picmal is a native Mac app, it works with Shortcuts, and it handles more file types. HandBrake is the better pick if you want deep video encoding controls and would rather not pay for an app.",
  },
  {
    question: "Why pay for Picmal when HandBrake is free?",
    answer:
      "HandBrake is great at video encoding, and it costs nothing. Picmal adds image conversion, audio, PDF tools, folder monitoring, and a Finder right-click, and it feels like a real Mac app. If video encoding is all you need, HandBrake is honestly a fine choice.",
  },
  {
    question: "Can Picmal convert images? Can HandBrake?",
    answer:
      "Picmal converts 20+ image formats (HEIC, JPG, PNG, WebP, and more) and reads RAW files. HandBrake is video only. It doesn't touch images.",
  },
  {
    question: "Does HandBrake have more video options than Picmal?",
    answer:
      "Yes. Device presets, CRF tuning, DVD and Blu-ray ripping, subtitle tracks, HDR. HandBrake goes deep on video. Picmal picks good defaults so you don't have to think about codecs, and it also handles images, audio, and PDFs.",
  },
  {
    question: "Does Picmal work on Windows or Linux like HandBrake?",
    answer:
      "No. Picmal is Mac-only. HandBrake runs on Windows and Linux too.",
  },
  {
    question: "What is the best free HandBrake alternative on Mac?",
    answer:
      "Honestly, for pure video encoding there isn't one. ffmpeg does more but lives in the Terminal, and QuickTime and VLC only cover basic exports. If HandBrake's interface is the problem rather than the price, that's the gap paid apps like Picmal fill: simpler, native, and covering images, audio, and PDFs too.",
  },
  {
    question: "What if Picmal doesn't work for me?",
    answer:
      "Full refund within 14 days, no questions asked. Just email support@picmal.app.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead
      title="Picmal: A native Mac HandBrake alternative"
      description={SITE_DESCRIPTION}
    />
    <ProductSchema url={Astro.site!.href} />
    <FAQSchema faqs={faqs} />
  </head>

  <body
    class="min-h-screen transition-colors duration-300 bg-background text-text overflow-x-hidden"
  >
    <Header />

    <main id="main-content">
    <ComparisonHero
      title="A native Mac HandBrake alternative"
      subhead="HandBrake is powerful and free. If you also work with images, audio, and PDFs, and you want something that feels like a proper Mac app, Picmal handles all of it for $29."
      buyEvent="buy_clicked_handbrake_comparison"
    />

    <ComparisonVerdict
      competitor="HandBrake"
      summary="HandBrake is free, open source, and runs on Windows, Linux, and Mac with serious encoding controls. Picmal is Mac only and costs $29 once. It handles images, audio, and PDFs alongside video, and it feels at home on your Mac. Neither one uploads your files."
      picmalFor="You're on a Mac and you need images, audio, or PDFs as well as video. Or you just want an app that feels native and works with Shortcuts."
      competitorFor="You need CRF tuning, device presets, DVD or Blu-ray ripping, or Windows and Linux support. And free matters to you."
    />

    <!-- Why people look for an alternative -->
    <Section width="narrow">
      <SectionHeading align="left">
        Why people go looking for a HandBrake alternative
      </SectionHeading>
      <div class="space-y-4">
        <Paragraph>
          Rarely because HandBrake is bad. It's free, open source, and after two
          decades it's still the reference tool for video encoding. When people
          search for an alternative, it's usually one of three things.
        </Paragraph>
        <Paragraph>
          <strong class="text-text">The interface asks a lot.</strong> Presets,
          CRF values, encoder tuning, filter tabs. If you know video, that
          depth is the whole point. If you just want this MOV as a smaller MP4,
          it's a wall of decisions you didn't want to make.
        </Paragraph>
        <Paragraph>
          <strong class="text-text">It only does video.</strong> The same
          project that produced the screen recording usually comes with
          screenshots to compress, audio to convert, or a PDF to shrink.
          HandBrake handles none of that, so you end up with a folder of
          single-purpose tools.
        </Paragraph>
        <Paragraph>
          <strong class="text-text">It doesn't feel like a Mac app.</strong> No
          Finder right-click, no Shortcuts actions, no folder watching. It runs
          fine on a Mac, it just doesn't plug into one.
        </Paragraph>
        <Paragraph>
          If none of those bother you, keep HandBrake, it's excellent. If they
          do, that's the gap I built <a href="/" class="link">Picmal</a> for:
          drag files in, pick a format, done, and it covers
          <a href="/compress-video-mac" class="link">video compression</a>,
          images, audio, and PDFs in one app.
        </Paragraph>
      </div>
    </Section>

    <!-- Comparison Table -->
    <Section width="default">
      <SectionHeading>
        Picmal vs HandBrake at a glance
        <Fragment slot="sublead">
          HandBrake is a free video encoder with serious encoding controls.
          Picmal is a paid Mac app that handles images, audio, and PDFs as well
          as video, with a simpler interface. Different tradeoffs, so pick the
          one that fits.
        </Fragment>
      </SectionHeading>
      <Card padding="p-4 md:p-8">
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left p-4 font-semibold text-text">Feature</th>
                  <th class="text-left p-4 font-semibold text-text">Picmal</th>
                  <th class="text-left p-4 font-semibold text-text"
                    >HandBrake</th
                  >
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr>
                  <td class="p-4 text-text-secondary">Price</td>
                  <td class="p-4 text-text">$29 one-time</td>
                  <td class="p-4 text-text">Free (open source)</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Platforms</td>
                  <td class="p-4 text-text">macOS only</td>
                  <td class="p-4 text-text">Windows, Mac, Linux</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Privacy</td>
                  <td class="p-4 text-text">100% offline</td>
                  <td class="p-4 text-text">100% offline</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Interface</td>
                  <td class="p-4 text-text">Native macOS, clean UI</td>
                  <td class="p-4 text-text">Cross-platform, gets the job done</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Image conversion</td>
                  <td class="p-4 text-text">Yes, 20+ formats</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video conversion</td>
                  <td class="p-4 text-text">Yes, common formats</td>
                  <td class="p-4 text-text">Yes, advanced encoding options</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Audio conversion</td>
                  <td class="p-4 text-text">Yes, MP3, WAV, FLAC, and more</td>
                  <td class="p-4 text-text">Audio within video only</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Compression</td>
                  <td class="p-4 text-text">Images, video, audio &amp; PDF</td>
                  <td class="p-4 text-text">Video encoding only</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">PDF tools</td>
                  <td class="p-4 text-text"
                    >Yes, compress, combine, images&rarr;PDF</td
                  >
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">DVD/BluRay ripping</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text">Yes (unprotected)</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Device presets</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text">Yes, Apple, Android, web, and more</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Video filters</td>
                  <td class="p-4 text-text">Basic</td>
                  <td class="p-4 text-text"
                    >Advanced (deinterlace, denoise, HDR)</td
                  >
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Subtitle support</td>
                  <td class="p-4 text-text">No</td>
                  <td class="p-4 text-text">Yes, SRT, SSA, VobSub, CEA-608</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Metadata removal</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">Limited</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Shortcuts integration</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Folder monitoring</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
                <tr>
                  <td class="p-4 text-text-secondary">Finder right-click</td>
                  <td class="p-4 text-text">Yes</td>
                  <td class="p-4 text-text">No</td>
                </tr>
              </tbody>
            </table>
          </div>
      </Card>
    </Section>

    <!-- Who Picmal Is For / Who Should Stick with HandBrake -->
    <Section width="default">
      <SectionHeading>
        Which one is right for you?
        <Fragment slot="sublead">
            Here's where each one makes more sense.
        </Fragment>
      </SectionHeading>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Picmal Column -->
          <Card>
            <div class="mb-6">
              <H3 class="mb-2">
                Choose Picmal
              </H3>
              <Paragraph color="secondary">
                Mac-native. Images, audio, PDFs, and video in one place.
              </Paragraph>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want to convert, compress, and edit images, video, audio,
                  and PDFs without juggling five apps
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You automate things with Apple Shortcuts
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want an app that actually looks and feels like a Mac app
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-accent flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You want folder monitoring and a Finder right-click
                </span>
              </li>
            </ul>
          </Card>

          <!-- HandBrake Column -->
          <Card>
            <div class="mb-6">
              <H3 class="mb-2">
                Choose HandBrake
              </H3>
              <Paragraph color="secondary">
                Free, powerful video encoding, runs everywhere.
              </Paragraph>
            </div>

            <ul class="space-y-4">
              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  Video transcoding and encoding is all you need
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text"> You're on Windows or Linux </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You'd rather not pay for an app
                </span>
              </li>

              <li class="flex gap-3 items-start">
                <svg
                  class="w-6 h-6 text-text-secondary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-text">
                  You need DVD or Blu-ray ripping, or subtitle tracks
                </span>
              </li>
            </ul>
          </Card>
        </div>
    </Section>

    <!-- Features -->
    <FeatureGrid
      heading="Everything else Picmal does"
      subleadIntro="One app for images, video, audio, and PDFs. Convert, compress, and edit, all on your Mac."
    />

    <!-- Testimonials Section -->

    <!-- Related guides -->
    <Section width="narrow" class="text-center">
      <SectionHeading class="mb-6">Related guides</SectionHeading>
      <div class="flex flex-col gap-3">
        <a
          href="/blog/compress-video-with-handbrake"
          class="text-accent hover:underline"
          >HandBrake settings for compressing video &rarr;</a
        >
        <a
          href="/blog/best-media-converter-mac-2026"
          class="text-accent hover:underline"
          >The best media converter for Mac in 2026 &rarr;</a
        >
      </div>
    </Section>

    <MasonryTestimonials />

    <!-- Pricing -->
    <PricingSection />

    <!-- Founder letter -->
    <FounderLetter />

    <!-- FAQ Section -->
    <Section id="faq" width="narrow">
      <SectionHeading
        sublead="Can't find what you're looking for? Email support@picmal.app"
      >
        Frequently asked questions
      </SectionHeading>
      <Card>
        <FAQ faqs={faqs} />
      </Card>
    </Section>

    </main>

    <Footer />

    <SupportedFormatsModal />

  </body>
</html>
