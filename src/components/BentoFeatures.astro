---
import { Image } from "astro:assets";
import H2 from "./H2.astro";
import H3 from "./H3.astro";
import Paragraph from "./Paragraph.astro";
import rawSampleTree from "../assets/raw-sample-tree.jpg";
import rawSampleBeach from "../assets/raw-sample-beach.jpg";

// Shared styles
const card =
  "relative bg-background-subtle rounded-2xl border border-border overflow-hidden";
const eyebrow = "text-small font-medium text-text-secondary mb-2";
const blockTitle = "text-h2 text-text text-balance";
// Screenshot that bleeds into a corner on desktop, stacks below text on mobile
const cornerImg = "rounded-2xl lg:rounded-tl-2xl shadow-sm w-full h-auto";

// Sample EXIF fields shown in the Metadata close-up panel
const metadataRows: [string, string][] = [
  ["Make", "FUJIFILM"],
  ["Model", "X-T5"],
  ["Lens", "XF33mmF1.4 R LM WR"],
  ["Focal Length", "33.0 mm"],
  ["Aperture", "ƒ/1.4"],
  ["Shutter Speed", "1/250 s"],
  ["ISO", "160"],
  ["Film Simulation", "Classic Chrome"],
];
---

<section id="features" class="relative z-10 px-6 xl:px-0 py-24">
  <div class="max-w-5xl mx-auto">
    <!-- Intro -->
    <div class="text-center mb-20">
      <H2 class="mb-4">What Picmal actually does</H2>
      <Paragraph class="max-w-xl mx-auto">
        Convert, compress, and resize images, video, audio, and PDFs. All on
        your Mac, nothing touches a server.
      </Paragraph>
    </div>

    <!-- Blocks, generously spaced -->
    <div class="space-y-28">
      <!-- ===============================================================
           Block 1 — Convert & compress
      ================================================================ -->
      <div>
        <div class="mb-10 max-w-2xl">
          <p class={eyebrow}>Convert, compress &amp; PDF</p>
          <h3 class={blockTitle}>Anything in, anything out</h3>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-6 gap-5">
          <!-- Convert — wide, video bleeding bottom-right -->
          <div class={`${card} lg:col-span-4 min-h-[315px]`}>
            <div class="p-6 relative z-10 lg:max-w-[45%]">
              <H3 class="mb-2"
                >Any format, in or out <button
                  id="open-formats-modal-bento"
                  class="relative inline-flex items-center justify-center w-6 h-6 rounded-full bg-text/5 hover:bg-text/10 cursor-pointer transition-[background-color,transform] active:scale-[0.96] align-middle before:absolute before:-inset-2 before:content-[''] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
                  type="button"
                  aria-label="View supported formats"
                  ><svg
                    class="w-3.5 h-3.5 text-text-secondary"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                  </svg></button
                ></H3
              >
              <Paragraph>
                Images, video, audio, RAW, PDF — over 100 formats. PSD to PNG,
                MOV to MP4, FLAC to ALAC. Pick the output and go.
              </Paragraph>
            </div>
            <div
              class="-mb-10 lg:mb-0 lg:p-0 lg:absolute lg:top-1/2 lg:right-0 lg:w-[65%] lg:translate-x-30 lg:-translate-y-1/2"
            >
              <video
                class={`theme-video ${cornerImg} aspect-video ring-1 ring-inset ring-black/10 dark:ring-white/10`}
                data-light-src="/convert.mp4"
                data-dark-src="/convert_dark.mp4"
                autoplay
                loop
                muted
                playsinline
                aria-label="Picmal conversion interface"></video>
            </div>
          </div>

          <!-- Before/after preview — slider close-up docked at the bottom -->
          <div class={`${card} lg:col-span-2 min-h-[315px] flex flex-col`}>
            <div class="p-6">
              <H3 class="mb-2">See it before you commit</H3>
              <Paragraph>
                Slide between the original and the compressed version, then dial
                in the quality.
              </Paragraph>
            </div>
            <div class="mt-auto">
              <div
                class="h-44 overflow-hidden rounded-t-2xl border border-b-0 border-black/10 dark:border-white/10 flex items-center justify-center translate-y-px"
              >
                <Image
                  class="w-full max-w-none h-auto"
                  src="/before_after.png"
                  width={1352}
                  height={1060}
                  alt="Before/after slider comparing the original 1.6 MB photo with the 145 KB compressed version"
                />
              </div>
            </div>
          </div>

          <!-- RAW & PDF — photo + PDF close-up, fanned arrangement -->
          <div class={`${card} lg:col-span-2 min-h-[315px] flex flex-col`}>
            <div class="p-6">
              <H3 class="mb-2">RAW and PDF, too</H3>
              <Paragraph>
                Camera RAW in, JPEG out. Rasterize a PDF to PNG at the DPI you
                pick.
              </Paragraph>
            </div>
            <!-- PDF page (center) flanked by two RAW photos, fanned out.
                 Stack is pushed down (translate-y-5) so the rotated bottoms
                 bleed off and the card clips them, leaving no gap at the base. -->
            <div
              class="mt-auto flex items-end justify-center overflow-hidden px-6"
            >
              <div class="relative h-40 w-64 translate-y-5" aria-hidden="true">
                <!-- RAW photo — tree (left) -->
                <div
                  class="absolute bottom-0 left-1/2 z-10 w-36 origin-bottom -translate-x-[86%] -rotate-[8deg] overflow-hidden rounded-xl shadow-lg ring-1 ring-black/10 dark:ring-white/10"
                >
                  <Image
                    class="h-28 w-full object-cover"
                    src={rawSampleTree}
                    alt=""
                    widths={[144, 288]}
                    sizes="144px"
                  />
                  <span
                    class="absolute left-2 top-2 rounded-xl bg-black/40 px-1.5 py-0.5 text-small font-semibold leading-none text-white backdrop-blur-sm"
                    >RAW</span
                  >
                </div>
                <!-- RAW photo — beach (right) -->
                <div
                  class="absolute bottom-0 left-1/2 z-10 w-36 origin-bottom -translate-x-[14%] rotate-[8deg] overflow-hidden rounded-xl shadow-lg ring-1 ring-black/10 dark:ring-white/10"
                >
                  <Image
                    class="h-28 w-full object-cover"
                    src={rawSampleBeach}
                    alt=""
                    widths={[144, 288]}
                    sizes="144px"
                  />
                  <span
                    class="absolute right-2 top-2 rounded-xl bg-black/40 px-1.5 py-0.5 text-small font-semibold leading-none text-white backdrop-blur-sm"
                    >RAW</span
                  >
                </div>
                <!-- PDF page (center, on top, lifted to crown the fan) -->
                <div
                  class="absolute bottom-0 left-1/2 z-20 w-28 origin-bottom -translate-x-1/2 -translate-y-0 overflow-hidden rounded-xl bg-white shadow-xl ring-1 ring-black/10 dark:ring-white/10"
                >
                  <span
                    class="absolute top-4 left-3.5 text-small font-bold leading-none tracking-wide text-red-500"
                    >PDF</span
                  >
                  <div class="space-y-2 px-3.5 pt-12 pb-4">
                    <span class="block h-1.5 w-10 rounded-xl bg-red-500/80"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-3/4 rounded-xl bg-neutral-200"
                    ></span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Compress — wide, video bleeding bottom-left -->
          <div class={`${card} lg:col-span-4 min-h-[315px]`}>
            <div class="p-6 relative z-10 lg:ml-[50%] lg:max-w-[60%]">
              <H3 class="mb-2"
                >Smaller files, same quality <button
                  id="open-compress-formats-modal-bento"
                  class="relative inline-flex items-center justify-center w-6 h-6 rounded-full bg-text/5 hover:bg-text/10 cursor-pointer transition-[background-color,transform] active:scale-[0.96] align-middle before:absolute before:-inset-2 before:content-[''] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
                  type="button"
                  aria-label="View supported compression formats"
                  ><svg
                    class="w-3.5 h-3.5 text-text-secondary"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                  </svg></button
                ></H3
              >
              <Paragraph>
                Fit an email limit or a slow upload without the quality drop
                you'd actually notice. Convert and compress in one pass.
              </Paragraph>
            </div>
            <div
              class="-mb-10 lg:mb-0 lg:p-0 lg:absolute lg:top-1/2 lg:left-0 lg:w-[65%] lg:-translate-x-30 lg:-translate-y-1/2"
            >
              <video
                class={`theme-video ${cornerImg} aspect-video ring-1 ring-inset ring-black/10 dark:ring-white/10 lg:rounded-tr-2xl lg:rounded-tl-none`}
                data-light-src="/compress.mp4"
                data-dark-src="/compress_dark.mp4"
                autoplay
                loop
                muted
                playsinline
                aria-label="Picmal compression interface"></video>
            </div>
          </div>

          <!-- Combine PDFs — separate card, diagram-led -->
          <div class={`${card} lg:col-span-3 p-6`}>
            <H3 class="mb-2">Combine PDFs</H3>
            <Paragraph>
              Merge a stack of PDFs into one. Drag to reorder pages, pick the
              page size, save it out.
            </Paragraph>
            <!-- Diagram: three source PDFs merging into one -->
            <div
              class="mt-10 flex items-center justify-center gap-6 sm:gap-8"
              aria-hidden="true"
            >
              <!-- Source stack — three fanned PDFs -->
              <div class="relative h-44 w-36">
                <div
                  class="absolute inset-0 m-auto h-24 md:h-36 w-16 md:w-28 -translate-x-5 -rotate-[14deg] overflow-hidden rounded-xl bg-white shadow-md ring-1 ring-black/10 dark:ring-white/10"
                >
                  <span
                    class="absolute left-3.5 top-4 text-small font-bold leading-none tracking-wide text-red-500"
                    >PDF</span
                  >
                  <div class="space-y-2 px-3.5 pt-12 pb-4">
                    <span class="block h-1.5 w-10 rounded-xl bg-red-500/80"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-3/4 rounded-xl bg-neutral-200"
                    ></span>
                  </div>
                </div>
                <div
                  class="absolute inset-0 z-10 m-auto h-24 md:h-36 w-16 md:w-28 rotate-[4deg] overflow-hidden rounded-xl bg-white shadow-md ring-1 ring-black/10 dark:ring-white/10"
                >
                  <span
                    class="absolute left-3.5 top-4 text-small font-bold leading-none tracking-wide text-red-500"
                    >PDF</span
                  >
                  <div class="space-y-2 px-3.5 pt-12 pb-4">
                    <span class="block h-1.5 w-10 rounded-xl bg-red-500/80"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-3/4 rounded-xl bg-neutral-200"
                    ></span>
                  </div>
                </div>
                <div
                  class="absolute inset-0 z-20 m-auto h-24 md:h-36 w-16 md:w-28 translate-x-5 rotate-[14deg] overflow-hidden rounded-xl bg-white shadow-md ring-1 ring-black/10 dark:ring-white/10"
                >
                  <span
                    class="absolute left-3.5 top-4 text-small font-bold leading-none tracking-wide text-red-500"
                    >PDF</span
                  >
                  <div class="space-y-2 px-3.5 pt-12 pb-4">
                    <span class="block h-1.5 w-10 rounded-xl bg-red-500/80"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-3/4 rounded-xl bg-neutral-200"
                    ></span>
                  </div>
                </div>
              </div>
              <!-- Arrow -->
              <svg
                class="h-4 md:h-6 w-4 md:w-6 shrink-0 text-text-secondary"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
              </svg>
              <!-- Result — one merged PDF -->
              <div class="relative h-44 w-32">
                <div
                  class="absolute inset-0 m-auto h-24 md:h-36 w-16 md:w-28 overflow-hidden rounded-xl bg-white shadow-lg ring-2 ring-red-500/25"
                >
                  <span
                    class="absolute left-3.5 top-4 text-small font-bold leading-none tracking-wide text-red-500"
                    >PDF</span
                  >
                  <div class="space-y-2 px-3.5 pt-12 pb-4">
                    <span class="block h-1.5 w-10 rounded-xl bg-red-500/80"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-3/4 rounded-xl bg-neutral-200"
                    ></span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Images to PDF — separate card, diagram-led -->
          <div class={`${card} lg:col-span-3 p-6`}>
            <H3 class="mb-2">Images to PDF</H3>
            <Paragraph>
              Turn a batch of photos into a multi-page PDF. A4, Letter, or
              custom — with an optional password.
            </Paragraph>
            <!-- Diagram: photo thumbs collate into a multi-page PDF -->
            <div
              class="mt-10 flex items-center justify-center gap-6 sm:gap-8"
              aria-hidden="true"
            >
              <!-- Source — three fanned photo thumbs -->
              <div class="relative h-24 md:h-44 w-36">
                <div
                  class="absolute inset-0 m-auto h-16 md:h-28 w-20 md:w-36 -translate-x-5 -rotate-[14deg] overflow-hidden rounded-xl shadow-md ring-1 ring-black/10 dark:ring-white/10"
                >
                  <Image
                    class="h-full w-full object-cover"
                    src={rawSampleBeach}
                    alt=""
                    widths={[144, 288]}
                    sizes="144px"
                  />
                </div>
                <div
                  class="absolute inset-0 z-10 m-auto h-16 md:h-28 w-20 md:w-36 rotate-[4deg] overflow-hidden rounded-xl bg-gradient-to-br from-sky-300 to-indigo-400 shadow-md ring-1 ring-black/10 dark:ring-white/10"
                >
                </div>
                <div
                  class="absolute inset-0 z-20 m-auto h-16 md:h-28 w-20 md:w-36 translate-x-5 rotate-[14deg] overflow-hidden rounded-xl shadow-md ring-1 ring-black/10 dark:ring-white/10"
                >
                  <Image
                    class="h-full w-full object-cover"
                    src={rawSampleTree}
                    alt=""
                    widths={[144, 288]}
                    sizes="144px"
                  />
                </div>
              </div>
              <!-- Arrow -->
              <svg
                class="h-4 md:h-6 w-4 md:w-6 shrink-0 text-text-secondary"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
              </svg>
              <!-- Result — multi-page PDF -->
              <div class="relative h-24 md:h-44 w-32">
                <div
                  class="absolute inset-0 m-auto h-24 md:h-36 w-16 md:w-28 -translate-x-[20%] -rotate-[8deg] overflow-hidden rounded-xl bg-white shadow-md ring-1 ring-black/10 dark:ring-white/10"
                >
                  <div class="space-y-2 px-3.5 pt-8 pb-4">
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-3/4 rounded-xl bg-neutral-200"
                    ></span>
                  </div>
                </div>
                <div
                  class="absolute inset-0 z-10 m-auto h-24 md:h-36 w-16 md:w-28 -translate-x-[10%] -rotate-[4deg] overflow-hidden rounded-xl bg-white shadow-md ring-1 ring-black/10 dark:ring-white/10"
                >
                  <div class="space-y-2 px-3.5 pt-8 pb-4">
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-3/4 rounded-xl bg-neutral-200"
                    ></span>
                  </div>
                </div>
                <div
                  class="absolute inset-0 z-20 m-auto h-24 md:h-36 w-16 md:w-28 overflow-hidden rounded-xl bg-white shadow-lg ring-1 ring-black/10 dark:ring-white/10"
                >
                  <span
                    class="absolute left-3.5 top-4 text-small font-bold leading-none tracking-wide text-red-500"
                    >PDF</span
                  >
                  <div class="space-y-2 px-3.5 pt-12 pb-4">
                    <span class="block h-1.5 w-10 rounded-xl bg-red-500/80"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-full rounded-xl bg-neutral-200"
                    ></span>
                    <span class="block h-1 w-3/4 rounded-xl bg-neutral-200"
                    ></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ===============================================================
           Block 2 — Batch & automate
      ================================================================ -->
      <div>
        <div class="mb-10 max-w-2xl">
          <p class={eyebrow}>Batch &amp; automate</p>
          <h3 class={blockTitle}>Built for hundreds of files</h3>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-6 gap-5">
          <!-- Lead — main app screenshot bleeding bottom-right -->
          <div class={`${card} lg:col-span-4 min-h-[360px]`}>
            <div class="p-6 relative z-10 lg:max-w-[45%]">
              <H3 class="mb-2">Drop a folder, walk away</H3>
              <Paragraph>
                Thousands of files at once, whole folders, mixed formats. Picmal
                sorts out each file type and works through them all.
              </Paragraph>
            </div>
            <div
              class="relative px-6 pb-6 lg:p-0 lg:absolute lg:bottom-0 lg:right-0 lg:w-[70%] lg:translate-x-40 lg:translate-y-1"
            >
              <Image
                class={`${cornerImg} block dark:hidden`}
                src="/main.png"
                width={800}
                height={500}
                alt="Picmal batch processing a list of files"
              />
              <Image
                class={`${cornerImg} hidden dark:block`}
                src="/main_dark.png"
                width={800}
                height={500}
                alt="Picmal batch processing a list of files"
              />

              <!-- Folder being dropped onto the drop zone -->
              <div
                class="pointer-events-none absolute left-[16%] lg:left-[2%] top-[74%] -translate-x-1/2 -translate-y-1/2 -rotate-6 drop-shadow-md"
                aria-hidden="true"
              >
                <Image
                  class="w-12 h-auto sm:w-14"
                  src="/folder-blue.png"
                  width={1004}
                  height={841}
                  alt=""
                />
                <!-- macOS-style count badge -->
                <span
                  class="absolute -top-1.5 -right-2 px-1.5 py-px rounded-xl bg-red-500 text-white text-small font-semibold leading-tight tracking-tight ring-[1.5px] ring-white tabular-nums"
                  >1,248</span
                >
              </div>
            </div>
          </div>

          <!-- Run overnight — schedule dialog docked at the bottom -->
          <div class={`${card} lg:col-span-2 lg:min-h-[360px] flex flex-col`}>
            <div class="p-6">
              <H3 class="mb-2">Run it overnight</H3>
              <Paragraph>
                Schedule big jobs for later. They survive quitting the app.
              </Paragraph>
            </div>
            <div
              class="flex-1 flex items-end justify-center px-6 pb-6 pt-10 lg:pt-0"
            >
              <div class="relative w-full max-w-[300px] -translate-x-2">
                <!-- Back card — compress, peeking above the front card -->
                <Image
                  class="absolute left-1/2 top-0 w-full h-auto -translate-x-[calc(50%-1rem)] -translate-y-7 rounded-xl shadow-lg"
                  src="/schedule_compress.png"
                  width={733}
                  height={314}
                  alt="Picmal schedule dialog set to compress files at a chosen time"
                />
                <!-- Front card — convert -->
                <Image
                  class="relative w-full h-auto rounded-xl shadow-xl"
                  src="/schedule_convert.png"
                  width={751}
                  height={332}
                  alt="Picmal schedule dialog set to run a job at a chosen time"
                />
              </div>
            </div>
          </div>

          <!-- Watched folders -->
          <div class={`${card} lg:col-span-3 min-h-[220px] flex flex-col`}>
            <div class="p-6">
              <H3 class="mb-2">Watched folders</H3>
              <Paragraph>
                Drop a file in, it converts itself. Set it once, forget it.
              </Paragraph>
            </div>
            <div class="mt-auto pb-0 lg:px-6">
              <video
                class="rounded-t-2xl border border-b-0 border-black/10 dark:border-white/10 w-full h-auto aspect-[1628/1080] translate-y-px"
                src="/watched_folders.mp4"
                autoplay
                loop
                muted
                playsinline
                aria-label="Picmal watching a folder and converting files dropped into it"
              ></video>
            </div>
          </div>

          <!-- Clipboard optimization -->
          <div class={`${card} lg:col-span-3 min-h-[220px] flex flex-col`}>
            <div class="p-6">
              <H3 class="mb-2">Optimize from the clipboard</H3>
              <Paragraph>
                Copy a screenshot, paste it back smaller. Picmal compresses
                what's on your clipboard automatically.
              </Paragraph>
            </div>
            <div class="mt-auto pb-0 lg:px-6">
              <video
                class="rounded-t-2xl border border-b-0 border-black/10 dark:border-white/10 w-full h-auto aspect-[1712/1080] translate-y-px"
                src="/images/changelog/1.3.8/clipboard_demo.mp4"
                autoplay
                loop
                muted
                playsinline
                aria-label="Picmal compressing an image copied to the clipboard"
              ></video>
            </div>
          </div>
        </div>
      </div>

      <!-- ===============================================================
           Block 3 — Controls
      ================================================================ -->
      <div>
        <div class="mb-10 max-w-2xl">
          <p class={eyebrow}>Presets &amp; controls</p>
          <h3 class={blockTitle}>Simple by default, deep when you need it</h3>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-6 gap-5">
          <!-- Presets lead — preferences bleeding bottom-right -->
          <div class={`${card} lg:col-span-4 min-h-[360px]`}>
            <div class="p-6 relative z-10 lg:max-w-[45%]">
              <H3 class="mb-2"
                >Presets for the usual stuff. Full control for the rest.</H3
              >
              <Paragraph>
                One-click presets for web, social media, and archiving. Save
